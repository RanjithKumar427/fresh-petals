# Copy this file to .env and fill in real values. .env is gitignored —
# never commit real credentials.

# Supabase → Settings → Database → Connection pooling → "Transaction" mode
# (port 6543). This is a pooled connection, not a direct one — see
# docs/architecture/supabase-migration.md for why that matters.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Supabase → Settings → API Keys. The publishable key is safe to expose in
# the browser; the secret key is server-only and must never reach client
# code or be logged/committed anywhere.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# Optional — the canonical production URL, used for canonical tags,
# sitemap.xml and robots.txt (see astro.config.mjs). Not required locally.
# Leave unset until a real production domain is chosen; astro.config.mjs
# falls back to the current Vercel deployment URL until then.
# SITE_URL=https://your-real-domain.example
