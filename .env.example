# Copy this file to .env and fill in real values. .env is gitignored —
# never commit real credentials.

# Supabase → Settings → Database → Connection pooling → "Transaction" mode
# (port 6543). This is a pooled connection, not a direct one — see
# docs/architecture/supabase-migration.md for why that matters.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Supabase → Settings → API Keys. The code reads these exact names:
# SUPABASE_ANON_KEY holds the publishable key; SUPABASE_SERVICE_ROLE_KEY
# holds the secret key, which is server-only and must never reach client
# code or be logged/committed anywhere.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# The canonical site URL, used for canonical tags, sitemap.xml, robots.txt
# and admin password-reset links. Required in Production
# (https://onlyfreshpetals.in): without it no reset email is sent, because
# reset links must never be built from a request's Host header. Optional
# locally and in Preview, where the request origin is used instead.
# SITE_URL=https://your-real-domain.example

# Garland website refresh (src/server/services/GarlandWebsite.ts). Neither is
# needed on Vercel: admin saves purge the CDN cache through the platform API.
# SITE_CACHE_PURGE_URL: only when the site is served through a different
# CDN — receives POST {"tags":["garlands"]}.
# SITE_CHECK_ORIGIN: where the editor's "Website" check fetches pages from,
# if not the address the admin is using (e.g. https://onlyfreshpetals.in).
# SITE_CACHE_PURGE_URL=
# SITE_CHECK_ORIGIN=
