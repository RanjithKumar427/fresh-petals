---
import BaseLayout from "../../layouts/BaseLayout.astro";
import DeliveryChecker from "../../components/DeliveryChecker.astro";
import ProductOptions from "../../components/ProductOptions.astro";
import { productCatalog } from "../../data/productCatalog";

export function getStaticPaths() {
  return productCatalog.map((product) => ({
    params: {
      slug: product.slug,
    },
    props: {
      product,
    },
  }));
}

const { product } = Astro.props;

const whatsappNumber = "919652012274";

const fallbackWhatsappMessage = encodeURIComponent(
  `Hi Fresh Petals, I want to enquire about:\n\nProduct: ${product.name}\nPrice: ${product.priceLabel}\n\nPlease help me with availability, delivery and final price.`
);

const fallbackWhatsappUrl = `https://wa.me/${whatsappNumber}?text=${fallbackWhatsappMessage}`;
---

<BaseLayout
  title={`${product.name} | Fresh Petals Hyderabad`}
  description={product.description}
>
  <main class="bg-white">
    <section class="px-5 py-12 md:px-8 md:py-16">
      <div class="mx-auto grid max-w-7xl gap-10 lg:grid-cols-2 lg:items-start">
        <div class="overflow-hidden rounded-[28px] bg-[#F8F1F3]">
          <img
            src={product.image}
            alt={product.name}
            class="h-full w-full object-cover"
            loading="eager"
          />
        </div>

        <div>
          <div class="flex flex-wrap items-center gap-2">
            <p class="text-[11px] font-semibold uppercase tracking-[0.32em] text-[#9B6B78]">
              {product.category}
            </p>

            {
              product.badge && (
                <span class="rounded-full bg-[#FFF8FA] px-3 py-1 text-[10px] font-semibold uppercase tracking-[0.18em] text-[#7C243E]">
                  {product.badge}
                </span>
              )
            }
          </div>

          <h1 class="fp-serif mt-4 text-4xl uppercase tracking-[0.16em] text-[#171717] md:text-5xl">
            {product.name}
          </h1>

          {
            product.ratingLabel && (
              <p class="mt-3 text-sm font-semibold uppercase tracking-[0.20em] text-[#075838]">
                {product.ratingLabel}
              </p>
            )
          }

          <p class="mt-5 text-xl font-bold text-[#7C243E]">
            {product.priceLabel}
          </p>

          <p class="mt-5 max-w-xl text-base leading-8 text-[#5E5358]">
            {product.longDescription}
          </p>

          {
            product.requiresConfirmation && (
              <div class="mt-6 rounded-2xl border border-[#E8D8DE] bg-[#FFF8FA] p-5">
                <p class="text-sm font-semibold text-[#7C243E]">
                  Final price and availability will be confirmed on WhatsApp before payment.
                </p>
              </div>
            )
          }

          <ProductOptions product={product} />

          <div class="mt-6 rounded-[24px] border border-[#EEE5E8] bg-[#FAFAFA] p-5">
            <div class="flex flex-col gap-2 md:flex-row md:items-center md:justify-between">
              <div>
                <p class="text-[10px] font-semibold uppercase tracking-[0.28em] text-[#9B6B78]">
                  Optional Check
                </p>

                <h2 class="mt-2 text-base font-semibold text-[#171717]">
                  Only want to check delivery first?
                </h2>

                <p class="mt-2 text-sm leading-6 text-[#66565D]">
                  Use this only if you want to check pincode, date and slot before configuring the full order above.
                </p>
              </div>
            </div>

            <DeliveryChecker
              productName={product.name}
              priceLabel={product.priceLabel}
            />
          </div>

          <p class="mt-4 text-sm leading-7 text-[#66565D]">
            Not sure about delivery area or custom requirement?
            <a
              href={fallbackWhatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="font-semibold text-[#075838] underline underline-offset-4 transition hover:text-[#7C243E]"
            >
              Chat with us directly on WhatsApp.
            </a>
          </p>

          <div class="mt-10 grid gap-6 md:grid-cols-2">
            <div>
              <h2 class="text-[12px] font-bold uppercase tracking-[0.24em] text-[#171717]">
                What’s Included
              </h2>

              <ul class="mt-4 space-y-3 text-sm leading-6 text-[#5E5358]">
                {
                  product.whatsIncluded.map((item) => (
                    <li class="flex gap-2">
                      <span class="mt-1 text-[#7C243E]">•</span>
                      <span>{item}</span>
                    </li>
                  ))
                }
              </ul>
            </div>

            <div>
              <h2 class="text-[12px] font-bold uppercase tracking-[0.24em] text-[#171717]">
                Care Notes
              </h2>

              <ul class="mt-4 space-y-3 text-sm leading-6 text-[#5E5358]">
                {
                  product.careNotes.map((item) => (
                    <li class="flex gap-2">
                      <span class="mt-1 text-[#7C243E]">•</span>
                      <span>{item}</span>
                    </li>
                  ))
                }
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>