---
import BaseLayout from "../../layouts/BaseLayout.astro";
import DeliveryChecker from "../../components/DeliveryChecker.astro";
import { productCatalog } from "../../data/productCatalog";

export function getStaticPaths() {
  return productCatalog.map((product) => ({
    params: {
      slug: product.slug,
    },
    props: {
      product,
    },
  }));
}

const { product } = Astro.props;

const whatsappNumber = "919652012274";

const fallbackWhatsappMessage = encodeURIComponent(
  `Hi Fresh Petals, I want to enquire about:\n\nProduct: ${product.name}\nPrice: ${product.priceLabel}\n\nPlease help me with availability, delivery and final price.`
);

const fallbackWhatsappUrl = `https://wa.me/${whatsappNumber}?text=${fallbackWhatsappMessage}`;
---

<BaseLayout
  title={`${product.name} | Fresh Petals Hyderabad`}
  description={product.description}
>
  <main class="bg-white">
    <section
      class="px-5 py-12 md:px-8 md:py-16"
      data-product-detail
      data-cart-id={product.id}
      data-cart-slug={product.slug}
      data-cart-name={product.name}
      data-cart-image={product.image}
      data-cart-price-label={product.priceLabel}
      data-cart-category={product.category}
    >
      <div class="mx-auto grid max-w-7xl gap-10 lg:grid-cols-2 lg:items-start">
        <div class="overflow-hidden rounded-[28px] bg-[#F8F1F3]">
          <img
            src={product.image}
            alt={product.name}
            class="h-full w-full object-cover"
            loading="eager"
          />
        </div>

        <div>
          <p class="text-[11px] font-semibold uppercase tracking-[0.32em] text-[#9B6B78]">
            {product.category}
          </p>

          <h1 class="fp-serif mt-4 text-4xl uppercase tracking-[0.16em] text-[#171717] md:text-5xl">
            {product.name}
          </h1>

          <p class="mt-5 text-xl font-bold text-[#7C243E]">
            {product.priceLabel}
          </p>

          <p class="mt-5 max-w-xl text-base leading-8 text-[#5E5358]">
            {product.longDescription}
          </p>

          {
            product.requiresConfirmation && (
              <div class="mt-6 rounded-2xl border border-[#E8D8DE] bg-[#FFF8FA] p-5">
                <p class="text-sm font-semibold text-[#7C243E]">
                  Final price and availability will be confirmed on WhatsApp before payment.
                </p>
              </div>
            )
          }

          <div class="mt-6 rounded-[24px] border border-[#EEE5E8] bg-white p-5 shadow-[0_10px_30px_rgba(40,24,32,0.05)]">
            <h2 class="text-[12px] font-bold uppercase tracking-[0.24em] text-[#171717]">
              Add to Cart
            </h2>

            <p class="mt-3 text-sm leading-7 text-[#66565D]">
              Add this product to your cart if you want to combine it with other flowers, add-ons or gift items.
            </p>

            <div class="mt-5 flex flex-col gap-3 sm:flex-row">
              <button
                type="button"
                data-product-add-to-cart
                class:list={[
                  "inline-flex items-center justify-center rounded-full px-7 py-4 text-[11px] font-bold uppercase tracking-[0.22em] transition",
                  product.isAvailable
                    ? "bg-[#7C243E] text-white hover:bg-[#111111]"
                    : "pointer-events-none bg-[#D8D1D4] text-[#7A6E73]",
                ]}
              >
                {product.isAvailable ? "Add to Cart" : "Unavailable"}
              </button>

              <a
                href="/cart"
                class="inline-flex items-center justify-center rounded-full border border-[#111111] px-7 py-4 text-[11px] font-bold uppercase tracking-[0.22em] text-[#111111] transition hover:bg-[#111111] hover:text-white"
              >
                View Cart
              </a>
            </div>

            <p
              data-product-cart-feedback
              class="mt-4 hidden rounded-full bg-[#F3FFF7] px-4 py-3 text-center text-sm font-semibold text-[#075838]"
            >
              Added to cart. You can continue shopping or view cart.
            </p>
          </div>

          <DeliveryChecker
            productName={product.name}
            priceLabel={product.priceLabel}
          />

          <p class="mt-4 text-sm leading-7 text-[#66565D]">
            Not sure about delivery area or custom requirement?
            <a
              href={fallbackWhatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="font-semibold text-[#075838] underline underline-offset-4 transition hover:text-[#7C243E]"
            >
              Chat with us directly on WhatsApp.
            </a>
          </p>

          <div class="mt-10 grid gap-6 md:grid-cols-2">
            <div>
              <h2 class="text-[12px] font-bold uppercase tracking-[0.24em] text-[#171717]">
                What’s Included
              </h2>

              <ul class="mt-4 space-y-3 text-sm leading-6 text-[#5E5358]">
                {
                  product.whatsIncluded.map((item) => (
                    <li class="flex gap-2">
                      <span class="mt-1 text-[#7C243E]">•</span>
                      <span>{item}</span>
                    </li>
                  ))
                }
              </ul>
            </div>

            <div>
              <h2 class="text-[12px] font-bold uppercase tracking-[0.24em] text-[#171717]">
                Care Notes
              </h2>

              <ul class="mt-4 space-y-3 text-sm leading-6 text-[#5E5358]">
                {
                  product.careNotes.map((item) => (
                    <li class="flex gap-2">
                      <span class="mt-1 text-[#7C243E]">•</span>
                      <span>{item}</span>
                    </li>
                  ))
                }
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <script>
    import { addToCart } from "../../utils/cart";

    const productDetail = document.querySelector("[data-product-detail]");
    const addButton = document.querySelector("[data-product-add-to-cart]");
    const feedback = document.querySelector("[data-product-cart-feedback]");

    addButton?.addEventListener("click", () => {
      if (!productDetail) return;

      const section = productDetail as HTMLElement;

      const id = section.dataset.cartId || "";
      const slug = section.dataset.cartSlug || "";
      const name = section.dataset.cartName || "";
      const image = section.dataset.cartImage || "";
      const priceLabel = section.dataset.cartPriceLabel || "";
      const category = section.dataset.cartCategory || "";

      addToCart(
        {
          id,
          slug,
          name,
          image,
          priceLabel,
          category,
        },
        1
      );

      feedback?.classList.remove("hidden");

      setTimeout(() => {
        feedback?.classList.add("hidden");
      }, 1800);
    });
  </script>
</BaseLayout>