---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { productTitle } from "../../data/productTitles";
import { guideForCategory } from "../../data/guides";
import ProductOptions from "../../components/ProductOptions.astro";
import JourneyNote from "../../components/occasion/JourneyNote.astro";
import ProductCard from "../../components/ProductCard.astro";
import type { Product } from "../../data/productCatalog";
import { TaxonomyService } from "../../server/services/TaxonomyService";
import { loadAuthoritativePrices, withAuthoritativePrice } from "../../server/services/ProductPricing";
import { loadPublicCatalogue } from "../../server/services/PublicCatalogue";
import { slugify } from "../../server/utils/slugify";
import imageVariants from "../../data/imageVariants.json";
import imageDimensions from "../../data/imageDimensions.json";
import { whatsappLink } from "../../config/storefront";
import { QUOTE_ONLY_PRICE_LABEL, isQuoteOnly } from "../../shared/quoteOnly";
import { photoStatus, productPhotoAlt, representativePhoto } from "../../data/productPhotos";
import { presentationCheck } from "../../data/collectionGuidance";

// Catalog/Database Reconciliation milestone — the product's displayed
// price now comes from PostgreSQL (the admin-editable, authoritative
// value), not from productCatalog.ts's own priceLabel. Everything else
// about this product (name, description, images, flowerTypes, badge,
// etc.) still comes from the catalog — see ProductPricing.ts's header for
// exactly why that split is deliberate, not an oversight.
//
// Garland designs are not built here: they live in the admin and are
// rendered on request by ./[...garland].astro at the same /products/<slug>
// addresses (Astro falls through to that route for any slug not listed below).
//
// Only public catalogue products get a page: a record that is a draft or
// archived in this deployment's snapshot (src/server/services/
// PublicCatalogue.ts) is not built, so its address falls through to the
// "not available" 404 (noindex, no basket or enquiry) in ./[...garland].astro.
export async function getStaticPaths() {
  const [priceMap, publicCatalogue] = await Promise.all([loadAuthoritativePrices(), loadPublicCatalogue()]);
  return publicCatalogue.map((product) => ({
    params: {
      slug: product.slug,
    },
    props: {
      product: withAuthoritativePrice(product, priceMap),
    },
  }));
}

type Props = {
  product: Product;
};

const { product } = Astro.props;
// Offer ranges ("Budget picks", "Fresh deals") carry a merchandising label,
// not an amount, so there is no starting or set price to describe.
const pricedAs = /\d/.test(product.priceLabel) ? product.priceType : null;
// Bouquets and garlands are priced on WhatsApp (src/shared/quoteOnly.ts).
const quoteOnly = isQuoteOnly(product);

// Customer UX milestone — same admin-managed taxonomy cart.astro's
// Delivery Details section already uses for its Occasion field; reused
// here rather than duplicated so both stay in sync automatically.
const occasionOptions = await TaxonomyService.listOccasions();

const flowerTypes = product.flowerTypes?.length
  ? product.flowerTypes.join(", ")
  : product.whatsIncluded?.join(", ");

const idealFor = product.idealFor?.length
  ? product.idealFor.join(", ")
  : product.occasionTags?.join(", ");

// Facts that fit the product. A stem range is a bouquet fact: it is shown
// only for bouquets and lilies that record one, and stays a listed range, not
// a promise of the bouquet as made. Loose flowers, strings, boxes and other
// products have no stems to list; their quantity is confirmed on WhatsApp.
const isBouquet = /^(bouquets|lilies)$/i.test(product.category);
const stemCount = isBouquet ? product.stemCount ?? null : null;
// One useful care instruction from the record, in place of a vague grade.
const careLine = product.careNotes?.slice(0, 2).join(" ") || null;

const trustIndicators = [
  "Fresh Flowers",
  "Delivery Confirmed on WhatsApp",
  "WhatsApp Ordering",
  "Hand-Arranged",
];

// Content / Integrity milestone (Phase 0) — the old fallback silently
// swapped in `productCatalog.slice(0, 6)` (the first six catalogue
// entries, unrelated to this product) whenever the real category/
// occasion/collection filter came up short, and displayed the result
// under the heading "You May Also Like". Removed: this list is now only
// ever genuinely related products, even when that's fewer than six or
// zero — see the section below, which hides itself entirely rather than
// pad with arbitrary items.
//
// Phase 6 — the OR-filter above looked fixed but wasn't: occasionTags are
// near-universal (birthday alone is on 61 of 89 products), so the filter
// matched almost the whole catalogue for almost every product, and
// `.slice(0, 6)` fell back to raw catalogue order. Simulated across all 89
// product pages: 75 of them rendered the identical six bouquets, including
// on a florist's cutting tool and a chocolate add-on -- the exact
// "unrelated items under a related-items heading" defect the Phase 0
// removal above was meant to end, reproduced through a different
// mechanism. Fixed by scoring real overlap depth instead of a boolean
// match, using the same three fields -- no new data, no component change.
// Related products come from the same public catalogue as the pages they link to.
const relatedProducts = (await loadPublicCatalogue())
  .filter((item) => item.slug !== product.slug)
  .map((item) => {
    const sameCategory = item.category === product.category ? 5 : 0;

    const collectionOverlap = (item.collectionTags ?? []).filter((tag) =>
      product.collectionTags?.includes(tag)
    ).length * 2;

    const occasionOverlap = (item.occasionTags ?? []).filter((tag) =>
      product.occasionTags?.includes(tag)
    ).length;

    return { item, score: sameCategory + collectionOverlap + occasionOverlap };
  })
  .filter((entry) => entry.score > 0)
  .sort((a, b) => b.score - a.score)
  .slice(0, 6)
  .map((entry) => entry.item);

// Related cards must show the same database price as every other card for
// that product; reading productCatalog directly above left them on the
// stale static priceLabel (e.g. Country Love Note: ₹1299 here, ₹1499
// everywhere else). loadAuthoritativePrices() is cached per build, so this
// reuses getStaticPaths' single query.
const relatedPriceMap = await loadAuthoritativePrices();
const pricedRelatedProducts = relatedProducts.map((item) => withAuthoritativePrice(item, relatedPriceMap));

// The category in the title keeps same-named products distinct (two
// different "Pooja Flower Box" products previously shared one title) and
// says what the product is. Breadcrumbs mirror the real category page.
// No Product/Offer structured data: prices are "From ₹…" starting prices
// confirmed on WhatsApp, not a fixed offer Google could show as one.
const categoryPath = `/categories/${slugify(product.category)}`;
const mainVariants = (imageVariants as Record<string, Record<string, string>>)[product.image];
const mainSrcset = mainVariants
  ? [...Object.entries(mainVariants).map(([width, path]) => `${path} ${width}w`), `${product.image} 1200w`].join(", ")
  : undefined;
const mainDimensions = (imageDimensions as Record<string, { width: number; height: number }>)[product.image];
// Search snippet: what the product is, who makes it and where, and how the
// price is given. Quote-only products never mention an amount.
const quoteOnlyProduct = isQuoteOnly(product);
const metaDescription = `${product.description.replace(/\s+$/, "").replace(/([^.!?])$/, "$1.")} ${
  quoteOnlyProduct ? "Made by Fresh Petals for delivery across India; price and availability on WhatsApp." : "From Fresh Petals, for delivery across India; availability confirmed on WhatsApp."
}`;
// How the photograph relates to the product (src/data/productPhotos.ts): a
// bouquet's own photograph keeps its description; a representative one is
// described by what it shows and labelled on the image; a placeholder says so.
const photo = photoStatus(product);
const representative = representativePhoto(product);
const lowerFirst = (text: string) => text.charAt(0).toLowerCase() + text.slice(1);
const imageAlt = (photo === "product" || photo === "unconfirmed") && isBouquet ? `${product.name}: ${product.description.replace(/\.$/, "")}` : productPhotoAlt(product);
// Recorded presentation that the photograph contradicts: shown qualified, never restated as fact.
const presentation = presentationCheck(product);
const PRESENTATION_ITEM = /wrapping|hand-tied|\bvase\b|\bbox\b|basket/i;
const breadcrumbJsonLd = {
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: new URL("/", Astro.site).toString() },
    { "@type": "ListItem", position: 2, name: product.category, item: new URL(categoryPath, Astro.site).toString() },
    { "@type": "ListItem", position: 3, name: product.name, item: new URL(`/products/${product.slug}`, Astro.site).toString() },
  ],
};
---

<BaseLayout
  title={productTitle(product)}
  jsonLd={[breadcrumbJsonLd]}
  description={metaDescription}
  image={photo === "missing" ? undefined : product.image}
  showCategoryCarousel={false}
>
  <main data-track-item={product.slug} data-track-category={product.category}>
  <!-- Main Product Section -->
  <section class="px-5 py-10 md:px-8 md:py-12">
    <div class="mx-auto grid max-w-7xl gap-10 lg:grid-cols-[1.12fr_0.88fr] lg:items-start">
      <!-- Left sticky image -->
      <aside class="lg:sticky lg:top-28 lg:self-start">
        <!-- Phase 6 — Save is taught as the core discovery primitive on
             every DiscoveryPostCard, then vanished the moment a customer
             actually reached a product; the destination was the one place
             it was missing. Placed on the image, not the CTA column below
             (which already stacks Order-on-WhatsApp + Add-to-cart + two
             more buttons inside Delivery Details) so it doesn't compete
             with those, and so it's the exact gesture already learned from
             every feed card. Reuses src/utils/saved.ts unchanged. -->
        <div class="relative overflow-hidden rounded-[22px] bg-linen shadow-[0_20px_50px_rgba(40,24,32,0.10)]">
          <img
            src={product.image}
            srcset={mainSrcset}
            sizes={mainSrcset ? "(min-width: 1024px) 52vw, 100vw" : undefined}
            alt={imageAlt}
            width={mainDimensions?.width}
            height={mainDimensions?.height}
            class="aspect-[4/5] w-full object-cover lg:max-h-[calc(100vh-8rem)]"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />

          <button
            type="button"
            data-save-toggle
            data-save-id={product.slug}
            aria-label={`Save ${product.name}`}
            aria-pressed="false"
            class="fp-save-btn absolute right-3 top-3 z-20 flex h-11 w-11 items-center justify-center"
          >
            <span class="fp-save-visual flex h-9 w-9 items-center justify-center rounded-full bg-white/90 text-black/55 shadow-sm backdrop-blur transition active:scale-90">
              <svg
                class="fp-save-icon-outline h-[18px] w-[18px]"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M12 21s-7.5-4.6-9.8-9.1C.6 8 2 4.5 5.6 4.5c2.1 0 3.7 1.2 4.4 2.7.7-1.5 2.3-2.7 4.4-2.7 3.6 0 5 3.5 3.4 6.9C19.5 16.4 12 21 12 21Z"></path>
              </svg>

              <svg
                class="fp-save-icon-filled hidden h-[18px] w-[18px] text-berry"
                viewBox="0 0 24 24"
                fill="currentColor"
                aria-hidden="true"
              >
                <path d="M12 21s-7.5-4.6-9.8-9.1C.6 8 2 4.5 5.6 4.5c2.1 0 3.7 1.2 4.4 2.7.7-1.5 2.3-2.7 4.4-2.7 3.6 0 5 3.5 3.4 6.9C19.5 16.4 12 21 12 21Z"></path>
              </svg>
            </span>
          </button>
          {/* On the photograph itself (as on guide cards), so the sticky desktop column never hides it. */}
          {representative && (
            <p class="absolute inset-x-3 bottom-3 z-10 rounded-xl bg-paper/95 px-3 py-2 text-[12px] leading-5 text-ink shadow-sm" data-representative-photo>
              <span class="font-semibold">Representative photograph:</span> {lowerFirst(representative)}. It is not this exact product; what you receive is confirmed on WhatsApp.
            </p>
          )}
        </div>
      </aside>

      <!-- Right product content -->
      <section class="max-w-[560px] lg:pl-2">
        <div class="flex flex-wrap items-center gap-3">
          <p class="text-[11px] font-semibold uppercase tracking-[0.32em] text-rose-deep">
            {product.category}
          </p>

          {product.badge && (
            <span class="rounded-full bg-linen px-4 py-1 text-[10px] font-semibold uppercase tracking-[0.24em] text-berry">
              {product.badge}
            </span>
          )}
        </div>

        <h1 class="fp-serif mt-5 text-5xl leading-[0.95] text-ink md:text-6xl">
          {product.name}
        </h1>

        {/* P0.1 (Phase 1 discovery hardening) -- ratingLabel is mood/
            merchandising copy ("Blush tones", "Elegant gift"), not a
            rating. It was previously rendered in #075838 -- the same
            trust-green used sitewide for verified/confirmed badges --
            directly under the H1, reading as a credential it isn't.
            Restyled as plain supporting text; content unchanged. */}
        {product.ratingLabel && (
          <p class="mt-5 text-[13px] font-medium text-moss">
            {product.ratingLabel}
          </p>
        )}

        {
          quoteOnly ? (
            <div class="mt-6">
              <p class="text-2xl font-bold text-ink" data-quote-only-price>{QUOTE_ONLY_PRICE_LABEL}</p>
              <p class="mt-2 text-sm leading-6 text-moss">
                Choose what you like and send it to us — we reply on WhatsApp with the price and availability before anything is made.
              </p>
            </div>
          ) : product.priceType === "quote" ? (
            <div class="mt-6">
              <p class="text-2xl font-bold text-ink">Custom quotation</p>
              <p class="mt-2 text-sm leading-6 text-moss">
                The price depends on the design, flowers, quantity and date. We send a quotation on WhatsApp before
                anything is made — nothing is added to a fixed total.
              </p>
            </div>
          ) : product.priceType === "market" ? (
            <div class="mt-6">
              <p class="text-2xl font-bold text-ink">{product.priceLabel}</p>
              <p class="mt-2 text-sm leading-6 text-moss">Priced at the day's flower market rate, confirmed on WhatsApp before you pay.</p>
            </div>
          ) : (
            <p class="mt-6 text-2xl font-bold text-ink">
              {product.priceLabel}
            </p>
          )
        }

        <p class="mt-7 text-[17px] font-semibold leading-8 text-ink">
          “{product.longDescription}”
        </p>

        <!-- Trust indicators: supporting tier — true of the whole
             catalogue, so it recedes to one quiet caption line instead
             of four repeated icon badges. -->
        <p class="mt-6 flex items-center gap-2 text-[11px] font-medium uppercase tracking-[0.1em] text-moss">
          <svg class="h-3 w-3 shrink-0 text-ink" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="9"></circle>
            <path d="M8.5 12.5l2.5 2.5 5-5"></path>
          </svg>
          {trustIndicators.join("  ·  ")}
        </p>

        <!-- Product info — primary tier: what actually shapes the
             buying decision gets the boxed, icon-led treatment. -->
        <div class="mt-8 grid gap-3 sm:grid-cols-2">
          <div class="rounded-[22px] border border-line bg-linen p-5">
            <div class="flex gap-4">
              <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full border border-line bg-paper text-berry">
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M12 13c2.5-2.5 2.5-5.5 0-8-2.5 2.5-2.5 5.5 0 8Z"></path>
                  <path d="M12 13c-2.5-2.5-5.5-2.5-8 0 2.5 2.5 5.5 2.5 8 0Z"></path>
                  <path d="M12 13c2.5 2.5 5.5 2.5 8 0-2.5-2.5-5.5-2.5-8 0Z"></path>
                  <path d="M12 13v8"></path>
                </svg>
              </span>
              <div>
                <h3 class="text-sm font-bold text-ink">
                  Types of flowers
                </h3>
                <p class="mt-3 text-sm leading-7 text-moss">
                  {flowerTypes}
                </p>
              </div>
            </div>
          </div>

          <div class="rounded-[22px] border border-line bg-linen p-5">
            <div class="flex gap-4">
              <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full border border-line bg-paper text-berry">
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M12 20.5s-7.5-4.6-9.8-9.1C.6 8 2 4.5 5.6 4.5c2.1 0 3.7 1.2 4.4 2.7.7-1.5 2.3-2.7 4.4-2.7 3.6 0 5 3.5 3.4 6.9-2.3 4.5-9.8 9.1-9.8 9.1Z"></path>
                </svg>
              </span>
              <div>
                <h3 class="text-sm font-bold text-ink">
                  Ideal for
                </h3>
                <p class="mt-3 text-sm leading-7 text-moss">
                  {idealFor}
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- Product info — secondary tier: still useful, but plain
             label/value pairs rather than boxed cards so they read as
             detail, not as decisions of equal weight to the above. -->
        <div class="mt-4 flex flex-wrap gap-x-8 gap-y-2 border-t border-line pt-4">
          {stemCount && (
            <p class="text-xs text-moss" data-fact="stems">
              <span class="font-semibold text-ink">Listed stems</span> — {stemCount}. A listed range, not a count of the bouquet as made; confirm the final arrangement on WhatsApp.
            </p>
          )}
          {!isBouquet && (
            <p class="text-xs text-moss" data-fact="quantity">
              <span class="font-semibold text-ink">Quantity</span> — not fixed on this page. Tell us how much you need and we confirm it, and the price, on WhatsApp.
            </p>
          )}
          {careLine && (
            <p class="text-xs text-moss" data-fact="care">
              <span class="font-semibold text-ink">Care</span> — {careLine}
            </p>
          )}
        </div>

        <!-- Only facts the catalogue holds. Size is not recorded for any
             product, so it is asked about rather than estimated from the
             photograph; no preparation time is promised. -->
        <dl class="mt-6 grid gap-3 rounded-[22px] border border-line bg-paper p-5 text-sm leading-6 sm:grid-cols-3">
          <div>
            <dt class="font-semibold text-ink">Size</dt>
            <dd class="mt-1 text-moss">Not listed yet — ask us on WhatsApp.</dd>
          </div>
          <div>
            <dt class="font-semibold text-ink">Preparation</dt>
            <dd class="mt-1 text-moss">
              {product.requiresConfirmation ? "Made to order once we confirm it with you on WhatsApp." : "Confirmed with you on WhatsApp before we prepare it."}
            </dd>
          </div>
          <div>
            <dt class="font-semibold text-ink">Substitutions</dt>
            <dd class="mt-1 text-moss">Flowers depend on what is fresh that day; we agree any change with you before you pay.</dd>
          </div>
        </dl>

        <JourneyNote />
        {/* What the price covers, beside the buying actions — restating the
            terms page: starting vs set price, add-ons and delivery charged
            separately and agreed before payment. (Substitutions are in the
            facts list just above; not repeated here.) */}
        {product.isAvailable && (
          <div class="mt-6 rounded-[18px] border border-line bg-paper px-4 py-3 text-sm leading-6 text-moss" data-price-basis>
            {pricedAs === "from" && (
              <p><strong class="text-ink">{product.priceLabel} is the starting price.</strong> The final price can vary with that day's flowers and any change you ask for — we confirm it before you pay.</p>
            )}
            {pricedAs === "fixed" && (
              <p><strong class="text-ink">{product.priceLabel} is the price of this {product.category === "Bouquets" || product.category === "Lilies" ? "bouquet" : "item"}.</strong></p>
            )}
            {quoteOnly ? (
              <p>We send the price of this {product.category === "Bouquets" || product.category === "Lilies" ? "bouquet" : "item"}, any add-ons you choose and delivery on WhatsApp, and confirm availability before you pay. <a href="/terms" class="inline-flex min-h-[44px] items-center font-semibold text-ink underline underline-offset-2">Terms</a></p>
            ) : (
            <p class={pricedAs === "from" || pricedAs === "fixed" ? "mt-1" : ""}>Add-ons are priced separately (shown with each one). Delivery is charged separately; availability, delivery and the final price are confirmed on WhatsApp before you pay. <a href="/terms" class="inline-flex min-h-[44px] items-center font-semibold text-ink underline underline-offset-2">Terms</a></p>
            )}
          </div>
        )}
        <ProductOptions product={product} occasionOptions={occasionOptions} />

        <p class="mt-5 text-sm leading-6 text-moss">
          Want different colours, flowers or size?
          <a
            href={whatsappLink(`Hi Fresh Petals, I'd like to customise "${product.name}".\nProduct: ${new URL(`/products/${product.slug}`, Astro.site).toString()}\nWhat I'd like to change: \nOccasion and date: \nBudget (optional): `)}
            target="_blank"
            rel="noopener noreferrer"
            data-customise-whatsapp
            class="font-semibold text-ink underline underline-offset-4"
          >Customise on WhatsApp</a>
        </p>

        <div class="mt-10 grid gap-8 border-t border-line pt-8 md:grid-cols-2">
          <div>
            <h2 class="text-[12px] font-semibold uppercase tracking-[0.28em] text-ink">
              What’s included
            </h2>

            <ul class="mt-4 space-y-3 text-sm leading-6 text-moss">
              {product.whatsIncluded.map((item) => (
                <li class="flex gap-2.5">
                  <span class="mt-2.5 h-1 w-1 shrink-0 rounded-full bg-berry"></span>
                  {presentation && PRESENTATION_ITEM.test(item) ? <span data-presentation-unconfirmed>{presentation.note}</span> : item}
                </li>
              ))}
            </ul>
          </div>

          <div>
            <h2 class="text-[12px] font-semibold uppercase tracking-[0.28em] text-ink">
              Care notes
            </h2>

            <ul class="mt-4 space-y-3 text-sm leading-6 text-moss">
              {product.careNotes.map((item) => (
                <li class="flex gap-2.5">
                  <span class="mt-2.5 h-1 w-1 shrink-0 rounded-full bg-berry"></span>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>
    </div>
  </section>

  <!-- You May Also Like — Content / Integrity milestone (Phase 0): only
       renders when relatedProducts has genuine matches. No arbitrary-
       products fallback anymore, so an empty result now means the
       section doesn't render, not that it pads itself with unrelated
       items labelled as picks. -->
  {
    relatedProducts.length > 0 && (
      <section class="border-t border-line bg-ivory px-5 py-14 md:px-8 md:py-16">
        <div class="mx-auto max-w-7xl">
          <div class="text-center">
            <p class="fp-eyebrow">
              Fresh Petals Picks
            </p>

            <h2 class="fp-h2 mt-3">
              You May Also Like
            </h2>
          </div>

          <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-6">
            {
              pricedRelatedProducts.map((item) => (
                <ProductCard
                  id={item.id}
                  name={item.name}
                  image={item.image}
                  imageAlt={productPhotoAlt(item)}
                  priceLabel={item.priceLabel}
                  category={item.category}
                  description={item.description}
                  slug={item.slug}
                  priceType={item.priceType}
                  isAvailable={item.isAvailable}
                />
              ))
            }
          </div>
        </div>
      </section>
    )
  }

  <!-- Feedback: /reviews holds general, site-wide feedback, not reviews of
       this product, and there is no product review system; the copy says
       where the link goes rather than inviting a review of this product. -->
  <section class="border-t border-line bg-ivory px-5 py-14 md:px-8 md:py-16" data-product-feedback>
    <div class="mx-auto max-w-5xl text-center">
      <h2 class="fp-h2">
        Feedback
      </h2>

      <!-- P0.1 (Phase 1 discovery hardening) -- this block previously
           rendered a hardcoded ★★★★★ / "5.00 out of 5" directly beside
           "Be the first to write a review" on all 89 product pages: a
           fabricated 5.00 average over zero real reviews, contradicted by
           its own neighbouring copy. Removed rather than replaced -- no
           review count or score exists anywhere in the codebase to
           honestly show instead. The two remaining columns re-flow to
           md:grid-cols-2 rather than leaving an empty gap. -->
      <div class="mt-8 grid gap-6 border-t border-line pt-8 md:grid-cols-2 md:items-center">
        <div>
