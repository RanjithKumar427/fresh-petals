---
// Garland product pages, rendered on request at /products/<slug>. Astro
// serves every bouquet from the prebuilt ./[slug].astro; any other slug falls
// through to this route. Data is read fresh from the admin database on every
// render; the CDN caches the result briefly and an admin save purges it
// (src/server/services/GarlandWebsite.ts), so changes appear without a
// deployment. A garland that isn't public returns 404 — no page, no enquiry.
import BaseLayout from "../../layouts/BaseLayout.astro";
import GarlandProductMain from "../../components/GarlandProductMain.astro";
import GarlandCard from "../../components/GarlandCard.astro";
import { isListedGarland, loadGarlands } from "../../data/garlands";
import { TaxonomyService } from "../../server/services/TaxonomyService";
import { garlandCacheHeaders } from "../../server/services/GarlandWebsite";
import { GARLANDS_PATH, GARLAND_COLLECTIONS, GARLAND_GUIDE_PATH } from "../../data/garlandCollections";
import { productCatalog } from "../../data/productCatalog";

export const prerender = false;

for (const [name, value] of Object.entries(garlandCacheHeaders())) Astro.response.headers.set(name, value);

const slug = Astro.params.garland ?? "";
const garlands = /^[a-z0-9-]+$/.test(slug) ? await loadGarlands() : [];
const product = garlands.find((item) => item.slug === slug) ?? null;
if (!product) Astro.response.status = 404;
// A catalogue product that isn't published in this deployment (a draft or an
// archived record; ./[slug].astro builds pages for public ones only) lands
// here too. It gets the same unavailable answer: 404, noindex, no basket or
// enquiry, and no redirect to a substitute product.
const catalogueRecord = !product && productCatalog.some((item) => item.slug === slug);

// Six alternatives sharing a flower filter, taken from the designs that
// follow this one in the catalogue (wrapping round), so each design links to
// its neighbours rather than every page linking to the same first six.
const position = product ? garlands.indexOf(product) : -1;
const related = product
  ? [...garlands.slice(position + 1), ...garlands.slice(0, position)]
      .filter((item) => item.garland.filters.some((key) => product.garland.filters.includes(key)))
      .slice(0, 6)
  : [];
const occasionOptions = product ? await TaxonomyService.listOccasions() : [];
const noindex = !product || !isListedGarland(product.garland);
const abs = (path: string) => new URL(path, Astro.site).toString();
// The flower collections this design belongs to; the first leads the breadcrumb.
const collections = product ? GARLAND_COLLECTIONS.filter((collection) => product.garland.filters.includes(collection.key)) : [];
const trail = product
  ? [
      { name: "Home", path: "/" },
      { name: "Garlands", path: GARLANDS_PATH },
      ...(collections[0] ? [{ name: collections[0].label, path: collections[0].path }] : []),
      { name: product.name, path: `/products/${product.slug}` },
    ]
  : [];
// The photograph is the owner's own (confirmed before launch), so it is
// credited. No Product/Offer data: garlands are quote-only and carry no
// amount, rating or stock claim (src/shared/quoteOnly.ts).
const jsonLd = product
  ? [
      { "@type": "BreadcrumbList", itemListElement: trail.map((step, index) => ({ "@type": "ListItem", position: index + 1, name: step.name, item: abs(step.path) })) },
      {
        "@type": "ImageObject",
        contentUrl: abs(product.garland.image.path),
        name: `${product.name} (${product.garland.code})`,
        caption: product.garland.image.alt,
        width: product.garland.image.width,
        height: product.garland.image.height,
        creditText: "Fresh Petals",
        creator: { "@type": "Organization", name: "Fresh Petals", url: abs("/") },
        copyrightNotice: "Fresh Petals",
      },
    ]
  : [];
// Search snippet: what the photograph shows (the only confirmed details),
// the design code, and how it is sold. An admin-written description leads
// when there is one; the catalogue's placeholder ("… — design FP-G001.") does not.
const written = product && !/— design FP-G\d+\.$/.test(product.description) ? product.description.replace(/([^.!?])$/, "$1.") : "";
const metaDescription = product
  ? `${written || product.garland.image.alt.replace(/([^.!?])$/, "$1.")} Design ${product.garland.code}, made to order by Fresh Petals. Price on WhatsApp.`
  : "This page isn't available.";
---

<BaseLayout
  title={product ? `${product.name} (${product.garland.code}) | Fresh Petals` : "Not available | Fresh Petals"}
  description={metaDescription}
  image={product?.image}
  jsonLd={noindex ? [] : jsonLd}
  showCategoryCarousel={false}
  noindex={noindex}
>
  <main>
    {
      product ? (
        <>
          <GarlandProductMain product={product} occasionOptions={occasionOptions} />
          {related.length > 0 && (
            <section class="border-t border-line bg-ivory px-5 py-14 md:px-8 md:py-16">
              <div class="mx-auto max-w-7xl">
                <h2 class="fp-h2 text-center">You May Also Like</h2>
                <div class="mt-10 grid grid-cols-2 gap-3 md:grid-cols-3 lg:grid-cols-6">
                  {related.map((item) => <GarlandCard product={item} />)}
                </div>
                <p class="mt-8 flex flex-wrap justify-center gap-2" data-garland-more>
                  {collections.map((collection) => (
                    <a href={collection.path} class="inline-flex min-h-[44px] items-center rounded-full border border-line bg-paper px-4 text-sm text-ink hover:border-ink">All {collection.label.toLowerCase()}</a>
                  ))}
                  <a href={GARLANDS_PATH} class="inline-flex min-h-[44px] items-center rounded-full border border-line bg-paper px-4 text-sm text-ink hover:border-ink">All garlands</a>
                  <a href={GARLAND_GUIDE_PATH} class="inline-flex min-h-[44px] items-center rounded-full border border-line bg-paper px-4 text-sm text-ink hover:border-ink">How to choose a wedding garland</a>
                </p>
              </div>
            </section>
          )}
        </>
      ) : (
        <section class="px-5 py-20 text-center md:px-8" data-garland-unavailable data-product-unavailable={catalogueRecord ? "catalogue" : "garland"}>
          <h1 class="fp-h1">This page isn't available</h1>
          <p class="mx-auto mt-4 max-w-xl text-sm leading-7 text-moss">
            {catalogueRecord
              ? "This product isn't on sale at the moment. Browse the flowers we're making now, or ask us for a custom order."
              : "This garland design isn't on sale at the moment. Browse the garlands we're making now, or ask us for a custom order."}
          </p>
          <p class="mt-7 flex flex-wrap justify-center gap-3">
            {catalogueRecord
              ? <a href="/categories/all-flowers" class="inline-flex min-h-[44px] items-center rounded-full bg-berry px-6 text-sm font-semibold text-white">See all flowers</a>
              : <a href="/categories/garlands" class="inline-flex min-h-[44px] items-center rounded-full bg-berry px-6 text-sm font-semibold text-white">See garlands</a>}
            <a href="/custom-orders" class="inline-flex min-h-[44px] items-center rounded-full border border-ink px-6 text-sm font-semibold text-ink">Custom orders</a>
          </p>
        </section>
      )
    }
  </main>
</BaseLayout>
