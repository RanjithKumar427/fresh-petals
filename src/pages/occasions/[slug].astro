---
import BaseLayout from "../../layouts/BaseLayout.astro";
import DiscoveryFeed from "../../components/DiscoveryFeed.astro";
import { productCatalog, type Product } from "../../data/productCatalog";
import { loadAuthoritativePrices, withAuthoritativePrice } from "../../server/services/ProductPricing";
import { curateDiscoveryOrder } from "../../utils/feedCuration";
import LandingDetails from "../../components/LandingDetails.astro";
import { OCCASION_LANDING, NOINDEX_OCCASION_SLUGS, lowestPrice } from "../../data/seoLanding";
import { GARLAND_OCCASION_ROUTES, LAUNCH_OCCASION_ROUTES, OCCASION_CAROUSEL_ROUTES, garlandsPromoted, launchProductsForOccasion, occasionBouquets } from "../../data/launchCatalogue";
import LiveGarlands from "../../components/LiveGarlands.astro";

type OccasionMeta = {
  name: string;
  slug: string;
  description: string;
  eyebrow: string;
  heroNote: string;
  fallbackProductSlugs: string[];
};

export async function getStaticPaths() {
  // Catalog/Database Reconciliation milestone — see products/[slug].astro's
  // matching comment. One shared price map for every occasion page this
  // build generates.
  const priceMap = await loadAuthoritativePrices();

  const occasions: OccasionMeta[] = [
    {
      name: "Birthday",
      slug: "birthday",
      eyebrow: "Birthday Flowers",
      description:
        "Fresh bouquets, baskets, flower boxes and hampers for birthday gifting in Bengaluru.",
      heroNote:
        "Choose a birthday-ready flower gift and confirm today’s flower availability on WhatsApp.",
      fallbackProductSlugs: [
        "flower-chocolate-hamper",
        "gift-basket",
        "premium-card-addon",
      ],
    },
    {
      name: "Anniversary",
      slug: "anniversary",
      eyebrow: "Anniversary Flowers",
      description:
        "Romantic rose bouquets, premium gift bouquets, hampers and flower baskets for anniversaries.",
      heroNote:
        "Best for romantic gifting, surprise deliveries and premium flower combinations.",
      fallbackProductSlugs: [
        "flower-chocolate-hamper",
        "candle-diffuser-addon",
      ],
    },
    {
      name: "Wedding",
      slug: "wedding",
      eyebrow: "Wedding Flowers",
      description:
        "Fresh wedding flowers, bridal accessories, garlands, jasmine gajra and event flower requirements.",
      heroNote:
        "Wedding and event flower pricing depends on flower type, quantity, date and market rate.",
      fallbackProductSlugs: [
        "bridal-flower-accessories",
        "event-garlands",
        "jasmine-gajra",
        "fresh-flower-toran",
        "temple-bulk-flowers",
        "jasmine-malli",
      ],
    },
    {
      // Built only when it has products (see the filter below): garland
      // designs once they are public, or the drafts in a local preview.
      name: "Engagement",
      slug: "engagement",
      eyebrow: "Engagement Flowers",
      description: "Garlands for engagement ceremonies, made to order and quoted on WhatsApp.",
      heroNote: "Garlands are made to order; the flowers, length and price are confirmed with you on WhatsApp.",
      fallbackProductSlugs: [],
    },
    {
      name: "Pooja",
      slug: "pooja",
      eyebrow: "Pooja Flowers",
      description:
        "Fresh pooja flowers, jasmine, torans, pooja flower boxes and baskets for rituals and daily worship.",
      heroNote:
        "Morning pooja flower availability and delivery slots are confirmed on WhatsApp.",
      fallbackProductSlugs: [
        "daily-pooja-flowers",
        "jasmine-malli",
        "pooja-flower-box",
        "pooja-flowerbox",
        "pooja-basket",
        "fresh-flower-toran",
        "temple-bulk-flowers",
      ],
    },
    {
      name: "Housewarming",
      slug: "housewarming",
      eyebrow: "Housewarming Flowers",
      description:
        "Flower hampers, baskets, plants, decor flowers and torans for housewarming gifting and pooja.",
      heroNote:
        "Ideal for Gruhapravesam, new home gifting, pooja decor and premium flower hampers.",
      fallbackProductSlugs: [
        "housewarming-flower-hamper",
        "plant-and-flower-hamper",
        "fresh-flower-toran",
        "flower-basket",
      ],
    },
    {
      name: "Thank You",
      slug: "thank-you",
      eyebrow: "Thank You Flowers",
      description:
        "Simple flower gifts, bouquets, baskets and hampers to say thank you with fresh flowers.",
      heroNote:
        "Add a message card and confirm the final gift combination on WhatsApp.",
      fallbackProductSlugs: [
        "gift-flower-box",
        "flower-chocolate-hamper",
        "premium-card-addon",
        "mini-succulent-gift",
      ],
    },
    {
      name: "Get Well Soon",
      slug: "get-well-soon",
      eyebrow: "Get Well Soon Flowers",
      description:
        "Soft flower arrangements, plants and simple fresh flower gifts for get well soon messages.",
      heroNote:
        "Choose gentle flowers or a simple plant gift and confirm delivery availability.",
      fallbackProductSlugs: [
        "mini-succulent-gift",
        "gift-flower-box",
        "premium-card-addon",
      ],
    },
    {
      name: "I Am Sorry",
      slug: "i-am-sorry",
      eyebrow: "Sorry Flowers",
      description:
        "Rose bouquets, soft flower boxes and premium cards for apology gifting.",
      heroNote:
        "Add a message note and confirm the flower style before order.",
      fallbackProductSlugs: [
        "gift-flower-box",
        "premium-card-addon",
        "flower-chocolate-hamper",
      ],
    },
    {
      name: "Mom To Be",
      slug: "mom-to-be",
      eyebrow: "Mom To Be Flowers",
      description:
        "Soft premium bouquets, hampers, baskets and gentle flower gifts for mom-to-be celebrations.",
      heroNote:
        "Best for baby shower gifting, soft pastel flowers, hampers and thoughtful message cards.",
      fallbackProductSlugs: [
        "flower-chocolate-hamper",
        "housewarming-flower-hamper",
        "premium-card-addon",
        "mini-succulent-gift",
      ],
    },
    {
      name: "New Mom",
      slug: "new-mom",
      eyebrow: "New Mom Flowers",
      description:
        "Thoughtful flower gifts, plants, hampers and soft bouquets for new mom gifting.",
      heroNote:
        "Keep it gentle, fresh and gift-ready with a message card confirmed on WhatsApp.",
      fallbackProductSlugs: [
        "mini-succulent-gift",
        "flower-chocolate-hamper",
        "premium-card-addon",
      ],
    },
    {
      name: "Sympathy",
      slug: "sympathy",
      eyebrow: "Sympathy Flowers",
      description:
        "Simple, respectful flower arrangements for sympathy, remembrance and support messages.",
      heroNote:
        "Choose soft flowers and a simple note. Final availability and delivery timing are confirmed on WhatsApp.",
      fallbackProductSlugs: [
        "premium-card-addon",
      ],
    },
    {
      name: "Just Because",
      slug: "just-because",
      eyebrow: "Just Because Flowers",
      description:
        "Fresh everyday flowers, flowerboxes, stems and small gifts for no-reason surprises.",
      heroNote:
        "A simple flower surprise for someone special, confirmed quickly on WhatsApp.",
      fallbackProductSlugs: [
        "loose-flower-box",
        "mini-succulent-gift",
      ],
    },
    {
      name: "Congratulations",
      slug: "congratulations",
      eyebrow: "Congratulations Flowers",
      description:
        "Premium bouquets, hampers, baskets and flower gifts for achievements, milestones and celebrations.",
      heroNote:
        "Send a premium fresh flower gift with a message card and optional add-ons.",
      fallbackProductSlugs: [
        "flower-chocolate-hamper",
        "gift-basket",
        "premium-card-addon",
        "plant-and-flower-hamper",
      ],
    },
    {
      name: "Romantic",
      slug: "romantic",
      eyebrow: "Romantic Flowers",
      description:
        "Rose bouquets, romantic hampers, candles, cards and premium arrangements for love-filled gifting.",
      heroNote:
        "Best for anniversaries, proposals, apology gifting and special romantic surprises.",
      fallbackProductSlugs: [
        "flower-chocolate-hamper",
        "candle-diffuser-addon",
        "premium-card-addon",
      ],
    },
  ];

  return occasions
    // Engagement has no launch products of its own; its page exists once it
    // has some, or once garlands are promoted (its garlands load live).
    .filter((occasion) => occasion.slug !== "engagement" || launchProductsForOccasion("engagement").length > 0 || garlandsPromoted())
    .map((occasion) => {
    // Launch occasions (src/data/launchCatalogue.ts) recommend only launch
    // products genuinely tagged for them — no fallback add-ons, baskets or
    // torans that aren't ready. An empty one is noindexed and left out of
    // the menu and sitemap. Homepage carousel occasions list exactly the
    // bouquets their carousel card counts (occasionBouquets): for launch
    // occasions that is the same launch list; for Condolence (sympathy) it
    // is its tagged public bouquets, without add-ons or fallbacks.
    if (LAUNCH_OCCASION_ROUTES.has(occasion.slug) || OCCASION_CAROUSEL_ROUTES.has(occasion.slug)) {
      return {
        params: { slug: occasion.slug },
        props: {
          occasion,
          products: occasionBouquets(occasion.slug).map((product) => withAuthoritativePrice(product, priceMap)),
        },
      };
    }

    const taggedProducts = productCatalog.filter((product) =>
      product.occasionTags?.includes(occasion.slug)
    );

    const fallbackProducts = occasion.fallbackProductSlugs
      .map((slug) => productCatalog.find((product) => product.slug === slug))
      .filter((product): product is Product => Boolean(product));

    const products: Product[] = [...taggedProducts, ...fallbackProducts]
      .filter(
        (product, index, array) =>
          array.findIndex((item) => item.slug === product.slug) === index
      )
      .map((product) => withAuthoritativePrice(product, priceMap));

    return {
      params: {
        slug: occasion.slug,
      },
      props: {
        occasion,
        products,
      },
    };
  });
}

const { occasion, products } = Astro.props as {
  occasion: OccasionMeta;
  products: Product[];
};

// Discovery Architecture Hardening (Phase 5), Workstream B milestone —
// this page previously rendered a `ProductCard` grid (VIEW/ADD/ORDER ON
// WHATSAPP on every tile), so a customer who tapped an occasion tag from
// a homepage discovery card landed straight back in full ecommerce mode —
// the exact "discovery -> catalogue" trap this milestone exists to close.
// getStaticPaths() above (slug resolution, tag/fallback matching, dedup,
// pricing) is completely unchanged; only what renders the resulting
// `products` list changes, from ProductCard to the same DiscoveryFeed
// component the homepage uses -- no second card implementation, no
// duplicated masonry/pricing logic. The slug order is passed through the
// same curateDiscoveryOrder() the homepage now uses (src/utils/
// feedCuration.ts), for the same reason: a handful of occasion pages have
// specific known repeats in their fallback lists, and this keeps that
// behavior consistent rather than inventing a second ordering approach.
//
// Removing the per-card WhatsApp buttons is a real commerce-access
// change, not just a visual one -- per this milestone's own explicit
// exception, ONE restrained page-level WhatsApp entry point replaces
// them, reusing the exact existing wa.me link pattern (same number, same
// encodeURIComponent construction) every other WhatsApp CTA on the site
// already uses -- not a second WhatsApp implementation.
const feedSlugs = curateDiscoveryOrder(products.map((product) => product.slug));

const whatsappNumber = "919652012274";
const whatsappMessage = encodeURIComponent(
  `Hi Fresh Petals, I'm looking for ${occasion.name} flowers. Please help me choose and confirm availability.`
);
const whatsappUrl = `https://wa.me/${whatsappNumber}?text=${whatsappMessage}`;

// Search landing copy for occasions mapped to a distinct Bengaluru search
// (src/data/seoLanding.ts). /occasions/pooja is noindexed so it doesn't
// compete with /categories/pooja-flowers for pooja-flower searches.
const landing = OCCASION_LANDING[occasion.slug];
const pageTitle = landing?.title ?? `${occasion.name} Flowers | Fresh Petals Bengaluru`;
const pageDescription =
  products.length === 0
    ? `Our ${occasion.name.toLowerCase()} range isn't ready yet. Ask Fresh Petals for a custom order on WhatsApp.`
    : (landing?.description ?? occasion.description);
const pageHeading = landing?.h1 ?? `${occasion.name} Flowers`;
const fromPrice = landing ? lowestPrice(products) : null;
// Wedding and engagement also show the live garland designs for that
// occasion, loaded in the browser so admin changes need no deployment. They
// aren't known at build time, so they don't count towards indexing here.
const liveGarlands = GARLAND_OCCASION_ROUTES.has(occasion.slug);
const noindex = products.length === 0 || NOINDEX_OCCASION_SLUGS.has(occasion.slug);
const breadcrumbJsonLd = {
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: new URL("/", Astro.site).toString() },
    { "@type": "ListItem", position: 2, name: `${occasion.name} Flowers`, item: new URL(`/occasions/${occasion.slug}`, Astro.site).toString() },
  ],
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  noindex={noindex}
  jsonLd={noindex ? [] : [breadcrumbJsonLd]}
>
  <main class="bg-paper">
    <section class="px-5 pt-12 md:px-8 md:pt-16">
      <div class="mx-auto max-w-7xl">
        <div class="text-center">
          <p class="fp-eyebrow">
            {occasion.eyebrow}
          </p>

          <h1 class="fp-h1 mt-3">
            {pageHeading}
          </h1>

          {/* A launch occasion with nothing ready shows only its heading and
               the custom-order prompt below — no description of items that
               aren't on sale yet. */}
          {
            products.length === 0 ? null : landing ? (
              <div class="mx-auto mt-5 max-w-2xl space-y-3 text-sm leading-7 text-moss md:text-base">
                {landing.intro.map((paragraph) => <p>{paragraph}</p>)}
                {fromPrice !== null && (
                  <p class="font-semibold text-berry">
                    Prices on this page start from ₹{fromPrice}. The final price is confirmed on WhatsApp before you pay.
                  </p>
                )}
              </div>
            ) : (
              <p class="mx-auto mt-5 max-w-2xl text-sm leading-7 text-moss md:text-base">
                {occasion.description}
              </p>
            )
          }

          {products.length > 0 && (
          <div class="mx-auto mt-6 max-w-2xl rounded-[24px] border border-line bg-linen px-5 py-4">
            <p class="text-sm leading-7 text-moss">
              {occasion.heroNote}
            </p>
          </div>
          )}

          {products.length > 0 && (
          <div class="mx-auto mt-6 flex max-w-2xl flex-wrap items-center justify-center gap-2">
            <span class="rounded-full border border-line bg-paper px-4 py-2 text-[11px] font-semibold uppercase tracking-[0.18em] text-berry">
              {products.length} option{products.length === 1 ? "" : "s"}
            </span>

            <span class="rounded-full border border-mint-soft bg-mint-soft px-4 py-2 text-[11px] font-semibold uppercase tracking-[0.18em] text-ink">
              WhatsApp confirmed
            </span>

            <span class="rounded-full border border-line bg-paper px-4 py-2 text-[11px] font-semibold uppercase tracking-[0.18em] text-moss">
              Delivery area confirmed on WhatsApp
            </span>
          </div>
          )}
        </div>
      </div>
    </section>

    {
      products.length > 0 ? (
        <Fragment>
          <DiscoveryFeed slugs={feedSlugs} />

          <section class="px-5 pb-14 text-center md:px-8">
            <a
              href={whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="fp-btn-whatsapp inline-flex items-center rounded-full bg-ink px-6 py-3 text-[11px] font-bold uppercase tracking-[0.18em] text-white shadow-[0_10px_22px_rgba(7,88,56,0.22)] transition hover:bg-berry"
            >
              Ask about {occasion.name} flowers on WhatsApp
            </a>
          </section>
        </Fragment>
      ) : (
        <section class="px-5 pb-14 md:px-8" data-occasion-empty>
          <div class="mx-auto max-w-7xl">
            <div class="rounded-[24px] border border-line bg-linen p-8 text-center">
              <h2 class="text-lg font-semibold text-ink">
                Our {occasion.name.toLowerCase()} range isn't ready yet
              </h2>

              <p class="mt-3 text-sm leading-7 text-moss">
                Tell us what you need and we'll let you know what we can make.
              </p>
              <a
                href="/custom-orders"
                class="mt-6 inline-flex min-h-[44px] items-center rounded-full bg-ink px-6 text-[11px] font-bold uppercase tracking-[0.18em] text-white transition hover:bg-berry"
              >
                Ask for a custom order
              </a>
            </div>
          </div>
        </section>
      )
    }

    {liveGarlands && <LiveGarlands occasion={occasion.slug} />}

    {landing && <LandingDetails content={landing} />}
  </main>
</BaseLayout>