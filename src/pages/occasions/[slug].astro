---
// Occasion pages, prebuilt (static files served without running the Worker).
// Which products each lists comes from the admin's "Suitable occasions"
// (product_occasions), read by the build, so adding or removing an occasion
// in the dashboard changes the page, its filters and counts with the next
// build, which publishing starts on its own (src/server/services/Publishing.ts;
// src/data/occasionJourneys.ts occasionPageProducts: the gift occasions list
// every assigned public bouquet; the older pages keep their wider catalogue
// scope). Which products are public is the build's snapshot
// (src/server/services/PublicCatalogue.ts). An unknown occasion is not built,
// so it answers 404; an older ?colour=… link gets this file and the filter
// script moves the selection to the fragment address.
import OccasionPage from "../../components/occasion/OccasionPage.astro";
import { OCCASION_PAGES } from "../../data/occasionPages";
import { occasionPageProducts } from "../../data/occasionJourneys";
import { loadPublicCatalogue } from "../../server/services/PublicCatalogue";
import { loadOccasionMembership } from "../../server/services/OccasionMembership";
import { loadAuthoritativePrices, withAuthoritativePrice } from "../../server/services/ProductPricing";

export const prerender = true;

export function getStaticPaths() {
  return OCCASION_PAGES.map((occasion) => ({ params: { slug: occasion.slug } }));
}

const occasion = OCCASION_PAGES.find((item) => item.slug === Astro.params.slug)!;

const [publicCatalogue, priceMap] = await Promise.all([loadPublicCatalogue(), loadAuthoritativePrices()]);
const membership = await loadOccasionMembership(publicCatalogue.map((product) => product.slug));
const products = occasionPageProducts(occasion, membership, publicCatalogue).map((product) => withAuthoritativePrice(product, priceMap));
---

<OccasionPage occasion={occasion} products={products} />
