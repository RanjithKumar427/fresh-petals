---
import BaseLayout from "../layouts/BaseLayout.astro";
import { DeliveryService } from "../server/services/delivery/DeliveryService";

import AreaSelector from "../components/AreaSelector.astro";
import HomeHeroBanners from "../components/HomeHeroBanners.astro";
import OccasionSection from "../components/OccasionSection.astro";
import ProductSection from "../components/ProductSection.astro";
import PoojaProductsSection from "../components/PoojaProductsSection.astro";
import FlowerboxSection from "../components/FlowerboxSection.astro";
import BasketsSection from "../components/BasketsSection.astro";
import OffersSection from "../components/OffersSection.astro";
import PopularWithFlowers from "../components/PopularWithFlowers.astro";
import HomeDecorGiftingSection from "../components/HomeDecorGiftingSection.astro";
import WeddingTraditionalSection from "../components/WeddingTraditionalSection.astro";
import TrustSection from "../components/TrustSection.astro";
import WhatsAppOrderSection from "../components/WhatsAppOrderSection.astro";
import SubscriptionProducts from "../components/SubscriptionProducts.astro";
import UnboxingReels from "../components/UnboxingReels.astro";
import CustomerReviews from "../components/CustomerReviews.astro";
import ReferEarnSection from "../components/ReferEarnSection.astro";

const areas = await DeliveryService.listAreas();
---

<BaseLayout title="Fresh Petals Hyderabad">
  <main>
    <AreaSelector areas={areas} />
    <HomeHeroBanners />
    <OccasionSection />
    <ProductSection />
    <PoojaProductsSection />
    <FlowerboxSection />
    <BasketsSection />
    <OffersSection />
    <PopularWithFlowers />
    <HomeDecorGiftingSection />
    <WeddingTraditionalSection />
    <TrustSection />
    <WhatsAppOrderSection />
    <SubscriptionProducts />
    <UnboxingReels />
    <CustomerReviews />
    <ReferEarnSection />
  </main>
</BaseLayout>