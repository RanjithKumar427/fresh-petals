---
// Homepage — the floral atelier, built around the questions a shopper has
// (docs/occasion-journeys.md, "Homepage structure"): a full-width hero of
// three campaign photographs → bouquets to choose from (budget shortcut,
// availability helper) → the occasion carousel → what will arrive → how
// ordering works → focused questions → assisted choice → footer. No
// promotional claims: the delivery strip uses the confirmed initial areas.
// The bouquet edit shows four designs; the category retains the full range.
// (The bouquet builder — /studio — was removed
// on 4 Oct 2026; its URL redirects to /categories/bouquets.) All server-rendered HTML;
// depth is CSS perspective plus small scripts. HeroReel.astro is kept but
// not mounted: a second browsing carousel before the products duplicated
// the occasion carousel and pushed the first price further down.
// SEO title/description/structured data are unchanged from the previous
// homepage (src/data/seoLanding.ts).
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroAtelier from "../components/atelier/HeroAtelier.astro";
import OccasionCarousel from "../components/atelier/OccasionCarousel.astro";
import BouquetEdit from "../components/atelier/BouquetEdit.astro";
import InsideBouquet from "../components/atelier/InsideBouquet.astro";
import OrderJourney from "../components/atelier/OrderJourney.astro";
import FinalInvite from "../components/atelier/FinalInvite.astro";
import HomeFaq from "../components/atelier/HomeFaq.astro";
import { HOME_LANDING } from "../data/seoLanding";
import { HERO_SCENE_SIZES, getArrivalBouquet, getBouquetBrowse, getBouquetEdit, getBudgetShortcut, getFeaturedBouquets, getHeroCampaigns } from "../data/atelierHome";
import { catalogueSlugs } from "../data/occasionJourneys";
import { garlandsPromoted } from "../data/launchCatalogue";
import { loadGarlands, isListedGarland } from "../data/garlands";
import { loadOccasionMembership } from "../server/services/OccasionMembership";
import { loadAuthoritativePrices } from "../server/services/ProductPricing";
import { OCCASION_INDEX_TAG, occasionCacheHeaders } from "../server/services/GarlandWebsite";
import frauncesUrl from "@fontsource-variable/fraunces/files/fraunces-latin-wght-normal.woff2?url";

// Rendered on request and CDN-cached with the occasion index tag, so the
// occasion carousel and the hero's shortcuts follow the admin's occasion
// assignments from the first byte (no script needed); saving a changed
// assignment purges the copy (src/server/services/OccasionWebsite.ts).
export const prerender = false;
for (const [name, value] of Object.entries(occasionCacheHeaders([OCCASION_INDEX_TAG]))) Astro.response.headers.set(name, value);

// The whole catalogue: the Condolence card can list bouquets outside the
// launch range (occasionJourneys.carouselOccasions).
const [priceMap, membership] = await Promise.all([loadAuthoritativePrices(), loadOccasionMembership(catalogueSlugs())]);
const editProducts = getBouquetEdit(priceMap);
const featuredProducts = getFeaturedBouquets(editProducts);
const budget = getBudgetShortcut(priceMap);
const publicGarlands = garlandsPromoted() ? (await loadGarlands()).map((product) => product.garland).filter(isListedGarland) : [];
// The hero's campaign slides; the garland slide and its buttons need public garlands.
const heroCampaigns = getHeroCampaigns({ garlandsPublic: publicGarlands.length > 0 });

// Organization/WebSite structured data — only verified facts: the name,
// the site URL, the WhatsApp number every order link on the site uses, and
// the business's own Instagram account. No address, opening hours, rating
// or logo: none are verified yet (public/favicon.* is Astro's default mark).
const siteUrl = new URL("/", Astro.site).toString();
const homeJsonLd = [
  {
    "@type": "Organization",
    "@id": `${siteUrl}#organization`,
    name: "Fresh Petals",
    alternateName: "Fresh Petals Bengaluru",
    url: siteUrl,
    sameAs: ["https://www.instagram.com/freshpetals.hyderabad/"],
    contactPoint: {
      "@type": "ContactPoint",
      telephone: "+91-96520-12274",
      contactType: "customer service",
    },
  },
  {
    "@type": "WebSite",
    "@id": `${siteUrl}#website`,
    name: "Fresh Petals",
    url: siteUrl,
    inLanguage: "en-IN",
    publisher: { "@id": `${siteUrl}#organization` },
  },
];
---

<BaseLayout
  title={HOME_LANDING.title}
  description={HOME_LANDING.description}
  showCategoryCarousel={false}
  homeHeader={true}
  jsonLd={homeJsonLd}
>
  <!-- Homepage only: the display serif sets the hero headline in the first
       viewport (measured: helps here, hurts listing pages, so not global). -->
  <link slot="head" rel="preload" href={frauncesUrl} as="font" type="font/woff2" crossorigin />
  <!-- The first hero photograph only, with the same AVIF srcset/sizes as its
       <picture> (HeroAtelier.astro); the other two are fetched after it. -->
  {heroCampaigns[0] && <link slot="head" rel="preload" as="image" type="image/avif" imagesrcset={heroCampaigns[0].image.avif} imagesizes={HERO_SCENE_SIZES} fetchpriority="high" />}

  <main class="atelier-home">
    <HeroAtelier membership={membership} campaigns={heroCampaigns} publicGarlands={publicGarlands} budget={budget} />
    <BouquetEdit products={featuredProducts} totalCount={editProducts.length} browse={getBouquetBrowse()} budget={budget} />
    <OccasionCarousel membership={membership} />
    <InsideBouquet bouquet={getArrivalBouquet(priceMap)} />
    <OrderJourney />
    <HomeFaq />
    <FinalInvite />
  </main>
</BaseLayout>
