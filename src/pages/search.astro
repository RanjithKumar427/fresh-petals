---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProductCard from "../components/ProductCard.astro";
import { productCatalog } from "../data/productCatalog";
import { loadAuthoritativePrices, withAuthoritativePrice } from "../server/services/ProductPricing";

const categories = Array.from(
  new Set(productCatalog.map((product) => product.category))
);

// Catalog/Database Reconciliation milestone — see products/[slug].astro's
// matching comment.
const priceMap = await loadAuthoritativePrices();
const searchableProducts = productCatalog.map((product) => withAuthoritativePrice(product, priceMap));
---

<BaseLayout
  title="Search Flowers | Fresh Petals Bengaluru"
  noindex
  description="Search Fresh Petals Bengaluru products including bouquets, pooja flowers, jasmine, flower boxes, baskets, add-ons and subscriptions."
  showCategoryCarousel={false}
>
  <main class="bg-paper">
    <section class="px-5 py-12 md:px-8 md:py-16">
      <div class="mx-auto max-w-7xl">
        <div class="mb-10 text-center">
          <p class="fp-eyebrow">
            Fresh Petals Bengaluru
          </p>

          <h1 class="fp-h1 mt-3">
            Search Flowers
          </h1>

          <p class="mx-auto mt-5 max-w-2xl text-sm leading-7 text-moss md:text-base">
            Search bouquets, pooja flowers, jasmine, flower boxes, baskets, add-ons and subscriptions.
          </p>
        </div>

        <div class="mx-auto mb-10 max-w-3xl rounded-[28px] border border-line bg-linen p-5">
          <div class="grid gap-3 md:grid-cols-[1fr_220px]">
            <div>
              <label class="mb-2 block text-[10px] font-bold uppercase tracking-[0.22em] text-berry">
                Search Product
              </label>

              <input
                type="search"
                data-search-input
                placeholder="Search jasmine, bouquet, pooja, basket..."
                class="w-full rounded-full border border-line-strong bg-paper px-5 py-3 text-sm text-ink outline-none transition placeholder:text-sage focus:border-berry"
              />
            </div>

            <div>
              <label class="mb-2 block text-[10px] font-bold uppercase tracking-[0.22em] text-berry">
                Category
              </label>

              <select
                data-category-filter
                class="w-full rounded-full border border-line-strong bg-paper px-5 py-3 text-sm text-ink outline-none transition focus:border-berry"
              >
                <option value="all">All Categories</option>
                {
                  categories.map((category) => (
                    <option value={category}>{category}</option>
                  ))
                }
              </select>
            </div>
          </div>

          <div class="mt-4 flex flex-wrap gap-2">
            <button
              type="button"
              data-quick-search="pooja"
              class="rounded-full border border-line-strong bg-paper px-4 py-2 text-[10px] font-bold uppercase tracking-[0.16em] text-berry transition hover:border-berry"
            >
              Pooja
            </button>

            <button
              type="button"
              data-quick-search="jasmine"
              class="rounded-full border border-line-strong bg-paper px-4 py-2 text-[10px] font-bold uppercase tracking-[0.16em] text-berry transition hover:border-berry"
            >
              Jasmine
            </button>

            <button
              type="button"
              data-quick-search="bouquet"
              class="rounded-full border border-line-strong bg-paper px-4 py-2 text-[10px] font-bold uppercase tracking-[0.16em] text-berry transition hover:border-berry"
            >
              Bouquet
            </button>

            <button
              type="button"
              data-quick-search="subscription"
              class="rounded-full border border-line-strong bg-paper px-4 py-2 text-[10px] font-bold uppercase tracking-[0.16em] text-berry transition hover:border-berry"
            >
              Subscription
            </button>

            <button
              type="button"
              data-clear-search
              class="rounded-full bg-ink px-4 py-2 text-[10px] font-bold uppercase tracking-[0.16em] text-white transition hover:bg-berry"
            >
              Clear
            </button>
          </div>
        </div>

        <div class="mb-6 flex items-center justify-between gap-4">
          <h2 class="text-[12px] font-bold uppercase tracking-[0.24em] text-ink">
            Results
          </h2>

          <p data-result-count class="text-sm font-semibold text-moss">
            Showing all products
          </p>
        </div>

        <div
          data-results-grid
          class="grid grid-cols-2 gap-4 md:grid-cols-3 lg:grid-cols-4"
        >
          {
            // P1.3a (Phase 1 discovery hardening) -- occasionTags/
            // collectionTags/flowerTypes exist on every product (the
            // routes and cards already run on them) but were invisible
            // to search: measured "romantic" returning 1 result
            // against 16 products actually tagged romantic. Indexed
            // as one lowercase space-joined string, same substring
            // match as every other field below -- no new search
            // mechanism, no semantic/AI matching, just more of what's
            // already real data.
            searchableProducts.map((product) => (
              <div
                data-product-result
                data-product-name={product.name.toLowerCase()}
                data-product-category={product.category}
                data-product-description={product.description.toLowerCase()}
                data-product-long-description={product.longDescription.toLowerCase()}
                data-product-tags={[
                  ...(product.occasionTags ?? []),
                  ...(product.collectionTags ?? []),
                  ...(product.flowerTypes ?? []),
                ]
                  .join(" ")
                  .toLowerCase()}
              >
                <ProductCard
                  id={product.id}
                  name={product.name}
                  image={product.image}
                  priceLabel={product.priceLabel}
                  priceType={product.priceType}
                  category={product.category}
                  description={product.description}
                  slug={product.slug}
                  isAvailable={product.isAvailable}
                />
              </div>
            ))
          }
        </div>

        <div
          data-empty-search
          class="mt-10 hidden rounded-[24px] border border-line bg-linen p-8 text-center"
        >
          <h2 class="text-lg font-semibold text-ink">
            No products found
          </h2>

          <p class="mx-auto mt-3 max-w-xl text-sm leading-7 text-moss">
            Try searching for bouquet, pooja, jasmine, flowerbox, basket, add-on or subscription.
          </p>

          <a
            href="/categories/bouquets"
            class="mt-6 inline-flex fp-btn-pill-dark"
          >
            Browse Bouquets
          </a>
        </div>
      </div>
    </section>
  </main>

  <script>
    const searchInput = document.querySelector<HTMLInputElement>(
      "[data-search-input]"
    );

    const categoryFilter = document.querySelector<HTMLSelectElement>(
      "[data-category-filter]"
    );

    let productCards = Array.from(
      document.querySelectorAll<HTMLElement>("[data-product-result]")
    );

    const resultCount = document.querySelector<HTMLElement>(
      "[data-result-count]"
    );

    const emptySearch = document.querySelector<HTMLElement>(
      "[data-empty-search]"
    );

    const quickSearchButtons = document.querySelectorAll<HTMLButtonElement>(
      "[data-quick-search]"
    );

    const clearButton = document.querySelector<HTMLButtonElement>(
      "[data-clear-search]"
    );

    function normalize(value: string) {
      return String(value || "").trim().toLowerCase();
    }

    function applySearch() {
      const query = normalize(searchInput?.value || "");
      const selectedCategory = categoryFilter?.value || "all";

      let visibleCount = 0;

      productCards.forEach((card) => {
        const name = card.dataset.productName || "";
        const category = card.dataset.productCategory || "";
        const description = card.dataset.productDescription || "";
        const longDescription = card.dataset.productLongDescription || "";
        const tags = card.dataset.productTags || "";

        const matchesQuery =
          !query ||
          name.includes(query) ||
          category.toLowerCase().includes(query) ||
          description.includes(query) ||
          longDescription.includes(query) ||
          tags.includes(query);

        const matchesCategory =
          selectedCategory === "all" || category === selectedCategory;

        const shouldShow = matchesQuery && matchesCategory;

        if (shouldShow) {
          card.classList.remove("hidden");
          visibleCount += 1;
        } else {
          card.classList.add("hidden");
        }
      });

      if (resultCount) {
        resultCount.textContent =
          visibleCount === productCards.length
            ? "Showing all products"
            : `${visibleCount} product${visibleCount === 1 ? "" : "s"} found`;
      }

      if (emptySearch) {
        if (visibleCount === 0) {
          emptySearch.classList.remove("hidden");
        } else {
          emptySearch.classList.add("hidden");
        }
      }
    }

    searchInput?.addEventListener("input", applySearch);
    categoryFilter?.addEventListener("change", applySearch);

    quickSearchButtons.forEach((button) => {
      button.addEventListener("click", () => {
        if (!searchInput) return;

        searchInput.value = button.dataset.quickSearch || "";
        applySearch();
      });
    });

    clearButton?.addEventListener("click", () => {
      if (searchInput) searchInput.value = "";
      if (categoryFilter) categoryFilter.value = "all";

      applySearch();
    });

    // A shared link such as /search?q=FP-G012 or ?q=lily fills the box.
    const sharedQuery = new URLSearchParams(location.search).get("q");
    if (searchInput && sharedQuery && !searchInput.value) searchInput.value = sharedQuery.slice(0, 80);

    applySearch();

    // Garland designs are managed in the admin and loaded live (with their
    // own cards: no add-to-cart unless a design is in cart mode), so a
    // change there needs no deployment. Search works without them if the
    // request fails.
    fetch("/fragments/garlands?for=search", { headers: { accept: "text/html" } })
      .then((response) => (response.ok ? response.text() : ""))
      .then((html) => {
        const grid = document.querySelector<HTMLElement>("[data-results-grid]");
        if (!grid || !html.trim()) return;
        const template = document.createElement("template");
        template.innerHTML = html;
        const results = template.content.querySelectorAll<HTMLElement>("[data-product-result]");
        if (results.length === 0) return;
        grid.append(...results);
        productCards = Array.from(document.querySelectorAll<HTMLElement>("[data-product-result]"));
        if (categoryFilter && ![...categoryFilter.options].some((option) => option.value === "Garlands")) {
          categoryFilter.add(new Option("Garlands", "Garlands"));
        }
        applySearch();
      })
      .catch(() => {});
  </script>
</BaseLayout>