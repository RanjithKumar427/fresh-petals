---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProductCard from "../components/ProductCard.astro";
import { productCatalog } from "../data/productCatalog";

const categories = Array.from(
  new Set(productCatalog.map((product) => product.category))
);
---

<BaseLayout
  title="Search Flowers | Fresh Petals Hyderabad"
  description="Search Fresh Petals Hyderabad products including bouquets, pooja flowers, jasmine, flower boxes, baskets, add-ons and subscriptions."
>
  <main class="bg-white">
    <section class="px-5 py-12 md:px-8 md:py-16">
      <div class="mx-auto max-w-7xl">
        <div class="mb-10 text-center">
          <p class="text-[10px] font-semibold uppercase tracking-[0.32em] text-[#9B6B78]">
            Fresh Petals Hyderabad
          </p>

          <h1 class="fp-serif mt-3 text-3xl uppercase tracking-[0.20em] text-[#171717] md:text-5xl">
            Search Flowers
          </h1>

          <p class="mx-auto mt-5 max-w-2xl text-sm leading-7 text-[#66565D] md:text-base">
            Search bouquets, pooja flowers, jasmine, flower boxes, baskets, add-ons and subscriptions.
          </p>
        </div>

        <div class="mx-auto mb-10 max-w-3xl rounded-[28px] border border-[#EEE5E8] bg-[#FFF8FA] p-5">
          <div class="grid gap-3 md:grid-cols-[1fr_220px]">
            <div>
              <label class="mb-2 block text-[10px] font-bold uppercase tracking-[0.22em] text-[#7C243E]">
                Search Product
              </label>

              <input
                type="search"
                data-search-input
                placeholder="Search jasmine, bouquet, pooja, basket..."
                class="w-full rounded-full border border-[#E5D6DC] bg-white px-5 py-3 text-sm text-[#171717] outline-none transition placeholder:text-[#A99DA3] focus:border-[#7C243E]"
              />
            </div>

            <div>
              <label class="mb-2 block text-[10px] font-bold uppercase tracking-[0.22em] text-[#7C243E]">
                Category
              </label>

              <select
                data-category-filter
                class="w-full rounded-full border border-[#E5D6DC] bg-white px-5 py-3 text-sm text-[#171717] outline-none transition focus:border-[#7C243E]"
              >
                <option value="all">All Categories</option>
                {
                  categories.map((category) => (
                    <option value={category}>{category}</option>
                  ))
                }
              </select>
            </div>
          </div>

          <div class="mt-4 flex flex-wrap gap-2">
            <button
              type="button"
              data-quick-search="pooja"
              class="rounded-full border border-[#E5D6DC] bg-white px-4 py-2 text-[10px] font-bold uppercase tracking-[0.16em] text-[#7C243E] transition hover:border-[#7C243E]"
            >
              Pooja
            </button>

            <button
              type="button"
              data-quick-search="jasmine"
              class="rounded-full border border-[#E5D6DC] bg-white px-4 py-2 text-[10px] font-bold uppercase tracking-[0.16em] text-[#7C243E] transition hover:border-[#7C243E]"
            >
              Jasmine
            </button>

            <button
              type="button"
              data-quick-search="bouquet"
              class="rounded-full border border-[#E5D6DC] bg-white px-4 py-2 text-[10px] font-bold uppercase tracking-[0.16em] text-[#7C243E] transition hover:border-[#7C243E]"
            >
              Bouquet
            </button>

            <button
              type="button"
              data-quick-search="subscription"
              class="rounded-full border border-[#E5D6DC] bg-white px-4 py-2 text-[10px] font-bold uppercase tracking-[0.16em] text-[#7C243E] transition hover:border-[#7C243E]"
            >
              Subscription
            </button>

            <button
              type="button"
              data-clear-search
              class="rounded-full bg-[#111111] px-4 py-2 text-[10px] font-bold uppercase tracking-[0.16em] text-white transition hover:bg-[#7C243E]"
            >
              Clear
            </button>
          </div>
        </div>

        <div class="mb-6 flex items-center justify-between gap-4">
          <h2 class="text-[12px] font-bold uppercase tracking-[0.24em] text-[#171717]">
            Results
          </h2>

          <p data-result-count class="text-sm font-semibold text-[#66565D]">
            Showing all products
          </p>
        </div>

        <div
          data-results-grid
          class="grid grid-cols-2 gap-4 md:grid-cols-3 lg:grid-cols-4"
        >
          {
            productCatalog.map((product) => (
              <div
                data-product-result
                data-product-name={product.name.toLowerCase()}
                data-product-category={product.category}
                data-product-description={product.description.toLowerCase()}
                data-product-long-description={product.longDescription.toLowerCase()}
              >
                <ProductCard
                  id={product.id}
                  name={product.name}
                  image={product.image}
                  priceLabel={product.priceLabel}
                  priceType={product.priceType}
                  category={product.category}
                  description={product.description}
                  slug={product.slug}
                  isAvailable={product.isAvailable}
                />
              </div>
            ))
          }
        </div>

        <div
          data-empty-search
          class="mt-10 hidden rounded-[24px] border border-[#EEE5E8] bg-[#FFF8FA] p-8 text-center"
        >
          <h2 class="text-lg font-semibold text-[#171717]">
            No products found
          </h2>

          <p class="mx-auto mt-3 max-w-xl text-sm leading-7 text-[#66565D]">
            Try searching for bouquet, pooja, jasmine, flowerbox, basket, add-on or subscription.
          </p>

          <a
            href="/categories/bouquets"
            class="mt-6 inline-flex rounded-full bg-[#111111] px-7 py-3 text-[11px] font-bold uppercase tracking-[0.22em] text-white transition hover:bg-[#7C243E]"
          >
            Browse Bouquets
          </a>
        </div>
      </div>
    </section>
  </main>

  <script>
    const searchInput = document.querySelector("[data-search-input]");
    const categoryFilter = document.querySelector("[data-category-filter]");
    const productCards = Array.from(
      document.querySelectorAll("[data-product-result]")
    );
    const resultCount = document.querySelector("[data-result-count]");
    const emptySearch = document.querySelector("[data-empty-search]");
    const quickSearchButtons = document.querySelectorAll("[data-quick-search]");
    const clearButton = document.querySelector("[data-clear-search]");

    function normalize(value) {
      return String(value || "").trim().toLowerCase();
    }

    function applySearch() {
      const query = normalize(searchInput?.value);
      const selectedCategory = categoryFilter?.value || "all";

      let visibleCount = 0;

      productCards.forEach((card) => {
        const name = card.dataset.productName || "";
        const category = card.dataset.productCategory || "";
        const description = card.dataset.productDescription || "";
        const longDescription = card.dataset.productLongDescription || "";

        const matchesQuery =
          !query ||
          name.includes(query) ||
          category.toLowerCase().includes(query) ||
          description.includes(query) ||
          longDescription.includes(query);

        const matchesCategory =
          selectedCategory === "all" || category === selectedCategory;

        const shouldShow = matchesQuery && matchesCategory;

        if (shouldShow) {
          card.classList.remove("hidden");
          visibleCount += 1;
        } else {
          card.classList.add("hidden");
        }
      });

      if (resultCount) {
        resultCount.textContent =
          visibleCount === productCards.length
            ? "Showing all products"
            : `${visibleCount} product${visibleCount === 1 ? "" : "s"} found`;
      }

      if (emptySearch) {
        if (visibleCount === 0) {
          emptySearch.classList.remove("hidden");
        } else {
          emptySearch.classList.add("hidden");
        }
      }
    }

    searchInput?.addEventListener("input", applySearch);
    categoryFilter?.addEventListener("change", applySearch);

    quickSearchButtons.forEach((button) => {
      button.addEventListener("click", () => {
        if (!searchInput) return;

        searchInput.value = button.getAttribute("data-quick-search") || "";
        applySearch();
      });
    });

    clearButton?.addEventListener("click", () => {
      if (searchInput) searchInput.value = "";
      if (categoryFilter) categoryFilter.value = "all";
      applySearch();
    });

    applySearch();
  </script>
</BaseLayout>