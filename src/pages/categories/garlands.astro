---
// /categories/garlands, rendered on request. The garland designs are read
// fresh from the admin database, so publishing, unpublishing and edits in
// the dashboard reach this page without a deployment; the CDN holds a copy
// for at most a few minutes and an admin save purges it
// (src/server/services/GarlandWebsite.ts). Every other category page is still
// built by ./[slug].astro, which leaves this slug out.
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProductCard from "../../components/ProductCard.astro";
import GarlandListing from "../../components/GarlandListing.astro";
import { loadPublicCatalogue } from "../../server/services/PublicCatalogue";
import { productPhotoAlt } from "../../data/productPhotos";
import { isListedGarland, loadGarlands } from "../../data/garlands";
import { loadAuthoritativePrices, withAuthoritativePrice } from "../../server/services/ProductPricing";
import { garlandCacheHeaders } from "../../server/services/GarlandWebsite";
import LandingDetails from "../../components/LandingDetails.astro";
import { GARLANDS_LANDING, populatedCollections } from "../../data/garlandCollections";

export const prerender = false;

for (const [name, value] of Object.entries(garlandCacheHeaders())) Astro.response.headers.set(name, value);

const [garlands, priceMap, publicCatalogue] = await Promise.all([loadGarlands(), loadAuthoritativePrices(), loadPublicCatalogue()]);
// The other garland orders in the public catalogue (e.g. event garlands),
// at this deployment's published price, like their product pages.
const otherProducts = publicCatalogue
  .filter((product) => product.collectionTags?.includes("garlands") || product.category.toLowerCase() === "garlands")
  .map((product) => withAuthoritativePrice(product, priceMap));
const total = garlands.length + otherProducts.length;
const drafts = garlands.some((product) => !isListedGarland(product.garland));
const noindex = total === 0 || drafts;

// Arrived from an enquiry link for a design that is no longer available.
const unavailable = (Astro.url.searchParams.get("unavailable") ?? "").toUpperCase();
const unavailableCode = /^FP-G\d{3,}$/.test(unavailable) ? unavailable : null;
// A redirect notice is per-visitor; keep it out of the shared cache.
if (unavailableCode) Astro.response.headers.set("Cache-Control", "no-store");

const name = "Garlands";
// With designs listed this is the wedding garland / poola mala search landing
// (src/data/garlandCollections.ts); without any, the plain category copy.
const description =
  garlands.length > 0
    ? GARLANDS_LANDING.description
    : "Explore garlands from Fresh Petals. Final availability, pricing and delivery will be confirmed on WhatsApp.";
const collections = populatedCollections(garlands);
const landing = {
  faqs: GARLANDS_LANDING.faqs,
  links: [...collections.map((entry) => ({ href: entry.collection.path, label: entry.collection.label })), ...GARLANDS_LANDING.links],
};
const breadcrumbJsonLd = {
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: new URL("/", Astro.site).toString() },
    { "@type": "ListItem", position: 2, name, item: new URL("/categories/garlands", Astro.site).toString() },
  ],
};
---

<BaseLayout
  title={garlands.length > 0 ? GARLANDS_LANDING.title : `${name} | Fresh Petals`}
  description={description}
  image={garlands[0]?.image}
  showCategoryCarousel={false}
  noindex={noindex}
  jsonLd={noindex ? [] : [breadcrumbJsonLd]}
>
  <main class="bg-ivory" data-track-list="garlands">
    <section class="px-5 py-10 md:px-8 md:py-16">
      <div class="mx-auto max-w-7xl">
        <div class="collection-head mb-10 md:mb-14">
          <div>
            <p class="fp-eyebrow">
              <a href="/" class="hover:underline">Home</a> <span aria-hidden="true">/</span> Collection
            </p>
            <h1 class="fp-h1 mt-3">{garlands.length > 0 ? "Wedding Garlands / Poola Mala" : name}</h1>
          </div>
          <div>
            {
              garlands.length > 0 ? (
                <p class="max-w-2xl text-sm leading-7 text-moss md:text-base">{GARLANDS_LANDING.intro}</p>
              ) : (
                <p class="max-w-2xl text-sm leading-7 text-moss md:text-base">{description}</p>
              )
            }
            <div class="mt-5 flex max-w-2xl flex-wrap items-center gap-2">
              <span class="rounded-full border border-line bg-linen px-4 py-2 text-[11px] font-semibold uppercase tracking-[0.18em] text-berry" data-garland-total>
                {garlands.length > 0
                  ? `${garlands.length} coded design${garlands.length === 1 ? "" : "s"}${otherProducts.length > 0 ? ` + ${otherProducts.length === 1 ? otherProducts[0].name : `${otherProducts.length} services`}` : ""}`
                  : `${total} option${total === 1 ? "" : "s"}`}
              </span>
              <span class="rounded-full border border-mint-soft bg-mint-soft px-4 py-2 text-[11px] font-semibold uppercase tracking-[0.18em] text-ink">
                WhatsApp confirmed
              </span>
              <span class="rounded-full border border-line bg-paper px-4 py-2 text-[11px] font-semibold uppercase tracking-[0.18em] text-moss">
                Delivery area confirmed on WhatsApp
              </span>
            </div>
          </div>
        </div>

        {unavailableCode && (
          <p role="status" class="mb-8 rounded-2xl border border-line bg-linen px-5 py-4 text-sm leading-6 text-ink" data-garland-unavailable-notice>
            Design {unavailableCode} isn't available at the moment. Choose another design below, or ask us for a custom order.
          </p>
        )}

        {garlands.length > 0 && <GarlandListing garlands={garlands} hasMore={otherProducts.length > 0} />}

        {
          otherProducts.length > 0 ? (
            <div class="grid grid-cols-2 gap-4 md:grid-cols-3 lg:grid-cols-4">
              {otherProducts.map((product) => (
                <ProductCard
                  id={product.id}
                  name={product.name}
                  image={product.image}
                  imageAlt={productPhotoAlt(product)}
                  priceLabel={product.priceLabel}
                  priceType={product.priceType}
                  category={product.category}
                  description={product.description}
                  slug={product.slug}
                  isAvailable={product.isAvailable}
                />
              ))}
            </div>
          ) : garlands.length > 0 ? null : (
            <div class="rounded-[28px] border border-line bg-linen p-8 text-center md:p-12">
              <p class="text-[10px] font-semibold uppercase tracking-[0.28em] text-rose-deep">Available on request</p>
              <h2 class="fp-serif mt-3 text-2xl text-ink">Custom {name} Orders</h2>
              <p class="mx-auto mt-4 max-w-xl text-sm leading-7 text-moss">
                This category is available as a WhatsApp-confirmed custom order. Share your preferred quantity, occasion
                and delivery date. We’ll confirm today’s availability and price before payment.
              </p>
              <a
                href={`https://wa.me/919652012274?text=Hi%20Fresh%20Petals%2C%20I%20want%20to%20check%20availability%20for%20${encodeURIComponent(name)}`}
                class="mt-7 inline-flex rounded-full bg-berry px-7 py-3 text-xs font-semibold uppercase tracking-[0.18em] text-white transition hover:bg-berry-deep"
              >
                Check on WhatsApp
              </a>
            </div>
          )
        }
      </div>
    </section>
    {garlands.length > 0 && <LandingDetails content={landing} />}
  </main>
</BaseLayout>

<style>
  .collection-head {
    display: grid;
    gap: 1.25rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--color-line);
  }

  @media (min-width: 1024px) {
    .collection-head {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      align-items: end;
      gap: 3rem;
    }
  }
</style>
