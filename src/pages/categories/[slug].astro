---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProductCard from "../../components/ProductCard.astro";
import { productCatalog, type Product } from "../../data/productCatalog";
import { loadAuthoritativePrices, withAuthoritativePrice } from "../../server/services/ProductPricing";
import LandingDetails from "../../components/LandingDetails.astro";
import { CATEGORY_LANDING, NOINDEX_CATEGORY_SLUGS, lowestPrice } from "../../data/seoLanding";
import { launchGroups } from "../../data/launchCatalogue";

type CategoryMeta = {
  name: string;
  slug: string;
  description: string;
};

export async function getStaticPaths() {
  // Catalog/Database Reconciliation milestone — see products/[slug].astro's
  // matching comment. One shared price map for every category page this
  // build generates, not one query per category.
  const priceMap = await loadAuthoritativePrices();

  const slugify = (value: string) =>
    value
      .toLowerCase()
      .replace(/&/g, "and")
      .replace(/\//g, "")
      .replace(/\s+/g, "-")
      .replace(/[^a-z0-9-]/g, "")
      .replace(/-+/g, "-")
      .replace(/^-|-$/g, "");

  const titleFromSlug = (slug: string) =>
    slug
      .split("-")
      .map((word) => {
        if (word === "and") return "&";
        if (word === "pooja") return "Pooja";
        if (word === "diy") return "DIY";
        return word.charAt(0).toUpperCase() + word.slice(1);
      })
      .join(" ");

  const categoryDescriptions: Record<string, string> = {
    "all-flowers":
      "Explore all fresh flowers, bouquets, lilies, flowerboxes, baskets and gifting arrangements from Fresh Petals Bengaluru.",

    bouquets:
      "Fresh hand-arranged bouquets for gifting, celebrations and custom flower orders.",

    lilies:
      "Explore lilies from Fresh Petals Bengaluru. Final availability, pricing and delivery will be confirmed on WhatsApp.",

    "fragrant-lilies":
      "Premium lily bouquets and fragrant flower arrangements based on fresh market availability.",

    "pooja-flowers":
      "Fresh pooja flowers, jasmine, flower boxes and temple bulk flowers based on daily market availability.",

    flowerbox:
      "Fresh flower boxes for DIY arrangements, gifting, pooja use and custom flower requirements.",

    baskets:
      "Fresh flower baskets for gifting, pooja, celebrations and premium custom arrangements.",

    offers:
      "Budget flower picks, fresh bouquet deals and today’s available flower offers.",

    "add-ons":
      "Add chocolates, candles, premium cards, vases, tools or decor items with your flower gifting order.",

    subscriptions:
      "Recurring flower plans for pooja, jasmine, home styling and custom flower needs.",

    "dried-flowers":
      "Long-lasting dried flowers for home styling, desk decor, gifting and premium aesthetic corners.",

    "plants-and-succulents":
      "Low-maintenance plants and succulent gifts paired with flowers for desk decor, housewarming and simple gifting.",

    vases:
      "Glass vases and premium decor vase options to pair with flowerboxes, loose flowers and subscriptions.",

    "floral-tools":
      "Florist cutters, flower food and care essentials for customers who arrange flowers at home.",

    // P0.1 trust containment (see pet-friendly-flowerbox in
    // productCatalog.ts): we hold no verified list of which flowers are safe
    // for pets, so this no longer asserts one.
    "pet-friendly":
      "Flowerbox options for homes with cats or dogs — tell us about your pet on WhatsApp and we will go through that day's flowers with you before confirming.",

    "flower-strings-and-torans":
      "Fresh torans, jasmine gajra and traditional flower strings for pooja, functions and festive decor.",

    "room-mist-and-diffuser":
      "Room mist and diffuser add-ons for premium flower gifting, hampers, anniversaries and housewarming.",

    hampers:
      "Premium flower hampers paired with chocolates, plants, candles, cards and decor add-ons.",

    wedding:
      "Fresh wedding flowers, bridal accessories, garlands and event flower requirements made on request.",

    "by-stems":
      "Fresh flowers by stem for DIY arrangements, vases, gifting and custom flower styling.",

    "eid-al-adha":
      "Elegant white bouquets, soft floral gifts and custom Bakrid flower arrangements available on request.",

    "tuberose-rajnigandha":
      "Fresh tuberose and rajnigandha flowers for pooja, fragrance styling, events and traditional decor.",

    hydrangeas:
      "Premium hydrangea bouquets and soft pastel arrangements available on request.",

    sunflower:
      "Bright sunflower bouquets and cheerful gifting arrangements based on today’s availability.",

    orchid:
      "Elegant orchid bouquets and premium floral arrangements for birthdays, anniversaries and gifting.",

    rose:
      "Fresh rose bouquets and rose arrangements for romantic gifting, birthdays, anniversaries and celebrations.",

    "pastel-flowers":
      "Soft pastel flower arrangements for premium gifting, birthdays, anniversaries and aesthetic decor.",

    "pink-flowers":
      "Pink flower bouquets and feminine floral arrangements for gifting and special occasions.",

    "white-flowers":
      "White bouquets and elegant floral arrangements for peaceful, premium and festive gifting.",

    "red-flowers":
      "Red flower bouquets for romantic gifting, anniversaries and premium celebrations.",

    "yellow-flowers":
      "Yellow flower bouquets for cheerful gifting, friendship, celebrations and festive moments.",

    "blue-flowers":
      "Blue-toned and cool pastel flower arrangements available as custom premium orders.",

    "bestselling-bouquets":
      "Fresh Petals’ most requested bouquet styles for gifting, celebrations and quick WhatsApp orders.",

    "mini-bouquets":
      "Small, cute and affordable mini bouquets for simple gifting and daily flower moments.",

    "bouquets-with-vases":
      "Ready-to-display flower bouquets paired with glass vases for home styling and gifting.",

    "floral-torans-and-strings":
      "Fresh floral torans, strings and traditional decor flowers for pooja, functions and festivals.",

    "handcrafted-torans-and-streamers":
      "Decorative handcrafted torans and streamers for festive styling, pooja rooms and home entrances.",

    "pooja-urli-boxes":
      "Pooja urli boxes and floral decor arrangements for festivals, rituals and gifting.",

    "fairy-lights-tim-tim-lights":
      "Fairy lights and tim tim lights to pair with flowers, hampers and festive decor setups.",

    "diyas-and-tea-light-holders":
      "Diyas and tea light holder add-ons for pooja, festive decor, hampers and gifting.",

    "all-decor":
      "Explore flower decor, torans, lights, diyas and festive home styling add-ons.",

    "all-gifts":
      "Explore gifting add-ons, hampers, stationery, DIY kits and premium flower-paired gifts.",

    "flowers-and-jewellery":
      "Floral jewellery and flower accessories for haldi, mehendi, bridal events and festive styling.",

    stationery:
      "Premium stationery add-ons to pair with bouquets, hampers and thoughtful gifting orders.",

    "planners-and-journal":
      "Planner and journal add-ons for premium gifting, birthdays and curated hamper orders.",

    "diy-kits":
      "DIY floral kits and creative gifting options available on request.",

    skincare:
      "Skincare gifting add-ons for curated hampers and premium flower gift boxes.",

    tea:
      "Tea gifting add-ons for premium hampers, wellness gifts and thoughtful floral pairings.",
  };

  const categoryNameOverrides: Record<string, string> = {
    "all-flowers": "All Flowers",
    bouquets: "Bouquets",
    "pooja-flowers": "Pooja Flowers",
    flowerbox: "Flowerbox",
    baskets: "Baskets",
    offers: "Offers",
    "add-ons": "Add-ons",
    subscriptions: "Subscriptions",
    "dried-flowers": "Dried Flowers",
    "plants-and-succulents": "Plants & Succulents",
    vases: "Vases",
    "floral-tools": "Floral Tools",
    "pet-friendly": "Pet Friendly",
    "flower-strings-and-torans": "Flower Strings & Torans",
    "room-mist-and-diffuser": "Room Mist & Diffuser",
    hampers: "Hampers",
    wedding: "Wedding",
    "by-stems": "By Stems",
    "eid-al-adha": "Eid Al-Adha",
    lilies: "Lilies",
    "fragrant-lilies": "Fragrant Lilies",
    "tuberose-rajnigandha": "Tuberose / Rajnigandha",
    hydrangeas: "Hydrangeas",
    sunflower: "Sunflower",
    orchid: "Orchid",
    rose: "Rose",
    "pastel-flowers": "Pastel Flowers",
    "pink-flowers": "Pink Flowers",
    "white-flowers": "White Flowers",
    "red-flowers": "Red Flowers",
    "yellow-flowers": "Yellow Flowers",
    "blue-flowers": "Blue Flowers",
    "bestselling-bouquets": "Bestselling Bouquets",
    "mini-bouquets": "Mini Bouquets",
    "bouquets-with-vases": "Bouquets With Vases",
    "floral-torans-and-strings": "Floral Torans & Strings",
    "handcrafted-torans-and-streamers": "Handcrafted Torans & Streamers",
    "pooja-urli-boxes": "Pooja Urli Boxes",
    "fairy-lights-tim-tim-lights": "Fairy Lights / Tim Tim Lights",
    "diyas-and-tea-light-holders": "Diyas & Tea Light Holders",
    "all-decor": "All Decor",
    "all-gifts": "All Gifts",
    "flowers-and-jewellery": "Flowers & Jewellery",
    stationery: "Stationery",
    "planners-and-journal": "Planners & Journal",
    "diy-kits": "DIY Kits",
    skincare: "Skincare",
    tea: "Tea",
  };

  const manualCategorySlugs = [
    "all-flowers",
    "eid-al-adha",
    "fragrant-lilies",
    "lilies",
    "tuberose-rajnigandha",
    "hydrangeas",
    "sunflower",
    "orchid",
    "rose",
    "pastel-flowers",
    "pink-flowers",
    "white-flowers",
    "red-flowers",
    "yellow-flowers",
    "blue-flowers",
    "bestselling-bouquets",
    "mini-bouquets",
    "bouquets-with-vases",
    "floral-torans-and-strings",
    "handcrafted-torans-and-streamers",
    "pooja-urli-boxes",
    "fairy-lights-tim-tim-lights",
    "diyas-and-tea-light-holders",
    "all-decor",
    "all-gifts",
    "flowers-and-jewellery",
    "stationery",
    "planners-and-journal",
    "diy-kits",
    "skincare",
    "tea",
  ];

  // Menu categories whose slug matches no product category or collection
  // tag, mapped to the real products that genuinely belong there (checked
  // against flowerTypes / whatsIncluded / existing tags — nothing invented).
  // Menu slugs with no genuine products (Eid al-Adha, Tuberose, Hydrangeas,
  // Orchid, Handcrafted Torans, Pooja Urli Boxes, Fairy Lights, Diyas,
  // Flowers & Jewellery, Planners & Journal, Skincare, Tea) stay empty and
  // are noindexed until real products exist.
  const hasTag = (product: Product, tags: string[]) =>
    tags.some((tag) => product.collectionTags?.includes(tag));
  const menuCategoryRules: Record<string, (product: Product) => boolean> = {
    sunflower: (product) => (product.flowerTypes ?? []).some((type) => /sunflower/i.test(type)),
    "bouquets-with-vases": (product) =>
      (product.category === "Bouquets" || product.category === "Lilies") &&
      (product.whatsIncluded ?? []).some((item) => /\bvase/i.test(item)),
    "floral-torans-and-strings": (product) => hasTag(product, ["flower-strings-torans"]),
    "all-decor": (product) => hasTag(product, ["home-decor", "desk-decor", "premium-decor"]),
    "all-gifts": (product) => hasTag(product, ["gifting", "premium-gifting", "hampers"]),
    stationery: (product) => product.slug === "premium-card-addon",
    "diy-kits": (product) => hasTag(product, ["diy"]),
  };

  const getProductsForSlug = (slug: string) =>
    productCatalog.filter((product) => {
      const productCategorySlug = slugify(product.category);

      return (
        productCategorySlug === slug ||
        product.collectionTags?.includes(slug) ||
        menuCategoryRules[slug]?.(product) === true
      );
    });

  const productCategorySlugs = productCatalog.map((product) =>
    slugify(product.category)
  );

  const productCollectionSlugs = productCatalog.flatMap(
    (product) => product.collectionTags ?? []
  );

  // /categories/garlands is rendered on request by ./garlands.astro, so admin
  // garland changes reach it without a deployment.
  const uniqueSlugs = Array.from(
    new Set([
      ...productCategorySlugs,
      ...productCollectionSlugs,
      ...manualCategorySlugs,
    ])
  ).filter((slug) => slug !== "garlands");

  return uniqueSlugs.map((slug) => {
    const category: CategoryMeta = {
      name: categoryNameOverrides[slug] ?? titleFromSlug(slug),
      slug,
      description:
        categoryDescriptions[slug] ??
        `Explore ${titleFromSlug(slug).toLowerCase()} from Fresh Petals Bengaluru. Final availability, pricing and delivery will be confirmed on WhatsApp.`,
    };

    // The launch range (src/data/launchCatalogue.ts) replaces the full
    // listing for launch categories such as bouquets; the other products
    // keep their pages and URLs.
    const groups = launchGroups(slug).map(({ group, products: list }) => ({
      ...group,
      products: list.map((product) => withAuthoritativePrice(product, priceMap)),
    }));
    const products = groups.length
      ? groups.flatMap((group) => group.products)
      : getProductsForSlug(slug).map((product) => withAuthoritativePrice(product, priceMap));

    return {
      params: {
        slug,
      },
      props: {
        category,
        products,
        groups,
      },
    };
  });
}

const { category, products, groups = [] } = Astro.props as {
  category: CategoryMeta;
  products: Product[];
  groups?: { id: string; label: string; products: Product[] }[];
};

// Search landing copy for the categories mapped to a distinct Bengaluru
// search intent (src/data/seoLanding.ts); every other category keeps its
// existing title/description. Empty categories stay reachable from the
// menu but are noindexed (and left out of sitemap.xml) — a page with no
// products is not a useful search result.
const landing = CATEGORY_LANDING[category.slug];
const pageTitle = landing?.title ?? `${category.name} | Fresh Petals Bengaluru`;
const pageDescription = landing?.description ?? category.description;
const pageHeading = landing?.h1 ?? category.name;
const fromPrice = landing ? lowestPrice(products) : null;
const noindex = products.length === 0 || NOINDEX_CATEGORY_SLUGS.has(category.slug);
const breadcrumbJsonLd = {
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: new URL("/", Astro.site).toString() },
    { "@type": "ListItem", position: 2, name: category.name, item: new URL(`/categories/${category.slug}`, Astro.site).toString() },
  ],
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  showCategoryCarousel={false}
  noindex={noindex}
  jsonLd={noindex ? [] : [breadcrumbJsonLd]}
>
  <main class="bg-paper">
    <section class="px-5 py-10 md:px-8 md:py-16">
      <div class="mx-auto max-w-7xl">
        <div class="collection-head mb-10 md:mb-14">
          <div>
          <p class="fp-eyebrow">
            <a href="/" class="hover:underline">Home</a> <span aria-hidden="true">/</span> Collection
          </p>

          <h1 class="fp-h1 mt-3">
            {pageHeading}
          </h1>
          </div>
          <div>

          {
            landing ? (
              <div class="max-w-2xl space-y-3 text-sm leading-7 text-moss md:text-base">
                {landing.intro.map((paragraph) => <p>{paragraph}</p>)}
                {fromPrice !== null && (
                  <p class="font-semibold text-berry">
                    Prices on this page start from ₹{fromPrice}. The final price is confirmed on WhatsApp before you pay.
                  </p>
                )}
              </div>
            ) : (
              <p class="max-w-2xl text-sm leading-7 text-moss md:text-base">
                {category.description}
              </p>
            )
          }

          <div class="mt-5 flex max-w-2xl flex-wrap items-center gap-2">
            <span class="rounded-full border border-line bg-linen px-4 py-2 text-[11px] font-semibold uppercase tracking-[0.18em] text-berry">
              {products.length} option{products.length === 1 ? "" : "s"}
            </span>

            <span class="rounded-full border border-mint-soft bg-mint-soft px-4 py-2 text-[11px] font-semibold uppercase tracking-[0.18em] text-ink">
              WhatsApp confirmed
            </span>

            <span class="rounded-full border border-line bg-paper px-4 py-2 text-[11px] font-semibold uppercase tracking-[0.18em] text-moss">
              Delivery area confirmed on WhatsApp
            </span>
          </div>
          </div>
        </div>

        {
          groups.length > 0 && (
            <nav aria-label="Bouquet types" class="mb-8 flex flex-wrap gap-2">
              {groups.map((group) => (
                <a href={`#${group.id}`} class="inline-flex min-h-[44px] items-center gap-1 rounded-full border border-line bg-paper px-4 text-[12px] font-semibold text-ink transition hover:border-ink">
                  {group.label} <span class="text-moss">({group.products.length})</span>
                </a>
              ))}
            </nav>
          )
        }
        {
          groups.length > 0 ? (
            <div class="space-y-14">
              {groups.map((group) => (
                <section id={group.id} aria-labelledby={`${group.id}-title`} class="scroll-mt-28">
                  <h2 id={`${group.id}-title`} class="fp-serif mb-5 text-2xl text-ink md:text-3xl">{group.label}</h2>
                  <div class="grid grid-cols-2 gap-4 md:grid-cols-3 lg:grid-cols-4">
                    {group.products.map((product) => (
                      <ProductCard
                        id={product.id}
                        name={product.name}
                        image={product.image}
                        priceLabel={product.priceLabel}
                        priceType={product.priceType}
                        category={product.category}
                        description={product.description}
                        slug={product.slug}
                        isAvailable={product.isAvailable}
                      />
                    ))}
                  </div>
                </section>
              ))}
              <p class="text-sm leading-7 text-moss">
                Looking for something else?{" "}
                <a href="/custom-orders" class="font-semibold text-ink underline underline-offset-4">Ask for a custom bouquet</a>.
              </p>
            </div>
          ) : products.length > 0 ? (
            <div class="grid grid-cols-2 gap-4 md:grid-cols-3 lg:grid-cols-4">
              {products.map((product) => (
                <ProductCard
                  id={product.id}
                  name={product.name}
                  image={product.image}
                  priceLabel={product.priceLabel}
                  priceType={product.priceType}
                  category={product.category}
                  description={product.description}
                  slug={product.slug}
                  isAvailable={product.isAvailable}
                />
              ))}
            </div>
          ) : (
            <div class="rounded-[28px] border border-line bg-linen p-8 text-center md:p-12">
              <p class="text-[10px] font-semibold uppercase tracking-[0.28em] text-rose-deep">
                Available on request
              </p>

              <h2 class="fp-serif mt-3 text-2xl text-ink">
                Custom {category.name} Orders
              </h2>

              <p class="mx-auto mt-4 max-w-xl text-sm leading-7 text-moss">
                This category is available as a WhatsApp-confirmed custom order.
                Share your preferred quantity, occasion and delivery date. We’ll
                confirm today’s availability and price before payment.
              </p>

              <a
                href={`https://wa.me/919652012274?text=Hi%20Fresh%20Petals%2C%20I%20want%20to%20check%20availability%20for%20${encodeURIComponent(category.name)}`}
                class="mt-7 inline-flex rounded-full bg-berry px-7 py-3 text-xs font-semibold uppercase tracking-[0.18em] text-white transition hover:bg-berry"
              >
                Check on WhatsApp
              </a>
            </div>
          )
        }
      </div>
    </section>

    {landing && <LandingDetails content={landing} />}
  </main>
</BaseLayout>

<style>
  .collection-head {
    display: grid;
    gap: 1.25rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--color-line);
  }

  @media (min-width: 1024px) {
    .collection-head {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      align-items: end;
      gap: 3rem;
    }
  }
</style>