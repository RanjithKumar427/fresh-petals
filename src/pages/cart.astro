 ---
import BaseLayout from "../layouts/BaseLayout.astro";
import DestinationCity from "../components/DestinationCity.astro";
import { cityOptions } from "../data/serviceCities";
import { TaxonomyService } from "../server/services/TaxonomyService";
import { DELIVERY_METHOD_OPTIONS } from "../server/services/delivery/DeliveryService";
import { productCatalog } from "../data/productCatalog";
import { loadAuthoritativePrices, withAuthoritativePrice } from "../server/services/ProductPricing";
import { QUOTE_ONLY_BASKET_LABEL, QUOTE_ONLY_CONFIG } from "../shared/quoteOnly";
import InlineScript from "../components/InlineScript.astro";
// The basket script (reviewed source, allowed by its CSP hash). It reads the
// JSON data blocks below; those are data and never run.
import cartScript from "../scripts/inline/cart.js?raw";

// Commerce Foundation Phase 3, Milestone 2 — Delivery Details' Occasion
// field reuses the real, admin-managed taxonomy instead of a hardcoded
// duplicate list, so it stays in sync automatically if an admin ever
// renames/adds/removes an occasion via the taxonomy admin UI.
const occasionOptions = await TaxonomyService.listOccasions();

// Delivery Capability Engine milestone — UI copy only, not a decision:
// the actual availability/fee/promise for whichever one the customer
// picks is always fetched fresh from POST /api/delivery/check
// (DeliveryService), never computed here. `method` is what gets sent to
// that endpoint. Imported from the engine itself (not hand-written here)
// so there's exactly one place these four options are defined — see
// deliveryRules.ts's DELIVERY_METHOD_OPTIONS.
const timeSlots = DELIVERY_METHOD_OPTIONS;

// The price label every catalogue product (and add-on) is published with in
// this deployment — the same snapshot the product pages and listings show.
// A basket saved earlier is brought up to date against it before it is shown
// or sent, so WhatsApp never receives an outdated price. Quote-only products
// (src/shared/quoteOnly.ts) are published as "Price on WhatsApp": the page
// receives no amount for them.
const priceMap = await loadAuthoritativePrices();
const publishedPrices = Object.fromEntries(productCatalog.map((product) => [product.slug, withAuthoritativePrice(product, priceMap).priceLabel]));
---

<BaseLayout
  title="Cart | Fresh Petals"
  noindex
  description="Review your Fresh Petals flower order cart and continue on WhatsApp."
  showCategoryCarousel={false}
>
  <main class="bg-ivory">
    <section class="px-5 py-12 md:px-8 md:py-16">
      <div class="mx-auto max-w-5xl">
        <div class="mb-10 text-center">
          <p class="fp-eyebrow">
            Fresh Petals
          </p>

          <h1 class="fp-h1 mt-3">
            Your basket
          </h1>

          <p class="mx-auto mt-5 max-w-2xl text-sm leading-7 text-moss md:text-base">
            Review your selected flowers and send them to us on WhatsApp. We reply with the prices and availability before you pay.
          </p>
        </div>

        <div
          data-cart-empty
          class="hidden rounded-[24px] border border-line bg-linen p-8 text-center"
        >
          <h2 class="text-lg font-semibold text-ink">
            Your basket is empty
          </h2>

          <p class="mt-3 text-sm leading-7 text-moss">
            Add bouquets, pooja flowers, flower boxes, baskets or add-ons to prepare your order.
          </p>

          <a
            href="/categories/bouquets"
            class="mt-6 inline-flex fp-btn-pill-dark"
          >
            Browse bouquets
          </a>
        </div>

        <div data-cart-content class="hidden">
          <p data-cart-price-notice role="status" class="mb-5 rounded-2xl border border-line bg-linen px-4 py-3 text-sm leading-6 text-ink" hidden></p>
          <div data-cart-items class="space-y-5"></div>

          <div class="mt-8 rounded-[24px] border border-line bg-linen p-5">
            <h2 class="text-[12px] font-bold uppercase tracking-[0.24em] text-ink">
              Order Details
            </h2>

            <div class="mt-5 grid gap-3 md:grid-cols-2">
              <div>
                <label class="mb-2 block text-[10px] font-bold uppercase tracking-[0.22em] text-berry">
                  Your name (sender)
                </label>

                <input
                  type="text"
                  data-customer-name
                  placeholder="Your name"
                  class="w-full rounded-full border border-line-strong bg-paper px-5 py-3 text-sm text-ink outline-none transition placeholder:text-sage-deep focus:border-berry"
                />
              </div>

              <div>
                <label class="mb-2 block text-[10px] font-bold uppercase tracking-[0.22em] text-berry">
                  Phone / WhatsApp
                </label>

                <input
                  type="tel"
                  data-customer-phone
                  placeholder="Your phone number"
                  class="w-full rounded-full border border-line-strong bg-paper px-5 py-3 text-sm text-ink outline-none transition placeholder:text-sage-deep focus:border-berry"
                />
              </div>

              {/* The order's one recipient city (src/utils/destination.ts): shown, editable, never required. */}
              <div class="md:col-span-2" data-cart-destination>
                <DestinationCity label="Recipient city" />
              </div>

              <div>
                <label class="mb-2 block text-[10px] font-bold uppercase tracking-[0.22em] text-berry">
                  Delivery Pincode (optional)
                </label>

                <input
                  type="text"
                  inputmode="numeric"
                  maxlength="6"
                  data-customer-pincode
                  placeholder="6-digit pincode — optional"
                  class="w-full rounded-full border border-line-strong bg-paper px-5 py-3 text-sm text-ink outline-none transition placeholder:text-sage-deep focus:border-berry"
                />
              </div>

              <div>
                <label class="mb-2 block text-[10px] font-bold uppercase tracking-[0.22em] text-berry">
                  Main Delivery Date
                </label>

                <input
                  type="date"
                  data-delivery-date
                  class="w-full rounded-full border border-line-strong bg-paper px-5 py-3 text-sm text-ink outline-none transition focus:border-berry"
                />
              </div>

              <div class="md:col-span-2">
                <label class="mb-2 block text-[10px] font-bold uppercase tracking-[0.22em] text-berry">
                  Main Delivery Time Slot
                </label>

                <select
                  data-delivery-slot
                  class="w-full rounded-full border border-line-strong bg-paper px-5 py-3 text-sm text-ink outline-none transition focus:border-berry"
                >
                  <option value="">Select delivery time slot</option>
                  {
                    timeSlots.map((slot) => (
                      <option value={slot.value} data-method={slot.method}>
                        {slot.label}
                      </option>
                    ))
                  }
                </select>
              </div>

              <div class="md:col-span-2">
                <label class="mb-2 block text-[10px] font-bold uppercase tracking-[0.22em] text-berry">
                  Delivery Address / Order Note
                </label>

                <textarea
                  rows="3"
                  data-customer-note
                  placeholder="Delivery address, preferred flowers, special instructions, etc."
                  class="w-full rounded-[20px] border border-line-strong bg-paper px-5 py-3 text-sm text-ink outline-none transition placeholder:text-sage-deep focus:border-berry"
                ></textarea>
              </div>
            </div>

            <div class="mt-8 border-t border-line pt-6">
              <h2 class="text-[12px] font-bold uppercase tracking-[0.24em] text-ink">
                Delivery Details
              </h2>

              <p class="mt-2 text-xs leading-6 text-moss">
                Who are the flowers for, and where should they arrive?
              </p>

              <div class="mt-5 grid gap-3 md:grid-cols-2">
                <div>
                  <label class="mb-2 block text-[10px] font-bold uppercase tracking-[0.22em] text-berry">
                    Recipient Name
                  </label>

                  <input
                    type="text"
                    data-recipient-name
                    placeholder="Who should receive the flowers?"
                    class="w-full rounded-full border border-line-strong bg-paper px-5 py-3 text-sm text-ink outline-none transition placeholder:text-sage-deep focus:border-berry"
                  />
                </div>

                <div>
                  <label class="mb-2 block text-[10px] font-bold uppercase tracking-[0.22em] text-berry">
                    Recipient Phone
                  </label>

                  <input
                    type="tel"
                    data-recipient-phone
                    placeholder="10-digit mobile number"
                    class="w-full rounded-full border border-line-strong bg-paper px-5 py-3 text-sm text-ink outline-none transition placeholder:text-sage-deep focus:border-berry"
                  />
                </div>

                <div>
                  <label class="mb-2 block text-[10px] font-bold uppercase tracking-[0.22em] text-berry">
                    Delivery Landmark
                  </label>

                  <input
                    type="text"
                    data-delivery-landmark
                    placeholder="Apartment, office, landmark, etc."
                    class="w-full rounded-full border border-line-strong bg-paper px-5 py-3 text-sm text-ink outline-none transition placeholder:text-sage-deep focus:border-berry"
                  />
                </div>

                <div>
                  <label class="mb-2 block text-[10px] font-bold uppercase tracking-[0.22em] text-berry">
                    Occasion
                  </label>

                  <select
                    data-occasion
                    class="w-full rounded-full border border-line-strong bg-paper px-5 py-3 text-sm text-ink outline-none transition focus:border-berry"
                  >
                    <option value="">Select occasion</option>
                    {
                      occasionOptions.map((occasion) => (
                        <option value={occasion.name}>{occasion.name}</option>
                      ))
                    }
                    <option value="Other">Other</option>
                  </select>
                </div>

                <div class="md:col-span-2 hidden" data-occasion-other-wrapper>
                  <label class="mb-2 block text-[10px] font-bold uppercase tracking-[0.22em] text-berry">
                    Tell us more (optional)
                  </label>

                  <input
                    type="text"
                    data-occasion-other
                    placeholder="Short description of the occasion"
                    maxlength="80"
                    class="w-full rounded-full border border-line-strong bg-paper px-5 py-3 text-sm text-ink outline-none transition placeholder:text-sage-deep focus:border-berry"
                  />
                </div>
              </div>
            </div>

            <div
              data-service-area-result
              class="mt-5 hidden rounded-2xl border p-4 text-sm leading-7"
            ></div>

            <div
              data-cart-summary
              class="mt-5 hidden rounded-[24px] border border-line bg-paper p-5"
            ></div>

            <div
              data-cart-error
              class="mt-5 hidden rounded-2xl border border-rose bg-linen p-4 text-sm font-semibold text-berry"
            ></div>
                <div
  data-cart-error
  class="mt-5 hidden rounded-2xl border border-rose bg-linen p-4 text-sm font-semibold text-berry"
></div>

<div class="mt-6 rounded-[24px] border border-mint-soft bg-mint-soft p-5">
  <h3 class="text-[12px] font-bold uppercase tracking-[0.24em] text-ink">
    Before Sending
  </h3>

  <ul class="mt-4 space-y-3 text-sm leading-6 text-moss">
    <li class="flex gap-2">
      <span class="mt-1 text-ink">•</span>
      <span>No payment is collected on this website.</span>
    </li>

    <li class="flex gap-2">
      <span class="mt-1 text-ink">•</span>
      <span>Prices and flower availability are sent to you on WhatsApp.</span>
    </li>

    <li class="flex gap-2">
      <span class="mt-1 text-ink">•</span>
      <span>Delivery charges are confirmed on WhatsApp.</span>
    </li>

    <li class="flex gap-2">
      <span class="mt-1 text-ink">•</span>
      <span>Custom items may vary based on daily market freshness.</span>
    </li>
  </ul>
</div>
            <div class="mt-6 flex flex-col gap-3 sm:flex-row">
              <button
                type="button"
                data-send-cart-whatsapp
                class="fp-btn-whatsapp inline-flex items-center justify-center rounded-full bg-berry px-7 py-4 text-[11px] font-bold uppercase tracking-[0.22em] text-white hover:bg-berry-deep"
              >
                {QUOTE_ONLY_BASKET_LABEL}
              </button>

              <button
                type="button"
                data-clear-cart
                class="inline-flex items-center justify-center rounded-full border border-ink px-7 py-4 text-[11px] font-bold uppercase tracking-[0.22em] text-ink transition hover:bg-ink hover:text-white"
              >
                Clear Cart
              </button>
            </div>

            <p class="mt-4 text-xs leading-6 text-moss">
              Prices, flower availability, delivery fee and payment are confirmed on WhatsApp.
            </p>
          </div>
        </div>
      </div>
    </section>
  </main>

  <script is:inline type="application/json" id="published-prices" set:html={JSON.stringify(publishedPrices)}></script>
  <script is:inline type="application/json" id="quote-only" set:html={JSON.stringify(QUOTE_ONLY_CONFIG)}></script>
  <script is:inline type="application/json" id="service-cities" set:html={JSON.stringify(Object.fromEntries(cityOptions().map((city) => [city.slug, city.name])))}></script>
  <InlineScript code={cartScript} />
</BaseLayout>
