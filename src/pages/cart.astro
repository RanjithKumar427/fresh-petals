 ---
import BaseLayout from "../layouts/BaseLayout.astro";
import { serviceAreas } from "../data/serviceAreas";

const timeSlots = [
  {
    value: "Morning Slot: 7 AM - 10 AM",
    label: "Morning Slot: 7 AM - 10 AM",
    type: "morning",
  },
  {
    value: "Afternoon Slot: 12 PM - 3 PM",
    label: "Afternoon Slot: 12 PM - 3 PM",
    type: "standard",
  },
  {
    value: "Evening Slot: 5 PM - 8 PM",
    label: "Evening Slot: 5 PM - 8 PM",
    type: "standard",
  },
  {
    value: "Express Delivery: Within 4-6 Hours",
    label: "Express Delivery: Within 4-6 Hours",
    type: "express",
  },
];
---

<BaseLayout
  title="Cart | Fresh Petals Hyderabad"
  description="Review your Fresh Petals flower order cart and continue on WhatsApp."
>
  <main class="bg-white">
    <section class="px-5 py-12 md:px-8 md:py-16">
      <div class="mx-auto max-w-5xl">
        <div class="mb-10 text-center">
          <p class="text-[10px] font-semibold uppercase tracking-[0.32em] text-[#9B6B78]">
            Fresh Petals Hyderabad
          </p>

          <h1 class="fp-serif mt-3 text-3xl uppercase tracking-[0.20em] text-[#171717] md:text-5xl">
            Your Cart
          </h1>

          <p class="mx-auto mt-5 max-w-2xl text-sm leading-7 text-[#66565D] md:text-base">
            Review your selected flowers and continue on WhatsApp for availability, final price and payment confirmation.
          </p>
        </div>

        <div
          data-cart-empty
          class="hidden rounded-[24px] border border-[#EEE5E8] bg-[#FFF8FA] p-8 text-center"
        >
          <h2 class="text-lg font-semibold text-[#171717]">
            Your cart is empty
          </h2>

          <p class="mt-3 text-sm leading-7 text-[#66565D]">
            Add bouquets, pooja flowers, flower boxes, baskets or add-ons to prepare your order.
          </p>

          <a
            href="/categories/bouquets"
            class="mt-6 inline-flex rounded-full bg-[#111111] px-7 py-3 text-[11px] font-bold uppercase tracking-[0.22em] text-white transition hover:bg-[#7C243E]"
          >
            Start Shopping
          </a>
        </div>

        <div data-cart-content class="hidden">
          <div data-cart-items class="space-y-5"></div>

          <div class="mt-8 rounded-[24px] border border-[#EEE5E8] bg-[#FFF8FA] p-5">
            <h2 class="text-[12px] font-bold uppercase tracking-[0.24em] text-[#171717]">
              Order Details
            </h2>

            <div class="mt-5 grid gap-3 md:grid-cols-2">
              <div>
                <label class="mb-2 block text-[10px] font-bold uppercase tracking-[0.22em] text-[#7C243E]">
                  Name
                </label>

                <input
                  type="text"
                  data-customer-name
                  placeholder="Your name"
                  class="w-full rounded-full border border-[#E5D6DC] bg-white px-5 py-3 text-sm text-[#171717] outline-none transition placeholder:text-[#A99DA3] focus:border-[#7C243E]"
                />
              </div>

              <div>
                <label class="mb-2 block text-[10px] font-bold uppercase tracking-[0.22em] text-[#7C243E]">
                  Phone / WhatsApp
                </label>

                <input
                  type="tel"
                  data-customer-phone
                  placeholder="Your phone number"
                  class="w-full rounded-full border border-[#E5D6DC] bg-white px-5 py-3 text-sm text-[#171717] outline-none transition placeholder:text-[#A99DA3] focus:border-[#7C243E]"
                />
              </div>

              <div>
                <label class="mb-2 block text-[10px] font-bold uppercase tracking-[0.22em] text-[#7C243E]">
                  Main Delivery Pincode
                </label>

                <input
                  type="text"
                  inputmode="numeric"
                  maxlength="6"
                  data-customer-pincode
                  placeholder="Delivery pincode"
                  class="w-full rounded-full border border-[#E5D6DC] bg-white px-5 py-3 text-sm text-[#171717] outline-none transition placeholder:text-[#A99DA3] focus:border-[#7C243E]"
                />
              </div>

              <div>
                <label class="mb-2 block text-[10px] font-bold uppercase tracking-[0.22em] text-[#7C243E]">
                  Main Delivery Date
                </label>

                <input
                  type="date"
                  data-delivery-date
                  class="w-full rounded-full border border-[#E5D6DC] bg-white px-5 py-3 text-sm text-[#171717] outline-none transition focus:border-[#7C243E]"
                />
              </div>

              <div class="md:col-span-2">
                <label class="mb-2 block text-[10px] font-bold uppercase tracking-[0.22em] text-[#7C243E]">
                  Main Delivery Time Slot
                </label>

                <select
                  data-delivery-slot
                  class="w-full rounded-full border border-[#E5D6DC] bg-white px-5 py-3 text-sm text-[#171717] outline-none transition focus:border-[#7C243E]"
                >
                  <option value="">Select delivery time slot</option>
                  {
                    timeSlots.map((slot) => (
                      <option value={slot.value} data-slot-type={slot.type}>
                        {slot.label}
                      </option>
                    ))
                  }
                </select>
              </div>

              <div class="md:col-span-2">
                <label class="mb-2 block text-[10px] font-bold uppercase tracking-[0.22em] text-[#7C243E]">
                  Delivery Address / Order Note
                </label>

                <textarea
                  rows="3"
                  data-customer-note
                  placeholder="Address, landmark, occasion, preferred flowers, gift message, etc."
                  class="w-full rounded-[20px] border border-[#E5D6DC] bg-white px-5 py-3 text-sm text-[#171717] outline-none transition placeholder:text-[#A99DA3] focus:border-[#7C243E]"
                ></textarea>
              </div>
            </div>

            <div
              data-service-area-result
              class="mt-5 hidden rounded-2xl border p-4 text-sm leading-7"
            ></div>

            <div
              data-cart-summary
              class="mt-5 hidden rounded-[24px] border border-[#EEE5E8] bg-white p-5"
            ></div>

            <div
              data-cart-error
              class="mt-5 hidden rounded-2xl border border-[#E7B7C0] bg-[#FFF3F5] p-4 text-sm font-semibold text-[#7C243E]"
            ></div>

            <div class="mt-6 flex flex-col gap-3 sm:flex-row">
              <button
                type="button"
                data-send-cart-whatsapp
                class="inline-flex items-center justify-center rounded-full bg-[#075838] px-7 py-4 text-[11px] font-bold uppercase tracking-[0.22em] text-white transition hover:bg-[#7C243E]"
              >
                Send Cart on WhatsApp
              </button>

              <button
                type="button"
                data-clear-cart
                class="inline-flex items-center justify-center rounded-full border border-[#111111] px-7 py-4 text-[11px] font-bold uppercase tracking-[0.22em] text-[#111111] transition hover:bg-[#111111] hover:text-white"
              >
                Clear Cart
              </button>
            </div>

            <p class="mt-4 text-xs leading-6 text-[#66565D]">
              Final flower availability, price, delivery fee and payment confirmation will happen on WhatsApp.
            </p>
          </div>
        </div>
      </div>
    </section>
  </main>

  <script define:vars={{ serviceAreas }}>
    const whatsappNumber = "919652012274";
    const CART_KEY = "fresh_petals_cart";

    function getCartItems() {
      const storedCart = window.localStorage.getItem(CART_KEY);

      if (!storedCart) return [];

      try {
        return JSON.parse(storedCart);
      } catch {
        return [];
      }
    }

    function saveCartItems(items) {
      window.localStorage.setItem(CART_KEY, JSON.stringify(items));
      window.dispatchEvent(new Event("fresh-petals-cart-updated"));
    }

    function updateCartItemQuantity(id, quantity) {
      const currentItems = getCartItems();

      if (quantity <= 0) {
        removeCartItem(id);
        return;
      }

      const updatedItems = currentItems.map((item) =>
        item.id === id
          ? {
              ...item,
              quantity,
            }
          : item
      );

      saveCartItems(updatedItems);
    }

    function removeCartItem(id) {
      const currentItems = getCartItems();
      const updatedItems = currentItems.filter((item) => item.id !== id);
      saveCartItems(updatedItems);
    }

    function clearCart() {
      saveCartItems([]);
    }

    const emptyState = document.querySelector("[data-cart-empty]");
    const cartContent = document.querySelector("[data-cart-content]");
    const cartItemsContainer = document.querySelector("[data-cart-items]");
    const clearCartButton = document.querySelector("[data-clear-cart]");
    const sendWhatsappButton = document.querySelector("[data-send-cart-whatsapp]");
    const errorBox = document.querySelector("[data-cart-error]");
    const serviceAreaResult = document.querySelector("[data-service-area-result]");
    const cartSummary = document.querySelector("[data-cart-summary]");

    const nameInput = document.querySelector("[data-customer-name]");
    const phoneInput = document.querySelector("[data-customer-phone]");
    const pincodeInput = document.querySelector("[data-customer-pincode]");
    const dateInput = document.querySelector("[data-delivery-date]");
    const slotInput = document.querySelector("[data-delivery-slot]");
    const noteInput = document.querySelector("[data-customer-note]");

    const today = new Date();
    const todayIso = today.toISOString().split("T")[0];

    if (dateInput) {
      dateInput.min = todayIso;
    }

    function escapeHtml(value) {
      return String(value || "")
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#039;");
    }

    function showError(message) {
      if (!errorBox) return;

      errorBox.textContent = message;
      errorBox.classList.remove("hidden");
    }

    function hideError() {
      if (!errorBox) return;

      errorBox.textContent = "";
      errorBox.classList.add("hidden");
    }

    function showServiceAreaResult({ type, html }) {
      if (!serviceAreaResult) return;

      serviceAreaResult.classList.remove("hidden");
      serviceAreaResult.innerHTML = html;

      if (type === "success") {
        serviceAreaResult.className =
          "mt-5 rounded-2xl border border-[#B9D8C6] bg-[#F3FFF7] p-4 text-sm leading-7 text-[#075838]";
      } else {
        serviceAreaResult.className =
          "mt-5 rounded-2xl border border-[#E7B7C0] bg-[#FFF3F5] p-4 text-sm leading-7 text-[#7C243E]";
      }
    }

    function hideServiceAreaResult() {
      if (!serviceAreaResult) return;

      serviceAreaResult.classList.add("hidden");
      serviceAreaResult.innerHTML = "";
    }

    function hideCartSummary() {
      if (!cartSummary) return;

      cartSummary.classList.add("hidden");
      cartSummary.innerHTML = "";
    }

    function findServiceArea(pincode) {
      return serviceAreas.find((area) => area.pincode === pincode);
    }

    function getSelectedSlotType() {
      const selectedOption = slotInput?.options?.[slotInput.selectedIndex];
      return selectedOption?.dataset?.slotType || "standard";
    }

    function hasConfiguredDetails(item) {
      return Boolean(
        item.deliveryDate ||
          item.deliverySlot ||
          item.pincode ||
          item.greetingCard ||
          item.message ||
          item.note ||
          (item.addOns && item.addOns.length > 0) ||
          item.subscription
      );
    }

    function renderAddOnsHtml(addOns) {
      if (!addOns || addOns.length === 0) return "";

      const addOnRows = addOns
        .map(
          (addOn) => `
            <li>
              ${escapeHtml(addOn.name)} (${escapeHtml(addOn.priceLabel)}) × ${escapeHtml(addOn.quantity || 1)}
            </li>
          `
        )
        .join("");

      return `
        <div>
          <p class="font-semibold text-[#171717]">Add-ons</p>
          <ul class="mt-1 list-disc space-y-1 pl-5">
            ${addOnRows}
          </ul>
        </div>
      `;
    }

    function renderSubscriptionHtml(subscription) {
      if (!subscription) return "";

      const rows = [
        subscription.frequency ? `Frequency: ${subscription.frequency}` : "",
        subscription.duration ? `Duration: ${subscription.duration}` : "",
        subscription.startDate ? `Start Date: ${subscription.startDate}` : "",
      ].filter(Boolean);

      if (rows.length === 0) return "";

      return `
        <div>
          <p class="font-semibold text-[#171717]">Subscription</p>
          <ul class="mt-1 list-disc space-y-1 pl-5">
            ${rows.map((row) => `<li>${escapeHtml(row)}</li>`).join("")}
          </ul>
        </div>
      `;
    }

    function renderConfiguredDetailsHtml(item) {
      if (!hasConfiguredDetails(item)) return "";

      const deliveryRows = [
        item.pincode ? `Item Pincode: ${item.pincode}` : "",
        item.deliveryDate ? `Item Delivery Date: ${item.deliveryDate}` : "",
        item.deliverySlot ? `Item Delivery Slot: ${item.deliverySlot}` : "",
        item.greetingCard ? `Greeting Card: ${item.greetingCard}` : "",
        item.message ? `Message: ${item.message}` : "",
        item.note ? `Item Note: ${item.note}` : "",
      ].filter(Boolean);

      const deliveryHtml =
        deliveryRows.length > 0
          ? `
            <div>
              <p class="font-semibold text-[#171717]">Configured Details</p>
              <ul class="mt-1 list-disc space-y-1 pl-5">
                ${deliveryRows.map((row) => `<li>${escapeHtml(row)}</li>`).join("")}
              </ul>
            </div>
          `
          : "";

      return `
        <div class="mt-4 space-y-3 rounded-2xl border border-[#EEE5E8] bg-[#FFF8FA] p-4 text-xs leading-6 text-[#66565D]">
          ${deliveryHtml}
          ${renderAddOnsHtml(item.addOns)}
          ${renderSubscriptionHtml(item.subscription)}
        </div>
      `;
    }

    function buildConfiguredDetailsText(item) {
      const lines = [];

      if (item.pincode) lines.push(`Item Pincode: ${item.pincode}`);
      if (item.deliveryDate) lines.push(`Item Delivery Date: ${item.deliveryDate}`);
      if (item.deliverySlot) lines.push(`Item Delivery Slot: ${item.deliverySlot}`);
      if (item.greetingCard) lines.push(`Greeting Card: ${item.greetingCard}`);
      if (item.message) lines.push(`Message: ${item.message}`);
      if (item.note) lines.push(`Item Note: ${item.note}`);

      if (item.addOns && item.addOns.length > 0) {
        lines.push("Add-ons:");
        item.addOns.forEach((addOn) => {
          lines.push(
            `- ${addOn.name} (${addOn.priceLabel}) × ${addOn.quantity || 1}`
          );
        });
      }

      if (item.subscription) {
        lines.push("Subscription:");
        if (item.subscription.frequency) {
          lines.push(`- Frequency: ${item.subscription.frequency}`);
        }
        if (item.subscription.duration) {
          lines.push(`- Duration: ${item.subscription.duration}`);
        }
        if (item.subscription.startDate) {
          lines.push(`- Start Date: ${item.subscription.startDate}`);
        }
      }

      return lines.length > 0 ? lines.join("\n") : "No item-level configuration";
    }

    function renderCart() {
      const items = getCartItems();

      if (!cartItemsContainer || !emptyState || !cartContent) return;

      cartItemsContainer.innerHTML = "";

      if (items.length === 0) {
        emptyState.classList.remove("hidden");
        cartContent.classList.add("hidden");
        return;
      }

      emptyState.classList.add("hidden");
      cartContent.classList.remove("hidden");

      items.forEach((item) => {
        const itemElement = document.createElement("div");

        itemElement.className =
          "grid gap-4 rounded-[24px] border border-[#EEE5E8] bg-white p-4 shadow-[0_10px_30px_rgba(40,24,32,0.05)] md:grid-cols-[110px_1fr_auto] md:items-start";

        itemElement.innerHTML = `
          <a href="/products/${escapeHtml(item.slug)}" class="block overflow-hidden rounded-2xl bg-[#F8F1F3]">
            <img
              src="${escapeHtml(item.image)}"
              alt="${escapeHtml(item.name)}"
              class="h-[110px] w-full object-cover md:w-[110px]"
            />
          </a>

          <div>
            <p class="text-[10px] font-semibold uppercase tracking-[0.24em] text-[#9B6B78]">
              ${escapeHtml(item.category)}
            </p>

            <a href="/products/${escapeHtml(item.slug)}" class="mt-2 block">
              <h2 class="text-base font-semibold text-[#171717]">
                ${escapeHtml(item.name)}
              </h2>
            </a>

            <p class="mt-2 text-sm font-bold text-[#7C243E]">
              ${escapeHtml(item.priceLabel)}
            </p>

            ${renderConfiguredDetailsHtml(item)}
          </div>

          <div class="flex items-center justify-between gap-3 md:flex-col md:items-end">
            <div class="flex items-center rounded-full border border-[#E5D6DC] bg-white">
              <button
                type="button"
                data-decrease="${escapeHtml(item.id)}"
                class="px-4 py-2 text-sm font-bold text-[#171717]"
              >
                -
              </button>

              <span class="min-w-8 text-center text-sm font-semibold text-[#171717]">
                ${escapeHtml(item.quantity)}
              </span>

              <button
                type="button"
                data-increase="${escapeHtml(item.id)}"
                class="px-4 py-2 text-sm font-bold text-[#171717]"
              >
                +
              </button>
            </div>

            <button
              type="button"
              data-remove="${escapeHtml(item.id)}"
              class="text-[10px] font-bold uppercase tracking-[0.18em] text-[#7C243E] underline underline-offset-4"
            >
              Remove
            </button>
          </div>
        `;

        cartItemsContainer.appendChild(itemElement);
      });

      bindCartButtons();
    }

    function bindCartButtons() {
      document.querySelectorAll("[data-increase]").forEach((button) => {
        button.addEventListener("click", () => {
          const id = button.getAttribute("data-increase");
          const item = getCartItems().find((cartItem) => cartItem.id === id);

          if (!item) return;

          updateCartItemQuantity(item.id, item.quantity + 1);
          hideCartSummary();
          renderCart();
        });
      });

      document.querySelectorAll("[data-decrease]").forEach((button) => {
        button.addEventListener("click", () => {
          const id = button.getAttribute("data-decrease");
          const item = getCartItems().find((cartItem) => cartItem.id === id);

          if (!item) return;

          updateCartItemQuantity(item.id, item.quantity - 1);
          hideCartSummary();
          renderCart();
        });
      });

      document.querySelectorAll("[data-remove]").forEach((button) => {
        button.addEventListener("click", () => {
          const id = button.getAttribute("data-remove");

          if (!id) return;

          removeCartItem(id);
          hideCartSummary();
          renderCart();
        });
      });
    }

    function renderCartSummaryItemRows(items) {
      return items
        .map((item, index) => {
          const configuredHtml = renderConfiguredDetailsHtml(item);

          return `
            <div class="border-b border-[#F0E4E8] pb-3">
              <div class="flex justify-between gap-4">
                <span>${index + 1}. ${escapeHtml(item.name)}</span>
                <strong class="text-right text-[#171717]">
                  ${escapeHtml(item.priceLabel)} × ${escapeHtml(item.quantity)}
                </strong>
              </div>

              ${configuredHtml}
            </div>
          `;
        })
        .join("");
    }

    function renderCartSummary({
      customerName,
      customerPhone,
      pincode,
      areaText,
      deliveryFeeText,
      serviceStatusText,
      deliveryDate,
      deliverySlot,
      slotStatusText,
      note,
      items,
    }) {
      if (!cartSummary) return;

      const itemRows = renderCartSummaryItemRows(items);

      cartSummary.classList.remove("hidden");

      cartSummary.innerHTML = `
        <h3 class="text-[12px] font-bold uppercase tracking-[0.24em] text-[#171717]">
          Cart Order Summary
        </h3>

        <div class="mt-4 space-y-3 text-sm leading-6 text-[#5E5358]">
          <div class="flex justify-between gap-4 border-b border-[#F0E4E8] pb-2">
            <span>Name</span>
            <strong class="text-right text-[#171717]">${escapeHtml(customerName)}</strong>
          </div>

          <div class="flex justify-between gap-4 border-b border-[#F0E4E8] pb-2">
            <span>Phone</span>
            <strong class="text-right text-[#171717]">${escapeHtml(customerPhone)}</strong>
          </div>

          <div class="flex justify-between gap-4 border-b border-[#F0E4E8] pb-2">
            <span>Main Pincode</span>
            <strong class="text-right text-[#171717]">${escapeHtml(pincode)}</strong>
          </div>

          <div class="flex justify-between gap-4 border-b border-[#F0E4E8] pb-2">
            <span>Area</span>
            <strong class="text-right text-[#171717]">${escapeHtml(areaText)}</strong>
          </div>

          <div class="flex justify-between gap-4 border-b border-[#F0E4E8] pb-2">
            <span>Delivery Fee</span>
            <strong class="text-right text-[#171717]">${escapeHtml(deliveryFeeText)}</strong>
          </div>

          <div class="flex justify-between gap-4 border-b border-[#F0E4E8] pb-2">
            <span>Service Status</span>
            <strong class="text-right text-[#075838]">${escapeHtml(serviceStatusText)}</strong>
          </div>

          <div class="flex justify-between gap-4 border-b border-[#F0E4E8] pb-2">
            <span>Main Delivery Date</span>
            <strong class="text-right text-[#171717]">${escapeHtml(deliveryDate)}</strong>
          </div>

          <div class="flex justify-between gap-4 border-b border-[#F0E4E8] pb-2">
            <span>Main Delivery Slot</span>
            <strong class="text-right text-[#171717]">${escapeHtml(deliverySlot)}</strong>
          </div>

          <div class="flex justify-between gap-4 border-b border-[#F0E4E8] pb-2">
            <span>Slot Status</span>
            <strong class="text-right text-[#075838]">${escapeHtml(slotStatusText)}</strong>
          </div>

          <div class="pt-2">
            <h4 class="mb-3 text-[11px] font-bold uppercase tracking-[0.20em] text-[#171717]">
              Items
            </h4>
            <div class="space-y-3">
              ${itemRows}
            </div>
          </div>

          <div>
            <span class="block text-[#66565D]">Address / Order Note</span>
            <strong class="mt-1 block text-[#171717]">${escapeHtml(note || "None")}</strong>
          </div>
        </div>

        <p class="mt-4 rounded-2xl bg-[#FFF8FA] p-4 text-xs leading-6 text-[#7C243E]">
          This is an estimated cart summary. Final price, flower availability, delivery fee and payment confirmation will happen on WhatsApp.
        </p>
      `;
    }

    function buildCartLineText(item, index) {
      const configuredText = buildConfiguredDetailsText(item);

      return [
        `${index + 1}. ${item.name}`,
        `Price: ${item.priceLabel}`,
        `Qty: ${item.quantity}`,
        `Category: ${item.category}`,
        configuredText !== "No item-level configuration"
          ? `Configured Details:\n${configuredText}`
          : "Configured Details: None",
      ].join("\n");
    }

    function buildCartWhatsappUrl() {
      const items = getCartItems();

      const customerName = nameInput?.value.trim() || "";
      const customerPhone = phoneInput?.value.trim() || "";
      const pincode = pincodeInput?.value.trim() || "";
      const deliveryDate = dateInput?.value || "";
      const deliverySlot = slotInput?.value || "";
      const note = noteInput?.value.trim() || "";

      hideError();
      hideServiceAreaResult();
      hideCartSummary();

      if (items.length === 0) {
        showError("Your cart is empty.");
        return "#";
      }

      if (!customerName) {
        showError("Please enter your name.");
        return "#";
      }

      if (!customerPhone) {
        showError("Please enter your phone number.");
        return "#";
      }

      if (!/^[0-9]{6}$/.test(pincode)) {
        showError("Please enter a valid 6-digit delivery pincode.");
        return "#";
      }

      if (!deliveryDate) {
        showError("Please select a delivery date.");
        return "#";
      }

      if (!deliverySlot) {
        showError("Please select a delivery time slot.");
        return "#";
      }

      const areaData = findServiceArea(pincode);
      const slotType = getSelectedSlotType();

      const cartLines = items
        .map((item, index) => buildCartLineText(item, index))
        .join("\n\n");

      let areaText = "Manual confirmation needed";
      let deliveryFeeText = "To be confirmed";
      let serviceStatusText = "Manual confirmation needed";
      let slotStatusText = "Manual confirmation needed";

      if (areaData) {
        areaText = `${areaData.area}, ${areaData.city}`;
        deliveryFeeText = `₹${areaData.deliveryFee}`;
        serviceStatusText = "Delivery available";
        slotStatusText = "Slot available";

        if (slotType === "morning" && !areaData.morningDeliveryAvailable) {
          slotStatusText = "Morning slot needs manual confirmation";

          showServiceAreaResult({
            type: "error",
            html: `
              <strong>Delivery available in ${escapeHtml(areaData.area)}, but morning slot needs confirmation.</strong><br />
              Delivery fee: ₹${escapeHtml(areaData.deliveryFee)}<br />
              Please continue on WhatsApp. We will manually confirm morning delivery possibility.
            `,
          });
        } else if (slotType === "express" && !areaData.sameDayAvailable) {
          slotStatusText = "Express slot needs manual confirmation";

          showServiceAreaResult({
            type: "error",
            html: `
              <strong>Delivery available in ${escapeHtml(areaData.area)}, but express delivery needs confirmation.</strong><br />
              Delivery fee: ₹${escapeHtml(areaData.deliveryFee)}<br />
              Please continue on WhatsApp. We will manually confirm express delivery possibility.
            `,
          });
        } else {
          showServiceAreaResult({
            type: "success",
            html: `
              <strong>Delivery available in ${escapeHtml(areaData.area)}.</strong><br />
              Delivery fee: ₹${escapeHtml(areaData.deliveryFee)}<br />
              Delivery slot: ${escapeHtml(deliverySlot)}<br />
              Same-day delivery: ${areaData.sameDayAvailable ? "Available" : "Not available"}<br />
              Morning delivery: ${areaData.morningDeliveryAvailable ? "Available" : "Not available"}
            `,
          });
        }
      } else {
        showServiceAreaResult({
          type: "error",
          html: `
            <strong>Delivery is not confirmed for this pincode yet.</strong><br />
            You can still continue on WhatsApp. We will manually confirm delivery possibility, fee and timing.
          `,
        });
      }

      renderCartSummary({
        customerName,
        customerPhone,
        pincode,
        areaText,
        deliveryFeeText,
        serviceStatusText,
        deliveryDate,
        deliverySlot,
        slotStatusText,
        note,
        items,
      });

      const message = `
Hi Fresh Petals, I want to place a cart order:

Customer Name: ${customerName}
Phone: ${customerPhone}
Main Pincode: ${pincode}
Area: ${areaText}
Delivery Fee: ${deliveryFeeText}
Service Status: ${serviceStatusText}
Main Delivery Date: ${deliveryDate}
Main Delivery Slot: ${deliverySlot}
Slot Status: ${slotStatusText}

Items:
${cartLines}

Order Note / Address:
${note || "None"}

Please confirm availability, final price, delivery fee and payment details.
      `.trim();

      return `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(message)}`;
    }

    sendWhatsappButton?.addEventListener("click", () => {
      const url = buildCartWhatsappUrl();

      if (url === "#") return;

      window.open(url, "_blank", "noopener,noreferrer");
    });

    pincodeInput?.addEventListener("input", () => {
      hideServiceAreaResult();
      hideCartSummary();
      hideError();
    });

    slotInput?.addEventListener("change", () => {
      hideServiceAreaResult();
      hideCartSummary();
      hideError();
    });

    dateInput?.addEventListener("change", () => {
      hideCartSummary();
      hideError();
    });

    noteInput?.addEventListener("input", () => {
      hideCartSummary();
      hideError();
    });

    clearCartButton?.addEventListener("click", () => {
      clearCart();
      hideCartSummary();
      renderCart();
    });

    renderCart();
  </script>
</BaseLayout>