---
import BaseLayout from "../layouts/BaseLayout.astro";
import { whatsappLink } from "../config/storefront";

// Opens a chat with the business number (the previous link had no number
// and only opened WhatsApp's share sheet).
const whatsappHref = whatsappLink("Hi Fresh Petals, I have a question about flowers.");

const contactCards = [
  {
    title: "Order Flowers",
    description:
      "Ask about our rose, mixed-flower and lily bouquets, or send your basket from the cart for a quick confirmation.",
    href: whatsappHref,
    external: true,
    cta: "Chat on WhatsApp",
  },
  {
    title: "Delivery",
    description:
      "We're starting with Chamarajpet and Basavanagudi. We confirm your address, timing and the final total including delivery on WhatsApp.",
    href: "/shipping",
    external: false,
    cta: "View Delivery Info",
  },
  {
    title: "Custom Orders",
    description:
      "A bouquet matched to your colours, occasion and budget, or flowers for a small ceremony, quoted on WhatsApp.",
    href: "/custom-orders",
    external: false,
    cta: "See Custom Orders",
  },
];

const enquiryTypes = ["Bouquet order", "Custom bouquet", "Small ceremony order", "Delivery question"];
---

<BaseLayout
  title="Contact Fresh Petals Bengaluru"
  description="Contact Fresh Petals Bengaluru on WhatsApp for bouquet orders, custom orders and delivery questions in Chamarajpet and Basavanagudi."
>
  <main id="contact" class="bg-paper">
    <section class="px-5 py-14 md:px-8 md:py-20">
      <div class="mx-auto max-w-7xl">
        <div class="mx-auto max-w-3xl text-center">
          <p class="fp-eyebrow">
            Contact Fresh Petals
          </p>

          <h1 class="fp-serif mt-4 text-3xl text-ink md:text-5xl">
            Fresh Flower Orders In Bengaluru
          </h1>

          <p class="mx-auto mt-5 max-w-2xl text-sm leading-7 text-moss md:text-base">
            Fresh Petals is WhatsApp-first. Tell us what you need, your delivery address and the date.
            We confirm availability and the final total, including delivery, before you pay.
          </p>

          <a
            href={whatsappHref}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-8 inline-flex rounded-full bg-ink px-7 py-3 text-[11px] font-semibold uppercase tracking-[0.22em] text-white transition hover:bg-ink-deep"
          >
            Chat on WhatsApp
          </a>
        </div>

        <div class="mt-14 grid gap-5 md:grid-cols-3">
          {
            contactCards.map((card) => (
              <article class="rounded-[28px] border border-line bg-linen p-7">
                <p class="text-[10px] font-semibold uppercase tracking-[0.28em] text-rose-deep">
                  Fresh Petals Bengaluru
                </p>

                <h2 class="mt-4 text-xl font-semibold text-ink">
                  {card.title}
                </h2>

                <p class="mt-4 text-sm leading-7 text-moss">
                  {card.description}
                </p>

                <a
                  href={card.href}
                  target={card.external ? "_blank" : undefined}
                  rel={card.external ? "noopener noreferrer" : undefined}
                  class="mt-6 inline-flex text-[11px] font-semibold uppercase tracking-[0.22em] text-ink"
                >
                  {card.cta}
                </a>
              </article>
            ))
          }
        </div>

        <div class="mt-12 grid gap-6 rounded-[32px] border border-line bg-paper p-8 md:grid-cols-[0.9fr_1.1fr] md:p-10">
          <div>
            <p class="fp-eyebrow">
              What to send on WhatsApp
            </p>

            <h2 class="mt-3 text-2xl font-semibold text-ink">
              Send these details for faster confirmation
            </h2>

            <p class="mt-4 text-sm leading-7 text-moss">
              The product or idea, the occasion and date, the delivery address, and a budget if you
              have one. For custom orders, attach a reference photo in WhatsApp.
            </p>
          </div>

          <div class="grid gap-3 sm:grid-cols-2">
            {
              enquiryTypes.map((item) => (
                <div class="rounded-2xl border border-line bg-linen px-4 py-3 text-sm font-medium text-ink">
                  {item}
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>