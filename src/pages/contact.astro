---
import BaseLayout from "../layouts/BaseLayout.astro";

const whatsappText = encodeURIComponent(
  "Hi Fresh Petals, I want to enquire about fresh flowers in Hyderabad."
);

const whatsappHref = `https://wa.me/?text=${whatsappText}`;

const contactCards = [
  {
    title: "Order Flowers",
    description:
      "Ask about bouquets, pooja flowers, jasmine, flowerboxes, baskets and hampers available today.",
    href: whatsappHref,
    external: true,
    cta: "Chat on WhatsApp",
  },
  {
    title: "Check Delivery",
    description:
      "Share your pincode and preferred delivery slot to confirm serviceability and delivery estimate.",
    href: "/shipping",
    external: false,
    cta: "View Delivery Info",
  },
  {
    title: "Search Products",
    description:
      "Browse Fresh Petals products, categories, subscriptions, add-ons and occasion pages.",
    href: "/search",
    external: false,
    cta: "Search Catalog",
  },
];

const enquiryTypes = [
  "Bouquet order",
  "Pooja flowers",
  "Jasmine / Malli",
  "Flowerbox",
  "Basket / Hamper",
  "Subscription",
  "Bulk flowers",
  "Event flowers",
];
---

<BaseLayout
  title="Contact Fresh Petals Hyderabad"
  description="Contact Fresh Petals Hyderabad for WhatsApp-first flower orders, delivery enquiries, subscriptions, pooja flowers, bouquets and bulk orders."
>
  <main id="contact" class="bg-white">
    <section class="px-5 py-14 md:px-8 md:py-20">
      <div class="mx-auto max-w-7xl">
        <div class="mx-auto max-w-3xl text-center">
          <p class="fp-eyebrow">
            Contact Fresh Petals
          </p>

          <h1 class="fp-serif mt-4 text-3xl uppercase tracking-[0.20em] text-[#171717] md:text-5xl">
            Fresh Flower Orders In Hyderabad
          </h1>

          <p class="mx-auto mt-5 max-w-2xl text-sm leading-7 text-[#66565D] md:text-base">
            Fresh Petals is currently WhatsApp-first. Share what you need, your delivery area,
            preferred date and slot. Final availability and price will be confirmed before order.
          </p>

          <a
            href={whatsappHref}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-8 inline-flex rounded-full bg-[#075838] px-7 py-3 text-[11px] font-semibold uppercase tracking-[0.22em] text-white transition hover:bg-[#06492f]"
          >
            Chat on WhatsApp
          </a>
        </div>

        <div class="mt-14 grid gap-5 md:grid-cols-3">
          {
            contactCards.map((card) => (
              <article class="rounded-[28px] border border-[#EEE5E8] bg-[#FFF8FA] p-7">
                <p class="text-[10px] font-semibold uppercase tracking-[0.28em] text-[#9B6B78]">
                  Fresh Petals Hyderabad
                </p>

                <h2 class="mt-4 text-xl font-semibold text-[#171717]">
                  {card.title}
                </h2>

                <p class="mt-4 text-sm leading-7 text-[#66565D]">
                  {card.description}
                </p>

                <a
                  href={card.href}
                  target={card.external ? "_blank" : undefined}
                  rel={card.external ? "noopener noreferrer" : undefined}
                  class="mt-6 inline-flex text-[11px] font-semibold uppercase tracking-[0.22em] text-[#075838]"
                >
                  {card.cta}
                </a>
              </article>
            ))
          }
        </div>

        <div class="mt-12 grid gap-6 rounded-[32px] border border-[#EEE5E8] bg-white p-8 md:grid-cols-[0.9fr_1.1fr] md:p-10">
          <div>
            <p class="fp-eyebrow">
              What to send on WhatsApp
            </p>

            <h2 class="mt-3 text-2xl font-semibold text-[#171717]">
              Send these details for faster confirmation
            </h2>

            <p class="mt-4 text-sm leading-7 text-[#66565D]">
              Product needed, delivery pincode, date, preferred slot, quantity, budget and any
              reference image if it is a custom order.
            </p>
          </div>

          <div class="grid gap-3 sm:grid-cols-2">
            {
              enquiryTypes.map((item) => (
                <div class="rounded-2xl border border-[#EEE5E8] bg-[#FFF8FA] px-4 py-3 text-sm font-medium text-[#171717]">
                  {item}
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>