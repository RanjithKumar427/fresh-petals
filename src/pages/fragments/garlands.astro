---
// Garland cards for the search page, which fetches this HTML in the browser
// (src/pages/search.astro, /fragments/garlands?for=search). Prebuilt like the
// garland pages, so it is a static file served without running the Worker
// (any query string gets the same file) and the next build after an admin
// change replaces it (src/server/services/Publishing.ts). The unused occasion
// view (src/components/LiveGarlands.astro) was removed: occasion pages are
// prebuilt with their garland designs.
import GarlandCard from "../../components/GarlandCard.astro";
import { GARLAND_FILTERS, loadGarlands } from "../../data/garlands";

export const partial = true;
export const prerender = true;

const garlands = await loadGarlands();
const filterLabels = (keys: string[]) =>
  keys.map((key) => GARLAND_FILTERS.find((filter) => filter.key === key)?.label ?? key).join(" ");
---

{
  garlands.map((product) => (
      <div
        data-product-result
        data-product-name={product.name.toLowerCase()}
        data-product-category={product.category}
        data-product-description={product.description.toLowerCase()}
        data-product-long-description={product.longDescription.toLowerCase()}
        data-product-tags={[product.garland.code, "garland", "poola mala", filterLabels(product.garland.filters), ...(product.occasionTags ?? [])]
          .join(" ")
          .toLowerCase()}
      >
        <GarlandCard product={product} />
      </div>
    ))
}
