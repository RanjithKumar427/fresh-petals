---
import { serviceCityCount } from "../data/serviceCities";
const cityCount = serviceCityCount();
import BaseLayout from "../layouts/BaseLayout.astro";

const faqs = [
  {
    question: "How do I place an order with Fresh Petals?",
    answer:
      "You can browse products on the website, add items to cart, fill delivery details, and send the order on WhatsApp. We will confirm flower availability, final price, delivery fee, and payment details before processing.",
  },
  {
    question: "Are the prices fixed?",
    answer:
      "Bouquet and garland prices are sent to you on WhatsApp once you choose a design. Pooja flowers, jasmine, bulk flowers, and event flowers depend on the daily flower market price. Final price is confirmed on WhatsApp before payment.",
  },
  {
    question: "Which cities do you deliver to?",
    answer: `We take orders for ${cityCount} cities across India, listed on the delivery cities page (/locations). Tell us the recipient city, the address and the date on WhatsApp: we confirm whether we can deliver there on that date, and the final total including delivery, before you pay. We do not promise same-day delivery or a fixed delivery charge on this website.`,
  },
  {
    question: "Can I order pooja flowers daily?",
    answer:
      "Yes. We support daily pooja flowers, jasmine/malli, flower boxes, and custom subscription-style requirements based on availability and delivery area.",
  },
  {
    question: "Do you provide jasmine, gajra, poola jada and garlands?",
    answer:
      "Yes. We take orders for jasmine/malli, gajra, poola jada, garlands, pooja flowers, and temple or event bulk flowers depending on market availability.",
  },
  {
    question: "Can I order for events or bulk requirements?",
    answer:
      "Yes. For events, temple orders, garlands, wedding flowers, decor flowers, and bulk pooja flowers, please share your requirement on WhatsApp. We will confirm quantity, price, sourcing, and delivery feasibility.",
  },
  {
    question: "Do you offer same-day delivery?",
    answer:
      "Same-day and express delivery are not confirmed services. Message us on WhatsApp with your address, date and product. Availability and delivery arrangements are agreed before your order is accepted.",
  },
  {
    question: "Do you accept online payment?",
    answer:
      "Nothing is paid on this website. We agree the complete quote and payment arrangements on WhatsApp before accepting your order, then share payment details. Accepted payment methods are confirmed with you there.",
  },
  {
    question: "Can I customize a bouquet or flower box?",
    answer:
      "Yes. You can mention preferred flowers, colors, occasion, note card, or budget in the order note. Customization depends on daily flower availability.",
  },
  {
    question: "What if flowers are unavailable after I place an order?",
    answer:
      "Fresh flowers depend on market supply. If a specific flower is unavailable, we will suggest alternatives before confirming payment.",
  },
];
---

<BaseLayout
  title="FAQs | Fresh Petals"
  description="Frequently asked questions about Fresh Petals flower delivery across India, pooja flowers, bouquets, jasmine, garlands, bulk orders and WhatsApp ordering."
>
  <main class="bg-ivory">
    <section class="px-5 py-12 md:px-8 md:py-16">
      <div class="mx-auto max-w-4xl">
        <div class="mb-10 text-center">
          <p class="fp-eyebrow">
            Fresh Petals
          </p>

          <h1 class="fp-h1 mt-3">
            FAQs
          </h1>

          <p class="mx-auto mt-5 max-w-2xl text-sm leading-7 text-moss md:text-base">
            Answers to common questions about flower orders, delivery, pricing, customization and WhatsApp checkout.
          </p>
        </div>

        <div class="space-y-4">
          {
            faqs.map((faq) => (
              <details class="group rounded-[22px] border border-line bg-linen p-5">
                <summary class="cursor-pointer list-none text-sm font-bold uppercase tracking-[0.14em] text-ink">
                  <span class="flex items-center justify-between gap-4">
                    {faq.question}
                    <span class="text-xl text-berry transition group-open:rotate-45">
                      +
                    </span>
                  </span>
                </summary>

                <p class="mt-4 text-sm leading-7 text-moss">
                  {faq.answer}
                </p>
              </details>
            ))
          }
        </div>

        <div class="mt-10 rounded-[24px] border border-line bg-paper p-6 text-center shadow-[0_10px_30px_rgba(40,24,32,0.05)]">
          <h2 class="text-[12px] font-bold uppercase tracking-[0.24em] text-ink">
            Still have a question?
          </h2>

          <p class="mx-auto mt-3 max-w-2xl text-sm leading-7 text-moss">
            Message us on WhatsApp with your flower requirement, delivery area, date and preferred budget.
          </p>

          <a
            href="https://wa.me/919652012274?text=Hi%20Fresh%20Petals%2C%20I%20have%20a%20question%20about%20flower%20orders."
            target="_blank"
            rel="noopener noreferrer"
            class="mt-6 inline-flex rounded-full bg-berry px-7 py-4 text-[11px] font-bold uppercase tracking-[0.22em] text-white transition hover:bg-berry-deep"
          >
            Ask on WhatsApp
          </a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
