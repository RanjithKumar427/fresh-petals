---
// /locations/<city>/shop: the whole public catalogue for one recipient city.
// Every serviceable city has it (59), with the same collections and products
// (src/server/services/CityCatalogue.ts). One address per city: the
// collection and the page are query parameters, so there is no city URL per
// collection. It is a shopping view, not a landing page: noindex, follow,
// canonical to itself, and not in the sitemap. The city's own page
// (/locations/<city>), which every serviceable city has, is the indexable page.
//
// Prebuilt: one static file per city holds every product, served without
// running the Worker, so no ?collection=…&page=… address (real or invented)
// renders anything or reads the database. The script below shows the chosen
// collection and page, 24 products a page, and updates the heading, title,
// chips, range and page links; an unknown collection shows everything and an
// out-of-range page shows the last one, as before. Without scripts every
// product is listed on one page (any collection link shows that same full
// list). Photographs are lazy-loaded.
import BaseLayout from "../../../layouts/BaseLayout.astro";
import DestinationCity from "../../../components/DestinationCity.astro";
import { CITY_PARAM, LOCATIONS_PATH, SERVICE_CITIES, findCity, serviceCityCount } from "../../../data/serviceCities";
import { CITY_SHOP_PAGE_SIZE, loadCityCatalogue, type CatalogueItem } from "../../../server/services/CityCatalogue";
import { cityEnquiryHref, cityProductEnquiryHref } from "../../../utils/cityEnquiry";
import { garlandEnquiryHref } from "../../../utils/garlandEnquiry";
import { QUOTE_ONLY_ENQUIRE_LABEL } from "../../../shared/quoteOnly";

export const prerender = true;

export function getStaticPaths() {
  return SERVICE_CITIES.filter((entry) => entry.serviceable).map((entry) => ({ params: { city: entry.slug } }));
}

const city = findCity(Astro.params.city ?? "")!;
const base = `${LOCATIONS_PATH}/${city.slug}/shop`;

const { collections, all } = await loadCityCatalogue();
const href = (id: string | null) => (id ? `${base}?collection=${encodeURIComponent(id)}` : base);
const origin = Astro.site ?? Astro.url;
const withCity = (path: string) => `${path}?${CITY_PARAM}=${city.slug}`;
const action = (item: CatalogueItem) =>
  item.code
    ? { href: garlandEnquiryHref({ code: item.code, quantity: 1, city: city.slug }), label: QUOTE_ONLY_ENQUIRE_LABEL }
    : { href: cityProductEnquiryHref({ name: item.name, url: new URL(item.path, origin).toString(), cityName: city.name, quoteOnly: item.quoteOnly, priceLabel: item.price }), label: item.quoteOnly ? QUOTE_ONLY_ENQUIRE_LABEL : "Order on WhatsApp" };

const heading = `All flowers and products for delivery in ${city.name}`;
const title = `Full Catalogue for Delivery in ${city.name} | Fresh Petals`;
const description = `Every bouquet, garland and pooja flower product available to order for delivery in ${city.name}. Availability, price and delivery details are confirmed on WhatsApp.`;
const primary = collections.filter((entry) => entry.primary);
const others = collections.filter((entry) => !entry.primary);
// What the script needs to show a collection: its label, its national page and its products in order.
const views = Object.fromEntries(collections.map((entry) => [entry.id, { label: entry.label, href: entry.href, garlands: entry.id.startsWith("garlands-"), keys: entry.items.map((item) => item.key) }]));
const shopData = JSON.stringify({ city: city.name, base, pageSize: CITY_SHOP_PAGE_SIZE, total: all.length, views, cities: serviceCityCount() }).replace(/</g, "\\u003c");
const chip = "inline-flex min-h-[44px] items-center gap-1 rounded-full border px-4 text-[13px] font-semibold transition";
const chipClass = (current: boolean) => [chip, current ? "border-ink bg-ink text-paper" : "border-line bg-paper text-ink hover:border-berry hover:text-berry"];
---

<BaseLayout title={title} description={description} image={all[0]?.image.src} showCategoryCarousel={false} noindex={true} canonical={base}>
  <main class="bg-ivory" data-city-context={city.slug} data-city-shop={city.slug} data-track-list={`city-shop:${city.slug}`}>
    <section class="px-5 py-10 md:px-8 md:py-14">
      <div class="mx-auto max-w-7xl">
        <nav aria-label="Breadcrumb">
          <p class="fp-eyebrow">
            <a href="/" class="hover:underline">Home</a> <span aria-hidden="true">/</span>
            <a href={LOCATIONS_PATH} class="hover:underline">Delivery cities</a> <span aria-hidden="true">/</span>
            <a href={`${LOCATIONS_PATH}/${city.slug}`} class="hover:underline">{city.name}</a> <span aria-hidden="true">/</span>
            <span aria-current="page">Shop</span>
          </p>
        </nav>

        <div class="mt-3 grid gap-8 md:grid-cols-[1.3fr_1fr] md:gap-14">
          <div>
            <h1 class="fp-h1" data-shop-heading>{heading}</h1>
            <p class="mt-4 max-w-2xl text-sm leading-7 text-moss md:text-base">
              <span data-shop-summary>{`The whole public catalogue: ${all.length} products in ${collections.length} collections.`}</span>
              {" "}Every product can be ordered for {city.name}; the catalogue is the same for each of the {serviceCityCount()} cities we take orders for. Availability for your date, the price and the delivery details are confirmed on WhatsApp before you pay.
            </p>
            <p class="mt-3 text-sm leading-7 text-moss" data-shop-about hidden>
              <span data-shop-about-note hidden>These groups sort the garland photographs for browsing; they are not a list of the flowers used. </span>
              <a href="" class="font-semibold text-ink underline underline-offset-4" data-shop-about-link></a>
            </p>
          </div>
          <div class="rounded-[18px] border border-line bg-paper p-5 md:self-start md:p-6">
            <h2 class="fp-serif text-lg text-ink">Ordering for {city.name}</h2>
            <p class="mt-2 text-sm leading-6 text-moss">Orders from this page are marked for {city.name}. You can change the recipient city here at any time.</p>
            <DestinationCity class="mt-4" label="Recipient city for your order" />
            <a href={cityEnquiryHref(city.name)} target="_blank" rel="noopener noreferrer" data-city-enquiry={city.slug} class="mt-4 inline-flex min-h-[44px] items-center justify-center rounded-full border border-ink px-5 text-sm font-semibold text-ink transition hover:bg-ink hover:text-paper">
              Ask about flowers for {city.name}
            </a>
          </div>
        </div>

        <nav aria-label={`Collections for ${city.name}`} class="mt-8" data-shop-collections>
          <ul class="flex flex-wrap gap-2">
            <li><a href={href(null)} class:list={chipClass(true)} aria-current="page" data-shop-collection="all">All products <span class="font-normal opacity-80">({all.length})</span></a></li>
            {primary.map((entry) => (
              <li><a href={href(entry.id)} class:list={chipClass(false)} data-shop-collection={entry.id}>{entry.label} <span class="font-normal opacity-80">({entry.items.length})</span></a></li>
            ))}
          </ul>
          {others.length > 0 && (
            <details class="mt-3" data-shop-more>
              <summary class="inline-flex min-h-[44px] cursor-pointer items-center text-sm font-semibold text-ink underline underline-offset-4">More collections ({others.length})</summary>
              <ul class="mt-3 flex flex-wrap gap-2">
                {others.map((entry) => (
                  <li><a href={href(entry.id)} class:list={chipClass(false)} data-shop-collection={entry.id}>{entry.label} <span class="font-normal opacity-80">({entry.items.length})</span></a></li>
                ))}
              </ul>
            </details>
          )}
        </nav>

        <p class="mt-8 text-sm text-moss" data-shop-range role="status">
          Showing all {all.length} products
        </p>

        <ul class="mt-4 grid grid-cols-2 gap-3 md:grid-cols-3 md:gap-5 lg:grid-cols-4" data-shop-grid>
          {all.map((item, index) => {
            const cta = action(item);
            return (
              <li data-shop-item={item.key}>
                <article class="shop-card group relative flex h-full flex-col overflow-hidden rounded-[18px] border border-line bg-paper" data-shop-card={item.key} data-quote-only={item.quoteOnly ? "true" : "false"}>
                  <div class:list={["relative bg-linen", item.image.contain ? "aspect-[4/5]" : "aspect-square"]}>
                    <img src={item.image.src} srcset={item.image.srcset} sizes={item.image.srcset ? "(min-width: 1024px) 23vw, (min-width: 768px) 31vw, 48vw" : undefined} width={item.image.width} height={item.image.height} alt={item.image.alt} loading={index < 4 ? "eager" : "lazy"} decoding="async" class:list={["absolute inset-0 h-full w-full", item.image.contain ? "object-contain" : "object-cover"]} />
                    {item.code && <span class="absolute left-2 top-2 rounded-full bg-paper/95 px-2.5 py-1 text-[10px] font-semibold tracking-[0.12em] text-ink">{item.code}</span>}
                  </div>
                  <div class="flex flex-1 flex-col px-3 pb-3 pt-2.5">
                    <h2 class="text-[14px] font-semibold leading-snug text-ink"><a href={withCity(item.path)} class="shop-card__link group-hover:text-berry">{item.name}</a></h2>
                    <p class="mt-1.5 text-[13px] font-semibold text-ink" data-shop-card-price>{item.price}</p>
                    <a href={cta.href} target="_blank" rel="noopener noreferrer" data-garland-quote={item.code} class="relative z-20 inline-flex min-h-[44px] items-center justify-center rounded-full bg-berry px-3 text-center text-[11px] font-semibold leading-tight text-white transition hover:bg-berry-deep" style="margin-top:auto;padding-top:0;margin-block-start:0.75rem">{cta.label}</a>
                  </div>
                </article>
              </li>
            );
          })}
        </ul>

        <nav aria-label="Pages" class="mt-10 flex flex-wrap items-center gap-2" data-shop-pages hidden data-chip-on={chipClass(true).join(" ")} data-chip-off={chipClass(false).join(" ")}></nav>
        <script type="application/json" id="fp-city-shop" set:html={shopData}></script>

        <p class="mt-10 max-w-3xl text-sm leading-7 text-moss">
          We do not promise same-day or timed delivery on this website, and delivery charges are not fixed here: both are confirmed for your address and date on WhatsApp. Photographs show our designs; they are not pictures of orders delivered in {city.name}.
          <> See <a href={`${LOCATIONS_PATH}/${city.slug}`} class="font-semibold text-ink underline underline-offset-4">flowers for {city.name}</a> and <a href="/guides" class="font-semibold text-ink underline underline-offset-4">our guides to choosing flowers</a>.</>
        </p>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .shop-card__link::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 10;
  }
  .shop-card__link:focus-visible {
    outline: none;
  }
  .shop-card:has(.shop-card__link:focus-visible) {
    outline: 2px solid var(--color-berry);
    outline-offset: 2px;
  }
</style>

<script>
  type View = { label: string; href: string; garlands: boolean; keys: string[] };
  type ShopData = { city: string; base: string; pageSize: number; total: number; views: Record<string, View>; cities: number };
  const data = JSON.parse(document.getElementById("fp-city-shop")?.textContent || "null") as ShopData | null;
  const grid = document.querySelector<HTMLElement>("[data-shop-grid]");
  if (data && grid) {
    const params = new URLSearchParams(location.search);
    const id = params.get("collection") ?? "";
    const view = Object.hasOwn(data.views, id) ? data.views[id] : null;
    const items = new Map([...grid.querySelectorAll<HTMLElement>("[data-shop-item]")].map((li) => [li.dataset.shopItem!, li]));
    const keys = view ? view.keys.filter((key) => items.has(key)) : [...items.keys()];
    const pages = Math.max(1, Math.ceil(keys.length / data.pageSize));
    const page = Math.min(pages, Math.max(1, Math.floor(Number(params.get("page"))) || 1));
    const shown = keys.slice((page - 1) * data.pageSize, page * data.pageSize);
    // Order and visibility: the collection's own order, one page of it.
    for (const li of items.values()) li.hidden = true;
    for (const key of shown) { const li = items.get(key)!; li.hidden = false; grid.append(li); }
    shown.slice(0, 4).forEach((key) => items.get(key)!.querySelector("img")?.setAttribute("loading", "eager"));
    const link = (collection: string | null, number = 1) => {
      const next = new URLSearchParams();
      if (collection) next.set("collection", collection);
      if (number > 1) next.set("page", String(number));
      return next.size ? `${data.base}?${next}` : data.base;
    };
    const label = view ? `${view.label} in ${data.city}` : `All flowers and products for delivery in ${data.city}`;
    document.querySelector("[data-shop-heading]")!.textContent = label;
    document.title = `${view ? view.label : "Full Catalogue"} for Delivery in ${data.city}${page > 1 ? `, page ${page}` : ""} | Fresh Petals`;
    const summary = document.querySelector("[data-shop-summary]");
    if (summary && view) summary.textContent = `All ${keys.length} ${keys.length === 1 ? "product" : "products"} in this collection.`;
    const about = document.querySelector<HTMLElement>("[data-shop-about]");
    if (about && view) {
      about.hidden = false;
      about.querySelector<HTMLElement>("[data-shop-about-note]")!.hidden = !view.garlands;
      const a = about.querySelector<HTMLAnchorElement>("[data-shop-about-link]")!;
      a.href = view.href;
      a.textContent = `About ${view.label.toLowerCase()}`;
    }
    const nav = document.querySelector<HTMLElement>("[data-shop-pages]")!;
    const on = nav.dataset.chipOn ?? "", off = nav.dataset.chipOff ?? "";
    for (const chip of document.querySelectorAll<HTMLAnchorElement>("[data-shop-collection]")) {
      const current = chip.dataset.shopCollection === (view ? id : "all");
      chip.className = current ? on : off;
      if (current) chip.setAttribute("aria-current", "page"); else chip.removeAttribute("aria-current");
      if (current && view && chip.closest("[data-shop-more]")) (chip.closest("[data-shop-more]") as HTMLDetailsElement).open = true;
    }
    const first = (page - 1) * data.pageSize + 1;
    document.querySelector("[data-shop-range]")!.textContent = keys.length ? `Showing ${first}–${first + shown.length - 1} of ${keys.length}${pages > 1 ? `, page ${page} of ${pages}` : ""}` : "Showing 0 of 0";
    if (pages > 1) {
      const make = (text: string, number: number, extra: Record<string, string> = {}) => {
        const a = document.createElement("a");
        a.href = link(view ? id : null, number);
        a.textContent = text;
        a.className = number === page && !extra.rel ? on : off;
        for (const [k, v] of Object.entries(extra)) a.setAttribute(k, v);
        return a;
      };
      const children: HTMLElement[] = [];
      if (page > 1) children.push(make("← Previous", page - 1, { rel: "prev" }));
      for (let number = 1; number <= pages; number++) {
        const a = make(String(number), number, { "aria-label": `Page ${number}` });
        if (number === page) a.setAttribute("aria-current", "page");
        children.push(a);
      }
      if (page < pages) children.push(make("Next →", page + 1, { rel: "next" }));
      nav.replaceChildren(...children);
      nav.hidden = false;
    }
  }
</script>
