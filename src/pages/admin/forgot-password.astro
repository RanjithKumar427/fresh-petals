---
import AdminLayout from "../../layouts/AdminLayout.astro";

export const prerender = false;

if (Astro.locals.admin) {
  return Astro.redirect("/admin/dashboard");
}

const error = Astro.url.searchParams.get("error");
const sent = Astro.url.searchParams.get("sent") === "1";
---

<AdminLayout title="Forgot password">
  <div class="flex min-h-screen items-center justify-center px-4">
    <div class="fp-card w-full max-w-sm p-8">
      <p class="fp-serif text-xl tracking-[0.12em] text-[#171717]">FreshPetals</p>
      <p class="fp-label mt-1 text-[#9B6B78]">Admin sign in</p>

      <h1 class="mt-6 text-[15px] font-semibold text-[#171717]">Forgot your password?</h1>
      <p class="mt-2 text-[13px] leading-6 text-[#66565D]">
        Enter your admin email and we'll send you a secure password reset link.
      </p>

      {
        error && (
          <p class="mt-4 rounded-lg bg-[#FBEAEE] px-3 py-2 text-[12px] text-[#7C243E]">{error}</p>
        )
      }

      {
        sent ? (
          <div class="mt-6">
            <p class="rounded-lg bg-[#F3FFF7] px-3 py-2.5 text-[13px] leading-6 text-[#075838]">
              If an account exists with this email, you'll receive a password reset link shortly.
            </p>

            <a
              href="/admin/login"
              class="mt-5 block text-center text-[11px] font-semibold uppercase tracking-[0.18em] text-[#7C243E] hover:underline"
            >
              Back to login
            </a>
          </div>
        ) : (
          <form
            method="post"
            action="/api/admin/auth/forgot-password"
            data-forgot-password-form
            class="mt-6 space-y-4"
          >
            <div>
              <label class="fp-label block text-[10px] text-[#66565D]" for="email">
                Email
              </label>
              <input
                id="email"
                name="email"
                type="email"
                required
                autocomplete="username"
                autofocus
                class="mt-1 w-full rounded-lg border border-[#D8D1D4] px-3 py-2.5 text-[14px] text-[#171717] outline-none focus:border-[#7C243E]"
              />
            </div>

            <button
              type="submit"
              data-forgot-password-submit
              class="w-full rounded-full bg-[#111111] py-3 text-[11px] font-bold uppercase tracking-[0.22em] text-white transition hover:bg-[#7C243E] disabled:cursor-not-allowed disabled:opacity-60"
            >
              Send reset link
            </button>

            <a
              href="/admin/login"
              class="block text-center text-[11px] font-semibold uppercase tracking-[0.18em] text-[#66565D] hover:text-[#7C243E] hover:underline"
            >
              Back to login
            </a>
          </form>
        )
      }
    </div>
  </div>
</AdminLayout>

<script>
  // Progressive-enhancement only: the form still works with JS disabled
  // (plain POST + redirect). This just prevents a double-tap on mobile
  // from firing two reset-email requests and gives visible feedback while
  // the request is in flight.
  const form = document.querySelector<HTMLFormElement>("[data-forgot-password-form]");
  const submitButton = document.querySelector<HTMLButtonElement>("[data-forgot-password-submit]");

  form?.addEventListener("submit", () => {
    if (!submitButton) return;
    submitButton.disabled = true;
    submitButton.textContent = "Sending…";
  });
</script>
