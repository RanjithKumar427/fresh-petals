---
// Recovery-link landing page. Three states, decided server-side:
//   1. done=1        -- password was just changed (AuthService.updatePassword
//                        already signed the recovery session out); show success.
//   2. valid session -- either a fresh ?code= just got exchanged, or a
//                        session cookie from an earlier exchange in this
//                        same visit is still good; show the new-password form.
//   3. neither        -- no exchangeable code and no session; show the
//                        invalid/expired state. The inline script below
//                        gets one more chance here: if this Supabase
//                        project's auth flow type is implicit rather than
//                        PKCE, the recovery tokens are sitting in the URL
//                        fragment, which only client-side JS can read.
import AdminLayout from "../../layouts/AdminLayout.astro";
import { AuthService } from "../../server/services/AuthService";

export const prerender = false;

if (Astro.locals.admin) {
  return Astro.redirect("/admin/dashboard");
}

const error = Astro.url.searchParams.get("error");
const done = Astro.url.searchParams.get("done") === "1";

let sessionValid = false;

if (!done) {
  const code = Astro.url.searchParams.get("code");
  if (code) {
    sessionValid = await AuthService.exchangeRecoveryCode(code, Astro.request, Astro.cookies);
  }
  if (!sessionValid) {
    sessionValid = await AuthService.hasSession(Astro.request, Astro.cookies);
  }
}
---

<AdminLayout title="Reset password">
  <div class="flex min-h-screen items-center justify-center px-4">
    <div class="fp-card w-full max-w-sm p-8">
      <p class="fp-serif text-xl tracking-[0.12em] text-[#171717]">FreshPetals</p>
      <p class="fp-label mt-1 text-[#9B6B78]">Admin sign in</p>

      {
        done ? (
          <div class="mt-6">
            <h1 class="text-[15px] font-semibold text-[#171717]">Password reset</h1>
            <p class="mt-3 rounded-lg bg-[#F3FFF7] px-3 py-2.5 text-[13px] leading-6 text-[#075838]">
              Your password has been reset successfully.
            </p>

            <a
              href="/admin/login"
              class="mt-5 block w-full rounded-full bg-[#111111] py-3 text-center text-[11px] font-bold uppercase tracking-[0.22em] text-white transition hover:bg-[#7C243E]"
            >
              Continue to Admin Login
            </a>
          </div>
        ) : sessionValid ? (
          <div class="mt-6">
            <h1 class="text-[15px] font-semibold text-[#171717]">Create a new password</h1>

            {error && (
              <p class="mt-4 rounded-lg bg-[#FBEAEE] px-3 py-2 text-[12px] text-[#7C243E]">{error}</p>
            )}

            <form
              method="post"
              action="/api/admin/auth/reset-password"
              data-reset-password-form
              class="mt-6 space-y-4"
            >
              <div>
                <label class="fp-label block text-[10px] text-[#66565D]" for="password">
                  New password
                </label>
                <input
                  id="password"
                  name="password"
                  type="password"
                  required
                  minlength="6"
                  autocomplete="new-password"
                  autofocus
                  class="mt-1 w-full rounded-lg border border-[#D8D1D4] px-3 py-2.5 text-[14px] text-[#171717] outline-none focus:border-[#7C243E]"
                />
              </div>

              <div>
                <label class="fp-label block text-[10px] text-[#66565D]" for="confirmPassword">
                  Confirm new password
                </label>
                <input
                  id="confirmPassword"
                  name="confirmPassword"
                  type="password"
                  required
                  minlength="6"
                  autocomplete="new-password"
                  class="mt-1 w-full rounded-lg border border-[#D8D1D4] px-3 py-2.5 text-[14px] text-[#171717] outline-none focus:border-[#7C243E]"
                />
              </div>

              <p data-reset-password-mismatch class="hidden text-[12px] text-[#7C243E]">
                Passwords do not match.
              </p>

              <button
                type="submit"
                data-reset-password-submit
                class="w-full rounded-full bg-[#111111] py-3 text-[11px] font-bold uppercase tracking-[0.22em] text-white transition hover:bg-[#7C243E] disabled:cursor-not-allowed disabled:opacity-60"
              >
                Reset password
              </button>
            </form>
          </div>
        ) : (
          <div class="mt-6" data-recovery-fallback>
            <h1 class="text-[15px] font-semibold text-[#171717]">Link expired</h1>
            <p class="mt-3 rounded-lg bg-[#FBEAEE] px-3 py-2.5 text-[13px] leading-6 text-[#7C243E]">
              This password reset link is invalid or has expired. Please request a new one.
            </p>

            <a
              href="/admin/forgot-password"
              class="mt-5 block w-full rounded-full bg-[#111111] py-3 text-center text-[11px] font-bold uppercase tracking-[0.22em] text-white transition hover:bg-[#7C243E]"
            >
              Request a new reset link
            </a>
          </div>
        )
      }
    </div>
  </div>
</AdminLayout>

<script>
  // Progressive enhancement #1: prevent a double-submit / show a loading
  // state, and block obviously-mismatched passwords before they ever hit
  // the server (the server re-validates the same thing regardless).
  const form = document.querySelector<HTMLFormElement>("[data-reset-password-form]");
  const submitButton = document.querySelector<HTMLButtonElement>("[data-reset-password-submit]");
  const mismatchNotice = document.querySelector<HTMLElement>("[data-reset-password-mismatch]");
  const passwordInput = document.querySelector<HTMLInputElement>("#password");
  const confirmInput = document.querySelector<HTMLInputElement>("#confirmPassword");

  form?.addEventListener("submit", (event) => {
    if (passwordInput && confirmInput && passwordInput.value !== confirmInput.value) {
      event.preventDefault();
      mismatchNotice?.classList.remove("hidden");
      return;
    }

    mismatchNotice?.classList.add("hidden");

    if (!submitButton) return;
    submitButton.disabled = true;
    submitButton.textContent = "Resetting…";
  });

  // Progressive enhancement #2: implicit-flow fallback. Only runs when the
  // server already decided this link looks invalid/expired (that branch is
  // the only place data-recovery-fallback exists) -- if Supabase actually
  // put the recovery tokens in the URL fragment instead of a ?code= query
  // param, the server never saw them (fragments aren't sent in HTTP
  // requests), but this script can read window.location.hash directly.
  // Bridges them into the same httpOnly session cookies the ?code= path
  // uses, then reloads without the fragment so the server-side check above
  // runs again and (this time) finds a valid session.
  const fallback = document.querySelector("[data-recovery-fallback]");
  if (fallback && window.location.hash.includes("type=recovery")) {
    const params = new URLSearchParams(window.location.hash.slice(1));
    const accessToken = params.get("access_token");
    const refreshToken = params.get("refresh_token");

    if (accessToken && refreshToken) {
      fetch("/api/admin/auth/recovery-session", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ access_token: accessToken, refresh_token: refreshToken }),
      })
        .then((response) => response.json())
        .then((result) => {
          if (result?.ok) {
            window.location.replace(window.location.pathname + window.location.search);
          }
        })
        .catch(() => {
          // Stays on the "link expired" state already rendered -- no
          // worse off than before this ran.
        });
    }
  }
</script>
