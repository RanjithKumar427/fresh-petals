---
import AdminLayout from "../../../../layouts/AdminLayout.astro";
import ProductEditor from "../../../../features/admin/productEditor/ProductEditor";
import { ProductService } from "../../../../server/services/ProductService";
import { CategoryService } from "../../../../server/services/CategoryService";
import { TaxonomyService } from "../../../../server/services/TaxonomyService";
import { isBouquet, editorialDrift, DRIFT_FIELD_LABELS, UNMAPPED_EDITORIAL_FIELDS, UNCOMPARED_EDITORIAL_FIELDS, DATABASE_DRIVEN_FIELDS } from "../../../../data/catalogueRange";
import { productCatalog } from "../../../../data/productCatalog";
import { loadAuthoritativePrices } from "../../../../server/services/ProductPricing";
import { isQuoteOnly } from "../../../../shared/quoteOnly";
import { loadPublicCatalogue, storefrontReadiness } from "../../../../server/services/PublicCatalogue";

export const prerender = false;

const id = Number(Astro.params.id);

if (!Number.isInteger(id)) {
  return Astro.redirect("/admin/products");
}

const product = await ProductService.get(id);
if (!product) {
  return Astro.redirect("/admin/products");
}

const [categoryList, occasions, moods, flowerTypes, uncategorized] = await Promise.all([
  CategoryService.list(),
  TaxonomyService.listOccasions(),
  TaxonomyService.listMoods(),
  TaxonomyService.listFlowerTypes(),
  CategoryService.getOrCreateUncategorized(),
]);
const categories = categoryList.map((category) => ({
  id: category.id,
  name: category.name,
  slug: category.slug,
}));
const uncategorizedCategoryId = uncategorized.id;

// Non-garland products: occasion help and storefront readiness follow this
// deployment's public catalogue (a dashboard status change reaches the
// storefront with the next deployment).
const publicCatalogue = product.garland ? [] : await loadPublicCatalogue().catch(() => []);
const readiness = product.garland ? null : await storefrontReadiness(product.slug);
const publicProduct = publicCatalogue.find((item) => item.slug === product.slug);
const liveOccasions = product.garland || !publicProduct ? null : isBouquet(publicProduct) ? "bouquet" : "catalogue";
// What waits for a deployment (price) and which dashboard edits the
// storefront doesn't show, compared field by field with the catalogue entry.
const catalogueEntry = productCatalog.find((item) => item.slug === product.slug);
const primaryImage = [...product.images].sort((a, b) => Number(b.isPrimary) - Number(a.isPrimary) || a.sortOrder - b.sortOrder)[0]?.url ?? null;
const drift = catalogueEntry
  ? editorialDrift(
      { slug: product.slug, status: product.status, name: product.name, category: categoryList.find((category) => category.id === product.categoryId)?.name ?? "", shortDescription: product.shortDescription ?? null, description: product.description ?? null, stemCount: product.stemCount ?? null, image: primaryImage },
      catalogueEntry
    ).map((entry) => ({ field: DRIFT_FIELD_LABELS[entry.field], ...(entry.deliberate ? { deliberate: entry.deliberate } : {}) }))
  : [];
const priceShown = !!catalogueEntry && !isQuoteOnly(catalogueEntry);
const deployedPrice = priceShown ? ((await loadAuthoritativePrices().catch(() => null))?.get(product.slug)?.sellingPrice ?? null) : null;
const storefront = readiness
  ? { ...readiness, deployedPrice, priceShown, drift, unmappedFields: [...UNMAPPED_EDITORIAL_FIELDS], uncomparedFields: [...UNCOMPARED_EDITORIAL_FIELDS], databaseFields: [...DATABASE_DRIVEN_FIELDS] }
  : null;

// Explicit mapping (rather than passing `product` straight through) keeps
// the server Product type's optional (`?:`) fields from leaking `undefined`
// into the client's ProductDraft, which declares them required-but-nullable.
const productDraft = {
  ...product,
  shortDescription: product.shortDescription ?? null,
  description: product.description ?? null,
  sellingPrice: product.sellingPrice ?? null,
  compareAtPrice: product.compareAtPrice ?? null,
  costPrice: product.costPrice ?? null,
  deliveryChargeOverride: product.deliveryChargeOverride ?? null,
  stemCount: product.stemCount ?? null,
  colourTheme: product.colourTheme ?? null,
  arrangementStyle: product.arrangementStyle ?? null,
  size: product.size ?? null,
  seoTitle: product.seoTitle ?? null,
  seoDescription: product.seoDescription ?? null,
  images: product.images.map((image) => ({ ...image, altText: image.altText ?? null })),
};
---

<AdminLayout title={product.name}>
  <ProductEditor
    client:load
    product={productDraft}
    categories={categories}
    occasions={occasions}
    moods={moods}
    flowerTypes={flowerTypes}
    uncategorizedCategoryId={uncategorizedCategoryId}
    liveOccasions={liveOccasions}
    storefront={storefront}
  />
</AdminLayout>
