---
import type { Product } from "../data/productCatalog";

type Props = {
  product: Product;
};

const { product } = Astro.props;

const whatsappNumber = "919652012274";

const addOns = [
  {
    id: "chocolates-addon",
    name: "Chocolates",
    priceLabel: "Add-on item",
  },
  {
    id: "premium-card-addon",
    name: "Premium Card",
    priceLabel: "Add-on item",
  },
  {
    id: "candle-diffuser-addon",
    name: "Candle / Diffuser",
    priceLabel: "Add-on item",
  },
  {
    id: "clear-glass-vase",
    name: "Clear Glass Vase",
    priceLabel: "From ₹399",
  },
  {
    id: "room-mist-flower-gift-addon",
    name: "Room Mist Gift Add-on",
    priceLabel: "Add-on item",
  },
];

const greetingCards = [
  "No card",
  "Birthday",
  "Anniversary",
  "Thank You",
  "I Am Sorry",
  "Congratulations",
  "Custom message",
];

const deliverySlots = [
  "Morning slot",
  "Afternoon slot",
  "Evening slot",
  "Express / urgent delivery",
  "Confirm manually on WhatsApp",
];
---

<section
  class="mt-6 rounded-[28px] border border-[#EEE5E8] bg-white p-5 shadow-[0_12px_34px_rgba(40,24,32,0.06)] md:p-6"
  data-product-options
  data-product-id={product.id}
  data-product-slug={product.slug}
  data-product-name={product.name}
  data-product-image={product.image}
  data-product-price-label={product.priceLabel}
  data-product-category={product.category}
  data-whatsapp-number={whatsappNumber}
>
  <div class="flex items-start justify-between gap-4">
    <div>
      <p class="text-[10px] font-semibold uppercase tracking-[0.28em] text-[#9B6B78]">
        Configure Order
      </p>

      <h2 class="mt-2 text-xl font-semibold text-[#171717]">
        Select delivery details & add-ons
      </h2>
    </div>

    <span class="rounded-full bg-[#FFF8FA] px-3 py-1 text-[10px] font-semibold uppercase tracking-[0.18em] text-[#7C243E]">
      WhatsApp confirmed
    </span>
  </div>

  <p class="mt-4 text-sm leading-7 text-[#66565D]">
    Add this product to cart with delivery date, slot, pincode, greeting card, message and optional add-ons.
    Final price and availability will still be confirmed on WhatsApp.
  </p>

  <div class="mt-6 grid gap-4 md:grid-cols-2">
    <label class="block">
      <span class="text-[11px] font-semibold uppercase tracking-[0.22em] text-[#171717]">
        Quantity
      </span>
      <input
        type="number"
        min="1"
        value="1"
        data-option-quantity
        class="mt-2 w-full rounded-2xl border border-[#EEE5E8] px-4 py-3 text-sm text-[#171717] outline-none transition focus:border-[#7C243E]"
      />
    </label>

    <label class="block">
      <span class="text-[11px] font-semibold uppercase tracking-[0.22em] text-[#171717]">
        Delivery Pincode
      </span>
      <input
        type="text"
        placeholder="Example: 500081"
        data-option-pincode
        class="mt-2 w-full rounded-2xl border border-[#EEE5E8] px-4 py-3 text-sm text-[#171717] outline-none transition focus:border-[#7C243E]"
      />
    </label>

    <label class="block">
      <span class="text-[11px] font-semibold uppercase tracking-[0.22em] text-[#171717]">
        Delivery Date
      </span>
      <input
        type="date"
        data-option-delivery-date
        class="mt-2 w-full rounded-2xl border border-[#EEE5E8] px-4 py-3 text-sm text-[#171717] outline-none transition focus:border-[#7C243E]"
      />
    </label>

    <label class="block">
      <span class="text-[11px] font-semibold uppercase tracking-[0.22em] text-[#171717]">
        Delivery Slot
      </span>
      <select
        data-option-delivery-slot
        class="mt-2 w-full rounded-2xl border border-[#EEE5E8] bg-white px-4 py-3 text-sm text-[#171717] outline-none transition focus:border-[#7C243E]"
      >
        <option value="">Select slot</option>
        {deliverySlots.map((slot) => <option value={slot}>{slot}</option>)}
      </select>
    </label>
  </div>

  <div class="mt-6">
    <p class="text-[11px] font-semibold uppercase tracking-[0.22em] text-[#171717]">
      Add-ons
    </p>

    <div class="mt-3 grid gap-3 md:grid-cols-2">
      {
        addOns.map((addOn) => (
          <label class="flex cursor-pointer items-start gap-3 rounded-2xl border border-[#EEE5E8] bg-[#FFF8FA] p-4 transition hover:border-[#7C243E]">
            <input
              type="checkbox"
              class="mt-1"
              data-option-addon
              data-addon-id={addOn.id}
              data-addon-name={addOn.name}
              data-addon-price-label={addOn.priceLabel}
            />
            <span>
              <span class="block text-sm font-semibold text-[#171717]">
                {addOn.name}
              </span>
              <span class="mt-1 block text-xs text-[#66565D]">
                {addOn.priceLabel}
              </span>
            </span>
          </label>
        ))
      }
    </div>
  </div>

  <div class="mt-6 grid gap-4 md:grid-cols-2">
    <label class="block">
      <span class="text-[11px] font-semibold uppercase tracking-[0.22em] text-[#171717]">
        Greeting Card
      </span>
      <select
        data-option-greeting-card
        class="mt-2 w-full rounded-2xl border border-[#EEE5E8] bg-white px-4 py-3 text-sm text-[#171717] outline-none transition focus:border-[#7C243E]"
      >
        {greetingCards.map((card) => <option value={card}>{card}</option>)}
      </select>
    </label>

    <label class="block">
      <span class="text-[11px] font-semibold uppercase tracking-[0.22em] text-[#171717]">
        Short Note
      </span>
      <input
        type="text"
        placeholder="Example: make it premium / soft pastel / urgent"
        data-option-note
        class="mt-2 w-full rounded-2xl border border-[#EEE5E8] px-4 py-3 text-sm text-[#171717] outline-none transition focus:border-[#7C243E]"
      />
    </label>
  </div>

  <label class="mt-6 block">
    <span class="text-[11px] font-semibold uppercase tracking-[0.22em] text-[#171717]">
      Personalized Message
    </span>
    <textarea
      rows="4"
      placeholder="Write message for card or WhatsApp confirmation..."
      data-option-message
      class="mt-2 w-full rounded-2xl border border-[#EEE5E8] px-4 py-3 text-sm leading-6 text-[#171717] outline-none transition focus:border-[#7C243E]"
    ></textarea>
  </label>

  <div class="mt-6 flex flex-col gap-3 sm:flex-row">
    <button
      type="button"
      data-configured-add-to-cart
      class:list={[
        "inline-flex items-center justify-center rounded-full px-7 py-4 text-[11px] font-bold uppercase tracking-[0.22em] transition",
        product.isAvailable
          ? "bg-[#7C243E] text-white hover:bg-[#111111]"
          : "pointer-events-none bg-[#D8D1D4] text-[#7A6E73]",
      ]}
    >
      {product.isAvailable ? "Add Configured Item" : "Unavailable"}
    </button>

    <button
      type="button"
      data-configured-whatsapp
      class="inline-flex items-center justify-center rounded-full border border-[#075838] px-7 py-4 text-[11px] font-bold uppercase tracking-[0.22em] text-[#075838] transition hover:bg-[#075838] hover:text-white"
    >
      Confirm on WhatsApp
    </button>

    <a
      href="/cart"
      class="inline-flex items-center justify-center rounded-full border border-[#111111] px-7 py-4 text-[11px] font-bold uppercase tracking-[0.22em] text-[#111111] transition hover:bg-[#111111] hover:text-white"
    >
      View Cart
    </a>
  </div>

  <p
    data-configured-feedback
    class="mt-4 hidden rounded-full bg-[#F3FFF7] px-4 py-3 text-center text-sm font-semibold text-[#075838]"
  >
    Configured item added to cart.
  </p>
</section>

<script>
  import { addToCart } from "../utils/cart";

  const optionsSection = document.querySelector("[data-product-options]");

  function getInputValue(selector: string) {
    const input = optionsSection?.querySelector(selector) as HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement | null;
    return input?.value?.trim() || "";
  }

  function getSelectedAddOns() {
    const selectedAddOns = Array.from(
      optionsSection?.querySelectorAll("[data-option-addon]:checked") || []
    ) as HTMLInputElement[];

    return selectedAddOns.map((input) => ({
      id: input.dataset.addonId || "",
      name: input.dataset.addonName || "",
      priceLabel: input.dataset.addonPriceLabel || "",
      quantity: 1,
    }));
  }

  function getConfiguredCartItem() {
    if (!optionsSection) return null;

    const section = optionsSection as HTMLElement;

    const quantityValue = Number(getInputValue("[data-option-quantity]"));
    const quantity = Number.isFinite(quantityValue) && quantityValue > 0 ? quantityValue : 1;

    return {
      quantity,
      item: {
        id: section.dataset.productId || "",
        productId: section.dataset.productId || "",
        slug: section.dataset.productSlug || "",
        name: section.dataset.productName || "",
        image: section.dataset.productImage || "",
        priceLabel: section.dataset.productPriceLabel || "",
        category: section.dataset.productCategory || "",
        deliveryDate: getInputValue("[data-option-delivery-date]"),
        deliverySlot: getInputValue("[data-option-delivery-slot]"),
        pincode: getInputValue("[data-option-pincode]"),
        addOns: getSelectedAddOns(),
        greetingCard: getInputValue("[data-option-greeting-card]"),
        message: getInputValue("[data-option-message]"),
        note: getInputValue("[data-option-note]"),
      },
    };
  }

  function buildWhatsAppMessage() {
    const configured = getConfiguredCartItem();

    if (!configured || !optionsSection) return "";

    const item = configured.item;
    const addOnsText =
      item.addOns && item.addOns.length > 0
        ? item.addOns.map((addOn) => `- ${addOn.name} (${addOn.priceLabel})`).join("\n")
        : "No add-ons selected";

    return [
      "Hi Fresh Petals, I want to confirm this flower order:",
      "",
      `Product: ${item.name}`,
      `Price: ${item.priceLabel}`,
      `Category: ${item.category}`,
      `Quantity: ${configured.quantity}`,
      `Pincode: ${item.pincode || "Not added"}`,
      `Delivery Date: ${item.deliveryDate || "Not selected"}`,
      `Delivery Slot: ${item.deliverySlot || "Not selected"}`,
      `Greeting Card: ${item.greetingCard || "Not selected"}`,
      "",
      "Add-ons:",
      addOnsText,
      "",
      `Message: ${item.message || "No message added"}`,
      `Note: ${item.note || "No extra note"}`,
      "",
      "Please confirm availability, final price and delivery possibility.",
    ].join("\n");
  }

  const addConfiguredButton = document.querySelector("[data-configured-add-to-cart]");
  const whatsappButton = document.querySelector("[data-configured-whatsapp]");
  const feedback = document.querySelector("[data-configured-feedback]");

  addConfiguredButton?.addEventListener("click", () => {
    const configured = getConfiguredCartItem();

    if (!configured) return;

    addToCart(configured.item, configured.quantity);

    feedback?.classList.remove("hidden");

    setTimeout(() => {
      feedback?.classList.add("hidden");
    }, 1800);
  });

  whatsappButton?.addEventListener("click", () => {
    if (!optionsSection) return;

    const section = optionsSection as HTMLElement;
    const whatsappNumber = section.dataset.whatsappNumber || "";
    const message = encodeURIComponent(buildWhatsAppMessage());

    window.open(`https://wa.me/${whatsappNumber}?text=${message}`, "_blank");
  });
</script>