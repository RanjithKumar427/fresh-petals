---
import type { Product } from "../data/productCatalog";

type Props = {
  product: Product;
};

const { product } = Astro.props;

const whatsappNumber = "919652012274";

const addOns = [
  {
    id: "chocolates-addon",
    name: "Chocolates",
    priceLabel: "Add-on item",
  },
  {
    id: "premium-card-addon",
    name: "Premium Card",
    priceLabel: "Add-on item",
  },
  {
    id: "candle-diffuser-addon",
    name: "Candle / Diffuser",
    priceLabel: "Add-on item",
  },
  {
    id: "clear-glass-vase",
    name: "Clear Glass Vase",
    priceLabel: "From ₹399",
  },
  {
    id: "room-mist-flower-gift-addon",
    name: "Room Mist Gift Add-on",
    priceLabel: "Add-on item",
  },
];

const deliverySlots = [
  "7 AM - 10 AM",
  "9 AM - 2 PM",
  "2 PM - 7 PM",
  "8 PM - 9 PM",
  "9 AM - 9 PM",
];

const greetingCards = [
  {
    id: "no-card",
    name: "No Card",
    image: "",
  },
  {
    id: "lovesongs",
    name: "LoveSongs",
    image: "/images/cards/lovesongs.jpg",
  },
  {
    id: "myfav",
    name: "MyFav",
    image: "/images/cards/myfav.jpg",
  },
  {
    id: "iloveu",
    name: "ILoveU",
    image: "/images/cards/iloveu.jpg",
  },
];
---

<section
  class="mt-7"
  data-product-options
  data-product-id={product.id}
  data-product-slug={product.slug}
  data-product-name={product.name}
  data-product-image={product.image}
  data-product-price-label={product.priceLabel}
  data-product-category={product.category}
  data-whatsapp-number={whatsappNumber}
>
  <!-- Delivery Info -->
  <div class="rounded-[22px] border border-[#EEE5E8] bg-[#FFF8FA] p-6">
    <div class="flex items-center gap-3">
      <svg class="h-5 w-5 shrink-0 text-[#7C243E]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 21s7-5.4 7-12a7 7 0 1 0-14 0c0 6.6 7 12 7 12z"></path>
        <circle cx="12" cy="9" r="2.4"></circle>
      </svg>
      <h2 class="text-[12px] font-semibold uppercase tracking-[0.28em] text-[#171717]">Delivery Info</h2>
    </div>

    <div class="mt-5 grid grid-cols-2 gap-5">
      <label>
        <span class="block text-[10px] font-semibold uppercase tracking-[0.28em] text-[#171717]">
          City
        </span>

        <div class="mt-3 border-b border-[#E5D6DC] pb-2 text-sm text-[#171717]">
          Hyderabad
          <span class="ml-1 underline">Change city</span>
        </div>
      </label>

      <label>
        <span class="block text-[10px] font-semibold uppercase tracking-[0.28em] text-[#171717]">
          Pin Code
        </span>

        <input
          type="text"
          inputmode="numeric"
          maxlength="6"
          placeholder="500072"
          data-option-pincode
          class="mt-2 w-full border-b border-[#E5D6DC] bg-transparent pb-2 text-sm text-[#171717] outline-none transition-colors focus:border-[#7C243E]"
        />
      </label>
    </div>

    <p
      data-delivery-status
      class="mt-4 rounded-2xl border border-[#EEE5E8] bg-white px-4 py-2 text-center text-sm text-[#66565D]"
    >
      Enter your pincode to check delivery
    </p>
  </div>

  <!-- Date -->
  <div class="mt-7">
    <label class="block">
      <span class="block text-[10px] font-semibold uppercase tracking-[0.28em] text-[#171717]">
        Select Date of Delivery
      </span>

      <input
        type="date"
        data-option-delivery-date
        class="mt-3 w-full max-w-[180px] rounded-full border border-[#E5D6DC] bg-white px-4 py-2 text-sm text-[#171717] outline-none transition-colors focus:border-[#7C243E]"
      />
    </label>
  </div>

  <!-- Time -->
  <div class="mt-7 hidden" data-delivery-slot-panel>
    <p class="text-[10px] font-semibold uppercase tracking-[0.28em] text-[#171717]">
      Select Preferred Delivery Time
    </p>

    <div class="mt-3 space-y-2">
      {
        deliverySlots.map((slot) => (
          <label class="block">
            <input
              type="radio"
              name={`delivery-slot-${product.id}`}
              value={slot}
              data-option-delivery-slot
              class="peer sr-only"
            />

            <span class="block cursor-pointer rounded-2xl border border-[#E5D6DC] px-4 py-2 text-center text-xs tracking-[0.16em] text-[#171717] transition-colors peer-checked:border-[#7C243E] peer-checked:bg-[#FFF3F6]">
              {slot} (+ ₹0)
            </span>
          </label>
        ))
      }
    </div>
  </div>

  <!-- Add-ons -->
  <details class="mt-7 border-t border-[#EFEFEF] pt-5">
    <summary class="cursor-pointer list-none text-[10px] font-semibold uppercase tracking-[0.28em] text-[#171717]">
      Select Add-ons
    </summary>

    <div class="mt-4 grid gap-3 sm:grid-cols-2">
      {
        addOns.map((addOn) => (
          <label class="flex cursor-pointer items-start gap-3 rounded-2xl border border-[#EEE5E8] p-3 transition-colors has-[:checked]:border-[#7C243E] has-[:checked]:bg-[#FFF8FA]">
            <input
              type="checkbox"
              class="mt-1 accent-[#7C243E]"
              data-option-addon
              data-addon-id={addOn.id}
              data-addon-name={addOn.name}
              data-addon-price-label={addOn.priceLabel}
            />

            <span>
              <span class="block text-sm font-semibold text-[#171717]">
                {addOn.name}
              </span>
              <span class="block text-xs text-[#66565D]">
                {addOn.priceLabel}
              </span>
            </span>
          </label>
        ))
      }
    </div>
  </details>

  <!-- Greeting Cards -->
  <div class="mt-7">
    <p class="text-[10px] font-semibold uppercase tracking-[0.28em] text-[#171717]">
      Select Greeting Card
    </p>

    <div class="mt-4 grid grid-cols-3 gap-3">
      {
        greetingCards
          .filter((card) => card.id !== "no-card")
          .map((card) => (
            <label class="cursor-pointer">
              <input
                type="radio"
                name={`greeting-card-${product.id}`}
                value={card.name}
                data-option-greeting-card
                class="peer sr-only"
              />

              <span class="block rounded-2xl border border-[#EEE5E8] p-2 transition-colors peer-checked:border-[#7C243E]">
                <img
                  src={card.image}
                  alt={card.name}
                  class="aspect-[3/4] w-full rounded-xl object-cover"
                  loading="lazy"
                  decoding="async"
                />

                <span class="mt-2 block text-center text-[10px] uppercase tracking-[0.28em] text-[#171717]">
                  {card.name}
                </span>
              </span>
            </label>
          ))
      }
    </div>

    <label class="mt-3 flex items-center gap-2 text-sm text-[#66565D]">
      <input
        type="radio"
        name={`greeting-card-${product.id}`}
        value="No card"
        data-option-greeting-card
        class="accent-[#7C243E]"
        checked
      />
      No greeting card
    </label>
  </div>

  <!-- Message -->
  <label class="mt-7 block">
    <span class="block text-[10px] font-semibold uppercase tracking-[0.28em] text-[#171717]">
      Personalised Message
    </span>

    <textarea
      rows="4"
      placeholder="Send a personalized message 😊"
      data-option-message
      class="mt-3 w-full rounded-2xl border border-[#E5D6DC] bg-white px-4 py-3 text-sm leading-6 text-[#171717] outline-none transition-colors focus:border-[#7C243E]"
    ></textarea>
  </label>

  <input type="hidden" data-option-quantity value="1" />
  <input type="hidden" data-option-note value="" />

  <!-- Add to Cart -->
  <button
    type="button"
    data-configured-add-to-cart
    class:list={[
      "mt-7 w-full bg-[#111111] px-7 py-4 text-[11px] font-bold uppercase tracking-[0.28em] text-white transition duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] active:scale-[0.98] hover:bg-[#7C243E]",
      !product.isAvailable && "pointer-events-none bg-[#D8D1D4] text-[#7A6E73]",
    ]}
  >
    {product.isAvailable ? "Add to Cart" : "Unavailable"}
  </button>

  <button
    type="button"
    data-configured-whatsapp
    class="mt-3 w-full bg-[#075838] px-7 py-4 text-[11px] font-bold uppercase tracking-[0.28em] text-white transition duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] active:scale-[0.98] hover:bg-[#7C243E]"
  >
    Confirm on WhatsApp
  </button>

  <p
    data-configured-feedback
    class="mt-4 hidden bg-[#F3FFF7] px-4 py-3 text-center text-sm font-semibold text-[#075838]"
  >
    Product added to cart.
  </p>
</section>

<script>
  import { addToCart } from "../utils/cart";

  const optionsSection = document.querySelector("[data-product-options]");

  function getInputValue(selector: string) {
    const input = optionsSection?.querySelector(selector) as
      | HTMLInputElement
      | HTMLSelectElement
      | HTMLTextAreaElement
      | null;

    return input?.value?.trim() || "";
  }

  function getRadioValue(selector: string) {
    const input = optionsSection?.querySelector(`${selector}:checked`) as
      | HTMLInputElement
      | null;

    return input?.value?.trim() || "";
  }

  function getSelectedAddOns() {
    const selectedAddOns = Array.from(
      optionsSection?.querySelectorAll("[data-option-addon]:checked") || []
    ) as HTMLInputElement[];

    return selectedAddOns.map((input) => ({
      id: input.dataset.addonId || "",
      name: input.dataset.addonName || "",
      priceLabel: input.dataset.addonPriceLabel || "",
      quantity: 1,
    }));
  }

  function getConfiguredCartItem() {
    if (!optionsSection) return null;

    const section = optionsSection as HTMLElement;

    return {
      quantity: 1,
      item: {
        id: section.dataset.productId || "",
        productId: section.dataset.productId || "",
        slug: section.dataset.productSlug || "",
        name: section.dataset.productName || "",
        image: section.dataset.productImage || "",
        priceLabel: section.dataset.productPriceLabel || "",
        category: section.dataset.productCategory || "",
        deliveryDate: getInputValue("[data-option-delivery-date]"),
        deliverySlot: getRadioValue("[data-option-delivery-slot]"),
        pincode: getInputValue("[data-option-pincode]"),
        addOns: getSelectedAddOns(),
        greetingCard: getRadioValue("[data-option-greeting-card]") || "No card",
        message: getInputValue("[data-option-message]"),
        note: "",
      },
    };
  }

  function buildWhatsAppMessage() {
    const configured = getConfiguredCartItem();

    if (!configured || !optionsSection) return "";

    const item = configured.item;

    const addOnsText =
      item.addOns && item.addOns.length > 0
        ? item.addOns
            .map((addOn) => `- ${addOn.name} (${addOn.priceLabel})`)
            .join("\n")
        : "No add-ons selected";

    return [
      "Hi Fresh Petals, I want to confirm this flower order:",
      "",
      `Product: ${item.name}`,
      `Price: ${item.priceLabel}`,
      `Category: ${item.category}`,
      `Pincode: ${item.pincode || "Not added"}`,
      `Delivery Date: ${item.deliveryDate || "Not selected"}`,
      `Delivery Slot: ${item.deliverySlot || "Not selected"}`,
      `Greeting Card: ${item.greetingCard || "No card"}`,
      "",
      "Add-ons:",
      addOnsText,
      "",
      `Message: ${item.message || "No message added"}`,
      "",
      "Please confirm availability, final price and delivery possibility.",
    ].join("\n");
  }

  const deliveryDateInput = optionsSection?.querySelector(
    "[data-option-delivery-date]"
  ) as HTMLInputElement | null;

  const deliverySlotPanel = optionsSection?.querySelector(
    "[data-delivery-slot-panel]"
  ) as HTMLElement | null;

  deliveryDateInput?.addEventListener("change", () => {
    if (!deliverySlotPanel) return;

    if (deliveryDateInput.value) {
      deliverySlotPanel.classList.remove("hidden");
    } else {
      deliverySlotPanel.classList.add("hidden");
    }
  });

  const addConfiguredButton = document.querySelector("[data-configured-add-to-cart]");
  const whatsappButton = document.querySelector("[data-configured-whatsapp]");
  const feedback = document.querySelector("[data-configured-feedback]");

  addConfiguredButton?.addEventListener("click", () => {
    const configured = getConfiguredCartItem();

    if (!configured) return;

    addToCart(configured.item, configured.quantity);

    feedback?.classList.remove("hidden");

    setTimeout(() => {
      feedback?.classList.add("hidden");
    }, 1800);
  });

  whatsappButton?.addEventListener("click", () => {
    if (!optionsSection) return;

    const section = optionsSection as HTMLElement;
    const whatsappNumber = section.dataset.whatsappNumber || "";
    const message = encodeURIComponent(buildWhatsAppMessage());

    window.open(`https://wa.me/${whatsappNumber}?text=${message}`, "_blank");
  });
</script>

<script is:inline>
  const deliveryPincodeInput = document.querySelector("[data-option-pincode]");
  const deliveryStatus = document.querySelector("[data-delivery-status]");

  const DELIVERY_STATUS_BASE_CLASS =
    "mt-4 rounded-2xl border px-4 py-2 text-center text-sm";

  // Delivery Capability Engine milestone — this used to look up a
  // locally-embedded copy of service-area data (its own separate
  // duplicate of the same logic in cart.astro and DeliveryChecker.astro).
  // Now it asks the same authoritative DeliveryService every other
  // delivery-aware surface in the app calls. This is a pure SERVICEABILITY
  // question (pincode only, no date/method) — see
  // DeliveryService.checkServiceability's own comment for why that's
  // deliberately a separate question from "what can be promised".
  let requestToken = 0;

  async function updateDeliveryStatus() {
    if (!deliveryStatus) return;

    const pincode = deliveryPincodeInput?.value.trim() || "";

    if (!/^[0-9]{6}$/.test(pincode)) {
      deliveryStatus.textContent = "Enter your pincode to check delivery";
      deliveryStatus.className = `${DELIVERY_STATUS_BASE_CLASS} border-[#EEE5E8] bg-white text-[#66565D]`;
      return;
    }

    const thisRequest = ++requestToken;

    try {
      const response = await fetch("/api/delivery/check", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ pincode }),
      });
      const result = await response.json();

      // The customer may have kept typing (or cleared the field) while
      // this request was in flight — only the most recent request should
      // ever get to update the status line.
      if (thisRequest !== requestToken) return;

      if (response.ok && result?.ok && result.data?.serviceable) {
        deliveryStatus.textContent = `Delivery available in ${result.data.area} • ₹${result.data.fee} delivery fee`;
        deliveryStatus.className = `${DELIVERY_STATUS_BASE_CLASS} border-[#B9D8C6] bg-[#F3FFF7] text-[#075838]`;
      } else {
        deliveryStatus.textContent = "We'll confirm delivery for this pincode on WhatsApp";
        deliveryStatus.className = `${DELIVERY_STATUS_BASE_CLASS} border-[#E7B7C0] bg-[#FFF3F5] text-[#7C243E]`;
      }
    } catch {
      if (thisRequest !== requestToken) return;
      deliveryStatus.textContent = "We'll confirm delivery for this pincode on WhatsApp";
      deliveryStatus.className = `${DELIVERY_STATUS_BASE_CLASS} border-[#E7B7C0] bg-[#FFF3F5] text-[#7C243E]`;
    }
  }

  deliveryPincodeInput?.addEventListener("input", updateDeliveryStatus);
</script>