---
// Smallest Homepage Discovery Layer milestone — a single, clearly-labeled
// "what are you looking for?" moment for customers who don't already know
// exactly what to search or which category to open. Deliberately not a new
// discovery backend: every card below links straight into the existing,
// already-live, already Postgres-price-integrated /occasions/[slug].astro
// pages (see that file) or an existing curated category — nothing here
// queries or filters anything itself.
//
// Occasion was chosen over mood/color/recipient/budget after auditing the
// real data: every one of FreshPetals' 89 products carries at least one
// occasion tag (100% coverage, verified directly against both the
// PostgreSQL product_occasions table and this same occasionTags field),
// while mood metadata only covers ~43% of products with one mood value
// (Cheerful) tagged on zero products, colour_theme is unpopulated for
// every product, and no recipient taxonomy exists anywhere in the schema.
// Building chips around any of those would risk an empty result — the six
// entries below are the six occasions/collections with the strongest real
// product counts (61/38/51/17/9 tagged products respectively, verified
// against productCatalog.ts's occasionTags, matching the live
// /occasions/[slug] pages exactly) plus one existing curated category for
// the "I don't know what I want" customer, not an invented list.
//
// This mirrors RoundCategoryCarousel's already-live Anniversary/Birthday/
// Wedding icons (also visible on mobile) rather than duplicating a second
// occasion system — the difference is framing: that carousel is a dense,
// unlabeled quick-nav strip mixed with unrelated categories sitting above
// the hero, so a first-time visitor has no reason to read it as "help me
// decide". This section is the one deliberate, explicitly-labeled
// discovery moment the homepage didn't have, placed after the hero and
// area selector so flowers are seen first, exactly like every other
// homepage section already does.
const discoveryOptions = [
  {
    label: "Birthday",
    emoji: "🎂",
    subtitle: "61 options",
    image: "/images/occasion-birthday.jpg",
    href: "/occasions/birthday",
  },
  {
    label: "Anniversary",
    emoji: "💕",
    subtitle: "38 options",
    image: "/images/cat-anniversary.jpg",
    href: "/occasions/anniversary",
  },
  {
    label: "Thank You",
    emoji: "💛",
    subtitle: "51 options",
    image: "/images/rose-bouquet.jpg",
    href: "/occasions/thank-you",
  },
  {
    label: "Pooja",
    emoji: "🪷",
    subtitle: "17 options",
    image: "/images/occasion-pooja.jpg",
    href: "/occasions/pooja",
  },
  {
    label: "Wedding",
    emoji: "💍",
    subtitle: "9 options",
    image: "/images/occasion-wedding.jpg",
    href: "/occasions/wedding",
  },
  {
    label: "Something Beautiful",
    emoji: "✨",
    subtitle: "Bestselling bouquets",
    image: "/images/bouquet-1.jpg",
    href: "/categories/bestselling-bouquets",
  },
];
---

<section class="border-b border-[#EEE5E8] bg-[#FFF8FA] px-5 py-12 md:px-8 md:py-14" aria-labelledby="find-your-flowers-heading">
  <div class="mx-auto max-w-7xl">
    <div class="mb-7 text-center">
      <p class="fp-eyebrow">
        Not sure where to start?
      </p>

      <h2 id="find-your-flowers-heading" class="fp-h2 mt-2">
        Find Your Flowers
      </h2>

      <p class="mx-auto mt-3 max-w-xl text-sm leading-6 text-[#66565D]">
        A few easy ways to find the right flowers for the moment.
      </p>
    </div>

    <div class="fp-scrollbar-hide -mx-5 flex gap-4 overflow-x-auto px-5 md:mx-0 md:grid md:grid-cols-6 md:gap-5 md:overflow-visible md:px-0">
      {
        discoveryOptions.map((option) => (
          <a
            href={option.href}
            class="group block w-[128px] shrink-0 text-center md:w-auto"
            aria-label={`Find flowers for ${option.label}`}
          >
            <div class="aspect-square w-full overflow-hidden rounded-[20px] bg-[#F8F1F3]">
              <img
                src={option.image}
                alt=""
                loading="lazy"
                decoding="async"
                class="h-full w-full object-cover transition duration-700 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:scale-105"
              />
            </div>

            <p class="mt-3 text-[12px] font-semibold uppercase tracking-[0.16em] text-[#171717] transition group-hover:text-[#7C243E]">
              {option.label} <span aria-hidden="true">{option.emoji}</span>
            </p>

            <p class="mt-0.5 text-[11px] text-[#9B8A90]">
              {option.subtitle}
            </p>
          </a>
        ))
      }
    </div>
  </div>
</section>
