---
// Deep Discovery Redesign milestone — rebuilt from the prior image-card
// version (Smallest Homepage Discovery Layer / Phase B). The product owner's
// explicit feedback was that the homepage still read as ecommerce, not
// discovery; auditing this section against that feedback, the image-card
// grid with a serif heading, eyebrow, subtitle and "N options" counts was
// itself part of the problem — it read as a small product-category section,
// not a lightweight topic row. Xiaohongshu's own top-of-feed topic
// navigation is plain text, one row, one quiet active/hover state, no
// imagery and no inventory counts — this rebuild matches that: no heading
// (removing an "interrupting section heading" the brief explicitly called
// out), no images, no "options" metadata, just the topic labels themselves.
//
// Data/routing is unchanged from Phase B and still fully real: every entry
// links straight into the existing, live, Postgres-price-integrated
// /occasions/[slug].astro pages (see that file) or an existing curated
// category. Occasion remains the strongest available discovery signal —
// 100% of products carry at least one occasion tag, verified against both
// PostgreSQL's product_occasions table and this same occasionTags field —
// see the prior revision's header comment (still true, not re-derived) for
// why mood/color/recipient/budget chips were not built.
const discoveryOptions = [
  { label: "Birthday", emoji: "🎂", href: "/occasions/birthday" },
  { label: "Anniversary", emoji: "💕", href: "/occasions/anniversary" },
  { label: "Thank You", emoji: "💛", href: "/occasions/thank-you" },
  { label: "Pooja", emoji: "🪷", href: "/occasions/pooja" },
  { label: "Wedding", emoji: "💍", href: "/occasions/wedding" },
  { label: "Something Beautiful", emoji: "✨", href: "/categories/bestselling-bouquets" },
];
---

<section class="border-b border-[#F3EEEF] bg-white px-5 py-3 md:px-8" aria-label="Discover flowers by occasion">
  <div class="mx-auto max-w-7xl">
    <div class="fp-scrollbar-hide flex items-center gap-5 overflow-x-auto">
      {
        discoveryOptions.map((option) => (
          <a
            href={option.href}
            class="shrink-0 whitespace-nowrap py-1 text-[13px] text-[#44383D] transition hover:text-[#7C243E]"
            aria-label={`Find flowers for ${option.label}`}
          >
            {option.label} <span aria-hidden="true">{option.emoji}</span>
          </a>
        ))
      }
    </div>
  </div>
</section>
