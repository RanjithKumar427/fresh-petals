---
// Complete Homepage Visual Consistency milestone — not in the brief's
// explicit list of seven, but found during Step 1's mandated audit
// ("search the homepage for every use of ProductCard") — also used the
// shared ecommerce card, which would have left one more visual break in
// an otherwise fully-converted homepage. Same conversion pattern applied
// for the same "the entire homepage must feel like one product" reason.
import DiscoveryPostCard from "./DiscoveryPostCard.astro";
import { productCatalog } from "../data/productCatalog";
import { loadAuthoritativePrices, withAuthoritativePrice } from "../server/services/ProductPricing";

const priceMap = await loadAuthoritativePrices();

const subscriptions = productCatalog
  .filter((product) => product.category === "Subscriptions")
  .map((product) => withAuthoritativePrice(product, priceMap));
---

<section id="subscription-products" class="bg-[#F5F5F5] px-3 pb-8 pt-5 md:px-6 md:pb-12">
  <div class="mx-auto max-w-7xl">
    <div class="mb-3 flex items-baseline justify-between px-0.5">
      <h2 class="text-[15px] font-medium text-black/80">
        Flower Subscriptions
      </h2>

      <a
        href="/categories/subscriptions"
        class="group inline-flex items-center gap-1 text-[12px] text-black/45 transition hover:text-[#FF2442]"
      >
        View all
        <span aria-hidden="true" class="transition group-hover:translate-x-0.5">→</span>
      </a>
    </div>

    <div class="columns-2 gap-2 md:columns-3 md:gap-2.5 lg:columns-4 xl:columns-5">
      {
        subscriptions.map((product) => (
          <DiscoveryPostCard
            slug={product.slug}
            name={product.name}
            image={product.image}
            description={product.description}
            category={product.category}
            priceLabel={product.priceLabel}
          />
        ))
      }
    </div>
  </div>
</section>
