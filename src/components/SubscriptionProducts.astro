---
import ProductCard from "./ProductCard.astro";
import { productCatalog } from "../data/productCatalog";
import { loadAuthoritativePrices, withAuthoritativePrice } from "../server/services/ProductPricing";

const priceMap = await loadAuthoritativePrices();

const subscriptions = productCatalog
  .filter((product) => product.category === "Subscriptions")
  .map((product) => withAuthoritativePrice(product, priceMap));
---

<section id="subscription-products" class="bg-white px-5 py-14 md:px-8 md:py-16">
  <div class="mx-auto max-w-7xl">
    <div class="mb-9 text-center">
      <p class="fp-eyebrow">
        Fresh Petals Hyderabad
      </p>

      <h2 class="fp-h2 mt-3">
        Flower Subscriptions
      </h2>

      <p class="mx-auto mt-4 max-w-2xl text-sm leading-7 text-[#66565D]">
        Recurring flower plans for pooja, jasmine, home styling and custom flower needs.
      </p>
    </div>

    <div class="grid grid-cols-2 gap-4 md:grid-cols-3 lg:grid-cols-4">
      {
        subscriptions.map((product) => (
          <ProductCard
            name={product.name}
            image={product.image}
            priceLabel={product.priceLabel}
            priceType={product.priceType}
            category={product.category}
            description={product.description}
            slug={product.slug}
            isAvailable={product.isAvailable}
          />
        ))
      }
    </div>

    <div class="mt-12 flex justify-center">
      <a
        href="/categories/subscriptions"
        class="fp-btn-block"
      >
        View All Subscriptions
      </a>
    </div>
  </div>
</section>