---
import { loadAuthoritativePrices } from "../server/services/ProductPricing";

// Starting price comes from the database (the same price the subscription's
// own product page shows) rather than a hardcoded figure: the old "₹299"
// here contradicted that page's database price.
const dailyPoojaSubscriptionPrice =
  (await loadAuthoritativePrices()).get("daily-pooja-flower-subscription")?.sellingPrice ?? null;

const occasions = [
  {
    title: "Delivery Info",
    subtitle: "In Bengaluru",
    image: "/images/banner-bouquet.jpg",
    href: "/shipping",
  },
  {
    title: "Birthday Collection",
    subtitle: "Fresh bouquets",
    image: "/images/cat-birthday.jpg",
    href: "/occasions/birthday",
  },
  {
    title:
      dailyPoojaSubscriptionPrice !== null
        ? `Subscription Starting At ₹${dailyPoojaSubscriptionPrice}`
        : "Pooja Flower Subscription",
    subtitle: "Daily pooja flowers",
    image: "/images/occasion-event.jpg",
    href: "/categories/subscriptions",
  },
];
---

<section id="occasions" class="bg-paper px-5 py-14 md:px-8 md:py-16">
  <div class="mx-auto max-w-7xl">
    <div class="grid grid-cols-2 gap-x-5 gap-y-10 md:grid-cols-4 md:gap-x-7 md:gap-y-12">
      {
        occasions.map((item) => (
          <a
            href={item.href}
            class="group block text-center"
            aria-label={`View ${item.title}`}
          >
            <div class="relative aspect-square w-full overflow-hidden bg-linen">
              <img
                src={item.image}
                alt={item.title}
                class="h-full w-full object-cover transition duration-700 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:scale-105"
                loading="lazy"
                decoding="async"
              />
            </div>

            <div class="pt-4 text-center">
              <h3 class="min-h-9 text-[10px] font-semibold uppercase leading-5 tracking-[0.18em] text-ink transition group-hover:text-rose-deep md:text-[11px] md:tracking-[0.22em]">
                {item.title}
              </h3>

              <p class="mt-1 text-[10px] font-medium uppercase tracking-[0.18em] text-moss">
                {item.subtitle}
              </p>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>