 ---
const whatsappNumber = "919652012274";

const whatsappMessage = encodeURIComponent(
  "Hi Fresh Petals, I want to know about daily pooja flower subscription in Hyderabad."
);
---

<section id="subscriptions" class="bg-white px-5 py-14 md:px-8 md:py-16">
  <div class="mx-auto max-w-7xl">
    <div class="relative overflow-hidden">
      <img
        src="/images/subscription-banner.jpg"
        alt="Fresh Petals flower subscription"
        class="absolute inset-0 h-full w-full object-cover"
        loading="lazy"
      />

      <div class="absolute inset-0 bg-black/15"></div>

      <div class="relative z-10 flex min-h-[420px] items-center px-5 py-10 md:min-h-[500px] md:px-14 md:py-14">
        <div class="max-w-[360px] border border-[#171717] bg-white/95 p-7 backdrop-blur-sm md:max-w-[420px] md:p-10">
          <p class="text-[10px] font-semibold uppercase tracking-[0.28em] text-[#77706f] md:text-[11px]">
            Starting at ₹299
          </p>

          <h2 class="fp-serif mt-3 text-3xl uppercase leading-tight text-[#171717] md:text-4xl">
            Daily Pooja Flower Subscription
          </h2>

          <p class="mt-5 text-sm leading-7 text-[#555] md:text-[15px]">
            Fresh flowers for your morning pooja, delivered regularly across Hyderabad.
            Choose daily or weekly flower plans directly on WhatsApp.
          </p>

          <p class="mt-5 text-[10px] uppercase tracking-[0.22em] text-[#77706f] md:text-[11px]">
            Fresh Petals Hyderabad
          </p>

          <div class="mt-7">
            <a
              href={`https://wa.me/${whatsappNumber}?text=${whatsappMessage}`}
              class="inline-flex items-center justify-center bg-[#171717] px-7 py-3 text-[11px] font-bold uppercase tracking-[0.24em] text-white transition hover:bg-[#E8A7B8] hover:text-[#171717]"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Order flower subscription on WhatsApp"
            >
              Shop Now
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>