 ---
import { loadAuthoritativePrices } from "../server/services/ProductPricing";

const whatsappNumber = "919652012274";

// Starting price comes from the database (the same price the subscription's
// own product page shows) rather than a hardcoded figure: the old "₹299"
// here contradicted that page's database price.
const dailyPoojaSubscriptionPrice =
  (await loadAuthoritativePrices()).get("daily-pooja-flower-subscription")?.sellingPrice ?? null;

const whatsappMessage = encodeURIComponent(
  "Hi Fresh Petals, I want to know about daily pooja flower subscription in Bengaluru."
);
---

<section id="subscriptions" class="bg-paper px-5 py-14 md:px-8 md:py-16">
  <div class="mx-auto max-w-7xl">
    <div class="relative overflow-hidden">
      <img
        src="/images/banner-pooja.jpg"
        alt="Fresh Petals flower subscription"
        class="absolute inset-0 h-full w-full object-cover"
        loading="lazy"
      />

      <div class="absolute inset-0 bg-black/15"></div>

      <div class="relative z-10 flex min-h-[420px] items-center px-5 py-10 md:min-h-[500px] md:px-14 md:py-14">
        <div class="max-w-[360px] border border-ink bg-white/95 p-7 backdrop-blur-sm md:max-w-[420px] md:p-10">
          {dailyPoojaSubscriptionPrice !== null && (
            <p class="text-[10px] font-semibold uppercase tracking-[0.28em] text-moss md:text-[11px]">
              Starting at ₹{dailyPoojaSubscriptionPrice}
            </p>
          )}

          <h2 class="fp-serif mt-3 text-3xl leading-tight text-ink md:text-4xl">
            Daily Pooja Flower Subscription
          </h2>

          <p class="mt-5 text-sm leading-7 text-moss md:text-[15px]">
            Fresh flowers for your morning pooja, for homes in Bengaluru.
            Choose daily or weekly flower plans directly on WhatsApp.
          </p>

          <p class="mt-5 text-[10px] uppercase tracking-[0.22em] text-moss md:text-[11px]">
            Fresh Petals Bengaluru
          </p>

          <div class="mt-7">
            <a
              href={`https://wa.me/${whatsappNumber}?text=${whatsappMessage}`}
              class="fp-btn-whatsapp inline-flex items-center justify-center bg-ink px-7 py-3 text-[11px] font-bold uppercase tracking-[0.24em] text-white hover:bg-rose hover:text-ink"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Order flower subscription on WhatsApp"
            >
              Shop Now
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>