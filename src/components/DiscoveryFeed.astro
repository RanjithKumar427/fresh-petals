---
// Visual Discovery Homepage Redesign milestone — the "Pinterest/Xiaohongshu
// interaction philosophy, not the UI" piece the brief asked for: an
// image-dominant, varied-aspect-ratio feed built with a pure-CSS multi-column
// masonry (`columns-*` + `break-inside-avoid`), not a JS masonry library —
// no dependency, no client-side layout code at all. Every card is a single
// tap target straight to the real product page; no button stack, no badges,
// matching "TAP CARD -> product -> WhatsApp", not "View / Add / WhatsApp"
// competing on every card the way ProductCard.astro's list-page treatment
// does elsewhere (that component is intentionally left untouched — search,
// category and occasion pages keep exactly the card they already had).
//
// Products and images are 100% real, existing catalog entries — nothing
// fabricated. The selection deliberately draws from Bouquets and Lilies
// specifically: auditing the actual image assets found every bouquet/lily
// product has its own dedicated photograph (/images/bouquets/*, /images/
// lilies/*), while most other categories currently reuse a small set of
// generic category thumbnails across many products. A "beautiful visual
// discovery" feed built from repeated stock-style images would look broken,
// not premium — so this feed showcases the products whose photography can
// actually carry it, rather than forcing category variety the asset library
// doesn't yet support. Deliberately different products from ProductSection's
// existing curated 8 (blue-mountain-grace, red-affair, midnight-romance,
// rose-promise, sunshine-story, cotton-candy-poetry, snow-white-saga,
// rainbow-hug) so the page doesn't repeat itself a few sections later.
//
// Pricing: same authoritative adapter every other storefront surface uses
// (see ProductPricing.ts) -- no new query, no second price source.
import { productCatalog } from "../data/productCatalog";
import { loadAuthoritativePrices, withAuthoritativePrice } from "../server/services/ProductPricing";

const feedSlugs = [
  "cloud-nine-blue",
  "colour-pop-love",
  "cotton-candy",
  "country-love-note",
  "dear-sunshine",
  "lilac-garden",
  "peach-petal-promise",
  "wild-sunset-charm",
  "purple-crush",
  "white-silence",
  "luxe-lily-bloom",
  "stargazer-affair",
];

// A short, fixed rhythm of aspect ratios (not random) so the masonry reads
// as an intentional editorial layout rather than noise -- repeats every 4
// cards: tall, square, short-wide, square.
const ratioRhythm = ["4 / 5", "1 / 1", "5 / 4", "1 / 1"];

const priceMap = await loadAuthoritativePrices();

const feedProducts = feedSlugs
  .map((slug) => productCatalog.find((product) => product.slug === slug))
  .filter((product): product is NonNullable<typeof product> => Boolean(product))
  .map((product) => withAuthoritativePrice(product, priceMap))
  .map((product, index) => ({
    ...product,
    ratio: ratioRhythm[index % ratioRhythm.length],
  }));
---

<section class="bg-white px-5 py-12 md:px-8 md:py-16" aria-labelledby="discovery-feed-heading">
  <div class="mx-auto max-w-7xl">
    <div class="mb-7 text-center">
      <p class="fp-eyebrow">
        Fresh Petals Hyderabad
      </p>

      <h2 id="discovery-feed-heading" class="fp-h2 mt-2">
        Discover Beautiful Ideas
      </h2>
    </div>

    <div class="columns-2 gap-3 md:columns-3 md:gap-4 lg:columns-4">
      {
        feedProducts.map((product) => (
          <a
            href={`/products/${product.slug}`}
            class="group mb-3 block break-inside-avoid md:mb-4"
            aria-label={`${product.name}, ${product.priceLabel}`}
          >
            <div
              class="overflow-hidden rounded-[18px] bg-[#F8F1F3]"
              style={`aspect-ratio: ${product.ratio};`}
            >
              <img
                src={product.image}
                alt=""
                loading="lazy"
                decoding="async"
                class="h-full w-full object-cover transition duration-700 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:scale-105"
              />
            </div>

            <p class="mt-2 line-clamp-1 text-[13px] font-medium text-[#2A2025] transition group-hover:text-[#7C243E]">
              {product.name}
            </p>

            <p class="text-[12px] font-semibold text-[#7C243E]">
              {product.priceLabel}
            </p>
          </a>
        ))
      }
    </div>
  </div>
</section>
