---
// Xiaohongshu-Inspired Post Card System milestone — the card markup itself
// was extracted into DiscoveryPostCard.astro (see that file's header for
// the full reasoning: natural image aspect ratio, real-description-derived
// caption, no CTA/button/price-badge on the card) so ProductSection.astro
// could adopt the exact same visual language rather than a second,
// slightly-different reimplementation. This file is now just the section
// shell: canvas background, layout grid, and which real products appear.
//
// Selection still scoped to Bouquets + Lilies -- the two categories where
// every product has its own dedicated photograph, per the original image-
// asset audit (Deep Discovery Redesign) -- and still deliberately
// different from ProductSection's own curated 8 so the page doesn't
// repeat itself a screen later.
//
// Pricing: same authoritative adapter every other storefront surface uses
// (see ProductPricing.ts) -- no new query, no second price source.
import DiscoveryPostCard from "./DiscoveryPostCard.astro";
import { productCatalog } from "../data/productCatalog";
import { loadAuthoritativePrices, withAuthoritativePrice } from "../server/services/ProductPricing";

const feedSlugs = [
  "cloud-nine-blue",
  "colour-pop-love",
  "cotton-candy",
  "country-love-note",
  "dear-sunshine",
  "lilac-garden",
  "peach-petal-promise",
  "wild-sunset-charm",
  "purple-crush",
  "white-silence",
  "luxe-lily-bloom",
  "stargazer-affair",
  "blush-garden-kiss",
  "sunshine-confession",
  "violet-picnic",
  "ivory-lily-grace",
];

const priceMap = await loadAuthoritativePrices();

const feedProducts = feedSlugs
  .map((slug) => productCatalog.find((product) => product.slug === slug))
  .filter((product): product is NonNullable<typeof product> => Boolean(product))
  .map((product) => withAuthoritativePrice(product, priceMap));
---

<section class="bg-[#F5F5F5] px-3 pb-8 pt-3 md:px-6 md:pb-12" aria-label="Discover beautiful flowers">
  <div class="mx-auto max-w-7xl">
    <div class="columns-2 gap-2 md:columns-3 md:gap-2.5 lg:columns-4 xl:columns-5">
      {
        feedProducts.map((product) => (
          <DiscoveryPostCard
            slug={product.slug}
            name={product.name}
            image={product.image}
            description={product.description}
            category={product.category}
            priceLabel={product.priceLabel}
          />
        ))
      }
    </div>
  </div>
</section>
