---
// Shared frame for a buying guide: breadcrumbs, one H1, the lead, a contents
// row, the guide's own sections (slot), links to the other guides and the
// structured data (Article + BreadcrumbList, published by the one
// Organization in src/data/businessProfile.ts). No author persona, rating or
// offer is declared.
import BaseLayout from "../layouts/BaseLayout.astro";
import { GUIDES, GUIDES_PATH, type Guide } from "../data/guides";
import { BUSINESS, organizationRef, publisherNode } from "../data/businessProfile";

interface Props {
  guide: Guide;
  lead: string[];
  /** In-page contents: section id and label. */
  contents: { id: string; label: string }[];
  /** Social and Article image (a catalogue photograph). */
  image?: string;
  /** data-track-list value. */
  track: string;
}

const { guide, lead, contents, image, track } = Astro.props;
const abs = (path: string) => new URL(path, Astro.site).toString();
const others = GUIDES.filter((entry) => entry.slug !== guide.slug);
const jsonLd = [
  {
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: abs("/") },
      { "@type": "ListItem", position: 2, name: "Guides", item: abs(GUIDES_PATH) },
      { "@type": "ListItem", position: 3, name: guide.label, item: abs(guide.path) },
    ],
  },
  publisherNode(Astro.site),
  {
    "@type": "Article",
    headline: guide.heading,
    description: guide.description,
    inLanguage: "en-IN",
    datePublished: guide.published,
    dateModified: guide.updated,
    mainEntityOfPage: abs(guide.path),
    ...(image ? { image: abs(image) } : {}),
    author: organizationRef(Astro.site),
    publisher: organizationRef(Astro.site),
  },
];
const date = (iso: string) => new Date(`${iso}T00:00:00Z`).toLocaleDateString("en-IN", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" });
---

<BaseLayout title={guide.title} description={guide.description} image={image} showCategoryCarousel={false} jsonLd={jsonLd}>
  <main class="bg-ivory" data-guide={guide.slug} data-track-list={track}>
    <article class="px-5 py-10 md:px-8 md:py-16">
      <div class="mx-auto max-w-4xl">
        <nav aria-label="Breadcrumb">
          <p class="fp-eyebrow">
            <a href="/" class="hover:underline">Home</a> <span aria-hidden="true">/</span>
            <a href={GUIDES_PATH} class="hover:underline">Guides</a> <span aria-hidden="true">/</span>
            <span aria-current="page">{guide.label}</span>
          </p>
        </nav>
        <h1 class="fp-h1 mt-3">{guide.heading}</h1>
        <div class="mt-5 max-w-3xl space-y-4 text-base leading-8 text-moss">
          {lead.map((paragraph) => <p>{paragraph}</p>)}
        </div>
        <p class="mt-4 text-xs text-moss">
          By {BUSINESS.name}. Updated <time datetime={guide.updated}>{date(guide.updated)}</time>.
        </p>
        <nav aria-label="In this guide" class="mt-6 flex flex-wrap gap-2">
          {contents.map((entry) => (
            <a href={`#${entry.id}`} class="inline-flex min-h-[44px] items-center rounded-full border border-line bg-paper px-4 text-sm text-ink hover:border-ink">{entry.label}</a>
          ))}
        </nav>

        <slot />

        <section class="guide-section" aria-labelledby="more-guides-title">
          <h2 id="more-guides-title" class="fp-serif text-2xl text-ink md:text-3xl">More guides</h2>
          <ul class="mt-5 grid gap-3 sm:grid-cols-2">
            {others.map((entry) => (
              <li class="rounded-[18px] border border-line bg-paper p-5">
                <a href={entry.path} class="text-sm font-semibold text-ink underline decoration-line underline-offset-4 hover:text-berry">{entry.label}</a>
                <p class="mt-2 text-sm leading-6 text-moss">{entry.summary}</p>
              </li>
            ))}
          </ul>
        </section>
      </div>
    </article>
  </main>
</BaseLayout>

<style is:global>
  .guide-section {
    margin-top: 3rem;
    padding-top: 2.5rem;
    border-top: 1px solid var(--color-line);
    scroll-margin-top: 6rem;
  }
  .guide-section > p,
  .guide-prose p {
    margin-top: 1rem;
    font-size: 0.9375rem;
    line-height: 1.85;
    color: var(--color-moss);
    max-width: 46rem;
  }
  .guide-prose a,
  .guide-section > p a {
    font-weight: 600;
    color: var(--color-ink);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
</style>
