---
// A category listing (heading, landing copy, filters for launch categories,
// grouped or plain product grid). Shared by the prebuilt category pages
// (src/pages/categories/[slug].astro) and the bouquet list, which is
// rendered on request (src/pages/categories/bouquets.astro).
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProductCard from "../ProductCard.astro";
import type { Product } from "../../data/productCatalog";
import LandingDetails from "../LandingDetails.astro";
import { CATEGORY_LANDING, NOINDEX_CATEGORY_SLUGS, CANONICAL_CATEGORY, lowestPrice } from "../../data/seoLanding";
import ShopFilters from "../occasion/ShopFilters.astro";
import { parseShopFilters, withoutUnpricedBudget, matchesShopFilters, shopFilterUrl, countShopFacets } from "../../utils/shopFilters";
import { makeJourney } from "../../utils/journey";
import { whatsappLink } from "../../config/storefront";
import { filterGroups, shopItemData, type Membership } from "../../data/occasionJourneys";
import { BOUQUET_GROUP_GUIDANCE, POOJA_ENQUIRY_HREF, POOJA_ENQUIRY_POINTS, POOJA_PHOTO_NOTE, bouquetLine, bouquetPhotoAlt, isVaseArrangement } from "../../data/collectionGuidance";

type CategoryMeta = {
  name: string;
  slug: string;
  description: string;
};

interface Props {
  category: CategoryMeta;
  products: Product[];
  groups?: { id: string; label: string; products: Product[] }[];
  /** The admin's occasion assignments for the listed products (launch categories), or null. */
  membership?: Membership | null;
  /** A sentence on what the listed prices cover (launch categories). */
  priceNote?: string;
  /**
   * Plain sections by product form (the pooja collection): jump links and a
   * note per section, no filters. Every listed product is in exactly one.
   */
  sections?: { id: string; label: string; note: string | null; products: Product[] }[];
}

const { category, products: listedProducts, groups: listedGroups = [], membership = null, priceNote, sections = [] } = Astro.props;

// Launch categories: each bouquet's occasions come from the admin's
// assignments (product_occasions), never the catalogue's original tags; the
// bouquet list is rendered on request (src/pages/categories/bouquets.astro),
// so they are current in the HTML.
const withOccasions = (product: Product): Product => (membership ? { ...product, occasionTags: [...(membership.get(product.slug) ?? [])] } : product);
const products = listedProducts.map(withOccasions);
const groups = listedGroups.map((group) => ({ ...group, products: group.products.map(withOccasions) }));

// Search landing copy for the categories mapped to a distinct
// search intent (src/data/seoLanding.ts); every other category keeps its
// existing title/description. Empty categories stay reachable from the
// menu but are noindexed (and left out of sitemap.xml) — a page with no
// products is not a useful search result.
const landing = CATEGORY_LANDING[category.slug];
const pageTitle = landing?.title ?? `${category.name} | Fresh Petals`;
const pageDescription = landing?.description ?? category.description;
const pageHeading = landing?.h1 ?? category.name;
const fromPrice = landing ? lowestPrice(products) : null;
const noindex = products.length === 0 || NOINDEX_CATEGORY_SLUGS.has(category.slug);
const canonical = CANONICAL_CATEGORY[category.slug] ? `/categories/${CANONICAL_CATEGORY[category.slug]}` : undefined;
// Launch categories (bouquets) can be narrowed by occasion, budget and
// colour — derived from the products, shown only when they divide the list
// (src/data/occasionJourneys.ts). Shareable: ?occasion=…&budget=…&colour=….
const filters = withoutUnpricedBudget(groups.length ? parseShopFilters(Astro.url.searchParams) : parseShopFilters(new URLSearchParams()), products.map((product) => shopItemData(product)));
const shopGroups = groups.length > 0 ? filterGroups(products, ["occasion", "budget", "colour"], { allOccasions: true, selected: filters }) : [];
const matches = (product: Product) => matchesShopFilters(shopItemData(product), filters);
const shown = products.filter(matches).length;
const contextualJourney = makeJourney(filters.occasion, filters.intent ?? "gift", shopFilterUrl(Astro.url.pathname, filters));
const facets = countShopFacets(shopGroups, products.map((product) => shopItemData(product)), filters);
const helpHref = whatsappLink("Hi Fresh Petals, please help me choose flowers.\nOccasions: " + (contextualJourney?.occasionLabel ?? "Please advise") + "\nPlease confirm availability, delivery and the complete price before I accept the order.");
// Bouquet groups: how the designs in a group differ, read from their records.
const guidanceFor = (groupId: string) => (category.slug === "bouquets" ? BOUQUET_GROUP_GUIDANCE[groupId] : undefined);
const vaseArrangements = category.slug === "bouquets" ? products.filter(isVaseArrangement) : [];
const breadcrumbJsonLd = {
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: new URL("/", Astro.site).toString() },
    { "@type": "ListItem", position: 2, name: category.name, item: new URL(`/categories/${category.slug}`, Astro.site).toString() },
  ],
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  showCategoryCarousel={false}
  noindex={noindex}
  canonical={canonical}
  jsonLd={noindex || canonical ? [] : [breadcrumbJsonLd]}
>
  <main class="bg-ivory" data-track-list={landing ? category.slug : undefined}>
    <section class="px-5 py-10 md:px-8 md:py-16">
      <div class="mx-auto max-w-7xl">
        <div class="collection-head mb-10 md:mb-14">
          <div>
          <p class="fp-eyebrow">
            <a href="/" class="hover:underline">Home</a> <span aria-hidden="true">/</span> Collection
          </p>

          <h1 class="fp-h1 mt-3">
            {pageHeading}
          </h1>
          </div>
          <div>

          {
            landing ? (
              <div class="max-w-2xl space-y-3 text-sm leading-7 text-moss md:text-base">
                {landing.intro.map((paragraph) => <p>{paragraph}</p>)}
                {fromPrice !== null && (
                  <p class="font-semibold text-ink">
                    Prices on this page start from ₹{fromPrice}.{priceNote && ` ${priceNote}`} The final price is confirmed on WhatsApp before you pay.
                  </p>
                )}
              </div>
            ) : (
              <p class="max-w-2xl text-sm leading-7 text-moss md:text-base">
                {category.description}
              </p>
            )
          }

          <div class="mt-5 flex max-w-2xl flex-wrap items-center gap-2">
            <span class="rounded-full border border-line bg-linen px-4 py-2 text-[11px] font-semibold uppercase tracking-[0.18em] text-berry">
              {products.length} option{products.length === 1 ? "" : "s"}
            </span>

            <span class="rounded-full border border-mint-soft bg-mint-soft px-4 py-2 text-[11px] font-semibold uppercase tracking-[0.18em] text-ink">
              WhatsApp confirmed
            </span>

            <span class="rounded-full border border-line bg-paper px-4 py-2 text-[11px] font-semibold uppercase tracking-[0.18em] text-moss">
              Recipient city and delivery confirmed on WhatsApp
            </span>
          </div>
          </div>
        </div>

        <div data-shop data-shop-key={`category:${category.slug}`} data-shop-noun="bouquets">
        {
          shopGroups.length > 0 && (
            <div class="mb-6">
              <ShopFilters groups={facets} total={products.length} shown={shown} noun="bouquets" />
            </div>
          )
        }
        {
          groups.length > 0 && (
            // One scrollable row on phones (it wrapped to two), so the first
            // bouquets sit higher; wraps again on wider screens.
            <nav aria-label="Bouquet types" class="-mx-1 mb-8 flex gap-2 overflow-x-auto px-1 py-1 md:flex-wrap md:overflow-visible">
              {groups.map((group) => (
                <a href={`#${group.id}`} class="inline-flex min-h-[44px] shrink-0 items-center gap-1 rounded-full border border-line bg-paper px-4 text-[12px] font-semibold text-ink transition hover:border-ink">
                  {group.label} <span class="text-moss">({group.products.length})</span>
                </a>
              ))}
            </nav>
          )
        }
        {
          groups.length > 0 ? (
            <div class="space-y-14">
              {groups.map((group) => (
                <section id={group.id} aria-labelledby={`${group.id}-title`} class="scroll-mt-28" data-shop-group hidden={!group.products.some(matches)}>
                  <h2 id={`${group.id}-title`} class={`fp-serif text-2xl text-ink md:text-3xl ${guidanceFor(group.id) ? "mb-3" : "mb-5"}`}>{group.label}</h2>
                  {guidanceFor(group.id) && (
                    <div class="mb-6 max-w-3xl text-sm leading-7 text-moss" data-group-guidance={group.id}>
                      <p>{guidanceFor(group.id)!.intro}</p>
                      <ul class="mt-2 space-y-1">
                        {group.products.map((product) => bouquetLine(product) && (
                          <li>
                            <a href={`/products/${product.slug}`} class="font-semibold text-ink underline underline-offset-4">{product.name}</a>: {bouquetLine(product)}
                          </li>
                        ))}
                      </ul>
                      <p class="mt-2">
                        Often chosen for:{" "}
                        {guidanceFor(group.id)!.links.map((link, index) => (
                          <Fragment>{index > 0 && ", "}<a href={link.href} class="text-ink underline underline-offset-4">{link.label.toLowerCase()}</a></Fragment>
                        ))}.
                      </p>
                    </div>
                  )}
                  <div class="grid grid-cols-2 gap-4 md:grid-cols-3 lg:grid-cols-4">
                    {group.products.map((product) => {
                      const data = shopItemData(product);
                      return (
                        <div data-shop-item hidden={!matches(product)} data-slug={product.slug} data-occasions={data.occasions.join(" ")} data-colours={data.colours.join(" ")} data-budget={data.budget ?? ""} data-intent="gift">
                          <ProductCard
                            journey={contextualJourney}
                          id={product.id}
                            name={product.name}
                            image={product.image}
                            imageAlt={category.slug === "bouquets" ? bouquetPhotoAlt(product) : undefined}
                            priceLabel={product.priceLabel}
                            priceType={product.priceType}
                            category={product.category}
                            description={product.description}
                            slug={product.slug}
                            isAvailable={product.isAvailable}
                          />
                        </div>
                      );
                    })}
                  </div>
                </section>
              ))}
              <div class="rounded-[24px] border border-line bg-linen p-6" data-shop-empty hidden={shown > 0}>
                <h2 class="text-lg font-semibold text-ink">No bouquet matches all of those filters</h2>
                <p class="mt-2 text-sm leading-6 text-moss">Try fewer filters, or tell us your colours and budget on WhatsApp.</p>
                <p class="mt-4 flex flex-wrap gap-3">
                  <a href={Astro.url.pathname} class="fp-btn-outline" data-filters-clear>Clear filters</a>
                  <a class="fp-btn" href={helpHref} data-filter-help target="_blank" rel="noopener noreferrer">Ask on WhatsApp</a>
                </p>
              </div>
              {category.slug === "bouquets" && (
                <div class="max-w-3xl rounded-[24px] border border-line bg-paper p-6 text-sm leading-7 text-moss" data-presentation-note>
                  <h2 class="text-base font-semibold text-ink">Wrapped bouquet or vase arrangement</h2>
                  <p class="mt-2">
                    {vaseArrangements.length > 0
                      ? <Fragment>{vaseArrangements.map((product, index) => <Fragment>{index > 0 && ", "}<a href={`/products/${product.slug}`} class="font-semibold text-ink underline underline-offset-4">{product.name}</a></Fragment>)}{vaseArrangements.length === 1 ? " is" : " are"} arranged in a glass vase and can be placed straight on a table. The other bouquets are wrapped and tied, ready to hand over, and need a vase at home.</Fragment>
                      : "These bouquets are wrapped and tied, ready to hand over, and need a vase at home."}{" "}
                    A vase can be added to a wrapped bouquet when you choose its options. Say on WhatsApp if you would like a different wrapping.
                  </p>
                </div>
              )}
              <p class="text-sm leading-7 text-moss">
                Looking for something else?{" "}
                <a href="/custom-orders" class="font-semibold text-ink underline underline-offset-4">Ask for a custom bouquet</a>.
              </p>
            </div>
          ) : sections.length > 0 ? (
            <div data-form-sections>
              <nav aria-label={`${category.name} by form`} class="-mx-1 mb-8 flex gap-2 overflow-x-auto px-1 py-1 md:flex-wrap md:overflow-visible">
                {sections.map((section) => (
                  <a href={`#${section.id}`} class="inline-flex min-h-[44px] shrink-0 items-center gap-1 rounded-full border border-line bg-paper px-4 text-[12px] font-semibold text-ink transition hover:border-ink">
                    {section.label} <span class="text-moss">({section.products.length})</span>
                  </a>
                ))}
              </nav>
              <div class="space-y-14">
                {sections.map((section) => (
                  <section id={section.id} aria-labelledby={`${section.id}-title`} class="scroll-mt-28" data-form-section={section.id}>
                    <h2 id={`${section.id}-title`} class="fp-serif mb-3 text-2xl text-ink md:text-3xl">{section.label}</h2>
                    {section.note && <p class="mb-6 max-w-3xl text-sm leading-7 text-moss">{section.note}{section.id === "bulk" && <Fragment>{" "}For wedding garlands with photographs, see the <a href="/categories/garlands" class="font-semibold text-ink underline underline-offset-4">garland designs</a>.</Fragment>}</p>}
                    <div class="grid grid-cols-2 gap-4 md:grid-cols-3 lg:grid-cols-4">
                      {section.products.map((product) => (
                        <ProductCard
                          id={product.id}
                          name={product.name}
                          image={product.image}
                          priceLabel={product.priceLabel}
                          priceType={product.priceType}
                          category={product.category}
                          description={product.description}
                          slug={product.slug}
                          isAvailable={product.isAvailable}
                        />
                      ))}
                    </div>
                  </section>
                ))}
                <div class="grid max-w-5xl gap-6 md:grid-cols-[1.3fr_1fr]" data-pooja-enquiry>
                  <div class="rounded-[24px] border border-line bg-paper p-6">
                    <h2 class="text-base font-semibold text-ink">What to send us on WhatsApp</h2>
                    <dl class="mt-3 space-y-3 text-sm leading-6">
                      {POOJA_ENQUIRY_POINTS.map((point) => (
                        <div>
                          <dt class="font-semibold text-ink">{point.label}</dt>
                          <dd class="text-moss">{point.detail}</dd>
                        </div>
                      ))}
                    </dl>
                    <a href={POOJA_ENQUIRY_HREF} target="_blank" rel="noopener noreferrer" data-whatsapp-enquiry class="mt-5 inline-flex min-h-[44px] items-center rounded-full bg-berry px-6 text-sm font-semibold text-white transition hover:bg-berry-deep">
                      Ask about pooja flowers on WhatsApp
                    </a>
                  </div>
                  <div class="rounded-[24px] border border-line bg-linen p-6 text-sm leading-7 text-moss">
                    <h2 class="text-base font-semibold text-ink">Loose flowers or a string?</h2>
                    <p class="mt-2">
                      Choose <a href="/products/jasmine-malli" class="font-semibold text-ink underline underline-offset-4">loose jasmine</a> if you will offer the flowers as they are or string them yourself, and
                      <a href="/products/jasmine-gajra" class="font-semibold text-ink underline underline-offset-4"> jasmine gajra</a> if you want them already strung.
                    </p>
                    <p class="mt-3">{POOJA_PHOTO_NOTE}</p>
                  </div>
                </div>
              </div>
            </div>
          ) : products.length > 0 ? (
            <div class="grid grid-cols-2 gap-4 md:grid-cols-3 lg:grid-cols-4">
              {products.map((product) => (
                <ProductCard
                  id={product.id}
                  name={product.name}
                  image={product.image}
                  priceLabel={product.priceLabel}
                  priceType={product.priceType}
                  category={product.category}
                  description={product.description}
                  slug={product.slug}
                  isAvailable={product.isAvailable}
                />
              ))}
            </div>
          ) : (
            <div class="rounded-[28px] border border-line bg-linen p-8 text-center md:p-12">
              <p class="text-[10px] font-semibold uppercase tracking-[0.28em] text-rose-deep">
                Available on request
              </p>

              <h2 class="fp-serif mt-3 text-2xl text-ink">
                Custom {category.name} Orders
              </h2>

              <p class="mx-auto mt-4 max-w-xl text-sm leading-7 text-moss">
                This category is available as a WhatsApp-confirmed custom order.
                Share your preferred quantity, occasion and delivery date. We’ll
                confirm today’s availability and price before payment.
              </p>

              <a
                href={`https://wa.me/919652012274?text=Hi%20Fresh%20Petals%2C%20I%20want%20to%20check%20availability%20for%20${encodeURIComponent(category.name)}`}
                class="mt-7 inline-flex rounded-full bg-berry px-7 py-3 text-xs font-semibold uppercase tracking-[0.18em] text-white transition hover:bg-berry-deep"
              >
                Check on WhatsApp
              </a>
            </div>
          )
        }
        </div>
      </div>
    </section>

    {landing && <LandingDetails content={landing} />}
  </main>
</BaseLayout>

<style>
  .collection-head {
    display: grid;
    gap: 1.25rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--color-line);
  }

  @media (min-width: 1024px) {
    .collection-head {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      align-items: end;
      gap: 3rem;
    }
  }
</style>
