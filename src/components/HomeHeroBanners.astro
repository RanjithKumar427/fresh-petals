 ---
// Phase 4 (True Visual Discovery Experience) milestone — three changes,
// all from the Opus audit's live measurement:
//   - Height reduced (220/280/360 -> 150/220/280). At 390px the hero was
//     measured consuming 220px of the 458px preceding the first savable
//     flower — 48% of the first screen. Still real flower photography
//     (kept, deliberately, per the earlier product decision recorded
//     below: "a customer should see flowers before being asked
//     anything") — just no longer the majority of the first screen.
//   - Each slide is now the tap target (the whole slide is an <a>, not
//     just the small arrow-link at the bottom) and the separate "Shop
//     Now" link element was replaced with plain visual label text — one
//     honest tap target per slide instead of a banner + a button doing
//     the same job, matching the "whole card is one tap target" pattern
//     already established on DiscoveryPostCard.
//   - Per-slide heading demoted from <h1> to <h2> (all three slides exist
//     in the DOM simultaneously, opacity-toggled, not conditionally
//     rendered — the audit found 3 <h1> elements on the homepage, none of
//     which name the page); one real, visually-hidden page <h1> added.
const slides = [
  {
    image: "/images/hero-main-banner.jpg",
    label: "Fresh Flowers Delivered In Hyderabad",
    title: "Same Day Delivery",
    subtitle:
      "Fresh pooja flowers, jasmine, bouquets and garlands delivered across Hyderabad.",
    button: "Shop Now",
    href: "/categories/offers",
  },
  {
    image: "/images/hero-bouquets.jpg",
    label: "Grab Your Perfect Bouquet Today",
    title: "Bouquets",
    subtitle:
      "Fresh hand-tied bouquets for birthdays, anniversaries and gifting.",
    button: "Shop Here",
    href: "/categories/bouquets",
  },
  {
    image: "/images/pooja-flowers.jpg",
    label: "Daily Fresh Flowers For Rituals",
    title: "Pooja Flowers",
    subtitle:
      "Fresh flowers, jasmine, garlands and pooja essentials for daily rituals.",
    button: "Order Now",
    // Phase 6 — the only hero slide with a genuinely equivalent occasion
    // page (17 tagged products + 7 fallbacks, already DiscoveryFeed-native)
    // and strictly better photography than /categories/pooja-flowers,
    // whose 11 products share only 5 distinct images. The other two
    // slides keep their /categories/* hrefs -- "offers" and "bouquets"
    // have no honest occasion equivalent, so forcing one would misrepresent
    // the destination rather than fix the inconsistency.
    href: "/occasions/pooja",
  },
];
---

<section class="bg-white">
  <h1 class="sr-only">Fresh Petals — Fresh Flowers Delivered in Hyderabad</h1>

  <div
    id="fresh-petals-hero-slider"
    class="relative h-[150px] w-full overflow-hidden sm:h-[220px] md:h-[280px]"
  >
    {
      slides.map((slide, index) => (
        <a
          href={slide.href}
          aria-label={`${slide.title} — ${slide.button}`}
          class={`hero-slide absolute inset-0 block transition-opacity duration-[900ms] ease-[cubic-bezier(0.22,1,0.36,1)] ${
            index === 0 ? "opacity-100" : "pointer-events-none opacity-0"
          }`}
          data-slide={index}
        >
          <img
            src={slide.image}
            alt={slide.title}
            class="absolute inset-0 h-full w-full object-cover"
            loading={index === 0 ? "eager" : "lazy"}
            decoding="async"
          />

          <div class="absolute inset-0 bg-gradient-to-t from-black/50 via-black/10 to-transparent"></div>

          <!-- Stage 3 (Phase 1 discovery hardening) -- md:items-center
               previously moved the caption to vertical centre on desktop,
               which is exactly where the gradient above is weakest
               (via-black/10, 10% opacity): confirmed live, white text on
               the "Pooja Flowers" slide was barely legible against bright
               florals. Dropped rather than darkening the gradient itself
               (which would dim the photography the hero exists to show) --
               the caption now anchors bottom-left at every breakpoint,
               inside the strong from-black/50 zone, matching mobile. -->
          <div class="relative z-10 mx-auto flex h-full max-w-7xl items-end px-5 pb-6 md:px-8">
            <div class="max-w-xl text-white md:max-w-2xl">
              <p class="text-[9px] font-semibold uppercase tracking-[0.24em] text-white/80">
                {slide.label}
              </p>

              <h2 class="fp-serif mt-1.5 text-xl uppercase leading-[1.05] text-white sm:text-2xl md:mt-2 md:text-3xl">
                {slide.title}
              </h2>

              <p class="mt-2.5 inline-flex items-center gap-1.5 text-[11px] font-semibold uppercase tracking-[0.18em] text-white/90 md:mt-3">
                {slide.button}
                <span aria-hidden="true">→</span>
              </p>
            </div>
          </div>
        </a>
      ))
    }

    <!-- Stage 3 (Phase 1 discovery hardening) -- the dots were previously
         both the visual bar AND the tap target at h-[3px] (a 3px-tall hit
         area). Split: each button below centres a nested span carrying
         the actual 3px visual bar unchanged -- the design doesn't get
         bigger, only what you can tap does. The pause control is a
         fourth, matching-size button so the autoplay (WCAG 2.2.2 --
         content that moves/auto-updates for >5s needs a way to pause it)
         has a real stop, not just a slide-jump side-effect from clicking
         a dot.

         Hit-area size is responsive, not a flat 44px: at a flat 44px,
         live measurement found this row overlapping the caption's "Shop
         Now" line by ~20px on mobile, where the hero is only 150px tall.
         32px clears WCAG 2.5.8's actual Level AA minimum (24x24 CSS px --
         44px is the AAA/best-practice target, not the requirement) with
         margin, and only grows to the full 44px from sm: (640px) up,
         where the hero is already 220px+ tall and there's real room. -->
    <div class="absolute bottom-2 left-1/2 z-20 flex -translate-x-1/2 items-center sm:bottom-5 md:bottom-8">
      {
        slides.map((_, index) => (
          <button
            type="button"
            class="hero-dot-hit flex h-8 w-8 items-center justify-center sm:h-11 sm:w-11"
            data-dot={index}
            aria-label={`Go to slide ${index + 1}`}
          >
            <span
              class={`hero-dot h-[3px] rounded-full transition-all duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] ${
                index === 0 ? "w-12 bg-white" : "w-6 bg-white/45"
              }`}
            />
          </button>
        ))
      }

      <button
        type="button"
        data-hero-pause
        aria-pressed="false"
        aria-label="Pause automatic slide rotation"
        class="flex h-8 w-8 items-center justify-center text-white/80 transition hover:text-white sm:h-11 sm:w-11"
      >
        <svg data-hero-pause-icon class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <rect x="6" y="5" width="4" height="14" rx="1"></rect>
          <rect x="14" y="5" width="4" height="14" rx="1"></rect>
        </svg>
        <svg data-hero-play-icon class="hidden h-3.5 w-3.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M7 5v14l12-7z"></path>
        </svg>
      </button>
    </div>
  </div>
</section>

<script>
  const slider = document.querySelector("#fresh-petals-hero-slider");

  if (slider) {
    const slides = Array.from(
      slider.querySelectorAll(".hero-slide")
    ) as HTMLElement[];

    // Stage 3 -- the visual bar (.hero-dot) now lives inside a 44x44 hit
    // area (.hero-dot-hit); state classes still toggle on the bar, clicks
    // are still bound to the button, which is what needs to be 44px.
    const dotButtons = Array.from(
      slider.querySelectorAll(".hero-dot-hit")
    ) as HTMLButtonElement[];

    const pauseButton = slider.querySelector<HTMLButtonElement>("[data-hero-pause]");
    const pauseIcon = slider.querySelector("[data-hero-pause-icon]");
    const playIcon = slider.querySelector("[data-hero-play-icon]");

    let currentSlide = 0;
    const totalSlides = slides.length;

    const showSlide = (index: number) => {
      slides.forEach((slide: HTMLElement, slideIndex: number) => {
        const isActive = slideIndex === index;
        slide.classList.toggle("opacity-100", isActive);
        slide.classList.toggle("opacity-0", !isActive);
        slide.classList.toggle("pointer-events-none", !isActive);
      });

      dotButtons.forEach((button: HTMLButtonElement, dotIndex: number) => {
        const dot = button.querySelector(".hero-dot");
        if (!dot) return;

        dot.classList.toggle("w-12", dotIndex === index);
        dot.classList.toggle("bg-white", dotIndex === index);

        dot.classList.toggle("w-6", dotIndex !== index);
        dot.classList.toggle("bg-white/45", dotIndex !== index);
      });

      currentSlide = index;
    };

    const nextSlide = () => {
      const next = (currentSlide + 1) % totalSlides;
      showSlide(next);
    };

    // Stage 3 -- WCAG 2.2.2 (Pause, Stop, Hide): auto-advancing content
    // running longer than 5s needs a real pause, not just "clicking a dot
    // happens to reset the timer" (the only control that existed before).
    // Also: a visitor with prefers-reduced-motion never gets an
    // auto-starting interval at all -- the slider starts paused, same
    // mechanism, just not auto-triggered.
    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let interval: number | null = null;
    let isPaused = prefersReducedMotion;

    const setPausedState = (paused: boolean) => {
      isPaused = paused;

      if (interval !== null) {
        window.clearInterval(interval);
        interval = null;
      }

      if (!paused) {
        interval = window.setInterval(nextSlide, 4500);
      }

      pauseButton?.setAttribute("aria-pressed", paused ? "true" : "false");
      pauseButton?.setAttribute(
        "aria-label",
        paused ? "Resume automatic slide rotation" : "Pause automatic slide rotation"
      );
      pauseIcon?.classList.toggle("hidden", paused);
      playIcon?.classList.toggle("hidden", !paused);
    };

    setPausedState(isPaused);

    dotButtons.forEach((button: HTMLButtonElement, index: number) => {
      button.addEventListener("click", () => {
        showSlide(index);
        // A manual slide choice shouldn't silently resume autoplay for a
        // visitor who paused it (or who has reduced-motion on) -- only
        // restart the timer if it was already running.
        if (!isPaused) setPausedState(false);
      });
    });

    pauseButton?.addEventListener("click", () => {
      setPausedState(!isPaused);
    });
  }
</script>
