---
const categories = [
  {
    label: "Eid Al-Adha",
    image: "/images/cat-under-1499.jpg",
    href: "/categories/eid-al-adha",
  },
  {
    label: "Bouquets",
    image: "/images/cat-bouquets.jpg",
    href: "/categories/bouquets",
  },
  {
    label: "Anniversary",
    image: "/images/cat-anniversary.jpg",
    href: "/occasions/anniversary",
  },
  {
    label: "Birthday",
    image: "/images/cat-birthday.jpg",
    href: "/occasions/birthday",
  },
  {
    label: "Subscription",
    image: "/images/cat-subscription.jpg",
    href: "/categories/subscriptions",
  },
  {
    label: "Flowerbox & Stems",
    image: "/images/cat-flowerbox.jpg",
    href: "/categories/flowerbox",
  },
  {
    label: "Basket",
    image: "/images/cat-basket.jpg",
    href: "/categories/baskets",
  },
  {
    label: "Plant",
    image: "/images/cat-plant.jpg",
    href: "/categories/plants-and-succulents",
  },
  {
    label: "Hampers",
    image: "/images/cat-hampers.jpg",
    href: "/categories/hampers",
  },
  {
    label: "Candles & Diffuser",
    image: "/images/cat-candle.jpg",
    href: "/products/candle-diffuser-addon",
  },
  {
    label: "Pooja",
    image: "/images/cat-pooja.jpg",
    href: "/categories/pooja-flowers",
  },
  {
    label: "Under 1499",
    image: "/images/cat-under-1499.jpg",
    href: "/products/flower-gifts-under-1499",
  },
  {
    label: "Vases",
    image: "/images/cat-vases.jpg",
    href: "/categories/vases",
  },
  {
    label: "Wedding",
    image: "/images/cat-wedding.jpg",
    href: "/occasions/wedding",
  },
];
---

<section class="border-b border-[#EEE5E8] bg-white px-4 py-4 md:px-8 md:py-5">
  <div class="mx-auto max-w-7xl overflow-hidden">
    <div class="fp-scrollbar-hide flex gap-6 overflow-x-auto px-4 py-2 md:justify-start md:gap-7">
      {
        categories.map((category) => (
          <a
            href={category.href}
            class="group w-[76px] shrink-0 text-center md:w-[86px]"
            aria-label={`View ${category.label}`}
          >
            <div class="mx-auto h-[66px] w-[66px] overflow-hidden rounded-full border border-[#E9E2E5] bg-white p-[3px] transition-colors duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:border-[#D8B5BE] md:h-[74px] md:w-[74px]">
              <img
                src={category.image}
                alt={category.label}
                class="h-full w-full rounded-full object-cover transition duration-700 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:scale-105"
                loading="lazy"
                decoding="async"
              />
            </div>

            <p class="mt-3 min-h-[34px] text-[10px] font-medium uppercase leading-[1.35] tracking-[0.12em] text-[#171717] transition-colors duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:text-[#D98B9A] md:text-[10px]">
              {category.label}
            </p>
          </a>
        ))
      }
    </div>
  </div>
</section>