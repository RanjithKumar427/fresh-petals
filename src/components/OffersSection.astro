---
import ProductCard from "./ProductCard.astro";
import { productCatalog } from "../data/productCatalog";

const offers = productCatalog.filter(
  (product) => product.category === "Offers"
);
---

<section id="offers" class="bg-white px-5 py-14 md:px-8 md:py-16">
  <div class="mx-auto max-w-7xl">
    <div class="mb-9 text-center">
      <p class="fp-eyebrow">
        Fresh Petals Hyderabad
      </p>

      <h2 class="fp-h2 mt-3">
        Today’s Offers
      </h2>

      <p class="mx-auto mt-4 max-w-2xl text-sm leading-7 text-[#66565D]">
        Budget flower picks, fresh bouquet deals and today’s available flower offers.
      </p>
    </div>

    <div class="grid grid-cols-2 gap-4 md:grid-cols-3 lg:grid-cols-4">
      {
        offers.map((product) => (
          <ProductCard
            name={product.name}
            image={product.image}
            priceLabel={product.priceLabel}
            priceType={product.priceType}
            category={product.category}
            description={product.description}
            slug={product.slug}
            isAvailable={product.isAvailable}
          />
        ))
      }
    </div>

    <div class="mt-12 flex justify-center">
      <a
        href="/categories/offers"
        class="fp-btn-block"
      >
        View All Offers
      </a>
    </div>
  </div>
</section>