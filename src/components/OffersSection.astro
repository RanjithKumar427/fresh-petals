---
const whatsappNumber = "919652012274";

const offers = [
  {
    name: "Under ₹499 Flowers",
    price: "Budget picks",
    image: "/images/cat-under-1499.jpg",
    text: "Hi Fresh Petals, show me flowers under ₹499.",
  },
  {
    name: "Under ₹999 Bouquets",
    price: "Fresh deals",
    image: "/images/bouquet-4.jpg",
    text: "Hi Fresh Petals, show me bouquets under ₹999.",
  },
  {
    name: "Under ₹1499 Gifts",
    price: "Popular range",
    image: "/images/bouquet-1.jpg",
    text: "Hi Fresh Petals, show me flower gifts under ₹1499.",
  },
  {
    name: "Today’s Offers",
    price: "Ask on WhatsApp",
    image: "/images/bouquet-2.jpg",
    text: "Hi Fresh Petals, please share today's flower offers.",
  },
];
---

<section id="offers" class="bg-white px-5 py-14 md:px-8 md:py-16">
  <div class="mx-auto max-w-7xl">
    <div class="mb-9 text-center">
      <h2 class="fp-serif text-2xl uppercase tracking-[0.24em] text-[#171717] md:text-3xl">
        Today’s Offers
      </h2>
    </div>

    <div class="grid grid-cols-2 gap-x-5 gap-y-10 md:grid-cols-4 md:gap-x-7 md:gap-y-12">
      {
        offers.map((offer) => {
          const message = encodeURIComponent(offer.text);

          return (
            <article class="group text-center">
              <a
                href={`https://wa.me/${whatsappNumber}?text=${message}`}
                class="block"
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`View ${offer.name} on WhatsApp`}
              >
                <div class="relative aspect-square w-full overflow-hidden bg-[#f8eef2]">
                  <span class="absolute right-2 top-2 z-10 bg-[#111111] px-2.5 py-1 text-[10px] font-semibold uppercase tracking-[0.16em] text-white">
                    Offer
                  </span>

                  <img
                    src={offer.image}
                    alt={offer.name}
                    class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
                    loading="lazy"
                  />
                </div>

                <div class="pt-4 text-center">
                  <h3 class="min-h-9 text-[10px] font-semibold uppercase leading-5 tracking-[0.18em] text-[#171717] md:text-[11px] md:tracking-[0.22em]">
                    {offer.name}
                  </h3>

                  <p class="mt-2 text-xs font-medium text-[#77706f]">
                    {offer.price}
                  </p>
                </div>
              </a>
            </article>
          );
        })
      }
    </div>
  </div>
</section>