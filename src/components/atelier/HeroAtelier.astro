  }

  /* ---- Controls --------------------------------------------------------- */
  .hero__controls {
    display: flex;
    align-items: center;
    justify-self: start;
    gap: 2px;
    margin-left: -10px;
  }

  .hero__controls[hidden] {
    display: none;
  }

  /* The script is on its way: keep the controls' place from the first paint,
     so nothing moves when they appear. */
  :global(html.js) .hero__controls[hidden] {
    display: flex;
    visibility: hidden;
  }

  .hero__btn,
  .hero__dot {
    display: inline-grid;
    place-items: center;
    height: 44px;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-ink);
    cursor: pointer;
  }

  .hero__btn {
    width: 44px;
    border-radius: 999px;
    transition:
      background-color 0.18s var(--ease-micro),
      color 0.18s var(--ease-micro);
