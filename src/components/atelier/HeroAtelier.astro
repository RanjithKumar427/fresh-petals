    .hero__doodle--sprig {
      left: 39.5%;
      top: 8%;
      width: 40px;
      transform: rotate(16deg);
    }

    .hero__note {
      display: block;
      position: absolute;
      left: 33.5%;
      top: 79%;
      width: 12.5rem;
      transform: rotate(-7deg);
    }

