      font-size: clamp(2.6rem, 0.9rem + 3.3vw, 3.9rem);
      line-height: 1.02;
    }

    .hero__body {
      max-width: 31ch;
      font-size: clamp(1.0625rem, 0.85rem + 0.55vw, 1.25rem);
      line-height: 1.5;
    }

    .hero__actions {
      gap: 0.8rem;
      margin-top: 0.5rem;
    }

    .hero__cta {
      min-height: 54px;
      padding-inline: 1.9rem;
      font-size: 1rem;
    }

    .hero__doodle--flourish {
      width: 78px;
    }

    /* A discreet pill at the lower right, above the strip. */
    .hero__controls {
      position: absolute;
      right: var(--gutter);
      bottom: 4.1rem;
      margin: 0;
      padding: 2px 4px;
      border-radius: 999px;
      background: color-mix(in srgb, var(--color-ivory) 86%, transparent);
