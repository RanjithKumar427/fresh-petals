  }

  .hero__strip li + li::before {
    content: "";
    width: 1px;
    height: 22px;
    margin-inline: 4px;
    background: var(--color-line);
  }

  .hero__strip a {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-height: 46px;
    padding: 0 0.95rem;
