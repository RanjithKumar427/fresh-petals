    .hero__headline {
      max-width: 18ch;
      font-size: 2.75rem;
    }

    .hero__body {
      max-width: 46ch;
    }
  }

  /* ---- Desktop: the photograph is the whole stage. ---------------------- */
  @media (min-width: 900px) {
    .hero__stage {
      --hero-h: clamp(600px, calc(100svh - var(--header-h) - 7.75rem), 740px);
      --print-w: clamp(124px, 10vw, 150px);
      --print-h: calc(var(--print-w) * 1.2 + 2.6rem);
      --print-top: 1.75rem;
      /* The lower print stops above the controls. */
      --print-drop: calc(var(--hero-h) - 8.6rem - var(--print-h) - var(--print-top));
      height: var(--hero-h);
      perspective: 1200px;
    }

    .hero__media {
      position: absolute;
      inset: 0;
      height: auto;
    }

    /* A margin beyond the stage, so the parallax never shows an edge. */
    .hero__scene {
      inset: -14px -16px;
      transform: translate3d(calc(var(--px) * -8px), calc(var(--py) * -6px + var(--ps) * 20px), 0);
    }

    .hero__photo--bouquets {
      --pos: 86% 14%;
    }
    .hero__photo--garlands {
      --pos: 88% 62%;
    }
    .hero__photo--pooja {
      --pos: 90% 74%;
    }

    /* Ivory only where the type sits, and a soft floor for the strip. */
    .hero__veil {
      background:
        linear-gradient(0deg, color-mix(in srgb, var(--color-ivory) 92%, transparent), transparent 22%),
        linear-gradient(
          90deg,
          color-mix(in srgb, var(--color-ivory) 90%, transparent) 0%,
          color-mix(in srgb, var(--color-ivory) 74%, transparent) 24%,
          color-mix(in srgb, var(--color-ivory) 30%, transparent) 41%,
          transparent 54%
        );
    }

    .hero__content {
      height: 100%;
      max-width: 1440px;
      margin: 0 auto;
      padding: 0 var(--gutter) 3.25rem;
      align-content: center;
      pointer-events: none;
    }

    .hero__copies {
      width: min(43%, 34rem);
      pointer-events: auto;
    }

    .hero__copy {
      gap: 1.15rem;
    }

    .hero__eyebrow {
