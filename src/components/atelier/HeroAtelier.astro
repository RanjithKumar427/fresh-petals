---
// A. Opening scene. One full-width campaign photograph with the copy set as
// ordinary HTML over its open left side, the flowers on the right, two small
// photo prints that lead to the other campaigns, a few hand-drawn SVG
// accents, and an ivory strip of shortcuts across the hero's lower edge.
// The campaigns (photograph, copy, destinations) are
// atelierHome.getHeroCampaigns: campaign imagery, so no product name or
// price is attached to a photograph.
//
// Layers, back to front: photograph (.hero__scene) → prints → doodles →
// copy and controls. Each moving layer has two wrappers: the outer one takes
// the pointer/scroll parallax (CSS variables set by the script), the inner
// one takes the slide transition, so the two never fight over `transform`.
//
// Without JavaScript the first campaign is the whole hero, with working
// links. With it, the three cross-fade every 5.5 seconds, with previous/next,
// three selectors, "1 / 3", pause/play, touch swipe and the arrow keys.
// Autoplay waits while the hero is hovered, focused, touched, out of view or
// in a hidden tab; an explicit pause stays until Play. With reduced motion
// there is no autoplay, parallax, drawing or fade — only the controls.
// Only the first photograph is in the HTML (and preloaded in
// pages/index.astro); each later one is fetched just before it is needed and
// decoded before it is shown.
import { HOME_LANDING } from "../../data/seoLanding";
import { HERO_PRINT_SIZES, HERO_SCENE_SIZES, type HeroCampaign } from "../../data/atelierHome";
import { heroOccasionLinks, homeShortcuts, type Membership } from "../../data/occasionJourneys";
import type { GarlandDesign } from "../../data/garlandRules";

interface Props {
  membership: Membership;
  /** The campaign slides (atelierHome.getHeroCampaigns). */
  campaigns: HeroCampaign[];
  publicGarlands?: GarlandDesign[];
  budget?: { href: string; label: string } | null;
}

const { campaigns, budget } = Astro.props;
const many = campaigns.length > 1;

// The shortcut strip. Each entry appears only when its destination has
// public products (docs/occasion-journeys.md): occasions follow the admin's
// assignments, garlands and ceremony flowers need public garland designs,
// and the budget shortcut exists only while bouquets are priced under it.
const needs = homeShortcuts(Astro.props.membership, Astro.props.publicGarlands);
const garlands = needs.find((item) => item.href === "/categories/garlands");
const ceremony = needs.find((item) => item.href.includes("for=ceremony"));
const strip: { label: string; href: string; icon: string }[] = [
  ...heroOccasionLinks(Astro.props.membership)
    .filter((link) => link.href !== "/occasions")
    .map((link) => ({ ...link, icon: link.href.endsWith("/birthday") ? "cake" : "heart" })),
  ...(garlands ? [{ label: "Garlands", href: garlands.href, icon: "garland" }] : []),
  ...(ceremony ? [{ label: ceremony.href.includes("/wedding") ? "Wedding flowers" : "Engagement flowers", href: ceremony.href, icon: "rings" }] : []),
  { label: "Custom orders", href: "/custom-orders", icon: "pencil" },
  ...(budget ? [{ label: "Under ₹1,500", href: budget.href, icon: "tag" }] : []),
];

const ICONS: Record<string, string[]> = {
  cake: ["M4 20h16", "M5 20v-7.5c0-.8.7-1.5 1.5-1.5h11c.8 0 1.5.7 1.5 1.5V20", "M5 15.5c1.2 1 2.3 1 3.5 0s2.3-1 3.5 0 2.3 1 3.5 0 2.3-1 3.5 0", "M12 11V8", "M12 5.2c.7-.6.7-1.4 0-2.2-.7.8-.7 1.6 0 2.2z"],
  heart: ["M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.4A4 4 0 0 1 19 10c0 5.6-7 10-7 10z"],
  garland: ["M4 4c0 9 3.5 15 8 15s8-6 8-15", "M6.2 11.2a1.3 1.3 0 1 0 .1 0", "M9.3 16.3a1.3 1.3 0 1 0 .1 0", "M14.7 16.3a1.3 1.3 0 1 0 .1 0", "M17.8 11.2a1.3 1.3 0 1 0 .1 0"],
  rings: ["M9 20a5 5 0 1 0 0-10 5 5 0 0 0 0 10z", "M15 20a5 5 0 1 0 0-10 5 5 0 0 0 0 10z", "M10.5 6.5 12 4l1.5 2.5L12 8z"],
  pencil: ["M4 20l1-4.5L15.5 5a2 2 0 0 1 2.8 0l.7.7a2 2 0 0 1 0 2.8L8.5 19z", "M13.5 7l3.5 3.5"],
  tag: ["M4 12.5V5.5A1.5 1.5 0 0 1 5.5 4h7l7.5 7.5a1.5 1.5 0 0 1 0 2.1l-5.4 5.4a1.5 1.5 0 0 1-2.1 0z", "M8.5 8.5h.01"],
};

// The prints shown beside a slide are the other campaigns, in order: the
// first takes the upper place, the second the lower one.
const printSlot = (print: number, active: number) => {
  const others = campaigns.map((_, index) => index).filter((index) => index !== active);
  return print === active ? "off" : others.indexOf(print) === 0 ? "a" : "b";
};
---

<section class="hero" data-hero data-slide={campaigns[0]?.id} aria-label="Fresh Petals flowers in Bengaluru">
  <div
    class="hero__stage"
    data-hero-stage
    role={many ? "group" : undefined}
    aria-roledescription={many ? "carousel" : undefined}
    aria-label={many ? "Flowers for your occasion" : undefined}
  >
    <div class="hero__media">
      <!-- 1. The photograph. -->
      <div class="hero__scene" data-hero-scene>
        {campaigns.map((campaign, index) => (
          <div class:list={["hero__photo", `hero__photo--${campaign.id}`, { "is-active": index === 0 }]} data-hero-photo aria-hidden={index === 0 ? undefined : "true"}>
            <picture>
              {index === 0 ? (
                <Fragment>
                  <source type="image/avif" srcset={campaign.image.avif} sizes={HERO_SCENE_SIZES} />
                  <source type="image/webp" srcset={campaign.image.webp} sizes={HERO_SCENE_SIZES} />
                  <img src={campaign.image.src} width={campaign.image.width} height={campaign.image.height} alt={campaign.image.alt} fetchpriority="high" draggable="false" />
                </Fragment>
              ) : (
                <Fragment>
                  <source type="image/avif" data-srcset={campaign.image.avif} sizes={HERO_SCENE_SIZES} />
                  <source type="image/webp" data-srcset={campaign.image.webp} sizes={HERO_SCENE_SIZES} />
                  <img data-src={campaign.image.src} width={campaign.image.width} height={campaign.image.height} alt={campaign.image.alt} decoding="async" draggable="false" />
                </Fragment>
              )}
            </picture>
          </div>
        ))}
      </div>
      <div class="hero__veil" aria-hidden="true"></div>

      <!-- 2. Photo prints: the other campaigns. -->
      {many && (
        <div class="hero__prints" data-hero-prints>
          {campaigns.map((campaign, index) => {
            const slot = printSlot(index, 0);
            return (
              <div class="hero__print-slot" data-hero-print data-slot={slot}>
                <div class="hero__print-drift">
                  <a class="hero__print" href={campaign.print.href} tabindex={slot === "off" ? -1 : undefined} aria-hidden={slot === "off" ? "true" : undefined}>
                    <picture>
                      <source type="image/avif" srcset={campaign.print.image.avif} sizes={HERO_PRINT_SIZES} />
                      <source type="image/webp" srcset={campaign.print.image.webp} sizes={HERO_PRINT_SIZES} />
                      <img src={campaign.print.image.src} width={campaign.print.image.width} height={campaign.print.image.height} alt="" loading="lazy" decoding="async" draggable="false" />
                    </picture>
                    <span class="hero__print-caption">{campaign.print.caption}</span>
                  </a>
                </div>
              </div>
            );
          })}
        </div>
      )}

      <!-- 3. Hand-drawn accents (decorative). One set per campaign, each placed
           on that photograph's open areas; only the current one shows. -->
      <div class="hero__doodles" aria-hidden="true">
        {campaigns.map((campaign) => (
          <div class:list={["hero__doodle-set", `hero__doodle-set--${campaign.id}`]}>
        <svg class="hero__doodle hero__doodle--sprig" viewBox="0 0 60 90" focusable="false">
          <path pathLength="1" d="M30 88C28 62 33 36 27 6" />
          <path pathLength="1" style="--d:0.15s" d="M29 66C16 62 10 52 9 44c11 2 19 10 21 20" />
          <path pathLength="1" style="--d:0.25s" d="M31 52c13-2 19-12 21-21-11 2-19 9-21 19" />
          <path pathLength="1" style="--d:0.35s" d="M29 38C18 34 14 26 14 19c9 3 14 9 15 17" />
          <path pathLength="1" style="--d:0.45s" d="M29 22c8-2 12-9 12-15-7 2-11 7-12 13" />
        </svg>
        <div class="hero__note">
          <p class="hero__note-text">For life’s<br />beautiful moments</p>
          <svg class="hero__doodle hero__doodle--heart" viewBox="0 0 40 36" focusable="false">
            <path pathLength="1" style="--d:0.5s" d="M20 32C8 24 3 16 6 9c3-6 11-5 14 2 2-7 11-9 15-3 3 7-4 16-16 25" />
          </svg>
          <svg class="hero__doodle hero__doodle--arrow" viewBox="0 0 90 50" focusable="false">
            <path pathLength="1" style="--d:0.65s" d="M4 40c20 6 50 0 74-28" />
            <path pathLength="1" style="--d:0.95s" d="M62 12l17-1-3 17" />
          </svg>
        </div>
          </div>
        ))}
      </div>
    </div>

    <!-- 4. Copy and controls: never moved by the parallax. -->
    <div class="hero__content">
      <div class="hero__copies">
        {campaigns.map((campaign, index) => {
          const Heading = index === 0 ? "h1" : "h2";
          return (
            <div
              class:list={["hero__copy", { "is-active": index === 0 }]}
              data-hero-copy
              role={many ? "group" : undefined}
              aria-roledescription={many ? "slide" : undefined}
              aria-label={many ? `${index + 1} of ${campaigns.length}` : undefined}
              inert={index !== 0}
            >
              <svg class="hero__doodle hero__doodle--flourish" viewBox="0 0 120 24" aria-hidden="true" focusable="false">
                <path pathLength="1" d="M2 14C22 2 38 22 56 12c6-4 12-6 14 0s-6 8-8 2c-2-8 16-10 30-2 10 5 18 0 26-4" />
              </svg>
              <p class="hero__eyebrow">Floral moments in Bengaluru</p>
              <Heading class="hero__headline" id={index === 0 ? "hero-title" : undefined}>
                {campaign.headline.before}<em>{campaign.headline.accent}</em>{campaign.headline.after}
              </Heading>
              <p class="hero__body">{campaign.text}</p>
              <div class="hero__actions">
                <a class="fp-btn hero__cta" href={campaign.primary.href}>
                  {campaign.primary.label}
                  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
                </a>
                {campaign.secondary && (
                  <a class="fp-btn-outline hero__cta hero__cta--quiet" href={campaign.secondary.href}>
                    {campaign.secondary.label}
                  </a>
                )}
              </div>
            </div>
          );
        })}
      </div>

      {many && (
        <div class="hero__controls" data-hero-controls hidden>
          <button type="button" class="hero__btn" data-hero-prev aria-label="Previous slide">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6" /></svg>
          </button>
          <div class="hero__dots" role="group" aria-label="Choose a slide">
            {campaigns.map((campaign, index) => (
              <button
                type="button"
                class="hero__dot"
                data-hero-dot
                aria-label={`Slide ${index + 1} of ${campaigns.length}: ${campaign.primary.label}`}
                aria-current={index === 0 ? "true" : undefined}
              >
                <span></span>
              </button>
            ))}
          </div>
          <p class="hero__count" aria-hidden="true"><span data-hero-count>1</span> / {campaigns.length}</p>
          <button type="button" class="hero__btn" data-hero-next aria-label="Next slide">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
          </button>
          <button type="button" class="hero__btn hero__btn--toggle" data-hero-toggle aria-label="Pause slideshow">
            <svg class="hero__icon-pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6v12M15 6v12" /></svg>
            <svg class="hero__icon-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l10-6.5z" /></svg>
          </button>
        </div>
      )}
      {many && <p class="sr-only" aria-live="polite" data-hero-live></p>}
    </div>
  </div>

  <!-- Shortcuts across the hero's lower edge. -->
  <nav class="hero__strip" aria-label="Shop by what you need">
    <ul>
      {strip.map((item) => (
        <li>
          <a href={item.href}>
            <svg class="hero__strip-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              {ICONS[item.icon].map((d) => <path d={d} />)}
            </svg>
            <span>{item.label}</span>
            <svg class="hero__strip-arrow" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <div class="hero__below">
    <p class="hero__assure">Availability, delivery and your final total confirmed before you pay.</p>
    <p class="hero__links"><a href="/search">Search by name or code</a> <span aria-hidden="true">·</span> <a href="/custom-orders">Custom orders</a></p>
    <p class="sr-only">{HOME_LANDING.intro[0]}</p>
  </div>
</section>

<script>
  const hero = document.querySelector<HTMLElement>("[data-hero]");
  const stage = hero?.querySelector<HTMLElement>("[data-hero-stage]");
  const controls = hero?.querySelector<HTMLElement>("[data-hero-controls]");
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  // ------------------------------------------------------------------
  // Slides
  // ------------------------------------------------------------------
  if (hero && stage && controls) {
    const photos = [...hero.querySelectorAll<HTMLElement>("[data-hero-photo]")];
    const images = photos.map((photo) => photo.querySelector<HTMLImageElement>("img")!);
    const copies = [...hero.querySelectorAll<HTMLElement>("[data-hero-copy]")];
    const prints = [...hero.querySelectorAll<HTMLElement>("[data-hero-print]")];
    const dots = [...hero.querySelectorAll<HTMLButtonElement>("[data-hero-dot]")];
    const toggle = hero.querySelector<HTMLButtonElement>("[data-hero-toggle]")!;
    const counter = hero.querySelector<HTMLElement>("[data-hero-count]");
    const live = hero.querySelector<HTMLElement>("[data-hero-live]");
    const ids = photos.map((photo) => [...photo.classList].find((name) => name.startsWith("hero__photo--"))?.replace("hero__photo--", "") ?? "");
    const count = photos.length;

    const INTERVAL = 5500;
    let index = 0;
    let request = 0; // the latest slide asked for; an older one still decoding is dropped
    let timer = 0;
    let userPaused = false;
    // Why autoplay is waiting: hover, focus, pointer, hidden, offscreen.
    const holds = new Set<string>();
    const mod = (value: number) => ((value % count) + count) % count;

    // A later photograph is not in the HTML: give it its sources when it is
    // about to be needed. Returns once it can be painted.
    const loaded = new Set<number>([0]);
    const load = (target: number) => {
      const image = images[target];
      if (!loaded.has(target)) {
        loaded.add(target);
        photos[target].querySelectorAll<HTMLSourceElement>("source[data-srcset]").forEach((source) => (source.srcset = source.dataset.srcset!));
        image.src = image.dataset.src!;
      }
      return image.complete && image.naturalWidth ? Promise.resolve() : image.decode().catch(() => {});
    };

    const apply = (target: number, direction: number, announce: boolean) => {
      const previous = index;
      const hadFocus = copies[previous].contains(document.activeElement);

      // The incoming photograph starts a little to the side it comes from;
      // the outgoing one leaves the other way.
      const incoming = photos[target];
      incoming.classList.add("is-prep");
      incoming.style.setProperty("--from", String(direction));
      photos[previous].style.setProperty("--from", String(-direction));
      void incoming.offsetWidth;
      incoming.classList.remove("is-prep");

      photos.forEach((photo, i) => {
        photo.classList.toggle("is-active", i === target);
        if (i === target) photo.removeAttribute("aria-hidden");
        else photo.setAttribute("aria-hidden", "true");
      });
      copies.forEach((copy, i) => {
        copy.classList.toggle("is-active", i === target);
        copy.inert = i !== target;
      });
      // The prints beside a slide are the other campaigns, in order.
      const others = prints.map((_, i) => i).filter((i) => i !== target);
      prints.forEach((print, i) => {
        const slot = i === target ? "off" : others.indexOf(i) === 0 ? "a" : "b";
        const link = print.querySelector<HTMLAnchorElement>("a")!;
        print.dataset.slot = slot;
        if (slot === "off") {
          link.tabIndex = -1;
          link.setAttribute("aria-hidden", "true");
        } else {
          link.removeAttribute("tabindex");
          link.removeAttribute("aria-hidden");
        }
      });
      dots.forEach((dot, i) => (i === target ? dot.setAttribute("aria-current", "true") : dot.removeAttribute("aria-current")));
      if (counter) counter.textContent = String(target + 1);

      // Show this photograph's accents and draw them again.
      hero.dataset.slide = ids[target];
      hero.removeAttribute("data-draw");
      void hero.offsetWidth;
      hero.setAttribute("data-draw", "");

      index = target;
      if (hadFocus) copies[target].querySelector<HTMLAnchorElement>("a")?.focus({ preventScroll: true });
      if (announce && live) live.textContent = `Slide ${target + 1} of ${count}: ${copies[target].querySelector(".hero__headline")?.textContent?.trim() ?? ""}`;
      // Have the following photograph ready before it is asked for.
      window.setTimeout(() => load(mod(target + 1)), 900);
    };

    const show = (to: number, direction: number, announce: boolean) => {
      const target = mod(to);
      const id = ++request;
      if (target === index) return;
      // Switch when the photograph can be painted, or after 1.5s at most.
      // Only the latest request is honoured, so quick presses cannot stack.
      let done = false;
      const swap = () => {
        if (done || id !== request) return;
        done = true;
        apply(target, direction, announce);
      };
      const fallback = window.setTimeout(swap, 1500);
      load(target).then(() => {
        window.clearTimeout(fallback);
        swap();
      });
    };

    // --- Autoplay ---------------------------------------------------------
    const schedule = () => {
      window.clearTimeout(timer);
      const waiting = userPaused || holds.size > 0 || reducedMotion.matches;
      hero.dataset.heroAutoplay = waiting ? "paused" : "running";
      if (waiting) return;
      // Always a full interval from now: nothing is caught up after a pause.
      timer = window.setTimeout(() => {
        show(index + 1, 1, false);
        schedule();
      }, INTERVAL);
    };
    const hold = (reason: string) => {
      holds.add(reason);
      schedule();
    };
    const release = (reason: string) => {
      if (holds.delete(reason)) schedule();
    };

    // A move the visitor made: announce it and restart the countdown.
    const go = (to: number, direction: number) => {
      show(to, direction, true);
      schedule();
    };

    controls.querySelector("[data-hero-prev]")?.addEventListener("click", () => go(index - 1, -1));
    controls.querySelector("[data-hero-next]")?.addEventListener("click", () => go(index + 1, 1));
    dots.forEach((dot, i) => dot.addEventListener("click", () => go(i, i < index ? -1 : 1)));

    const showToggle = () => {
      toggle.hidden = reducedMotion.matches; // nothing plays, so nothing to pause
      toggle.setAttribute("aria-label", userPaused ? "Play slideshow" : "Pause slideshow");
      toggle.classList.toggle("is-paused", userPaused);
    };
    toggle.addEventListener("click", () => {
      // The visitor's own choice: it stays until they press Play.
      userPaused = !userPaused;
      showToggle();
      schedule();
    });

    stage.addEventListener("keydown", (event) => {
      if (event.key !== "ArrowLeft" && event.key !== "ArrowRight") return;
      if (event.altKey || event.ctrlKey || event.metaKey || event.shiftKey) return;
      event.preventDefault();
      go(index + (event.key === "ArrowRight" ? 1 : -1), event.key === "ArrowRight" ? 1 : -1);
    });

    // Hover (mouse only), keyboard focus, a pressed pointer, a hidden tab and
    // an off-screen hero each hold autoplay until they end.
    stage.addEventListener("pointerenter", (event) => event.pointerType === "mouse" && hold("hover"));
    stage.addEventListener("pointerleave", (event) => event.pointerType === "mouse" && release("hover"));
    stage.addEventListener("focusin", (event) => (event.target as HTMLElement).matches(":focus-visible") && hold("focus"));
    stage.addEventListener("focusout", (event) => !stage.contains(event.relatedTarget as Node | null) && release("focus"));
    document.addEventListener("visibilitychange", () => (document.hidden ? hold("hidden") : release("hidden")));
    if (document.hidden) holds.add("hidden");
    new IntersectionObserver(([entry]) => (entry.isIntersecting ? release("offscreen") : hold("offscreen")), { threshold: 0.35 }).observe(stage);

    // --- Touch swipe ------------------------------------------------------
    // Vertical scrolling stays native (touch-action: pan-y); a gesture is a
    // swipe only once it is clearly horizontal, and a swipe never follows a
    // link under the finger. Mouse drags are left alone (text selection).
    let pointerId = -1;
    let startX = 0;
    let startY = 0;
    let swiping = false;
    let swiped = false;

    stage.addEventListener("pointerdown", (event) => {
      if (event.pointerType === "mouse" || !event.isPrimary) return;
      pointerId = event.pointerId;
      startX = event.clientX;
      startY = event.clientY;
      swiping = false;
      swiped = false;
      hold("pointer");
    });
    stage.addEventListener("pointermove", (event) => {
      if (event.pointerId !== pointerId || swiping) return;
      const dx = event.clientX - startX;
      if (Math.abs(dx) < 10 || Math.abs(dx) < Math.abs(event.clientY - startY) * 1.2) return;
      swiping = true;
      stage.setPointerCapture(pointerId);
    });
    const endPointer = (event: PointerEvent) => {
      if (event.pointerId !== pointerId) return;
      pointerId = -1;
      if (swiping && event.type === "pointerup") {
        const dx = event.clientX - startX;
        swiped = true;
        window.setTimeout(() => (swiped = false), 60);
        if (Math.abs(dx) >= 40) show(index + (dx < 0 ? 1 : -1), dx < 0 ? 1 : -1, true);
      }
      swiping = false;
      release("pointer");
    };
    stage.addEventListener("pointerup", endPointer);
    stage.addEventListener("pointercancel", endPointer);
    stage.addEventListener("dragstart", (event) => event.preventDefault());
    stage.addEventListener(
      "click",
      (event) => {
        if (!swiped) return;
        swiped = false;
        event.preventDefault();
        event.stopPropagation();
      },
      true
    );

    reducedMotion.addEventListener("change", () => {
      showToggle();
      schedule();
    });

    // --- Start ------------------------------------------------------------
    // After the first photograph has loaded, so nothing competes with it.
    const start = () => {
      hero.classList.add("is-slider");
      hero.setAttribute("data-draw", "");
      controls.hidden = false;
      showToggle();
      schedule();
      load(1 % count);
    };
    const whenIdle = () => {
      if ("requestIdleCallback" in window) window.requestIdleCallback(start, { timeout: 1200 });
      else setTimeout(start, 200);
    };
    if (images[0].complete) whenIdle();
    else {
      images[0].addEventListener("load", whenIdle, { once: true });
      images[0].addEventListener("error", whenIdle, { once: true });
    }
  }

  // ------------------------------------------------------------------
  // Depth: the photograph and the prints follow a fine pointer by a few
  // pixels and drift a little as the hero scrolls. One eased rAF loop that
  // sleeps once it has settled and stops while the hero is out of view.
  // ------------------------------------------------------------------
  if (hero && stage) {
    const finePointer = window.matchMedia("(hover: hover) and (pointer: fine)");
    const target = { x: 0, y: 0, s: 0 };
    const now = { x: 0, y: 0, s: 0 };
    let frame = 0;
    let visible = false;

    const write = () => {
      stage.style.setProperty("--px", now.x.toFixed(4));
      stage.style.setProperty("--py", now.y.toFixed(4));
      stage.style.setProperty("--ps", now.s.toFixed(4));
    };
    const tick = () => {
      frame = 0;
      now.x += (target.x - now.x) * 0.075;
      now.y += (target.y - now.y) * 0.075;
      now.s += (target.s - now.s) * 0.14;
      const settled = Math.abs(target.x - now.x) < 0.001 && Math.abs(target.y - now.y) < 0.001 && Math.abs(target.s - now.s) < 0.001;
      if (settled) Object.assign(now, target);
      write();
      if (!settled) wake();
    };
    const wake = () => {
      if (!frame && visible && !reducedMotion.matches) frame = requestAnimationFrame(tick);
    };
    const onScroll = () => {
      const rect = stage.getBoundingClientRect();
      target.s = Math.min(1, Math.max(0, -rect.top / Math.max(1, rect.height)));
      wake();
    };
    const onMove = (event: PointerEvent) => {
      if (event.pointerType !== "mouse" || !finePointer.matches) return;
      const rect = stage.getBoundingClientRect();
      target.x = Math.min(1, Math.max(-1, ((event.clientX - rect.left) / rect.width) * 2 - 1));
      target.y = Math.min(1, Math.max(-1, ((event.clientY - rect.top) / rect.height) * 2 - 1));
      wake();
    };
    const rest = () => {
      target.x = 0;
      target.y = 0;
      wake();
    };
    const reset = () => {
      cancelAnimationFrame(frame);
      frame = 0;
      Object.assign(target, { x: 0, y: 0, s: 0 });
      Object.assign(now, target);
      write();
    };

    stage.addEventListener("pointermove", onMove);
    stage.addEventListener("pointerleave", rest);
    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      if (visible) {
        window.addEventListener("scroll", onScroll, { passive: true });
        onScroll();
      } else {
        window.removeEventListener("scroll", onScroll);
        cancelAnimationFrame(frame);
        frame = 0;
      }
    }).observe(stage);
    reducedMotion.addEventListener("change", () => (reducedMotion.matches ? reset() : wake()));
  }
</script>

<style>
  .hero {
    position: relative;
    background: var(--color-ivory);
  }

  /* ---- Stage ------------------------------------------------------------
     Phone first: the photograph on top, fading into the ivory copy below it
     (one continuous hero). From 900px the photograph fills the stage and the
     copy sits over its open left side. */
  .hero__stage {
    --px: 0;
    --py: 0;
    --ps: 0;
    --gutter: clamp(16px, 4.4vw, 64px);
    position: relative;
    isolation: isolate;
    overflow: clip;
    touch-action: pan-y;
  }

  .hero__media {
    position: relative;
    height: clamp(270px, 66vw, 470px);
    overflow: clip;
  }

  /* Wider than the screen and anchored right, so a phone shows the flowers
     (the right two-thirds of each photograph) rather than the empty wall. */
  .hero__scene {
    position: absolute;
    inset: 0 0 0 -45%;
    transform: translate3d(0, calc(var(--ps) * 14px), 0);
  }

  .hero__photo {
    position: absolute;
    inset: 0;
    background: var(--color-blush);
  }

  /* Without the script: the first photograph only. */
  .hero__photo:not(.is-active) {
    opacity: 0;
    visibility: hidden;
  }

  .hero__photo picture,
  .hero__photo img {
    display: block;
    width: 100%;
    height: 100%;
  }

  .hero__photo img {
    object-fit: cover;
    object-position: var(--pos, 50% 50%);
    user-select: none;
    -webkit-user-drag: none;
  }

  /* Each photograph keeps its own subject when the frame crops it. */
  .hero__photo--bouquets {
    --pos: 100% 22%;
  }
  .hero__photo--garlands {
    --pos: 100% 68%;
  }
  .hero__photo--pooja {
    --pos: 100% 78%;
  }

  /* With it: stacked, cross-fading, each arriving from the side it was asked
     from (--from: 1 next, -1 previous). */
  .hero.is-slider .hero__photo {
    visibility: visible;
    transform: translate3d(calc(var(--from, 1) * 26px), 0, 0) scale(1.015);
    transition:
      opacity 0.85s var(--ease-premium),
      transform 0.85s var(--ease-premium);
  }

  .hero.is-slider .hero__photo.is-active {
    opacity: 1;
    transform: none;
    z-index: 1;
  }

  .hero.is-slider .hero__photo.is-prep {
    transition: none;
  }

  /* The photograph dissolves into the ivory copy area. */
  .hero__veil {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    background: linear-gradient(180deg, transparent 52%, color-mix(in srgb, var(--color-ivory) 70%, transparent) 80%, var(--color-ivory) 97%);
  }

  /* ---- Copy ------------------------------------------------------------- */
  .hero__content {
    position: relative;
    z-index: 5;
    display: grid;
    gap: 1rem;
    margin-top: -2.9rem;
    padding: 0 var(--gutter) 0.25rem;
  }

  .hero__copies {
    display: grid;
  }

  /* Every campaign's copy occupies the same cell, so the hero keeps one
     height whichever is showing. */
  .hero__copy {
    grid-area: 1 / 1;
    display: grid;
    align-content: start;
    justify-items: start;
    gap: 0.85rem;
    opacity: 0;
    visibility: hidden;
  }

  .hero__copy.is-active {
    opacity: 1;
    visibility: visible;
  }

  .hero.is-slider .hero__copy {
    transform: translate3d(0, 10px, 0);
    transition:
      opacity 0.3s var(--ease-micro),
      transform 0.3s var(--ease-micro),
      visibility 0s linear 0.3s;
  }

  /* The text follows the photograph in. */
  .hero.is-slider .hero__copy.is-active {
    transform: none;
    transition:
      opacity 0.7s var(--ease-premium) 0.28s,
      transform 0.7s var(--ease-premium) 0.28s,
      visibility 0s;
  }

  .hero__eyebrow {
    margin: 0;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.26em;
    text-transform: uppercase;
