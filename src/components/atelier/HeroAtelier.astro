    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .hero__icon-play,
  .hero__btn--toggle.is-paused .hero__icon-pause {
    display: none;
  }

  .hero__btn--toggle.is-paused .hero__icon-play {
    display: block;
  }

  .hero__icon-play path {
    fill: currentColor;
    stroke: none;
  }

  .hero__dots {
    display: flex;
  }

  /* A 24x44 target around a small mark. */
  .hero__dot {
    width: 24px;
  }

  .hero__dot span {
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: var(--color-sage);
    transition:
      width 0.3s var(--ease-premium),
      background-color 0.3s var(--ease-premium);
  }

  .hero__dot:hover span {
    background: var(--color-moss);
  }

  .hero__dot[aria-current="true"] span {
    width: 18px;
    background: var(--color-berry);
  }

  .hero__count {
    margin: 0;
    min-width: 3.2em;
    padding-inline: 0.35rem;
    font-size: var(--step--1);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    text-align: center;
    color: var(--color-ink);
  }

  /* ---- Photo prints ------------------------------------------------------
     Hidden on a phone, where they would sit on the flowers. Slot wrapper:
     place and visibility (slide transition). Drift wrapper: parallax. */
  .hero__prints {
    display: none;
  }

  .hero__print-slot {
    position: absolute;
    top: var(--print-top, 1.5rem);
    right: var(--gutter);
    width: var(--print-w);
    transition:
      transform 0.9s var(--ease-premium),
      opacity 0.5s var(--ease-micro),
      visibility 0s;
  }

  .hero__print-slot[data-slot="b"] {
    transform: translate3d(-14px, var(--print-drop), 0);
  }

  .hero__print-slot[data-slot="off"] {
    opacity: 0;
    visibility: hidden;
    transform: translate3d(18px, calc(var(--print-drop) * 0.5), 0);
    transition:
      transform 0.9s var(--ease-premium),
      opacity 0.4s var(--ease-micro),
      visibility 0s linear 0.4s;
  }

  .hero__print-drift {
    transform: translate3d(calc(var(--px) * -15px), calc(var(--py) * -12px + var(--ps) * -22px), 0) rotateX(calc(var(--py) * -1.6deg)) rotateY(calc(var(--px) * 1.6deg));
  }

  .hero__print {
    display: block;
    padding: 7px 7px 0;
    background: #fffdf8;
    border-radius: 3px;
    color: var(--color-ink);
    text-decoration: none;
    pointer-events: auto;
    box-shadow:
      0 1px 2px rgba(39, 59, 50, 0.16),
      0 18px 30px -18px rgba(39, 59, 50, 0.5);
    transform: rotate(var(--tilt));
    transition:
      transform 0.9s var(--ease-premium),
      box-shadow 0.3s var(--ease-micro);
  }

  .hero__print-slot[data-slot="a"] .hero__print {
    --tilt: -5deg;
  }

  .hero__print-slot[data-slot="b"] .hero__print {
    --tilt: 6deg;
  }

  .hero__print-slot[data-slot="off"] .hero__print {
    --tilt: 0deg;
  }

  .hero__print:hover,
  .hero__print:focus-visible {
    transform: rotate(calc(var(--tilt) * 0.4)) translateY(-3px);
    box-shadow:
      0 1px 2px rgba(39, 59, 50, 0.16),
      0 24px 34px -18px rgba(39, 59, 50, 0.55);
  }

  .hero__print:focus-visible {
    outline: 3px solid var(--color-berry);
    outline-offset: 3px;
  }

  .hero__print picture,
  .hero__print img {
    display: block;
    width: 100%;
  }

  .hero__print img {
    height: auto;
    aspect-ratio: 5 / 6;
    object-fit: cover;
    background: var(--color-blush);
  }

  .hero__print-caption {
    display: block;
    padding: 0.45rem 0.1rem 0.6rem;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 0.875rem;
    line-height: 1.15;
    text-align: center;
  }

  /* ---- Hand-drawn accents ----------------------------------------------- */
  .hero__doodles {
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
    transform: translate3d(calc(var(--px) * -10px), calc(var(--py) * -8px + var(--ps) * -12px), 0);
  }

  .hero__doodle-set {
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.35s var(--ease-micro),
      visibility 0s linear 0.35s;
  }

  .hero[data-slide="bouquets"] .hero__doodle-set--bouquets,
  .hero[data-slide="garlands"] .hero__doodle-set--garlands,
  .hero[data-slide="pooja"] .hero__doodle-set--pooja {
    opacity: 1;
    visibility: visible;
    transition-delay: 0s;
  }

  .hero__doodle {
    display: block;
    overflow: visible;
  }

  .hero__doodle path {
    fill: none;
    stroke: var(--color-rose-deep);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }

  .hero__doodle--sprig {
    position: absolute;
    left: 5%;
    top: 9%;
    width: 30px;
    transform: rotate(-14deg);
  }

  .hero__doodle--sprig path {
    stroke: color-mix(in srgb, var(--color-sage-deep) 78%, var(--color-sage));
  }

  /* The annotation needs open space beside the flowers: desktop only. */
  .hero__note {
    display: none;
  }

  .hero__doodle--flourish {
    width: 64px;
    margin-bottom: -0.2rem;
  }

  @keyframes hero-draw {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes hero-note-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  /* Drawn again each time a slide becomes active (the script re-sets
     data-draw). */
  @media (prefers-reduced-motion: no-preference) {
    .hero[data-draw] .hero__doodles .hero__doodle path,
    .hero[data-draw] .hero__copy.is-active .hero__doodle--flourish path {
      animation: hero-draw 0.9s var(--ease-premium) both;
      animation-delay: calc(0.35s + var(--d, 0s));
    }

    .hero[data-draw] .hero__note-text {
      animation: hero-note-in 0.7s var(--ease-micro) 0.45s both;
    }
  }

  /* ---- Shortcut strip --------------------------------------------------- */
  .hero__strip {
    position: relative;
    z-index: 6;
    margin: 1.1rem var(--strip-gutter, 16px) 0;
    border: 1px solid color-mix(in srgb, var(--color-sage) 38%, transparent);
    border-radius: 22px;
