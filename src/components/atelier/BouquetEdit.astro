---
// Four comparable bouquets before the occasion carousel. The category page
// keeps the full public range; prices and basket behaviour use existing sources.
import type { EditProduct } from "../../data/atelierHome";
import { whatsappLink } from "../../config/storefront";

interface Props {
  products: EditProduct[];
  totalCount: number;
  browse?: { label: string; href: string }[];
  budget?: { label: string; href: string } | null;
}
const { products, totalCount, browse = [], budget = null } = Astro.props;
const availabilityHref = whatsappLink(
  ["Hi Fresh Petals, can you deliver flowers on a particular date?", "Date: ", "Delivery area: ", "Bouquet (if you've chosen one): "].join("\n")
);
const imageSizes = "(min-width: 1440px) 312px, (min-width: 1024px) 23vw, 46vw";
const flowerLine = (product: EditProduct) =>
  (product.flowerTypes ?? []).slice(0, 2).map((type) => type.toLowerCase()).join(" · ");
---

{products.length > 0 && (
  <section id="featured-bouquets" class="edit" aria-labelledby="edit-title">
    <div class="edit__head">
      <div>
        <p class="edit__eyebrow" data-reveal="fade">The bouquet edit</p>
        <h2 id="edit-title" class="edit__title" data-reveal="mask">Find <em>your bouquet.</em></h2>
      </div>
      <div class="edit__intro">
        <p class="edit__lede">Red roses, soft pinks, a little colour or something with lilies. A few favourites to help you begin.</p>
        <p class="edit__price-note">Starting bouquet prices. Delivery is quoted separately before you pay.</p>
      </div>
    </div>

    <ul class="edit__grid">
      {products.map((product, index) => (
        <li class="edit__item" data-featured-bouquet={product.slug}>
          <a href={`/products/${product.slug}`} class="edit__photo fp-photo" data-reveal="image" style={`--reveal-delay:${index * 60}ms`}>
            <img src={product.img.src} srcset={product.img.srcset} sizes={imageSizes}
              width={product.img.width} height={product.img.height} alt={product.name}
              loading="lazy" decoding="async" />
          </a>
          <div class="edit__info">
            <h3 class="edit__name"><a href={`/products/${product.slug}`}>{product.name}</a></h3>
            {flowerLine(product) && <p class="edit__flowers">{flowerLine(product)}</p>}
            <p class="edit__price fp-price">{product.priceLabel}</p>
          </div>
          <div class="edit__actions">
            <a class="edit__view" href={`/products/${product.slug}`} aria-label={`View ${product.name}`}>View bouquet <span aria-hidden="true">↗</span></a>
            <button type="button" class="edit__add" data-edit-add aria-label={`Add ${product.name} to basket`}
              data-cart-id={product.id} data-cart-slug={product.slug} data-cart-name={product.name}
              data-cart-image={product.image} data-cart-price-label={product.priceLabel} data-cart-category={product.category}>
              <span data-edit-label>Add to basket</span>
            </button>
            <span class="sr-only" role="status" data-edit-feedback={product.id}></span>
          </div>
        </li>
      ))}
    </ul>

    <div class="edit__footer">
      <div>
        <nav class="edit__browse" aria-label="Browse bouquet types">
          {browse.map((link) => <a href={link.href}>{link.label}</a>)}
          {budget && <a href={budget.href}>{budget.label}</a>}
        </nav>
        <a class="edit__availability" href={availabilityHref} target="_blank" rel="noopener noreferrer">Need a particular date? Check availability <span aria-hidden="true">↗</span></a>
      </div>
      <a href="/categories/bouquets" class="fp-btn-outline edit__all">{`View all ${totalCount} ${totalCount === 1 ? "bouquet" : "bouquets"}`} <span aria-hidden="true">→</span></a>
    </div>
  </section>
)}

<script>
  import { addToCart } from "../../utils/cart";

  document.querySelectorAll<HTMLButtonElement>("[data-edit-add]").forEach((button) => {
    let reset = 0;
    button.addEventListener("click", () => {
      const { cartId = "", cartSlug = "", cartName = "", cartImage = "", cartPriceLabel = "", cartCategory = "" } = button.dataset;
      addToCart({ id: cartId, slug: cartSlug, name: cartName, image: cartImage, priceLabel: cartPriceLabel, category: cartCategory }, 1);
      const feedback = button.parentElement?.querySelector<HTMLElement>("[data-edit-feedback]");
      const label = button.querySelector<HTMLElement>("[data-edit-label]");
      window.clearTimeout(reset);
      if (feedback) feedback.textContent = `${cartName} added to your basket`;
      if (label) label.textContent = "Added ✓";
      button.classList.add("is-added");
      reset = window.setTimeout(() => {
        if (feedback) feedback.textContent = "";
        if (label) label.textContent = "Add to basket";
        button.classList.remove("is-added");
      }, 2200);
    });
  });
</script>

<style>
  .edit {
    background: var(--color-paper);
    padding: clamp(2.75rem, 5vw, 5rem) clamp(16px, 4vw, 56px);
    scroll-margin-top: calc(var(--header-h) + 20px);
  }

  .edit__head, .edit__grid, .edit__footer {
    max-width: 1320px;
    margin-inline: auto;
  }

  .edit__head {
    display: grid;
    gap: 1.25rem 3rem;
    margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
  }

  .edit__eyebrow {
    margin: 0 0 0.75rem;
    color: var(--color-rose-deep);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .edit__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 360;
    font-size: clamp(2.4rem, 1.6rem + 3vw, 4.5rem);
    line-height: 1.02;
    letter-spacing: -0.035em;
  }
  .edit__title em { color: var(--color-rose-deep); font-style: italic; }
  .edit__lede { max-width: 44ch; margin: 0; color: var(--color-moss); line-height: 1.6; }
  .edit__price-note { margin: 0.5rem 0 0; color: var(--color-moss); font-size: 0.875rem; line-height: 1.5; }

  .edit__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.75rem 0.85rem;
    list-style: none;
    padding: 0;
    margin-block: 0;
  }
  .edit__item { display: flex; flex-direction: column; min-width: 0; }
  .edit__photo { display: block; aspect-ratio: 4 / 5; border-radius: 16px; }
  .edit__photo img { transition: transform 0.7s var(--ease-premium); }
  .edit__photo:hover img { transform: scale(1.035); }

  .edit__info { padding-top: 0.85rem; }
  .edit__name { min-height: 2.5em; margin: 0; font-family: var(--font-display); font-weight: 440; font-size: clamp(1.125rem, 0.95rem + 0.65vw, 1.5rem); line-height: 1.25; }
  .edit__name a { color: var(--color-ink); text-decoration: none; }
  .edit__name a:hover { text-decoration: underline; text-underline-offset: 0.15em; }
  .edit__flowers { min-height: 2.8em; margin: 0.25rem 0 0; color: var(--color-moss); font-size: 0.8125rem; line-height: 1.4; }
  .edit__price { margin: 0.5rem 0 0; font-size: 1rem; color: var(--color-berry); }

  .edit__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 0.35rem 0.75rem; margin-top: auto; padding-top: 0.65rem; }
  .edit__view { display: inline-flex; align-items: center; justify-content: space-between; gap: 0.4rem; min-height: 44px; color: var(--color-ink); font-size: 0.8125rem; font-weight: 600; text-decoration: underline; text-underline-offset: 0.25em; }
  .edit__add { display: none; justify-content: center; align-items: center; min-height: 44px; padding: 0.5rem 0.75rem; border: 1px solid var(--color-line); border-radius: 999px; background: transparent; color: var(--color-ink); font: inherit; font-size: 0.8125rem; font-weight: 600; cursor: pointer; transition: background-color 0.2s, border-color 0.2s; }
  :global(html.js) .edit__add { display: inline-flex; }
  .edit__add:hover { border-color: var(--color-ink); background: var(--color-ivory); }
  .edit__add.is-added { border-color: var(--color-ink); background: var(--color-ink); color: var(--color-ivory); }

  .edit__footer { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1.25rem 2rem; margin-top: 2rem; padding-top: 1rem; border-top: 1px solid var(--color-line); }
  .edit__browse { display: flex; flex-wrap: wrap; gap: 0 1.2rem; }
  .edit__browse a { display: inline-flex; align-items: center; min-height: 44px; color: var(--color-ink); font-size: 0.875rem; text-underline-offset: 0.25em; }
  .edit__availability { display: inline-flex; align-items: center; gap: 0.35rem; min-height: 44px; color: var(--color-moss); font-size: 0.8125rem; text-underline-offset: 0.25em; }
  .edit__all { flex-shrink: 0; gap: 1rem; }

  @media (max-width: 479px) {
    .edit__actions { display: grid; gap: 0; }
    .edit__view { justify-content: flex-start; }
    .edit__all { width: 100%; justify-content: center; }
  }
  @media (min-width: 768px) {
    .edit__head { grid-template-columns: 1.15fr 1fr; align-items: end; }
    .edit__grid { gap: 1.75rem 1.5rem; }
  }
  @media (min-width: 1024px) {
    .edit__grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
</style>
