---
// A2. Hero gallery — the other photographs from the original homepage
// banners, in one horizontal sequence. It is a native scroll-snap strip,
// so touch swipe, trackpads and shift-wheel all work without script; JS
// adds mouse drag, buttons, arrow keys and the continuous depth effect
// (slides ease back and soften as they leave the centre). Every slide
// keeps its photograph's own aspect ratio — nothing is cropped.
import { getHeroReel } from "../../data/atelierHome";

const slides = getHeroReel();
---

<section class="reel" aria-labelledby="reel-title">
  <div class="reel__head">
    <div>
      <p class="reel__eyebrow" data-reveal="fade">From the shop</p>
      <h2 id="reel-title" class="reel__title" data-reveal="mask">Flowers for every day of the week</h2>
    </div>
    <div class="reel__controls" data-reel-controls hidden>
      <p class="reel__counter" aria-hidden="true"><span data-reel-current>01</span> / {String(slides.length).padStart(2, "0")}</p>
      <button type="button" class="reel__btn" data-reel-prev aria-label="Previous photograph">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
      </button>
      <button type="button" class="reel__btn" data-reel-next aria-label="Next photograph">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
      </button>
    </div>
  </div>

  <div class="reel__viewport" data-reel tabindex="0" role="region" aria-roledescription="carousel" aria-label="Featured flowers — use the arrow keys to move">
    <ul class="reel__track" data-reel-track>
      {
        slides.map((slide, index) => (
          <li
            class="reel__slide"
            data-reel-slide
            aria-roledescription="slide"
            aria-label={`${slide.title}, ${index + 1} of ${slides.length}`}
            style={`--ar: ${slide.photo.width / slide.photo.height}`}
          >
            <div class="reel__stage">
            <a class="reel__photo" href={slide.href} tabindex="-1" aria-hidden="true" draggable="false">
              <img
                src={slide.photo.src}
                srcset={slide.photo.srcset}
                sizes="(min-width: 1024px) 760px, 86vw"
                width={slide.photo.width}
                height={slide.photo.height}
                alt=""
                loading="lazy"
                decoding="async"
                draggable="false"
              />
            </a>
            </div>
            <div class="reel__caption">
              <p class="reel__kicker">{slide.eyebrow}</p>
              <h3 class="reel__name">{slide.title}</h3>
              <p class="reel__text">{slide.text}</p>
              <a class="reel__cta" href={slide.href} draggable="false">
                {slide.cta}
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
              </a>
              <span class="sr-only">Photograph: {slide.photo.alt}</span>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  const viewport = document.querySelector<HTMLElement>("[data-reel]");
  const slides = [...(viewport?.querySelectorAll<HTMLElement>("[data-reel-slide]") ?? [])];
  const controls = document.querySelector<HTMLElement>("[data-reel-controls]");
  const current = document.querySelector<HTMLElement>("[data-reel-current]");
  const prev = document.querySelector<HTMLButtonElement>("[data-reel-prev]");
  const next = document.querySelector<HTMLButtonElement>("[data-reel-next]");
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (viewport && slides.length) {
    viewport.classList.add("is-enhanced");
    if (controls) controls.hidden = false;

    let index = 0;
    let raf = 0;

    // Edge padding so the first and last photographs can sit in the centre.
    const measure = () => {
      const w = viewport.clientWidth;
      viewport.style.setProperty("--edge-start", `${Math.max(16, (w - slides[0].offsetWidth) / 2)}px`);
      viewport.style.setProperty("--edge-end", `${Math.max(16, (w - slides[slides.length - 1].offsetWidth) / 2)}px`);
    };

    const centreOf = (slide: HTMLElement) => slide.offsetLeft + slide.offsetWidth / 2;

    const update = () => {
      raf = 0;
      const mid = viewport.scrollLeft + viewport.clientWidth / 2;
      let best = 0;
      let bestD = Infinity;
      slides.forEach((slide, i) => {
        const d = (centreOf(slide) - mid) / Math.max(1, slide.offsetWidth);
        const a = Math.min(1.5, Math.abs(d));
        if (Math.abs(d) < bestD) {
          bestD = Math.abs(d);
          best = i;
        }
        slide.style.setProperty("--d", a.toFixed(3));
        slide.style.setProperty("--dir", Math.sign(d).toString());
      });
      if (best !== index) {
        index = best;
      }
      slides.forEach((slide, i) => slide.classList.toggle("is-current", i === index));
      if (current) current.textContent = String(index + 1).padStart(2, "0");
      if (prev) prev.disabled = viewport.scrollLeft <= 2;
      if (next) next.disabled = viewport.scrollLeft >= viewport.scrollWidth - viewport.clientWidth - 2;
    };
    const schedule = () => {
      if (!raf) raf = requestAnimationFrame(update);
    };

    const go = (i: number) => {
      const target = slides[Math.max(0, Math.min(slides.length - 1, i))];
      viewport.scrollTo({ left: centreOf(target) - viewport.clientWidth / 2, behavior: reduce ? "auto" : "smooth" });
    };

    prev?.addEventListener("click", () => go(index - 1));
    next?.addEventListener("click", () => go(index + 1));
    viewport.addEventListener("keydown", (event) => {
      if (event.key === "ArrowRight") {
        event.preventDefault();
        go(index + 1);
      } else if (event.key === "ArrowLeft") {
        event.preventDefault();
        go(index - 1);
      } else if (event.key === "Home") {
        event.preventDefault();
        go(0);
      } else if (event.key === "End") {
        event.preventDefault();
        go(slides.length - 1);
      }
    });

    // Mouse drag (touch and trackpads already scroll natively).
    let pointerId = -1;
    let startX = 0;
    let startLeft = 0;
    let moved = false;
    viewport.addEventListener("pointerdown", (event) => {
      if (event.pointerType !== "mouse" || event.button !== 0) return;
      pointerId = event.pointerId;
      startX = event.clientX;
      startLeft = viewport.scrollLeft;
      moved = false;
    });
    viewport.addEventListener("pointermove", (event) => {
      if (event.pointerId !== pointerId) return;
      const dx = event.clientX - startX;
      if (!moved && Math.abs(dx) > 6) {
        moved = true;
        viewport.setPointerCapture(pointerId);
        viewport.classList.add("is-dragging");
      }
      if (moved) viewport.scrollLeft = startLeft - dx;
    });
    const end = (event: PointerEvent) => {
      if (event.pointerId !== pointerId) return;
      pointerId = -1;
      if (!moved) return;
      viewport.classList.remove("is-dragging");
      const mid = viewport.scrollLeft + viewport.clientWidth / 2;
      let nearest = 0;
      slides.forEach((slide, i) => {
        if (Math.abs(centreOf(slide) - mid) < Math.abs(centreOf(slides[nearest]) - mid)) nearest = i;
      });
      go(nearest);
    };
    viewport.addEventListener("pointerup", end);
    viewport.addEventListener("pointercancel", end);
    viewport.addEventListener(
      "click",
      (event) => {
        if (moved) {
          event.preventDefault();
          event.stopPropagation();
          moved = false;
        }
      },
      true
    );

    viewport.addEventListener("scroll", schedule, { passive: true });
    window.addEventListener("resize", () => {
      measure();
      schedule();
    });
    requestAnimationFrame(() => {
      measure();
      update();
    });
  }
</script>

<style>
  .reel {
    position: relative;
    background: var(--color-paper);
    padding: clamp(3.5rem, 7vw, 6rem) 0 clamp(3rem, 6vw, 5rem);
    overflow: hidden;
    border-top: 1px solid var(--color-line);
  }

  .reel__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    max-width: 1320px;
    margin: 0 auto;
    padding: 0 clamp(16px, 4vw, 48px);
  }

  .reel__eyebrow {
    margin: 0 0 0.8rem;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-rose-deep);
  }

  .reel__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 360;
    font-size: clamp(2.1rem, 1.2rem + 3.6vw, 4.3rem);
    line-height: 0.98;
    letter-spacing: -0.03em;
    max-width: 14ch;
  }

  .reel__controls {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  .reel__controls[hidden] {
    display: none;
  }

  .reel__counter {
    margin: 0 0.75rem 0 0;
    font-variant-numeric: tabular-nums;
    font-size: 0.875rem;
    letter-spacing: 0.1em;
    color: var(--color-moss);
  }

  .reel__btn {
    display: inline-grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 999px;
    border: 1px solid var(--color-line-strong);
    background: transparent;
    color: var(--color-ink);
    cursor: pointer;
    transition: background-color 0.18s var(--ease-micro), border-color 0.18s var(--ease-micro), opacity 0.18s;
  }

  .reel__btn:hover:not(:disabled) {
    background: var(--color-ivory);
    border-color: var(--color-ink);
  }

  .reel__btn:disabled {
    opacity: 0.35;
    cursor: default;
  }

  .reel__btn svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
  }

  /* ---- The strip ---- */
  .reel__viewport {
    --h: min(52svh, 500px);
    --edge-start: clamp(16px, 4vw, 48px);
    --edge-end: clamp(16px, 4vw, 48px);
    margin-top: clamp(2rem, 4vw, 3rem);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    outline-offset: -3px;
  }

  .reel__viewport::-webkit-scrollbar {
    display: none;
  }

  .reel__viewport:focus-visible {
    outline: 3px solid var(--color-apricot-deep);
  }

  .reel__viewport.is-dragging {
    cursor: grabbing;
    scroll-snap-type: none;
    user-select: none;
  }

  .reel__track {
    list-style: none;
    margin: 0;
    padding: 1rem var(--edge-end) 1.5rem var(--edge-start);
    display: flex;
    align-items: flex-start;
    gap: clamp(1rem, 3vw, 2.5rem);
    width: max-content;
  }

  .reel__slide {
    --d: 0;
    /* Width follows the photograph: as tall as --h allows, never wider than
       the screen. */
    width: min(calc(var(--h) * var(--ar)), 86vw);
    flex: none;
    scroll-snap-align: center;
  }

  /* Every slide's photograph sits in a stage of the same height, centred,
     so captions line up across portrait and landscape pictures. */
  .reel__stage {
    display: flex;
    align-items: center;
    height: var(--h);
  }

  .reel__photo {
    display: block;
    width: 100%;
    aspect-ratio: var(--ar);
    border-radius: 6px;
    overflow: hidden;
    background: var(--color-linen);
    box-shadow: 0 30px 50px -32px rgba(23, 61, 45, 0.45);
    -webkit-user-drag: none;
  }

  .reel__photo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .reel__caption {
    max-width: 44ch;
    padding-top: 1.1rem;
  }

  .reel__kicker {
    margin: 0;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-rose-deep);
  }

  .reel__name {
    margin: 0.4rem 0 0;
    font-family: var(--font-display);
    font-weight: 380;
    font-size: clamp(1.6rem, 1.2rem + 1.4vw, 2.4rem);
    line-height: 1.02;
    letter-spacing: -0.02em;
  }

  .reel__text {
    margin: 0.5rem 0 0;
    color: var(--color-moss);
    line-height: 1.5;
    font-size: 0.9375rem;
  }

  .reel__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    margin-top: 0.4rem;
    color: var(--color-ink);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--color-apricot);
    text-underline-offset: 0.3em;
  }

  .reel__cta svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    transition: translate 0.2s var(--ease-micro);
  }

  .reel__cta:hover svg {
    translate: 3px 0;
  }

  /* Continuous depth: a function of each slide's distance from centre,
     updated on every scroll frame, so slides glide rather than switch. */
  :global(html.motion) .reel__viewport.is-enhanced .reel__photo {
    transform: perspective(1400px) rotateY(calc(var(--dir, 0) * var(--d) * -7deg)) scale(calc(1 - var(--d) * 0.08));
    transform-origin: 50% 100%;
    filter: saturate(calc(1 - var(--d) * 0.35));
  }

  :global(html.motion) .reel__viewport.is-enhanced .reel__caption {
    opacity: calc(1 - var(--d) * 0.85);
    translate: 0 calc(var(--d) * 10px);
  }

  @media (max-width: 767px) {
    .reel__head {
      flex-direction: column;
      align-items: flex-start;
    }
    .reel__controls {
      align-self: stretch;
      justify-content: flex-end;
    }
    .reel__viewport {
      --h: min(48svh, 400px);
    }
  }
</style>
