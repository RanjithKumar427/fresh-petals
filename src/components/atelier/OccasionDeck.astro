---
// B. Shop by occasion — a cinematic carousel of the actual occasions that
// have public bouquets, in the owner's order (data in
// atelierHome.getOccasionDeck), each card a link to that occasion's page,
// followed by "View all occasions" (/occasions). Bouquet types and the
// budget shortcut are with the bouquets (BouquetEdit).
// Occasion membership comes from the admin's assignments, read when the
// homepage is rendered (on request, CDN-cached and purged when an assignment
// changes), so the cards and their counts are current without a script.
//
// The HTML is a plain, responsive set of linked cards — that is what shows
// without JavaScript, with reduced motion, and for one or two occasions.
// With three or more, the script lays the same cards out as a ring: a large
// centre card with smaller, dimmer neighbours behind it. One element per
// occasion; nothing is duplicated. Where each card sits is worked out in
// src/utils/occasionCarousel.ts and applied as a data-slot attribute; CSS
// transitions (transform and opacity only) do the moving.
import { getOccasionDeck } from "../../data/atelierHome";
import type { Membership } from "../../data/occasionJourneys";

interface Props {
  membership: Membership;
}

const panels = getOccasionDeck(Astro.props.membership);
const shown = panels.length;
// The centre card's width at each breakpoint (--occ-w below).
const sizes = "(min-width: 1440px) 340px, (min-width: 1024px) 310px, (min-width: 768px) 280px, 62vw";
const two = (value: number) => String(value).padStart(2, "0");
---

{
  shown > 0 && (
    <section class="occ" id="occasions" aria-labelledby="deck-title" data-deck-section data-occ-section data-count={shown}>
      <div class="occ__head">
        <h2 id="deck-title" class="occ__title" data-reveal="mask">Every occasion deserves flowers.</h2>
        <p class="occ__sub" data-reveal="fade">Find something beautiful for their moment.</p>
      </div>

      <div class="occ__carousel" data-occ-carousel>
        <div class="occ__stage" data-occ-stage>
          <ul class="occ__track" data-occ-track>
            {panels.map((panel) => (
              <li class="occ__card" data-occ-card data-occasion-key={panel.key} data-occ-name={panel.title} style={`--occ-focus: ${panel.focus}`}>
                <a href={panel.href} class="occ__link" draggable="false">
                  <span class="occ__photo">
                    <img
                      src={panel.image.src}
                      srcset={panel.image.srcset}
                      sizes={sizes}
                      width={panel.image.width}
                      height={panel.image.height}
                      alt=""
                      loading="lazy"
                      decoding="async"
                      draggable="false"
                    />
                  </span>
                  <span class="occ__caption">
                    <span class="occ__name">{panel.title}</span>
                    <span class="occ__count">{panel.countLabel}</span>
                    <span class="occ__cue">
                      {panel.cue}
                      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
                    </span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>

        {shown >= 3 && (
          <div class="occ__controls" data-occ-controls hidden>
            <button type="button" class="occ__btn" data-occ-prev aria-label="Previous occasion">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
            </button>
            <p class="occ__position" aria-hidden="true"><span data-occ-current>01</span> / {two(shown)}</p>
            <button type="button" class="occ__btn" data-occ-next aria-label="Next occasion">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
            </button>
            <button type="button" class="occ__btn occ__btn--toggle" data-occ-toggle data-state="playing" aria-label="Pause automatic rotation">
              <svg class="occ__icon-pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6v12M15 6v12" /></svg>
              <svg class="occ__icon-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8.5 5.5v13l10-6.5z" /></svg>
            </button>
          </div>
        )}
        <p class="sr-only" aria-live="polite" data-occ-status></p>
      </div>

      <p class="occ__more">
        <a class="occ__more-link occ__more-link--primary" href="/occasions">View all occasions</a>
        <a class="occ__more-link" href="/categories/bouquets">Not sure yet? <span>Browse all bouquets</span></a>
      </p>
    </section>
  )
}

<script>
  import { enqueueStep, planStep, restingSlots, visibleRadius, wrapIndex, type Direction, type Side, type Slot } from "../../utils/occasionCarousel";

  const STEP_MS = 800;
  // A step that has another press waiting behind it.
  const QUEUED_MS = 460;
  const AUTOPLAY_MS = 4500;

  /**
   * Lays the section's cards out as a ring and wires its controls. Returns
   * the function that undoes all of it (back to the plain linked cards), or
   * null when there is nothing to enhance.
   */
  function enhance(section: HTMLElement): (() => void) | null {
    const carousel = section.querySelector<HTMLElement>("[data-occ-carousel]");
    const stage = section.querySelector<HTMLElement>("[data-occ-stage]");
    const track = section.querySelector<HTMLElement>("[data-occ-track]");
    const controls = section.querySelector<HTMLElement>("[data-occ-controls]");
    const toggle = section.querySelector<HTMLButtonElement>("[data-occ-toggle]");
    const current = section.querySelector<HTMLElement>("[data-occ-current]");
    const status = section.querySelector<HTMLElement>("[data-occ-status]");
    const cards = [...section.querySelectorAll<HTMLElement>("[data-occ-card]")];
    const links = cards.map((card) => card.querySelector<HTMLAnchorElement>("a")).filter((link): link is HTMLAnchorElement => !!link);
    const count = cards.length;
    if (!carousel || !stage || !track || !controls || !toggle || count < 3 || links.length !== count) return null;

    const listeners = new AbortController();
    const on = { signal: listeners.signal };
    const wide = window.matchMedia("(min-width: 768px)");
    const observers: IntersectionObserver[] = [];
    // Why autoplay is not running; it runs only while this is empty.
    const pauses = new Set<string>(["offscreen"]);
    let alive = true;
    let active = 0;
    let radius = visibleRadius(count, wide.matches);
    let moving = false;
    let queue: Direction[] = [];
    // Arrow keys pressed on a card: focus goes with the centre card.
    let roving = false;
    let stepTimer = 0;
    let wrapTimer = 0;
    let autoTimer = 0;
    let clickTimer = 0;

    /** Puts cards in a slot at once, with no transition (hidden cards, the first layout, tidying up). */
    const jump = (moves: [HTMLElement, Slot][]) => {
      if (moves.length === 0) return;
      for (const [card, slot] of moves) {
        card.classList.add("is-jump");
        card.dataset.slot = slot;
      }
      // One style flush for the batch, so the cards are in place before transitions are allowed again.
      void stage.offsetWidth;
      for (const [card] of moves) card.classList.remove("is-jump");
    };

    const glide = (card: HTMLElement, slot: Slot, ms: number) => {
      card.style.setProperty("--occ-ms", `${Math.round(ms)}ms`);
      card.dataset.slot = slot;
    };

    const focusedCard = () => cards.findIndex((card) => card.contains(document.activeElement));

    /** Every card in its resting slot. Also the recovery path: whatever a step left behind is put right here. */
    const settle = () => {
      const rest = restingSlots(count, active, radius);
      const focused = focusedCard();
      // A card must not be hidden while it holds focus.
      if (focused >= 0 && rest[focused].startsWith("off")) links[active].focus({ preventScroll: true });
      jump(cards.flatMap((card, index): [HTMLElement, Slot][] => (card.dataset.slot === rest[index] ? [] : [[card, rest[index]]])));
    };

    const showPosition = () => {
      if (current) current.textContent = String(active + 1).padStart(2, "0");
    };

    const announce = () => {
      if (status) status.textContent = `${cards[active].dataset.occName ?? ""}, ${active + 1} of ${count}`;
    };

    const syncAutoplay = () => {
      const shouldRun = pauses.size === 0;
      carousel.dataset.occAutoplay = shouldRun ? "running" : "paused";
      if (shouldRun === (autoTimer !== 0)) return;
      if (shouldRun) {
        // Always a fresh, full interval: no catching up on time spent paused.
        autoTimer = window.setTimeout(tick, AUTOPLAY_MS);
      } else {
        window.clearTimeout(autoTimer);
        autoTimer = 0;
      }
    };

    const setPause = (reason: string, paused: boolean) => {
      if (paused) pauses.add(reason);
      else pauses.delete(reason);
      syncAutoplay();
    };

    const run = (direction: Direction, manual: boolean) => {
      if (!section.isConnected) return teardown();
      moving = true;
      if (manual) setPause("moving", true);
      const ms = queue.length > 0 ? QUEUED_MS : STEP_MS;
      const plan = planStep(count, active, direction, radius);
      const next = wrapIndex(active + direction, count);

      const focused = focusedCard();
      const leaving = focused >= 0 && (plan[focused].kind === "exit" || plan[focused].kind === "wrap");
      if (focused >= 0 && (roving || leaving)) links[next].focus({ preventScroll: true });

      // Hidden cards go to the side they will come in from before anything moves.
      jump(
        plan.flatMap((move, index): [HTMLElement, Slot][] => {
          const target = move.kind === "enter" ? move.from : move.kind === "park" ? move.to : null;
          return target && cards[index].dataset.slot !== target ? [[cards[index], target]] : [];
        })
      );

      const wrapping: { card: HTMLElement; from: Side; to: Slot }[] = [];
      plan.forEach((move, index) => {
        const card = cards[index];
        if (move.kind === "glide" || move.kind === "enter") glide(card, move.to, ms);
        else if (move.kind === "exit") glide(card, move.via, ms);
        else if (move.kind === "wrap") {
          // Out on one side, across while hidden, back in on the other.
          glide(card, move.via, ms * 0.42);
          wrapping.push({ card, from: move.from, to: move.to });
        }
      });
      if (wrapping.length > 0) {
        wrapTimer = window.setTimeout(() => {
          wrapTimer = 0;
          jump(wrapping.map(({ card, from }): [HTMLElement, Slot] => [card, from]));
          for (const { card, to } of wrapping) glide(card, to, ms * 0.58);
        }, ms * 0.42 + 20);
      }

      active = next;
      showPosition();
      if (manual) announce();
      // A timer, not transitionend: a cancelled or skipped transition still ends the step.
      stepTimer = window.setTimeout(finish, ms + 80);
    };

    const finish = () => {
      window.clearTimeout(stepTimer);
      window.clearTimeout(wrapTimer);
      stepTimer = wrapTimer = 0;
      if (!alive) return;
      settle();
      moving = false;
      const queued = queue[0];
      queue = queue.slice(1);
      if (queued !== undefined) {
        run(queued, true);
      } else {
        roving = false;
        setPause("moving", false);
      }
    };

    /** A press from a control, a key or a swipe. While a step runs, presses wait in a short queue. */
    const step = (direction: Direction) => {
      if (!moving) return run(direction, true);
      queue = enqueueStep(queue, direction);
      setPause("moving", true);
    };

    const tick = () => {
      autoTimer = window.setTimeout(tick, AUTOPLAY_MS);
      if (!section.isConnected) return teardown();
      if (!moving) run(1, false);
    };

    const showToggle = () => {
      const paused = pauses.has("user");
      toggle.dataset.state = paused ? "paused" : "playing";
      toggle.setAttribute("aria-label", paused ? "Play automatic rotation" : "Pause automatic rotation");
    };

    const teardown = () => {
      if (!alive) return;
      alive = false;
      listeners.abort();
      for (const observer of observers) observer.disconnect();
      for (const timer of [stepTimer, wrapTimer, autoTimer, clickTimer]) window.clearTimeout(timer);
      section.classList.remove("is-enhanced", "is-dragging");
      for (const card of cards) {
        card.classList.remove("is-jump");
        card.style.removeProperty("--occ-ms");
        delete card.dataset.slot;
      }
      track.style.removeProperty("--occ-drag");
      for (const name of ["role", "aria-roledescription", "aria-label"]) carousel.removeAttribute(name);
      delete carousel.dataset.occAutoplay;
      controls.hidden = true;
      if (status) status.textContent = "";
    };

    try {
      // Controls.
      section.querySelector("[data-occ-prev]")?.addEventListener("click", () => step(-1), on);
      section.querySelector("[data-occ-next]")?.addEventListener("click", () => step(1), on);
      toggle.addEventListener(
        "click",
        () => {
          // The visitor's own choice: stays paused until Play is pressed.
          setPause("user", !pauses.has("user"));
          showToggle();
        },
        on
      );

      // Keyboard: left/right anywhere inside the carousel.
      carousel.addEventListener(
        "keydown",
        (event) => {
          if (event.altKey || event.ctrlKey || event.metaKey || event.shiftKey) return;
          if (event.key !== "ArrowLeft" && event.key !== "ArrowRight") return;
          event.preventDefault();
          if (focusedCard() >= 0) roving = true;
          step(event.key === "ArrowRight" ? 1 : -1);
        },
        on
      );

      // Autoplay waits while the carousel is being used…
      carousel.addEventListener("pointerenter", (event) => event.pointerType === "mouse" && setPause("hover", true), on);
      carousel.addEventListener("pointerleave", () => setPause("hover", false), on);
      carousel.addEventListener("focusin", (event) => (event.target as Element).matches(":focus-visible") && setPause("focus", true), on);
      carousel.addEventListener("focusout", (event) => !carousel.contains(event.relatedTarget as Node | null) && setPause("focus", false), on);

      // …while the tab is hidden (a step in progress is completed at once, not replayed later)…
      const onVisibility = () => {
        setPause("hidden", document.hidden);
        if (document.hidden && moving) {
          queue = [];
          finish();
        }
      };
      document.addEventListener("visibilitychange", onVisibility, on);
      if (document.hidden) pauses.add("hidden");

      // …and while the stage is out of view.
      const inView = new IntersectionObserver(([entry]) => setPause("offscreen", !(entry.isIntersecting && entry.intersectionRatio >= 0.25)), { threshold: [0.3] });
      inView.observe(stage);
      observers.push(inView);

      // Cards waiting off stage are clipped, so the browser would not fetch
      // their lazy photographs until they slid in. Fetch them all as the
      // section approaches instead.
      const nearby = new IntersectionObserver(
        (entries) => {
          if (!entries.some((entry) => entry.isIntersecting)) return;
          for (const image of section.querySelectorAll<HTMLImageElement>("[data-occ-card] img")) image.loading = "eager";
          nearby.disconnect();
        },
        { rootMargin: "900px 0px" }
      );
      nearby.observe(section);
      observers.push(nearby);

      // Swipe / drag. Vertical scrolling stays native (touch-action: pan-y);
      // a gesture becomes a drag only once it is clearly horizontal.
      let pointerId = -1;
      let startX = 0;
      let startY = 0;
      let dragX = 0;
      let dragging = false;
      let suppressClick = false;

      stage.addEventListener(
        "pointerdown",
        (event) => {
          if (event.button !== 0 || !event.isPrimary) return;
          pointerId = event.pointerId;
          startX = event.clientX;
          startY = event.clientY;
          dragX = 0;
          dragging = false;
        },
        on
      );

      stage.addEventListener(
        "pointermove",
        (event) => {
          if (event.pointerId !== pointerId) return;
          const dx = event.clientX - startX;
          const dy = event.clientY - startY;
          if (!dragging) {
            if (Math.abs(dx) < 12 || Math.abs(dx) < Math.abs(dy) * 1.3) return;
            dragging = true;
            stage.setPointerCapture(pointerId);
            section.classList.add("is-dragging");
            setPause("drag", true);
          }
          dragX = dx;
          // The ring leans a little with the finger; the step itself happens on release.
          track.style.setProperty("--occ-drag", `${(dx * 0.28).toFixed(1)}px`);
        },
        on
      );

      const endDrag = (event: PointerEvent) => {
        if (event.pointerId !== pointerId) return;
        pointerId = -1;
        if (!dragging) return;
        dragging = false;
        section.classList.remove("is-dragging");
        track.style.removeProperty("--occ-drag");
        setPause("drag", false);
        if (event.type !== "pointerup") return;
        // Only the click this drag produces is swallowed; the next tap is an ordinary one.
        suppressClick = true;
        window.clearTimeout(clickTimer);
        clickTimer = window.setTimeout(() => (suppressClick = false), 60);
        if (Math.abs(dragX) >= 44) step(dragX < 0 ? 1 : -1);
      };
      stage.addEventListener("pointerup", endDrag, on);
      stage.addEventListener("pointercancel", endDrag, on);

      stage.addEventListener(
        "click",
        (event) => {
          if (!suppressClick) return;
          suppressClick = false;
          event.preventDefault();
          event.stopPropagation();
        },
        { capture: true, signal: listeners.signal }
      );
      // No ghost image of the link or photograph while dragging with a mouse.
      stage.addEventListener("dragstart", (event) => event.preventDefault(), on);

      // Two neighbours each side need room; below 768px only one is on stage.
      wide.addEventListener(
        "change",
        () => {
          radius = visibleRadius(count, wide.matches);
          if (moving) {
            queue = [];
            finish();
          } else settle();
        },
        on
      );

      // Everything is wired: switch from the plain cards to the ring.
      carousel.setAttribute("role", "group");
      carousel.setAttribute("aria-roledescription", "carousel");
      carousel.setAttribute("aria-label", "Occasions");
      section.classList.add("is-enhanced");
      settle();
      controls.hidden = false;
      showPosition();
      showToggle();
      syncAutoplay();
    } catch {
      teardown();
      return null;
    }
    return teardown;
  }

  const mounted = new WeakMap<Element, () => void>();

  /** The ring is for motion; with reduced motion (now or later in the session) the plain cards stay. */
  function mount(section: HTMLElement) {
    if (mounted.has(section)) return;
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");
    let stop: (() => void) | null = null;
    const sync = () => {
      stop?.();
      stop = reduced.matches ? null : enhance(section);
    };
    reduced.addEventListener("change", sync);
    sync();
    mounted.set(section, () => {
      reduced.removeEventListener("change", sync);
      stop?.();
      stop = null;
      mounted.delete(section);
    });
  }

  const sections = () => document.querySelectorAll<HTMLElement>("[data-occ-section]");
  sections().forEach(mount);
  // Leaving for good: nothing is left running. (A page kept for back/forward
  // is only paused, by visibilitychange above, and resumes when shown again.)
  window.addEventListener("pagehide", (event) => {
    if (!event.persisted) sections().forEach((section) => mounted.get(section)?.());
  });
</script>

<style>
  .occ {
    /* Deep burgundy, mixed from the site's berry. */
    --occ-bg: color-mix(in srgb, var(--color-berry) 50%, #14050b);
    --occ-bg-deep: color-mix(in srgb, var(--color-berry) 30%, #0e0308);
    --occ-ease: var(--ease-atelier);
    position: relative;
    isolation: isolate;
    overflow-x: clip;
    padding: clamp(2.75rem, 4.5vw, 4rem) 0 clamp(2.25rem, 4vw, 3.5rem);
    background: linear-gradient(180deg, var(--occ-bg-deep), var(--occ-bg) 30%, var(--occ-bg) 72%, var(--occ-bg-deep));
    color: var(--color-ivory);
  }

  /* A soft rose glow behind the centre card. */
  .occ::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background: radial-gradient(
      ellipse 46% 44% at 50% 57%,
      color-mix(in srgb, var(--color-rose) 24%, transparent),
      color-mix(in srgb, var(--color-rose-deep) 18%, transparent) 42%,
      transparent 72%
    );
  }

  .occ__head {
    max-width: 1320px;
    margin: 0 auto;
    padding: 0 clamp(16px, 4vw, 48px);
    text-align: center;
  }

  .occ__title {
    margin: 0 auto;
    max-width: 18ch;
    font-family: var(--font-display);
    font-weight: 360;
    font-size: clamp(2.1rem, 1.3rem + 3vw, 3.5rem);
    line-height: 1;
    letter-spacing: -0.03em;
    text-wrap: balance;
    color: var(--color-ivory);
  }

  .occ__sub {
    margin: 0.9rem auto 0;
    max-width: 40ch;
    font-size: clamp(1rem, 0.95rem + 0.3vw, 1.15rem);
    line-height: 1.5;
    color: color-mix(in srgb, var(--color-ivory) 80%, transparent);
  }

  /* The plain layout: linked cards that wrap and stay centred. Shown without
     JavaScript, with reduced motion, and for one or two occasions. */
  .occ__stage {
    margin-top: clamp(1.5rem, 3vw, 2.25rem);
    padding: 0 clamp(16px, 4vw, 48px);
  }

  .occ__track {
    list-style: none;
    margin: 0 auto;
    padding: 0;
    max-width: 1180px;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: clamp(0.75rem, 2vw, 1.25rem);
  }

  .occ__card {
    width: clamp(148px, 42vw, 220px);
  }

  .occ[data-count="1"] .occ__card {
    width: min(72vw, 320px);
  }

  .occ[data-count="2"] .occ__card {
    width: min(42vw, 300px);
  }

  .occ__link {
    position: relative;
    display: block;
    aspect-ratio: 5 / 7;
    container-type: inline-size;
    overflow: hidden;
    isolation: isolate;
    border: 1px solid color-mix(in srgb, var(--color-ivory) 18%, transparent);
    border-radius: 22px;
    background: var(--occ-bg-deep);
    box-shadow: 0 28px 56px -30px rgba(0, 0, 0, 0.78);
    color: var(--color-ivory);
    text-decoration: none;
    user-select: none;
    -webkit-user-drag: none;
    -webkit-tap-highlight-color: transparent;
  }

  .occ__link:focus-visible {
    outline: 3px solid var(--color-rose);
    outline-offset: 4px;
  }

  .occ__photo {
    position: absolute;
    inset: 0;
  }

  .occ__photo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--occ-focus, 50% 50%);
  }

  /* Bottom gradient under the caption. */
  .occ__photo::after {
    content: "";
    position: absolute;
    inset: 36% 0 0 0;
    background: linear-gradient(to top, rgba(30, 6, 14, 0.94), rgba(30, 6, 14, 0.6) 46%, rgba(30, 6, 14, 0));
  }

  /* Cards further from the centre are darker (opacity only — no filter). */
  .occ__link::after {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--occ-bg-deep);
    opacity: var(--dim, 0);
    pointer-events: none;
    transition: opacity var(--occ-ms, 800ms) var(--occ-ease);
  }

  .occ__caption {
    position: absolute;
    inset: auto 0 0 0;
    z-index: 1;
    display: grid;
    justify-items: center;
    gap: 0.3rem;
    padding: 0 0.9rem 1rem;
    padding: 0 6cqi 7.5cqi;
    text-align: center;
    transform: translate3d(var(--cap, 0%), 0, 0);
    opacity: var(--cap-o, 1);
    transition:
      transform var(--occ-ms, 800ms) var(--occ-ease),
      opacity var(--occ-ms, 800ms) var(--occ-ease);
  }

  .occ__name {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.3rem;
    font-size: clamp(1rem, 10.5cqi, 2.15rem);
    line-height: 1.04;
    letter-spacing: -0.02em;
    text-wrap: balance;
    overflow-wrap: anywhere;
  }

  .occ__count {
    font-size: 0.8125rem;
    font-size: clamp(0.75rem, 4.6cqi, 0.95rem);
    letter-spacing: 0.06em;
    color: color-mix(in srgb, var(--color-ivory) 88%, transparent);
  }

  .occ__cue {
