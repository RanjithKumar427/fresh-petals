---
// B. Browse the collections — the page's one collection browser: a curved
// deck of the launch range (bouquet types, occasions with launch products
// and custom orders; data in atelierHome.getOccasionDeck), each linking to
// a populated page. Panel transforms are a continuous function of
// one position value, so cards glide between states (no teleporting, no
// duplicate active state). Touch swipe, mouse drag, buttons and keyboard
// all drive the same position. Without JS it is a plain grid of links.
import { getOccasionDeck } from "../../data/atelierHome";

const panels = getOccasionDeck();
const sizes = "(min-width: 1024px) 380px, 66vw";
---

<section class="deck-section" aria-labelledby="deck-title">
  <div class="deck-section__head">
    <div>
      <p class="deck-section__eyebrow" data-reveal="fade">Collections</p>
      <h2 id="deck-title" class="deck-section__title" data-reveal="mask">Browse by collection or occasion</h2>
    </div>
    <div class="deck-controls" data-deck-controls hidden>
      <p class="deck-counter" aria-hidden="true"><span data-deck-current>02</span> / {String(panels.length).padStart(2, "0")}</p>
      <button type="button" class="deck-btn" data-deck-prev aria-label="Previous collection">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
      </button>
      <button type="button" class="deck-btn" data-deck-next aria-label="Next collection">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
      </button>
    </div>
  </div>

  <div class="deck" data-deck role="region" aria-roledescription="carousel" aria-label="Collections and occasions">
    <ul class="deck__track" data-deck-track>
      {
        panels.map((panel, index) => (
          <li class="deck__panel" data-deck-panel aria-roledescription="slide" aria-label={`${panel.title}, ${index + 1} of ${panels.length}`}>
            <a href={panel.href} class="deck__link" draggable="false">
              <span class="deck__photo">
                <img
                  src={panel.image.src}
                  srcset={panel.image.srcset}
                  sizes={sizes}
                  width={panel.image.width}
                  height={panel.image.height}
                  alt={panel.image.alt}
                  loading="lazy"
                  decoding="async"
                  draggable="false"
                />
              </span>
              <span class="deck__caption">
                <span class="deck__name">{panel.title}</span>
                <span class="deck__meta">
                  {panel.note}
                </span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
    <p class="sr-only" aria-live="polite" data-deck-live></p>
  </div>

  <p class="deck-section__more">
    <a class="deck-section__link" href="/categories/bouquets">Not sure yet? <span>Browse all bouquets</span></a>
  </p>
</section>

<script>
  const deck = document.querySelector<HTMLElement>("[data-deck]");
  const track = deck?.querySelector<HTMLElement>("[data-deck-track]");
  const panels = [...(deck?.querySelectorAll<HTMLElement>("[data-deck-panel]") ?? [])];
  const controls = document.querySelector<HTMLElement>("[data-deck-controls]");
  const current = document.querySelector<HTMLElement>("[data-deck-current]");
  const live = document.querySelector<HTMLElement>("[data-deck-live]");
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (deck && track && panels.length) {
    deck.classList.add("is-deck");
    if (controls) controls.hidden = false;

    const last = panels.length - 1;
    // Open on the second panel so the deck reads in both directions.
    let pos = Math.min(1, last);
    let target = pos;
    let raf = 0;
    let spacing = 300;
    let announced = -1;

    const measure = () => {
      const width = panels[0].offsetWidth || 300;
      spacing = width * (window.innerWidth < 768 ? 0.8 : 0.74);
    };

    const render = () => {
      panels.forEach((panel, i) => {
        const d = i - pos;
        const a = Math.abs(d);
        const clamped = Math.max(-3, Math.min(3, d));
        const x = d * spacing * (1 - Math.min(a, 3) * 0.05);
        const z = -Math.min(a, 4) * 110;
        const ry = clamped * -13;
        const scale = 1 - Math.min(a, 3) * 0.055;
        panel.style.transform = `translate3d(${x.toFixed(1)}px, 0, ${z.toFixed(1)}px) rotateY(${ry.toFixed(2)}deg) scale(${scale.toFixed(3)})`;
        panel.style.zIndex = String(100 - Math.round(a * 10));
        panel.style.opacity = String(a > 3.4 ? 0 : 1 - Math.max(0, a - 2.2) * 0.75);
        panel.style.setProperty("--active", String(Math.max(0, 1 - a)));
        // Neighbours keep a readable title so they read as the next choice.
        panel.style.setProperty("--near", String(Math.max(0, 1 - Math.max(0, a - 0.6) / 1.2)));
        // Neighbours' titles sit on the side that is not covered.
        panel.classList.toggle("is-after", d > 0.5);
        const isActive = Math.round(pos) === i;
        panel.classList.toggle("is-active", isActive);
        const link = panel.querySelector("a");
        if (link) link.tabIndex = a < 0.5 ? 0 : -1;
      });
      const index = Math.round(pos);
      if (current) current.textContent = String(index + 1).padStart(2, "0");
      if (index !== announced && Math.abs(pos - index) < 0.02) {
        announced = index;
        if (live) live.textContent = panels[index].getAttribute("aria-label") ?? "";
      }
    };

    const animate = () => {
      raf = 0;
      const diff = target - pos;
      if (reduce || Math.abs(diff) < 0.001) {
        pos = target;
        render();
        return;
      }
      pos += diff * 0.14;
      render();
      raf = requestAnimationFrame(animate);
    };

    const go = (index: number) => {
      target = Math.max(0, Math.min(last, index));
      if (!raf) raf = requestAnimationFrame(animate);
    };

    // Pointer drag / swipe. Vertical page scrolling stays native
    // (touch-action: pan-y); a horizontal gesture takes over only once it is
    // clearly horizontal.
    let startX = 0;
    let startY = 0;
    let startPos = 0;
    let dragging = false;
    let moved = false;
    let pointerId = -1;
    let lastX = 0;
    let lastT = 0;
    let velocity = 0;

    deck.addEventListener("pointerdown", (event) => {
      if (event.button !== 0) return;
      pointerId = event.pointerId;
      startX = lastX = event.clientX;
      startY = event.clientY;
      startPos = pos;
      lastT = performance.now();
      velocity = 0;
      dragging = false;
      moved = false;
    });

    deck.addEventListener("pointermove", (event) => {
      if (event.pointerId !== pointerId) return;
      const dx = event.clientX - startX;
      const dy = event.clientY - startY;
      if (!dragging) {
        if (Math.abs(dx) > 8 && Math.abs(dx) > Math.abs(dy) * 1.2) {
          dragging = true;
          moved = true;
          deck.setPointerCapture(event.pointerId);
          deck.classList.add("is-dragging");
          cancelAnimationFrame(raf);
          raf = 0;
        } else return;
      }
      const now = performance.now();
      velocity = (event.clientX - lastX) / Math.max(1, now - lastT);
      lastX = event.clientX;
      lastT = now;
      let next = startPos - dx / spacing;
      if (next < 0) next = next * 0.35;
      if (next > last) next = last + (next - last) * 0.35;
      pos = target = next;
      render();
    });

    const end = (event: PointerEvent) => {
      if (event.pointerId !== pointerId) return;
      pointerId = -1;
      if (!dragging) return;
      dragging = false;
      deck.classList.remove("is-dragging");
      const fling = -velocity * 6;
      go(Math.round(pos + Math.max(-1.5, Math.min(1.5, fling))));
    };
    deck.addEventListener("pointerup", end);
    deck.addEventListener("pointercancel", end);

    // A drag must never also follow a link.
    deck.addEventListener(
      "click",
      (event) => {
        if (moved) {
          event.preventDefault();
          event.stopPropagation();
          moved = false;
          return;
        }
        const panel = (event.target as HTMLElement).closest<HTMLElement>("[data-deck-panel]");
        const index = panel ? panels.indexOf(panel) : -1;
        if (index >= 0 && index !== Math.round(pos)) {
          event.preventDefault();
          go(index);
        }
      },
      true
    );

    deck.addEventListener("keydown", (event) => {
      if (event.key === "ArrowRight") {
        event.preventDefault();
        go(Math.round(target) + 1);
        requestAnimationFrame(() => panels[Math.round(target)]?.querySelector("a")?.focus({ preventScroll: true }));
      } else if (event.key === "ArrowLeft") {
        event.preventDefault();
        go(Math.round(target) - 1);
        requestAnimationFrame(() => panels[Math.round(target)]?.querySelector("a")?.focus({ preventScroll: true }));
      }
    });

    document.querySelector("[data-deck-prev]")?.addEventListener("click", () => go(Math.round(target) - 1));
    document.querySelector("[data-deck-next]")?.addEventListener("click", () => go(Math.round(target) + 1));

    window.addEventListener("resize", () => {
      measure();
      render();
    });
    measure();
    render();
  }
</script>

<style>
  .deck-section {
    position: relative;
    background: var(--color-ink);
    color: var(--color-ivory);
    padding: clamp(3rem, 5vw, 4.5rem) 0 clamp(2.5rem, 5vw, 4rem);
    overflow: hidden;
  }

  .deck-section__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    max-width: 1320px;
    margin: 0 auto;
    padding: 0 clamp(16px, 4vw, 48px);
  }

  .deck-section__eyebrow {
    margin: 0 0 0.8rem;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-rose);
  }

  .deck-section__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 360;
    font-size: clamp(2.2rem, 1.3rem + 3vw, 4rem);
    line-height: 0.95;
    letter-spacing: -0.035em;
    max-width: 16ch;
  }

  .deck-controls {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  .deck-controls[hidden] {
    display: none;
  }

  .deck-counter {
    margin: 0 0.75rem 0 0;
    font-variant-numeric: tabular-nums;
    font-size: 0.875rem;
    letter-spacing: 0.1em;
    color: color-mix(in srgb, var(--color-ivory) 75%, transparent);
  }

  .deck-btn {
    display: inline-grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--color-ivory) 40%, transparent);
    background: transparent;
    color: var(--color-ivory);
    cursor: pointer;
    transition: background-color 0.18s var(--ease-micro), border-color 0.18s var(--ease-micro);
  }

  .deck-btn:hover {
    background: color-mix(in srgb, var(--color-ivory) 10%, transparent);
    border-color: var(--color-ivory);
  }

  .deck-btn svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
  }

  .deck-btn:focus-visible {
    outline-color: var(--color-rose);
  }

  /* Static fallback: an ordinary grid of occasion links. */
  .deck {
    margin-top: clamp(2rem, 4vw, 3rem);
    padding: 0 clamp(16px, 4vw, 48px);
  }

  .deck__track {
    list-style: none;
    margin: 0 auto;
    padding: 0;
    max-width: 1320px;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 1rem;
  }

  .deck__link {
    position: relative;
    display: block;
    border-radius: 18px;
    overflow: hidden;
    color: var(--color-ivory);
    text-decoration: none;
    background: var(--color-ink-deep);
    user-select: none;
    -webkit-user-drag: none;
  }

  .deck__link:focus-visible {
    outline: 3px solid var(--color-rose);
    outline-offset: 4px;
  }

  .deck__photo {
    display: block;
    aspect-ratio: 4 / 5;
  }

  .deck__photo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .deck__caption {
    position: absolute;
    inset: auto 0 0 0;
    padding: 3.5rem 1.1rem 1rem;
    background: linear-gradient(to top, rgba(15, 42, 31, 0.86), rgba(15, 42, 31, 0.5) 55%, rgba(15, 42, 31, 0));
  }

  .deck__name {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 1.2rem + 1.4vw, 2.3rem);
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .deck__meta {
    display: block;
    margin-top: 0.45rem;
    font-size: 0.875rem;
    line-height: 1.4;
    color: color-mix(in srgb, var(--color-ivory) 88%, transparent);
  }


  /* Enhanced: the curved 3D deck. */
  .deck.is-deck {
    position: relative;
    height: clamp(420px, 44vw, 560px);
    perspective: 1500px;
    touch-action: pan-y;
    cursor: grab;
  }

  .deck.is-deck.is-dragging {
    cursor: grabbing;
  }

  .deck.is-deck .deck__track {
    position: relative;
    display: block;
    height: 100%;
    max-width: none;
    transform-style: preserve-3d;
  }

  .deck.is-deck .deck__panel {
    position: absolute;
    top: 50%;
    left: 50%;
    width: min(74vw, 350px);
    margin: calc(min(74vw, 350px) * -0.625) 0 0 calc(min(74vw, 350px) * -0.5);
    will-change: transform;
  }

  .deck.is-deck .deck__link {
    box-shadow: 0 30px 60px -30px rgba(0, 0, 0, 0.55);
  }

  .deck.is-deck .deck__caption {
    opacity: var(--near, 0);
    background: linear-gradient(to top, rgba(15, 42, 31, calc(0.55 + var(--active, 0) * 0.31)), rgba(15, 42, 31, 0.4) 55%, rgba(15, 42, 31, 0));
  }

  .deck.is-deck .deck__panel.is-after .deck__caption {
    text-align: right;
  }

  .deck.is-deck .deck__meta {
    opacity: var(--active, 0);
  }

  .deck-section__more {
    max-width: 1320px;
    margin: 1.5rem auto 0;
    padding: 0 clamp(16px, 4vw, 48px);
    text-align: center;
  }

  .deck-section__link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: color-mix(in srgb, var(--color-ivory) 82%, transparent);
    text-decoration: none;
    font-size: 0.9375rem;
  }

  .deck-section__link span {
    color: var(--color-ivory);
    text-decoration: underline;
    text-underline-offset: 0.25em;
    text-decoration-color: var(--color-apricot);
    margin-left: 0.3em;
  }

  @media (max-width: 767px) {
    .deck-section__head {
      flex-direction: column;
      align-items: flex-start;
    }
    .deck-controls {
      align-self: stretch;
      justify-content: flex-end;
    }
    .deck.is-deck {
      height: calc(min(66vw, 380px) * 1.25 + 40px);
    }
    .deck.is-deck .deck__panel {
      width: min(66vw, 380px);
      margin: calc(min(66vw, 380px) * -0.625) 0 0 calc(min(66vw, 380px) * -0.5);
    }
    .deck__name {
      font-size: 1.5rem;
    }
  }
</style>
