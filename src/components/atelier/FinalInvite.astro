---
// G. Assisted choice — for the undecided: one WhatsApp message that asks for
// the occasion and budget (and, optionally, the date and area), so we can
// suggest bouquets from the range. A deep green band, a launch bouquet's own
// photograph flush against the page edge (linked to its page), ivory type
// beside it. As the band scrolls through the viewport the photograph rises a
// little more slowly than the type (parallax depth); reduced motion shows it
// still.
import { getFinalPhoto } from "../../data/atelierHome";
import { whatsappLink } from "../../config/storefront";

const shot = getFinalPhoto();
const helpHref = whatsappLink(
  ["Hi Fresh Petals, could you help me choose flowers?", "Occasion: ", "Budget: ", "Delivery date (optional): ", "Delivery area (optional): "].join("\n")
);
---

<section class="final" data-final aria-labelledby="final-title" style={`--photo-ar: ${shot.width} / ${shot.height}`}>
  <a class="final__photo" href={`/products/${shot.slug}`} tabindex="-1" aria-hidden="true">
    <img
      src={shot.src}
      srcset={shot.srcset}
      sizes="(min-width: 1024px) 600px, 82vw"
      width={shot.width}
      height={shot.height}
      alt=""
      loading="lazy"
      decoding="async"
    />
  </a>

  <div class="final__copy">
    <p class="final__eyebrow" data-reveal="fade">Not sure what to choose?</p>
    <h2 id="final-title" class="final__title" data-reveal="mask">Tell us the occasion <em>and your budget.</em></h2>
    <p class="final__text">We'll suggest bouquets from our range that fit, and check your date and delivery area — before anything is ordered.</p>
    <div class="final__actions">
      <a class="final__btn" href={helpHref} target="_blank" rel="noopener noreferrer">Tell us the occasion and your budget</a>
      <a class="final__btn final__btn--quiet" href="/categories/bouquets">Browse bouquets</a>
    </div>
    <p class="final__caption">Pictured: <a href={`/products/${shot.slug}`}>{shot.name}</a></p>
  </div>
</section>

<script>
  const final = document.querySelector<HTMLElement>("[data-final]");
  if (final && document.documentElement.classList.contains("motion")) {
    let raf = 0;
    const update = () => {
      raf = 0;
      const r = final.getBoundingClientRect();
      const vh = window.innerHeight;
      // -1 as the band enters from below, 0 centred, 1 as it leaves.
      const p = Math.max(-1, Math.min(1, (vh / 2 - (r.top + r.height / 2)) / ((vh + r.height) / 2)));
      final.style.setProperty("--fp", p.toFixed(4));
    };
    const schedule = () => {
      if (!raf) raf = requestAnimationFrame(update);
    };
    new IntersectionObserver((entries) => {
      if (entries[0].isIntersecting) {
        window.addEventListener("scroll", schedule, { passive: true });
        schedule();
      } else window.removeEventListener("scroll", schedule);
    }).observe(final);
  }
</script>

<style>
  .final {
    --fp: 0;
    position: relative;
    overflow: clip;
    display: grid;
    gap: 2.5rem;
    background: var(--color-ink);
    color: var(--color-ivory);
    padding: 0 0 clamp(3.5rem, 8vw, 6rem);
  }

  /* Flush to the left edge; one rounded inner corner. */
  .final__photo {
    display: block;
    width: min(82vw, 460px);
    aspect-ratio: var(--photo-ar);
    overflow: hidden;
    border-radius: 0 0 18px 0;
    background: var(--color-ink-deep);
  }

  .final__photo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Just enough overscan for the parallax drift. */
    scale: 1.03;
    translate: 0 calc(var(--fp) * -1.4%);
  }

  .final__copy {
    padding: 0 clamp(16px, 4vw, 56px);
    max-width: 640px;
  }

  .final__eyebrow {
    margin: 0 0 0.8rem;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-rose);
  }

  .final__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 360;
    font-size: clamp(2.3rem, 1.3rem + 4vw, 4.8rem);
    line-height: 0.95;
    letter-spacing: -0.035em;
    max-width: 14ch;
  }

  .final__title em {
    display: block;
    margin-top: 0.3em;
    font-style: italic;
    font-size: 0.55em;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--color-rose);
    max-width: 22ch;
  }

  .final__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.8rem;
  }

  .final__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0.7rem 1.4rem;
    text-align: center;
    border-radius: 999px;
    background: var(--color-ivory);
    color: var(--color-ink);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background-color 0.18s var(--ease-micro), color 0.18s var(--ease-micro);
  }

  .final__btn:hover {
    background: var(--color-rose);
  }

  .final__btn--quiet {
    background: transparent;
    color: var(--color-ivory);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-ivory) 55%, transparent);
  }

  .final__btn--quiet:hover {
    background: color-mix(in srgb, var(--color-ivory) 12%, transparent);
  }

  .final__btn:focus-visible,
  .final__caption a:focus-visible {
    outline: 3px solid var(--color-rose);
    outline-offset: 3px;
  }

  .final__text {
    margin: 1rem 0 0;
    max-width: 40ch;
    line-height: 1.6;
    color: color-mix(in srgb, var(--color-ivory) 85%, transparent);
  }

  .final__caption {
    margin: 1.6rem 0 0;
    font-size: 0.875rem;
    color: color-mix(in srgb, var(--color-ivory) 75%, transparent);
  }

  .final__caption a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--color-ivory);
    font-weight: 600;
    text-underline-offset: 0.2em;
  }

  @media (min-width: 1024px) {
    .final {
      grid-template-columns: auto minmax(0, 1fr);
      align-items: center;
      gap: clamp(3rem, 6vw, 6rem);
      padding: 0;
    }

    .final__photo {
      width: auto;
      height: min(80svh, 600px);
      border-radius: 0 18px 18px 0;
      margin: clamp(3rem, 6vw, 5rem) 0;
    }

    .final__copy {
      padding: 3rem clamp(16px, 4vw, 56px) 3rem 0;
      translate: 0 calc(var(--fp) * -24px);
    }
  }
</style>
