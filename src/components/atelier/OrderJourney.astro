---
// F. How ordering works — the actual process, as the terms describe it:
// choosing, the WhatsApp enquiry (one bouquet from its page, or several from
// the basket — cart.astro builds that message with every item, option,
// quantity and price), our confirmation of availability, delivery and the
// complete price, then acceptance and payment. Opening WhatsApp is an
// enquiry, not an order. The questions that follow are in HomeFaq.astro;
// the WhatsApp invitation is in the closing section, not repeated here.
const steps = [
  { title: "Choose", text: "Pick a bouquet — or tell us the occasion and your budget and we'll suggest some." },
  {
    title: "Enquire on WhatsApp",
    text: "From a bouquet's page, “Enquire on WhatsApp” sends that bouquet straight away. For several, add them to your basket and “Send basket on WhatsApp”. Opening WhatsApp doesn't place an order.",
  },
  {
    title: "We confirm the details",
    text: "We reply with availability for your date and address, any change to the flowers, and the complete price including delivery.",
  },
  { title: "You accept, then pay", text: "When you accept, we confirm the order and share payment details. Nothing is paid on this website." },
];
---

<section class="journey atelier-grain" aria-labelledby="journey-title">
  <div class="journey__inner">
    <div class="journey__head">
      <p class="journey__eyebrow" data-reveal="fade">How ordering works</p>
      <h2 id="journey-title" class="journey__title" data-reveal="mask">From flowers <em>to a confirmed order</em></h2>
    </div>

    <ol class="journey__steps">
      {
        steps.map((step, index) => (
          <li class="journey__step" data-reveal="fade" style={`--reveal-delay:${index * 140}ms`}>
            <span class="journey__num" aria-hidden="true">{index + 1}</span>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </li>
        ))
      }
    </ol>

    <div class="journey__foot">
      <div class="journey__cta">
        <a class="fp-btn" href="/cart" data-journey-basket>Go to your basket</a>
      </div>
    </div>
  </div>
</section>

<script>
  import { getCartCount } from "../../utils/cart";
  const link = document.querySelector<HTMLAnchorElement>("[data-journey-basket]");
  const update = () => {
    const count = getCartCount();
    if (link) link.textContent = count > 0 ? `Review your basket (${count})` : "Go to your basket";
  };
  update();
  window.addEventListener("fresh-petals-cart-updated", update);
  window.addEventListener("pageshow", update);
</script>

<style>
  .journey {
    background: var(--color-ivory);
    padding: clamp(4rem, 9vw, 8rem) clamp(16px, 4vw, 56px);
    border-top: 1px solid var(--color-line);
  }

  .journey__inner {
    max-width: 1320px;
    margin: 0 auto;
  }

  .journey__eyebrow {
    margin: 0 0 0.8rem;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-rose-deep);
  }

  .journey__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 360;
    font-size: clamp(2.2rem, 1.3rem + 3.8vw, 4.6rem);
    line-height: 0.96;
    letter-spacing: -0.03em;
  }

  .journey__title em {
    font-style: italic;
    color: var(--color-rose-deep);
  }

  .journey__steps {
    list-style: none;
    margin: clamp(2.5rem, 5vw, 4rem) 0 0;
    padding: 0;
    display: grid;
    gap: 2.2rem;
  }

  @media (min-width: 640px) {
    .journey__steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2.5rem;
    }
  }

  @media (min-width: 1100px) {
    .journey__steps {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 2.5rem;
    }
  }

  .journey__step {
    position: relative;
    padding-top: 1.2rem;
    border-top: 1px solid var(--color-ink);
  }

  .journey__num {
    display: block;
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 300;
    font-size: clamp(3.2rem, 2rem + 4vw, 5.5rem);
    line-height: 0.9;
    color: var(--color-apricot-deep);
  }

  .journey__step h3 {
    margin: 0.8rem 0 0;
    font-family: var(--font-display);
    font-weight: 420;
    font-size: clamp(1.35rem, 1.1rem + 0.9vw, 1.8rem);
    letter-spacing: -0.015em;
  }

  .journey__step p {
    margin: 0.55rem 0 0;
    max-width: 36ch;
    color: var(--color-moss);
    line-height: 1.6;
  }

  .journey__foot {
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }

  .journey__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.8rem 1.4rem;
  }
</style>
