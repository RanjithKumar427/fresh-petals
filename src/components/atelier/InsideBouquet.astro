---
// D. What will arrive — evidence about an actual design rather than a
// generic photograph: one public launch bouquet (atelierHome
// getArrivalBouquet), its own photograph linked to its page, two close-ups
// cropped from that same file in CSS (the flowers; the wrap and ribbon), and
// the specification its catalogue entry records (flowers, stem count, what
// is included). What happens when a flower isn't available follows the
// published refund and terms pages. No sizes are claimed: none are recorded.
//
// Depth is kept, motion is not: the close-ups float in front of the
// photograph on wider screens (CSS perspective, static), always visible —
// no pinning or scroll-driven reveal.
import type { ArrivalBouquet } from "../../data/atelierHome";

interface Props {
  bouquet: ArrivalBouquet;
}

const { bouquet } = Astro.props;
const href = `/products/${bouquet.slug}`;
// One file for the photograph and both close-ups (same srcset and sizes).
const sizes = "(min-width: 1024px) 640px, 100vw";
const lower = (items: string[]) => items.map((item, index) => (index === 0 ? item : item.charAt(0).toLowerCase() + item.slice(1)));
const flowerText = lower(bouquet.flowers).join(", ");
const includedText = lower(bouquet.included.filter((item) => !/^fresh /i.test(item))).join(", ");
const crops = bouquet.crops ? [bouquet.crops.flowers, bouquet.crops.wrap] : [];
const cropStyle = (c: { x: number; y: number; w: number; h: number }) =>
  `--cw:${c.w};--ch:${c.h};--cx:${c.x};--cy:${c.y}`;
---

<section class="inside" aria-labelledby="inside-title">
  <div class="inside__pin">
    <div class="inside__copy">
      <p class="inside__eyebrow" data-reveal="fade">What will arrive</p>
      <h2 id="inside-title" class="inside__title" data-reveal="mask">A closer look at <em>one of our bouquets</em></h2>
      <ol class="inside__steps">
        <li class="inside__step">
          <span class="inside__num" aria-hidden="true">01</span>
          <span>
            <strong><a href={href}>{bouquet.name}</a> · {bouquet.priceLabel}</strong>
            <span class="inside__text">
              {bouquet.stems ? `Listed as ${bouquet.stems} stems: ` : ""}{flowerText}. Confirm the final arrangement with us on WhatsApp.
            </span>
          </span>
        </li>
        <li class="inside__step">
          <span class="inside__num" aria-hidden="true">02</span>
          <span>
            <strong>If a flower isn't available</strong>
            <span class="inside__text">
              Flowers vary naturally in shade, size and bloom stage. If one in your bouquet isn't available on your date,
              we tell you before you pay and suggest an alternative — or you can cancel.
            </span>
          </span>
        </li>
        <li class="inside__step">
          <span class="inside__num" aria-hidden="true">03</span>
          <span>
            <strong>Wrap and finish</strong>
            <span class="inside__text">{includedText ? `${includedText.charAt(0).toUpperCase()}${includedText.slice(1)}.` : "As shown on the bouquet's page."}</span>
          </span>
        </li>
      </ol>
      <p class="inside__source">
        Every bouquet page lists its flowers, stem count and what's included. <a href={href}>View {bouquet.name}</a>
      </p>
    </div>

    <div class="inside__scene">
      <div class="inside__stage">
        <a class="inside__whole" href={href} tabindex="-1" aria-hidden="true">
          <img
            src={bouquet.photo.src}
            srcset={bouquet.photo.srcset}
            sizes={sizes}
            width={bouquet.photo.width}
            height={bouquet.photo.height}
            alt=""
            loading="lazy"
            decoding="async"
          />
          {crops.map((c) => <span class="inside__ring" style={cropStyle(c)} aria-hidden="true"></span>)}
        </a>
        {
          crops.map((c, index) => (
            <figure class={`inside__detail inside__detail--${index === 0 ? "a" : "b"}`}>
              <span class="inside__crop" style={cropStyle(c)}>
                <img src={bouquet.photo.src} srcset={bouquet.photo.srcset} sizes={sizes} width={bouquet.photo.width} height={bouquet.photo.height} alt={c.alt} loading="lazy" decoding="async" />
              </span>
              <figcaption>{c.caption}</figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .inside {
    position: relative;
    overflow-x: clip;
    background: var(--color-ivory);
  }

  .inside__pin {
    display: grid;
    gap: 2.5rem;
    max-width: 1320px;
    margin: 0 auto;
    padding: clamp(3.5rem, 8vw, 6rem) clamp(16px, 4vw, 56px);
  }

  .inside__eyebrow {
    margin: 0 0 0.8rem;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-rose-deep);
  }

  .inside__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 360;
    font-size: clamp(2.1rem, 1.2rem + 3.4vw, 4rem);
    line-height: 0.98;
    letter-spacing: -0.03em;
    max-width: 13ch;
  }

  .inside__title em {
    font-style: italic;
    color: var(--color-rose-deep);
  }

  .inside__steps {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }

  .inside__step {
    display: grid;
    grid-template-columns: 2.4rem 1fr;
    gap: 0.6rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-line);
  }

  .inside__num {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.2rem;
    color: var(--color-apricot-deep);
    line-height: 1.3;
  }

  .inside__step strong {
    display: block;
    font-weight: 600;
  }

  .inside__step strong a,
  .inside__source a {
    color: var(--color-ink);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .inside__text {
    display: block;
    margin-top: 0.25rem;
    color: var(--color-moss);
    line-height: 1.55;
    font-size: 0.9375rem;
  }

  .inside__source {
    margin: 1.2rem 0 0;
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--color-moss);
  }

  .inside__source a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 700;
  }

  /* ---- The photographs ---- */
  .inside__scene {
    perspective: 1400px;
    perspective-origin: 40% 45%;
  }

  /* Mobile: the whole photograph, then its two close-ups side by side. */
  .inside__stage {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 1.1rem 0.8rem;
    transform-style: preserve-3d;
  }

  .inside__whole {
    position: relative;
    display: block;
    grid-column: 1 / -1;
    justify-self: center;
    width: min(78vw, 360px);
    border-radius: 6px;
    background: var(--color-linen);
    box-shadow: 0 30px 50px -30px rgba(23, 61, 45, 0.5);
  }

  .inside__whole img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 6px;
  }

  /* Where each close-up comes from in the photograph. */
  .inside__ring {
    position: absolute;
    left: calc(var(--cx) * 100%);
    top: calc(var(--cy) * 100%);
    width: calc(var(--cw) * 100%);
    height: calc(var(--ch) * 100%);
    border: 1.5px solid var(--color-paper);
    border-radius: 6px;
    box-shadow: 0 0 0 1px rgba(23, 61, 45, 0.2);
    pointer-events: none;
  }

  .inside__detail {
    align-self: center;
    margin: 0;
    padding: 6px 6px 0;
    background: var(--color-paper);
    border-radius: 6px;
    box-shadow:
      0 24px 40px -22px rgba(23, 61, 45, 0.55),
      0 2px 6px rgba(23, 61, 45, 0.12);
  }

  /* A window onto one region of the square photograph (CSS crop of the
     same file): the frame has the region's shape; the image is scaled so
     the region fills it. */
  .inside__crop {
    position: relative;
    display: block;
    overflow: hidden;
    aspect-ratio: calc(var(--cw) / var(--ch));
    border-radius: 3px;
  }

  .inside__crop img {
    position: absolute;
    left: calc(var(--cx) / var(--cw) * -100%);
    top: calc(var(--cy) / var(--ch) * -100%);
    width: calc(100% / var(--cw));
    height: auto;
    max-width: none;
  }

  .inside__detail figcaption {
    padding: 0.5rem 0.2rem 0.6rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-moss);
  }

  /* Mobile: heading, then the photographs, then what they show. */
  @media (max-width: 1023px) {
    .inside__pin {
      grid-template-areas: "eyebrow" "title" "scene" "steps" "source";
      gap: 0;
    }

    .inside__copy {
      display: contents;
    }

    .inside__eyebrow {
      grid-area: eyebrow;
    }

    .inside__title {
      grid-area: title;
    }

    .inside__scene {
      grid-area: scene;
      margin-top: 1.75rem;
    }

    .inside__steps {
      grid-area: steps;
    }

    .inside__source {
      grid-area: source;
    }
  }

  @media (min-width: 1024px) {
    .inside__pin {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      align-items: center;
      gap: 4rem;
    }

    /* The photograph, turned slightly, with the two close-ups floating
       beside it in front of the picture plane (static depth). */
    .inside__stage {
      /* Fits the 7fr column (about 660px at 1440px wide): the close-ups
         overlap the photograph's right edge rather than overflow. */
      --photo-h: min(calc(100svh - var(--header-h) - 7rem), 460px);
      display: block;
      height: var(--photo-h);
      width: calc(var(--photo-h) + 200px);
      margin: 0 auto;
    }

    .inside__whole {
      position: absolute;
      left: 0;
      top: 0;
      width: auto;
      height: 100%;
      aspect-ratio: 1;
      transform: rotateY(8deg);
      transform-origin: 0% 50%;
    }

    .inside__whole img {
      height: 100%;
      width: 100%;
      object-fit: cover;
    }

    .inside__detail {
      position: absolute;
      width: 240px;
    }

    .inside__detail--a {
      right: 0;
      top: 6%;
      transform: translate3d(0, 0, 70px) rotateY(-12deg);
    }

    .inside__detail--b {
      right: 20px;
      top: 56%;
      width: 220px;
      transform: translate3d(0, 0, 70px) rotateY(-12deg);
    }
  }
</style>
