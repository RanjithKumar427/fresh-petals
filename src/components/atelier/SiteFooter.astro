---
// Discovery footer: five readable groups of links to pages that exist, plus
// the verified contact details. Flowers and occasions come first, then the
// published city pages (the full list of cities lives on /locations, not
// here), the buying guide, and business and help pages.
// The Instagram handle is the business's existing account (still named
// freshpetals.hyderabad — flagged for the owner's decision).
import Wordmark from "./Wordmark.astro";
import { POOJA_FLOWERS_LINK, OCCASIONS_HREF } from "../../data/navigation";
import { garlandsPromoted, readyCategories } from "../../data/launchCatalogue";
import { GARLANDS_PATH, GARLAND_COLLECTIONS, GARLAND_GUIDE_PATH } from "../../data/garlandCollections";
import { LOCATIONS_PATH, hubPath, publishedHubs, serviceCityCount } from "../../data/serviceCities";
import { whatsappLink } from "../../config/storefront";

const whatsappUrl = whatsappLink("Hi Fresh Petals, I have a question about an order.");
const instagramUrl = "https://www.instagram.com/freshpetals.hyderabad/";
const cityCount = serviceCityCount();

type Link = { label: string; href: string };
const garlands = garlandsPromoted();
const flowers: Link[] = [
  ...readyCategories().filter((category) => category.id !== "garlands").map((category) => ({ label: category.label, href: category.href })),
  ...(garlands ? [{ label: "Wedding garlands", href: GARLANDS_PATH }] : []),
  POOJA_FLOWERS_LINK,
  ...(garlands ? GARLAND_COLLECTIONS.map((collection) => ({ label: collection.label, href: collection.path })) : []),
];
const occasions: Link[] = [
  { label: "All occasions", href: OCCASIONS_HREF },
  { label: "Birthday", href: "/occasions/birthday" },
  { label: "Anniversary", href: "/occasions/anniversary" },
  { label: "Wedding", href: "/occasions/wedding" },
  { label: "Sympathy", href: "/occasions/sympathy" },
];
const cities: Link[] = [
  ...publishedHubs().map((city) => ({ label: city.name, href: hubPath(city)! })),
  { label: `All ${cityCount} delivery cities`, href: LOCATIONS_PATH },
];
const choosing: Link[] = [
  { label: "Choosing a wedding garland", href: GARLAND_GUIDE_PATH },
  { label: "Custom orders", href: "/custom-orders" },
  { label: "FAQs", href: "/faqs" },
];
const help: Link[] = [
  { label: "About", href: "/about" },
  { label: "Contact", href: "/contact" },
  { label: "Delivery", href: "/shipping" },
  { label: "Refunds", href: "/refunds" },
  { label: "Terms", href: "/terms" },
  { label: "Privacy", href: "/privacy" },
];
const groups: { title: string; label: string; links: Link[] }[] = [
  { title: "Flowers", label: "Flowers", links: flowers },
  { title: "Occasions", label: "Occasions", links: occasions },
  { title: "Delivery cities", label: "Delivery cities", links: cities },
  { title: "Choosing flowers", label: "Choosing flowers", links: choosing },
  { title: "Fresh Petals", label: "Business and help", links: help },
];
---

<footer id="footer" class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__brand">
      <Wordmark tone="ivory" size="lg" />
      <p>Hand-tied bouquets, made-to-order wedding garlands and pooja flowers for delivery in {cityCount} cities across India. Choose online, confirm on WhatsApp.</p>
    </div>

    {
      groups.map((group) => (
        <nav aria-label={group.label} class="site-footer__col" data-footer-group={group.label}>
          <p class="site-footer__title">{group.title}</p>
          <ul>{group.links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}</ul>
        </nav>
      ))
    }

    <div class="site-footer__col">
      <p class="site-footer__title">Talk to us</p>
      <ul>
        <li>
          <a href={whatsappUrl} target="_blank" rel="noopener noreferrer">WhatsApp +91 96520 12274</a>
        </li>
        <li>
          <a href={instagramUrl} target="_blank" rel="noopener noreferrer">Instagram</a>
        </li>
      </ul>
    </div>
  </div>

  <div class="site-footer__base">
    <p>© 2026 Fresh Petals</p>
    <p>Availability, final price and delivery are confirmed on WhatsApp before you pay.</p>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    z-index: 1;
    background: var(--color-ink);
    color: var(--color-ivory);
    padding: clamp(3rem, 6vw, 5rem) clamp(16px, 4vw, 48px) 1.5rem;
  }

  .site-footer__inner {
    max-width: 1320px;
    margin: 0 auto;
    display: grid;
    gap: 2.5rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .site-footer__brand {
    grid-column: 1 / -1;
  }

  @media (min-width: 700px) {
    .site-footer__inner {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 1100px) {
    .site-footer__inner {
      gap: 2.5rem 2rem;
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }
  }

  .site-footer__brand p {
    margin: 1rem 0 0;
    max-width: 52ch;
    color: color-mix(in srgb, var(--color-ivory) 78%, transparent);
    line-height: 1.6;
  }

  .site-footer__title {
    margin: 0 0 0.75rem;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-rose);
  }

  .site-footer__col ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-footer__col a {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    color: var(--color-ivory);
    text-decoration: none;
    background-image: linear-gradient(var(--color-apricot), var(--color-apricot));
    background-size: 0% 1px;
    background-repeat: no-repeat;
    background-position: 0 calc(100% - 8px);
    transition: background-size 0.3s var(--ease-premium);
  }

  .site-footer__col a:hover {
    background-size: 100% 1px;
  }

  .site-footer__col a:focus-visible,
  .site-footer__brand a:focus-visible {
    outline-color: var(--color-rose);
  }

  .site-footer__base {
    max-width: 1320px;
    margin: clamp(2.5rem, 5vw, 4rem) auto 0;
    padding-top: 1.25rem;
    border-top: 1px solid color-mix(in srgb, var(--color-ivory) 18%, transparent);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    font-size: 0.8125rem;
    color: color-mix(in srgb, var(--color-ivory) 70%, transparent);
  }

  .site-footer__base p {
    margin: 0;
  }
</style>
