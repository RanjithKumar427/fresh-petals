---
// Complete Homepage Visual Consistency milestone — see PoojaProductsSection
// for the full reasoning. Section background standardized from the
// previous pink tint (#FFF8FA) to the same #F5F5F5 canvas every other
// converted rail now uses, per this milestone's explicit "must not
// alternate" / "light neutral background" instruction — a distinct pink
// section here would have reintroduced exactly the "does this still look
// like the same product" break the brief is correcting. Empty-state
// fallback preserved exactly, unchanged visually since it's not a card.
import DiscoveryPostCard from "./DiscoveryPostCard.astro";
import { productCatalog } from "../data/productCatalog";
import { loadAuthoritativePrices, withAuthoritativePrice } from "../server/services/ProductPricing";

const priceMap = await loadAuthoritativePrices();

const sectionProductSlugs = [
  "bridal-flower-accessories",
  "event-garlands",
  "fresh-flower-toran",
  "jasmine-gajra",
];

const products = sectionProductSlugs
  .map((slug) => productCatalog.find((product) => product.slug === slug))
  .filter((product): product is NonNullable<typeof product> => Boolean(product))
  .map((product) => withAuthoritativePrice(product, priceMap));
---

<section class="bg-[#F5F5F5] px-3 pb-8 pt-5 md:px-6 md:pb-12">
  <div class="mx-auto max-w-7xl">
    <div class="mb-3 flex items-baseline justify-between px-0.5">
      <h2 class="text-[15px] font-medium text-black/80">
        Wedding & Traditional
      </h2>

      <a
        href="/categories/wedding"
        class="group inline-flex items-center gap-1 text-[12px] text-black/45 transition hover:text-[#FF2442]"
      >
        View all
        <span aria-hidden="true" class="transition group-hover:translate-x-0.5">→</span>
      </a>
    </div>

    {
      products.length > 0 ? (
        <div class="columns-2 gap-2 md:columns-3 md:gap-2.5 lg:columns-4 xl:columns-5">
          {products.map((product) => (
            <DiscoveryPostCard
              slug={product.slug}
              name={product.name}
              image={product.image}
              description={product.description}
              category={product.category}
              priceLabel={product.priceLabel}
            />
          ))}
        </div>
      ) : (
        <div class="rounded-[24px] border border-black/[0.08] bg-white p-8 text-center">
          <h3 class="text-lg font-semibold text-[#171717]">
            Traditional flowers coming soon
          </h3>

          <p class="mt-3 text-sm leading-7 text-[#66565D]">
            We are updating wedding flowers, garlands, gajra and toran products.
          </p>
        </div>
      )
    }
  </div>
</section>
