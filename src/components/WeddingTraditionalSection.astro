---
import ProductCard from "./ProductCard.astro";
import { productCatalog } from "../data/productCatalog";

const sectionProductSlugs = [
  "bridal-flower-accessories",
  "event-garlands",
  "fresh-flower-toran",
  "jasmine-gajra",
];

const products = sectionProductSlugs
  .map((slug) => productCatalog.find((product) => product.slug === slug))
  .filter(Boolean);
---

<section class="bg-[#FFF8FA] px-5 py-14 md:px-8 md:py-16">
  <div class="mx-auto max-w-7xl">
    <div class="mb-8 flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="fp-eyebrow">
          Wedding & Traditional
        </p>

        <h2 class="fp-serif mt-3 text-3xl uppercase tracking-[0.18em] text-[#171717] md:text-4xl">
          Wedding & Traditional Flowers
        </h2>

        <p class="mt-4 max-w-2xl text-sm leading-7 text-[#66565D]">
          Fresh garlands, jasmine gajra, torans and bridal flower accessories for pooja, functions and wedding needs.
        </p>
      </div>

      <a
        href="/categories/wedding"
        class="inline-flex w-fit rounded-full bg-[#7C243E] px-6 py-3 text-[11px] font-bold uppercase tracking-[0.22em] text-white transition hover:bg-[#171717]"
      >
        View Wedding Flowers
      </a>
    </div>

    {
      products.length > 0 ? (
        <div class="grid grid-cols-2 gap-4 md:grid-cols-3 lg:grid-cols-4">
          {products.map((product) => (
            product && (
              <ProductCard
                id={product.id}
                name={product.name}
                image={product.image}
                priceLabel={product.priceLabel}
                priceType={product.priceType}
                category={product.category}
                description={product.description}
                slug={product.slug}
                isAvailable={product.isAvailable}
              />
            )
          ))}
        </div>
      ) : (
        <div class="rounded-[24px] border border-[#EEE5E8] bg-white p-8 text-center">
          <h3 class="text-lg font-semibold text-[#171717]">
            Traditional flowers coming soon
          </h3>

          <p class="mt-3 text-sm leading-7 text-[#66565D]">
            We are updating wedding flowers, garlands, gajra and toran products.
          </p>
        </div>
      )
    }
  </div>
</section>