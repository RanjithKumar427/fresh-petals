---
// A reviewed inline script, allowed by the page's Content-Security-Policy
// through the SHA-256 of its exact text. `code` must be literal source from
// this repository (imported with `?raw` from src/scripts/inline/), plus at
// most build-time configuration serialised with JSON.stringify — never
// anything a visitor sent. Any other inline script is blocked by the policy.
// Newlines are normalised to LF before both hashing and rendering, so the
// hash matches what the browser parses whatever the checkout's line endings.
import { inlineScriptHash, normalizeNewlines } from "../server/http/inlineScriptHash.mjs";

interface Props {
  code: string;
}

const script = normalizeNewlines(Astro.props.code);
const hash = inlineScriptHash(script);
Astro.csp?.insertScriptHash(hash);
---

<script is:inline set:html={script} />
