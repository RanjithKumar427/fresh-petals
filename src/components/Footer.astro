---
const whatsappNumber = "919652012274";

const whatsappMessage = encodeURIComponent(
  "Hi Fresh Petals, I want to know more about your flower delivery services."
);

const instagramUrl = "https://www.instagram.com/freshpetals.hyderabad/";

const whatsappUrl = `https://wa.me/${whatsappNumber}?text=${whatsappMessage}`;

const shopLinks = [
  { label: "All Flowers", href: "/categories/bouquets" },
  { label: "Bouquets", href: "/categories/bouquets" },
  { label: "Pooja Flowers", href: "/categories/pooja-flowers" },
  { label: "Flowerbox", href: "/categories/flowerbox" },
  { label: "Baskets", href: "/categories/baskets" },
  { label: "Flower Subscription", href: "/categories/subscriptions" },
  { label: "Add-ons & Hampers", href: "/categories/add-ons" },
  { label: "Today’s Offers", href: "/categories/offers" },
  { label: "Wedding Flowers", href: "/occasions/wedding" },
];

const helpLinks = [
  { label: "Contact Us", href: whatsappUrl },
  { label: "FAQs", href: "/faqs" },
  { label: "Shipping Policy", href: "/shipping" },
  { label: "Refund Policy", href: "/refunds" },
  { label: "Privacy Policy", href: "/privacy" },
  { label: "Terms of Service", href: "/terms" },
];
---

<footer id="footer" class="bg-[#075838] px-5 py-12 text-white md:px-8 md:py-14">
  <div class="mx-auto max-w-7xl">
    <div class="grid gap-10 border-b border-white/20 pb-10 lg:grid-cols-[1.2fr_0.8fr_0.8fr_1.1fr]">
      <div>
        <a href="/" class="inline-block" aria-label="Fresh Petals Hyderabad home">
          <span class="fp-serif block text-3xl tracking-[0.04em] text-white">
            Fresh Petals
          </span>

          <span class="mt-2 block text-[10px] font-medium uppercase tracking-[0.35em] text-white/70">
            Hyderabad
          </span>
        </a>

        <p class="mt-5 max-w-sm text-sm leading-7 text-white/75">
          Fresh flowers for pooja, bouquets, jasmine, garlands, wedding flowers,
          subscriptions and gifting across Hyderabad.
        </p>

        <div class="mt-6 flex items-center gap-3">
          <a
            href={instagramUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Fresh Petals Instagram"
            class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-white/35 text-white transition hover:border-[#E8A7B8] hover:bg-[#E8A7B8] hover:text-[#075838]"
          >
            <svg
              aria-hidden="true"
              viewBox="0 0 24 24"
              class="h-4 w-4"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <rect x="3" y="3" width="18" height="18" rx="5"></rect>
              <circle cx="12" cy="12" r="4"></circle>
              <circle cx="17.5" cy="6.5" r="0.8" fill="currentColor" stroke="none"></circle>
            </svg>
          </a>

          <a
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Chat with Fresh Petals on WhatsApp"
            class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-white/35 text-white transition hover:border-[#E8A7B8] hover:bg-[#E8A7B8] hover:text-[#075838]"
          >
            <svg
              aria-hidden="true"
              viewBox="0 0 24 24"
              class="h-4 w-4"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M20.5 11.8a8.4 8.4 0 0 1-12.4 7.4L4 20.4l1.3-4A8.4 8.4 0 1 1 20.5 11.8Z"></path>
              <path d="M9.2 8.6c.2-.4.4-.4.7-.4h.5c.2 0 .4.1.5.4l.7 1.6c.1.3.1.5-.1.7l-.4.5c.6 1.1 1.5 2 2.6 2.6l.5-.4c.2-.2.4-.2.7-.1l1.6.7c.3.1.4.3.4.6v.4c0 .3-.1.6-.4.7-.6.3-1.2.4-1.9.3-3.2-.5-5.8-3.1-6.3-6.3-.1-.6 0-1.3.4-1.9Z"></path>
            </svg>
          </a>
        </div>
      </div>

      <div>
        <h3 class="text-[11px] font-semibold uppercase tracking-[0.32em] text-white">
          Shop
        </h3>

        <ul class="mt-5 space-y-3">
          {
            shopLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-sm text-white/70 transition hover:text-white"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h3 class="text-[11px] font-semibold uppercase tracking-[0.32em] text-white">
          Help
        </h3>

        <ul class="mt-5 space-y-3">
          {
            helpLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-sm text-white/70 transition hover:text-white"
                  target={link.href.startsWith("https://wa.me") ? "_blank" : undefined}
                  rel={link.href.startsWith("https://wa.me") ? "noopener noreferrer" : undefined}
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h3 class="text-[11px] font-semibold uppercase tracking-[0.32em] text-white">
          Sign Up And Save
        </h3>

        <p class="mt-5 text-sm leading-7 text-white/75">
          Get updates on fresh flower availability, festive pooja flowers,
          bouquet offers and subscription plans.
        </p>

        <form class="mt-5 flex border border-white/40">
          <input
            type="email"
            placeholder="Enter your email"
            aria-label="Enter your email"
            class="min-w-0 flex-1 bg-transparent px-4 py-3 text-sm text-white placeholder:text-white/55 outline-none"
          />

          <button
            type="submit"
            class="bg-white px-5 py-3 text-[11px] font-bold uppercase tracking-[0.22em] text-[#075838] transition hover:bg-[#E8A7B8]"
          >
            Join
          </button>
        </form>

        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-5 inline-flex border border-white/50 px-5 py-3 text-[11px] font-bold uppercase tracking-[0.22em] text-white transition hover:border-white hover:bg-white hover:text-[#075838]"
        >
          Chat On WhatsApp
        </a>
      </div>
    </div>

    <div class="flex flex-col justify-between gap-4 pt-6 text-xs text-white/60 md:flex-row">
      <p>© 2026 Fresh Petals Hyderabad. All rights reserved.</p>
      <p>Fresh flower orders • Hyderabad • WhatsApp-first service</p>
    </div>
  </div>
</footer>