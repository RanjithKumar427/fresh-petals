---
// Xiaohongshu-Inspired Post Card System milestone — the reusable card unit
// extracted from DiscoveryFeed.astro so any other homepage discovery
// surface could adopt the same visual language instead of the shared
// ecommerce ProductCard.astro. Deliberately its own component, not a
// variant/prop on ProductCard.astro: ProductCard is still used as-is by
// search/category/occasion pages (real ecommerce browsing contexts, where
// View/Add/WhatsApp on every tile is correct).
//
// Discovery Experience Phase 1 (Save) milestone — the card is a <div> with
// an absolutely positioned <a href> covering the full card (still "tap
// anywhere to open the product") and the save <button> as a z-20 sibling
// stacked above it — a <button> can't nest inside an <a>, and this avoids
// any JS stopPropagation trickery.
//
// Phase 2 milestone — primary text is `name`, not the SEO-style
// `description` field; price never shows a raw commerce-action prompt for
// priceType market/quote products (see displayPrice below).
//
// Phase 4 (True Visual Discovery Experience) milestone — the Opus audit's
// single strongest finding: every card's context line was real but
// completely inert plain text, even though the routes it could point to
// already exist. `occasionTags` is present on all 89 catalog products and
// `src/pages/occasions/[slug].astro` already defines a live getStaticPaths
// route for all 14 real tag values — verified in the audit ("/occasions/
// birthday" returns 200, "61 options"). No new route, no new schema, no
// new backend. This replaces the old `idealFor`-derived context line
// (human-phrased but a dead end -- "Cute surprises" has no destination)
// with up to 2 real occasionTags rendered as tappable links to those
// existing pages. `idealFor` was decided against, not merely dropped:
// occasionTags is on 89/89 products (idealFor only ever covered 47,
// Bouquets+Lilies), and humanized ("get-well-soon" -> "Get well soon")
// reads with the same warmth `idealFor` had while actually going
// somewhere. `badge` is kept as the fallback for the rare case a product's
// tags don't resolve to a label, so the line is never empty and never
// invented.
//
// Structural note on the tag links: they sit inside the same
// pointer-events-none text block as the name/price (which stay inert, tap
// falls through to the full-card link beneath), so each tag <a> opts back
// in individually with pointer-events-auto and z-20 -- the same layering
// pattern the save button already established, no nested-anchor problem
// (these are siblings of the overlay <a>, not descendants).
//
// Also new in Phase 4: an optional `gridRowSpan` prop. DiscoveryFeed.astro
// switched from CSS `columns-*` (which the audit measured scrambling DOM/
// visual reading order and orphaning a column at >=1280px) to CSS Grid
// with a computed `grid-row: span N` per card. When gridRowSpan is passed,
// this card applies that as an inline style and drops its own
// margin-bottom (the grid's `gap` handles spacing instead, avoiding double
// spacing). When absent (the /saved page, which still uses the original
// CSS-columns layout -- its item count is small and variable, not worth
// the same rework this pass), the card behaves exactly as before.
//
// Image renders at its own natural intrinsic aspect ratio (no forced
// ratio) so masonry heights come from the real photography, not a
// synthetic pattern.
//
// Phase 3 milestone — the <img> has real width/height attributes sourced
// from imageDimensions.json (generated by scripts/generate-image-
// dimensions.mjs via `sharp`), the standard zero-JS mechanism browsers use
// to reserve the correct aspect-ratio box before decode. A product whose
// image isn't in the map renders without the attributes rather than
// breaking.
//
// Discovery Architecture Hardening (Phase 5), Workstream C milestone —
// the <img> also carries srcset/sizes now, sourced from
// imageVariants.json (generated by scripts/generate-image-derivatives.mjs
// via the same `sharp` already used for Phase 3's dimensions). Real
// sources were measured at ~1200px serving into ~156-370px rendered
// slots depending on breakpoint -- a 3-7x linear over-serve. `sizes`
// mirrors the grid's real column widths measured in the Phase 4 audit
// (2 columns below md, then the actual per-breakpoint desktop widths, all
// converging near ~240px once the grid hits its max-w-7xl cap). A
// product without generated variants renders with plain `src` only,
// exactly as before Phase 5 -- this never breaks on a missing derivative.
import imageDimensions from "../data/imageDimensions.json";
import imageVariantsData from "../data/imageVariants.json";

const imageVariants = imageVariantsData as Record<string, Record<string, string>>;
// Phase 6 correction -- the flat px/50vw tokens above were measured once
// against a single representative width per breakpoint band, not derived
// from the grid's real math (DiscoveryFeed.astro's gap-x-*/grid-cols-* at
// each breakpoint). Re-derived directly from that CSS: real desktop
// column width ranges from 233px (768px, 3 cols) up to 318px (1023px,
// still 3 cols) before the next breakpoint kicks in -- the old flat 235px
// under-declared by up to 27% there, silently selecting the 240w
// derivative for a slot nearly 320px wide. calc() tracks the actual
// column width at every viewport instead of one flat number per band;
// mobile's `50vw - 16px` matches DiscoveryFeed's 2-col gap-x-2 (8px) +
// section px-3 (12px/side) exactly the same way the desktop terms do.
const IMAGE_SIZES =
  "(min-width: 1328px) 248px, " +
  "(min-width: 1280px) calc((100vw - 88px) / 5), " +
  "(min-width: 1024px) calc((100vw - 78px) / 4), " +
  "(min-width: 768px) calc((100vw - 68px) / 3), " +
  "calc(50vw - 16px)";

const OCCASION_LABELS: Record<string, string> = {
  anniversary: "Anniversary",
  birthday: "Birthday",
  congratulations: "Congratulations",
  "get-well-soon": "Get well soon",
  housewarming: "Housewarming",
  "i-am-sorry": "I am sorry",
  "just-because": "Just because",
  "mom-to-be": "Mom to be",
  "new-mom": "New mom",
  pooja: "Pooja",
  romantic: "Romantic",
  sympathy: "Sympathy",
  "thank-you": "Thank you",
  wedding: "Wedding",
};

interface Props {
  slug: string;
  name: string;
  image: string;
  priceLabel: string;
  priceType: "fixed" | "from" | "market" | "quote";
  occasionTags?: string[];
  badge?: string;
  gridRowSpanMobile?: number;
  gridRowSpanTablet?: number;
  gridRowSpanDesktop?: number;
}

const {
  slug,
  name,
  image,
  priceLabel,
  priceType,
  occasionTags,
  badge,
  gridRowSpanMobile,
  gridRowSpanTablet,
  gridRowSpanDesktop,
} = Astro.props;

const isGridItem =
  gridRowSpanMobile != null && gridRowSpanTablet != null && gridRowSpanDesktop != null;

const tags = (occasionTags ?? [])
  .filter((tag) => OCCASION_LABELS[tag])
  .slice(0, 2);

const dimensions = (imageDimensions as Record<string, { width: number; height: number }>)[image];

const variants = imageVariants[image];
const srcset = variants
  ? Object.entries(variants)
      .map(([width, path]) => `${path} ${width}w`)
      .join(", ")
  : undefined;

// Never mix a commerce-action prompt into the price slot. Checked on the
// actual string, not just priceType: live testing found a handful of
// "Offers" products declare priceType "from" (normally a real ₹ number)
// but their catalog priceLabel is itself merchandising text ("Budget
// picks", "Fresh deals") with no DB price to override it, so a priceType-
// only check would have let those through unfixed. Whenever priceLabel
// doesn't actually contain a number, fall back to the same neutral wording
// ProductCard.astro's own priceBadge already establishes as house style
// per priceType ("Fixed price" / "Starting price" / "Custom quote" /
// "Today's price") instead of raw placeholder text ("Ask on WhatsApp",
// "On request", "Add-on item", "Budget picks"), which reads as an
// instruction to act, not a price. Real ₹ prices (the majority) are
// unaffected.
const looksLikePrice = /\d/.test(priceLabel);
const fallbackPriceText =
  priceType === "fixed"
    ? "Fixed price"
    : priceType === "from"
      ? "Starting price"
      : priceType === "quote"
        ? "Custom quote"
        : "Today's price";
const displayPrice = looksLikePrice ? priceLabel : fallbackPriceText;

const contextLabel = tags.length > 0 ? tags.map((tag) => OCCASION_LABELS[tag]).join(" · ") : badge;

const ariaLabel = contextLabel
  ? `${name} — ${contextLabel}, ${displayPrice}`
  : `${name}, ${displayPrice}`;
---

<div
  class:list={[
    "group relative mb-2 overflow-hidden rounded-xl border border-black/[0.08] bg-white md:mb-2.5",
    isGridItem ? "fp-grid-item" : "block break-inside-avoid",
  ]}
  style={
    isGridItem
      ? `--fp-rows-mobile: ${gridRowSpanMobile}; --fp-rows-tablet: ${gridRowSpanTablet}; --fp-rows-desktop: ${gridRowSpanDesktop};`
      : undefined
  }
>
  <a
    href={`/products/${slug}`}
    class="absolute inset-0 z-10"
    aria-label={ariaLabel}
  ></a>

  <div class="relative">
    <img
      src={image}
      srcset={srcset}
      sizes={srcset ? IMAGE_SIZES : undefined}
      width={dimensions?.width}
      height={dimensions?.height}
      alt=""
      loading="lazy"
      decoding="async"
      class="pointer-events-none block h-auto w-full transition duration-700 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:scale-[1.02]"
    />

    <button
      type="button"
      data-save-toggle
      data-save-id={slug}
      aria-label={`Save ${name}`}
      aria-pressed="false"
      class="fp-save-btn absolute right-1 top-1 z-20 flex h-11 w-11 items-center justify-center"
    >
      <span class="fp-save-visual flex h-9 w-9 items-center justify-center rounded-full bg-white/90 text-black/55 shadow-sm backdrop-blur transition group-hover:text-[#FF2442] active:scale-90">
        <svg
          class="fp-save-icon-outline h-[18px] w-[18px]"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M12 21s-7.5-4.6-9.8-9.1C.6 8 2 4.5 5.6 4.5c2.1 0 3.7 1.2 4.4 2.7.7-1.5 2.3-2.7 4.4-2.7 3.6 0 5 3.5 3.4 6.9C19.5 16.4 12 21 12 21Z"></path>
        </svg>

        <svg
          class="fp-save-icon-filled hidden h-[18px] w-[18px] text-[#FF2442]"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
        >
          <path d="M12 21s-7.5-4.6-9.8-9.1C.6 8 2 4.5 5.6 4.5c2.1 0 3.7 1.2 4.4 2.7.7-1.5 2.3-2.7 4.4-2.7 3.6 0 5 3.5 3.4 6.9C19.5 16.4 12 21 12 21Z"></path>
        </svg>
      </span>
    </button>
  </div>

  <div class="px-2.5 py-2">
    <p class="pointer-events-none line-clamp-1 text-[13px] font-medium leading-snug text-black/80 transition-colors group-hover:text-[#FF2442]">
      {name}
    </p>

    {
      tags.length > 0 ? (
        <p class="mt-1 flex flex-wrap items-center gap-x-1 text-[11px] text-black/45">
          {tags.map((tag, index) => (
            <>
              <a
                href={`/occasions/${tag}`}
                class="relative z-20 pointer-events-auto underline-offset-2 hover:text-[#FF2442] hover:underline"
              >
                {OCCASION_LABELS[tag]}
              </a>
              {index < tags.length - 1 && <span class="pointer-events-none">·</span>}
            </>
          ))}
        </p>
      ) : (
        badge && <p class="pointer-events-none mt-1 line-clamp-1 text-[11px] text-black/45">{badge}</p>
      )
    }

    <p class="pointer-events-none mt-1 text-[11px] text-black/45">
      {displayPrice}
    </p>
  </div>
</div>

<style>
  /* Phase 4 — three row-span values, switched by plain media queries
     rather than JS. See DiscoveryFeed.astro's header comment for the full
     history of how this went from one value to three, each step caught by
     live measurement: a single reference over-reserved at mobile; two
     tiers still under-reserved (cropped real product photos, via the
     card's own overflow-hidden) in the ~640-767px range, where the grid is
     still 2 columns but each column is genuinely wider than a phone's.
     640px and 768px match Tailwind's own sm:/md: breakpoints, the same
     points DiscoveryFeed's grid actually changes column count/width at. */
  .fp-grid-item {
    grid-row: span var(--fp-rows-mobile);
  }

  @media (min-width: 640px) {
    .fp-grid-item {
      grid-row: span var(--fp-rows-tablet);
    }
  }

  @media (min-width: 768px) {
    .fp-grid-item {
      grid-row: span var(--fp-rows-desktop);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .fp-save-btn.is-saved .fp-save-icon-filled {
      animation: fp-save-pop 0.28s cubic-bezier(0.22, 1, 0.36, 1);
    }
  }

  @keyframes fp-save-pop {
    0% {
      transform: scale(0.6);
    }
    60% {
      transform: scale(1.18);
    }
    100% {
      transform: scale(1);
    }
  }
</style>

<script>
  import { isSaved, toggleSaved, SAVED_UPDATED_EVENT } from "../utils/saved";

  // A single delegated listener handles every card on the page — Astro
  // dedupes this exact script block across every DiscoveryPostCard
  // instance, so this runs once per page load regardless of how many
  // cards are rendered, not once per card.
  function applyState(button: HTMLElement, saved: boolean) {
    button.setAttribute("aria-pressed", saved ? "true" : "false");
    button.classList.toggle("is-saved", saved);

    const outline = button.querySelector(".fp-save-icon-outline");
    const filled = button.querySelector(".fp-save-icon-filled");

    outline?.classList.toggle("hidden", saved);
    filled?.classList.toggle("hidden", !saved);
  }

  function syncAllButtons() {
    document.querySelectorAll<HTMLButtonElement>("[data-save-toggle]").forEach((button) => {
      const id = button.dataset.saveId || "";
      applyState(button, isSaved(id));
    });
  }

  syncAllButtons();

  document.addEventListener("click", (event) => {
    const target = event.target as HTMLElement;
    const button = target.closest<HTMLButtonElement>("[data-save-toggle]");

    if (!button) return;

    event.preventDefault();

    const id = button.dataset.saveId || "";

    if (!id) return;

    // toggleSaved persists to localStorage and synchronously dispatches
    // SAVED_UPDATED_EVENT, which syncAllButtons (below) is already
    // listening for — that single event is what repaints every matching
    // button (including other instances of the same product elsewhere
    // on the page), so no direct DOM update is done here.
    toggleSaved(id);
  });

  window.addEventListener(SAVED_UPDATED_EVENT, syncAllButtons);
</script>
