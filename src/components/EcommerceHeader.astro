---
const whatsappNumber = "919652012274";

const whatsappMessage = encodeURIComponent(
  "Hi Fresh Petals, I want to check today's flower availability and prices."
);

const whatsappUrl = `https://wa.me/${whatsappNumber}?text=${whatsappMessage}`;
---

<header class="border-b border-[#EEE5E8] bg-white">
  <div class="mx-auto grid max-w-7xl grid-cols-3 items-center px-4 py-3 md:px-8 md:py-4">
    <div class="flex items-center gap-4 text-[#171717]">
      <a
        href="/search"
        aria-label="Search Fresh Petals flowers"
        class="inline-flex transition duration-200 ease-[cubic-bezier(0.22,1,0.36,1)] hover:scale-110 hover:text-[#D98B9A] active:scale-95"
      >
        <svg
          class="h-5 w-5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="11" cy="11" r="7"></circle>
          <path d="M20 20l-3.5-3.5"></path>
        </svg>
      </a>

      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="hidden text-[10px] font-medium uppercase tracking-[0.22em] text-[#77706f] transition hover:text-[#D98B9A] md:inline-block"
      >
        Hyderabad
      </a>
    </div>

    <a
      href="/"
      class="text-center"
      aria-label="Fresh Petals Hyderabad home"
    >
      <span class="fp-serif block text-xl normal-case tracking-[0.03em] text-[#171717] md:text-2xl">
        Fresh Petals
      </span>

      <span class="mt-1 block text-[8px] font-medium uppercase tracking-[0.34em] text-[#77706f] md:text-[9px]">
        Hyderabad
      </span>
    </a>

    <div class="flex items-center justify-end gap-4 text-[#171717] md:gap-5">
      <a
        href="/categories/offers"
        aria-label="Fresh Petals offers"
        class="inline-flex transition duration-200 ease-[cubic-bezier(0.22,1,0.36,1)] hover:scale-110 hover:text-[#D98B9A] active:scale-95"
      >
        <svg
          class="h-5 w-5 md:h-6 md:w-6"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M20 13 11 22l-9-9V4h9l9 9Z"></path>
          <path d="M7.5 7.5h.01"></path>
        </svg>
      </a>

      <a
        href="/cart"
        aria-label="View Fresh Petals cart"
        class="relative inline-flex transition duration-200 ease-[cubic-bezier(0.22,1,0.36,1)] hover:scale-110 hover:text-[#D98B9A] active:scale-95"
      >
        <svg
          class="h-6 w-6 md:h-7 md:w-7"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M6 8h12l1 13H5L6 8z"></path>
          <path d="M9 8V6a3 3 0 0 1 6 0v2"></path>
        </svg>

        <span
          data-cart-count-badge
          class="absolute -right-2 -top-2 hidden min-h-5 min-w-5 items-center justify-center rounded-full bg-[#FF5A3D] px-1.5 text-[10px] font-bold leading-none text-white"
        >
          0
        </span>
      </a>
    </div>
  </div>

  <script>
    import { getCartCount } from "../utils/cart";

    function updateHeaderCartCount() {
      const badge = document.querySelector("[data-cart-count-badge]");
      if (!badge) return;

      const count = getCartCount();

      if (count > 0) {
        badge.textContent = String(count);
        badge.classList.remove("hidden");
        badge.classList.add("inline-flex");
      } else {
        badge.textContent = "0";
        badge.classList.add("hidden");
        badge.classList.remove("inline-flex");
      }
    }

    updateHeaderCartCount();

    window.addEventListener("fresh-petals-cart-updated", updateHeaderCartCount);
    window.addEventListener("storage", updateHeaderCartCount);
  </script>
</header>