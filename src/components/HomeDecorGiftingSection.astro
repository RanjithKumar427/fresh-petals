---
// Complete Homepage Visual Consistency milestone — see PoojaProductsSection
// for the full reasoning. The empty-state fallback (shown when none of the
// curated slugs resolve) is preserved exactly as before, just visually
// unchanged from its pre-existing form since it's not a product card.
import DiscoveryPostCard from "./DiscoveryPostCard.astro";
import { productCatalog } from "../data/productCatalog";
import { loadAuthoritativePrices, withAuthoritativePrice } from "../server/services/ProductPricing";

const priceMap = await loadAuthoritativePrices();

const sectionProductSlugs = [
  "dried-flower-bunch",
  "clear-glass-vase",
  "mini-succulent-gift",
  "room-mist-flower-gift-addon",
];

const products = sectionProductSlugs
  .map((slug) => productCatalog.find((product) => product.slug === slug))
  .filter((product): product is NonNullable<typeof product> => Boolean(product))
  .map((product) => withAuthoritativePrice(product, priceMap));
---

<section class="bg-linen px-3 pb-8 pt-5 md:px-6 md:pb-12">
  <div class="mx-auto max-w-7xl">
    <div class="mb-3 flex items-baseline justify-between px-0.5">
      <h2 class="text-[15px] font-medium text-black/80">
        Home Decor & Gifting
      </h2>

      <a
        href="/categories/dried-flowers"
        class="group inline-flex items-center gap-1 text-[12px] text-black/45 transition hover:text-apricot-deep"
      >
        View all
        <span aria-hidden="true" class="transition group-hover:translate-x-0.5">→</span>
      </a>
    </div>

    {
      products.length > 0 ? (
        <div class="columns-2 gap-2 md:columns-3 md:gap-2.5 lg:columns-4">
          {products.map((product) => (
            <DiscoveryPostCard
              slug={product.slug}
              name={product.name}
              image={product.image}
              priceLabel={product.priceLabel}
              priceType={product.priceType}
              idealFor={product.idealFor}
              badge={product.badge}
            />
          ))}
        </div>
      ) : (
        <div class="rounded-[24px] border border-black/[0.08] bg-paper p-8 text-center">
          <h3 class="text-lg font-semibold text-ink">
            Decor products coming soon
          </h3>

          <p class="mt-3 text-sm leading-7 text-moss">
            We are updating dried flowers, vases, plants and decor add-ons.
          </p>
        </div>
      )
    }
  </div>
</section>
