---
const whatsappNumber = "919652012274";
const whatsappMessage = encodeURIComponent(
  "Hi Fresh Petals, I want to know more about your flower delivery services."
);

const instagramUrl = "https://www.instagram.com/freshpetals.hyderabad/";

const shopLinks = [
  { label: "All Flowers", href: "#bouquets" },
  { label: "Bouquets", href: "#bouquets" },
  { label: "Pooja Flowers", href: "#pooja" },
  { label: "Flower Subscription", href: "#subscriptions" },
  { label: "Wedding Flowers", href: "#occasions" },
  { label: "Hampers", href: "#popular-with-flowers" },
];

const helpLinks = [
  {
    label: "Contact Us",
    href: `https://wa.me/${whatsappNumber}?text=${whatsappMessage}`,
  },
  { label: "FAQs", href: "/faqs" },
  { label: "Shipping Policy", href: "/shipping" },
  { label: "Refund Policy", href: "/refunds" },
  { label: "Privacy Policy", href: "/privacy" },
  { label: "Terms of Service", href: "/terms" },
];
---

   <div class="mx-auto max-w-7xl">
    <div class="grid gap-10 border-b border-white/20 pb-10 lg:grid-cols-[1.2fr_0.8fr_0.8fr_1.1fr]">
      <div>
        <a href="/" class="inline-block">
          <span class="fp-serif block text-3xl tracking-[0.04em] text-white">
            Fresh Petals
          </span>
          <span class="mt-2 block text-[10px] font-medium uppercase tracking-[0.35em] text-white/70">
            Hyderabad
          </span>
        </a>

        <p class="mt-5 max-w-sm text-sm leading-7 text-white/75">
          Fresh flowers for pooja, bouquets, jasmine, garlands, wedding flowers,
          subscriptions and gifting across Hyderabad.
        </p>

        <div class="mt-6 flex items-center gap-4 text-lg text-white">
          <a
            href={instagramUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Instagram"
            class="transition hover:text-[#E8A7B8]"
          >
            <svg
              class="h-5 w-5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <rect x="4" y="4" width="16" height="16" rx="5"></rect>
              <circle cx="12" cy="12" r="3.4"></circle>
              <circle
                cx="17"
                cy="7"
                r="0.8"
                fill="currentColor"
                stroke="none"
              ></circle>
            </svg>
          </a>

          <a
            href={`https://wa.me/${whatsappNumber}?text=${whatsappMessage}`}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="WhatsApp"
            class="transition hover:text-[#E8A7B8]"
          >
            <svg
              class="h-5 w-5"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path d="M20 3.9A10 10 0 0 0 4.3 18.7L3 22l3.4-1.2A10 10 0 1 0 20 3.9zm-8 16.2c-1.6 0-3.1-.4-4.5-1.2l-.3-.2-2 .7.7-2-.2-.3A8.1 8.1 0 1 1 12 20.1zm4.5-6.1c-.2-.1-1.2-.6-1.4-.7-.2-.1-.3-.1-.4.1-.1.2-.5.7-.6.8-.1.1-.2.1-.4 0-1.1-.5-1.9-1.1-2.7-2.4-.2-.3 0-.4.1-.6l.3-.4c.1-.1.1-.2.2-.3 0-.1 0-.2 0-.3 0-.1-.4-1-.6-1.4-.2-.4-.4-.3-.6-.3h-.5c-.2 0-.4.1-.6.3-.2.2-.8.8-.8 1.9s.8 2.1.9 2.3c.1.2 1.6 2.5 4 3.4.6.2 1 .4 1.4.5.6.2 1.1.2 1.5.1.5-.1 1.2-.5 1.4-1 .2-.5.2-.9.1-1-.1-.1-.2-.1-.4-.2z"></path>
            </svg>
          </a>
        </div>
      </div>

      <div>
        <h3 class="text-[11px] font-semibold uppercase tracking-[0.32em] text-white">
          Shop
        </h3>

        <ul class="mt-5 space-y-3">
          {shopLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-sm text-white/70 transition hover:text-white"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="text-[11px] font-semibold uppercase tracking-[0.32em] text-white">
          Help
        </h3>

        <ul class="mt-5 space-y-3">
          {helpLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-sm text-white/70 transition hover:text-white"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="text-[11px] font-semibold uppercase tracking-[0.32em] text-white">
          Sign Up And Save
        </h3>

        <p class="mt-5 text-sm leading-7 text-white/75">
          Get updates on fresh flower availability, festive pooja flowers,
          bouquet offers and subscription plans.
        </p>

        <form class="mt-5 flex border border-white/40">
          <input
            type="email"
            placeholder="Enter your email"
            class="min-w-0 flex-1 bg-transparent px-4 py-3 text-sm text-white placeholder:text-white/55 outline-none"
          />

          <button
            type="submit"
            class="bg-white px-5 py-3 text-[11px] font-bold uppercase tracking-[0.22em] text-[#075838] transition hover:bg-[#E8A7B8]"
          >
            Join
          </button>
        </form>

        <a
          href={`https://wa.me/${whatsappNumber}?text=${whatsappMessage}`}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-5 inline-flex border border-white/50 px-5 py-3 text-[11px] font-bold uppercase tracking-[0.22em] text-white transition hover:border-white hover:bg-white hover:text-[#075838]"
        >
          Chat On WhatsApp
        </a>
      </div>
    </div>

    <div class="flex flex-col justify-between gap-4 pt-6 text-xs text-white/60 md:flex-row">
      <p>© 2026 Fresh Petals Hyderabad. All rights reserved.</p>
      <p>Fresh flower orders • Hyderabad • WhatsApp-first service</p>
    </div>
  </div>
</footer>