---
import imageVariants from "../data/imageVariants.json";
import imageDimensions from "../data/imageDimensions.json";
import { journeyHref, journeyLines, type Journey } from "../utils/journey";
import { QUOTE_ONLY_CLOSING, isQuoteOnlyLabel } from "../shared/quoteOnly";
import { productCatalog } from "../data/productCatalog";
import { categoryLabel, enquiryConfirmLine, enquiryQuantityLine, identityInSentence, productIdentity } from "../data/productSupply";

type PriceType = "fixed" | "from" | "market" | "quote";

interface Props {
  id?: string;
  name: string;
  image: string;
  priceLabel?: string;
  category?: string;
  description?: string;
  slug?: string;
  priceType?: PriceType;
  isAvailable?: boolean;
  whatsappText?: string;
  journey?: Journey | null;
  /** Description of the photograph; the product name when not given. */
  imageAlt?: string;
}

const {
  id,
  name,
  image,
  priceLabel = "Market price today",
  category = "Fresh Flowers",
  description = "Fresh flowers made on order based on availability.",
  slug,
  priceType = "market",
  isAvailable = true,
  whatsappText,
  journey = null,
  imageAlt,
} = Astro.props;

const whatsappNumber = "919652012274";

// What the product is, from its catalogue record (src/data/productSupply.ts):
// shown in place of the category label and named in the WhatsApp draft, so a
// creative name ("Pink Secret") is never the only identification on a card.
const record = slug ? productCatalog.find((product) => product.slug === slug) : undefined;
const identity = record ? productIdentity(record) : null;
const named = identity ? `${name} (${identityInSentence(identity)})` : name;
// The quote question for a container the record leaves open (a vase, a pot) travels with the quantity line.
const quantityLine = record ? [enquiryQuantityLine(record), enquiryConfirmLine(record)].filter(Boolean).join("\n") : "Quantity: 1";

const productUrl = slug ? journeyHref(`/products/${slug}`, journey) : "#";
// Literal link text: what the link opens.
const viewLabel = /^(bouquets|lilies)$/i.test(category) ? "View bouquet" : "View details";

const cartId = id || slug || name.toLowerCase().replaceAll(" ", "-");

// Responsive variants (240/480/720w) from the existing manifest, so grid
// cards stop downloading the 1200px originals on phones.
const variants = (imageVariants as Record<string, Record<string, string>>)[image];
const dimensions = (imageDimensions as Record<string, { width: number; height: number }>)[image];
const srcset = variants
  ? Object.entries(variants)
      .map(([width, path]) => `${path} ${width}w`)
      .join(", ")
  : undefined;

// Quote-only products (src/shared/quoteOnly.ts) arrive with the quote-only
// label instead of an amount; their enquiry carries no price.
const quoteOnly = isQuoteOnlyLabel(priceLabel);
const defaultMessage = `Hi Fresh Petals, I want to order ${named}. Please confirm today's availability and price.`;
const linkLine = slug ? `Link: ${Astro.site ? new URL(`/products/${slug}`, Astro.site) : `/products/${slug}`}` : "";

const finalMessage = whatsappText || (quoteOnly
  ? [...[`Hi Fresh Petals, I'd like to enquire about ${named}.`, quantityLine, linkLine, ...journeyLines(journey)].filter(Boolean), "", QUOTE_ONLY_CLOSING]
  : [defaultMessage, `Price: ${priceLabel}`, quantityLine, linkLine, ...journeyLines(journey)].filter(Boolean)).join("\n");

// Product enquiries need a recipient city the customer chose
// (src/utils/productEnquiry.ts). The draft travels without one in
// data-enquiry-text; the city line is added when the link is used. The
// href never opens WhatsApp by itself: without scripts (no city can be
// chosen) it leads to the product page.
const enquiryFallbackHref = slug ? `${productUrl}#recipient-city` : "#";

const priceBadge = quoteOnly
  ? "WhatsApp quote"
  : priceType === "fixed"
    ? "Fixed price"
    : priceType === "from"
      ? "Starting price"
      : priceType === "quote"
        ? "Custom quote"
        : "Today’s price";
const priceBadgeShort =
  priceType === "fixed" ? "Fixed" : priceType === "from" ? "From" : priceType === "quote" ? "Quote" : "Today’s";
---

<article
  class="group fp-card flex h-full flex-col overflow-hidden hover:-translate-y-1"
>
  <!-- P1.5 (Phase 1 discovery hardening) -- the <a> below used to wrap the
       whole image container including where the price badge sits. Adding
       a save button meant it could no longer wrap the container itself:
       a <button> can't legally nest inside an <a>, the same reason
       DiscoveryPostCard.astro's card link is a sibling overlay rather than
       a wrapper (see that file's header comment). Restructured so the
       positioning container is now the outer element, the <a> wraps only
       the image + unavailable-overlay (identical tap target as before),
       and the price badge + new save button are its siblings. Purely
       structural -- no visual change to the existing elements. -->
  <div class="relative aspect-square overflow-hidden bg-linen">
    <a href={productUrl} data-journey-link class="block h-full w-full" aria-label={`View ${name}`}>
      <img
        src={image}
        srcset={srcset}
        sizes={srcset ? "(min-width: 1024px) 23vw, (min-width: 768px) 31vw, 48vw" : undefined}
        alt={imageAlt ?? name}
        width={dimensions?.width}
        height={dimensions?.height}
        loading="lazy"
        decoding="async"
        class="h-full w-full object-cover transition duration-700 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:scale-105"
      />

      {
        !isAvailable && (
          <div class="absolute inset-0 flex items-center justify-center bg-black/45">
            <span class="rounded-full bg-paper px-4 py-2 text-[11px] font-bold uppercase tracking-[0.22em] text-ink">
              Unavailable
            </span>
          </div>
        )
      }
    </a>

    <!-- Short label on narrow cards so it never runs under the save button. -->
    <span class="absolute left-3 top-3 max-w-[calc(100%-4rem)] truncate rounded-full bg-white/95 px-3 py-1 text-[10px] font-bold uppercase tracking-[0.14em] text-berry shadow-sm sm:tracking-[0.18em]">
      <span class="sm:hidden">{priceBadgeShort}</span><span class="hidden sm:inline">{priceBadge}</span>
    </span>

    {
      slug && (
        <button
          type="button"
          data-save-toggle
          data-save-id={slug}
          aria-label={`Save ${name}`}
          aria-pressed="false"
          class="fp-save-btn absolute right-1 top-1 z-20 flex h-11 w-11 items-center justify-center"
        >
          <span class="fp-save-visual flex h-9 w-9 items-center justify-center rounded-full bg-white/90 text-black/55 shadow-sm backdrop-blur transition active:scale-90">
            <svg
              class="fp-save-icon-outline h-[18px] w-[18px]"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M12 21s-7.5-4.6-9.8-9.1C.6 8 2 4.5 5.6 4.5c2.1 0 3.7 1.2 4.4 2.7.7-1.5 2.3-2.7 4.4-2.7 3.6 0 5 3.5 3.4 6.9C19.5 16.4 12 21 12 21Z" />
            </svg>

            <svg
              class="fp-save-icon-filled hidden h-[18px] w-[18px] text-berry"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path d="M12 21s-7.5-4.6-9.8-9.1C.6 8 2 4.5 5.6 4.5c2.1 0 3.7 1.2 4.4 2.7.7-1.5 2.3-2.7 4.4-2.7 3.6 0 5 3.5 3.4 6.9C19.5 16.4 12 21 12 21Z" />
            </svg>
          </span>
        </button>
      )
    }
  </div>

  <!-- A column whose actions sit at the bottom, so the buttons line up
       across a row whatever the length of the name, code or price. -->
  <div class="flex flex-1 flex-col p-4 sm:p-5">
    <p class="text-[10px] font-semibold uppercase tracking-[0.18em] text-rose-deep [overflow-wrap:anywhere] sm:tracking-[0.24em]" data-card-identity={identity ? "" : undefined}>
      {identity ?? categoryLabel(category)}
    </p>

    <a href={productUrl} data-journey-link class="mt-2 block">
      <h3 class="line-clamp-3 text-[15px] font-semibold leading-snug text-ink [overflow-wrap:anywhere] transition group-hover:text-berry">
        {name}
      </h3>
    </a>

    <p class="mt-2 line-clamp-2 min-h-[38px] text-[13px] leading-6 text-moss">
      {description}
    </p>

    <p class="mt-auto pt-4 text-[14px] font-bold text-ink">
      {priceLabel}
    </p>

    <a href={productUrl} data-journey-link class="mt-2 inline-flex min-h-[44px] items-center text-[12px] font-semibold text-ink underline underline-offset-2 hover:text-berry">
      {viewLabel}
    </a>

      <button
        type="button"
        data-add-to-cart
        data-cart-id={cartId}
        data-cart-slug={slug || ""}
        data-cart-name={name}
        data-cart-image={image}
        data-cart-price-label={priceLabel}
        data-cart-category={category}
        class:list={[
          "mt-1 inline-flex min-h-[44px] w-full items-center justify-center rounded-full border px-2 py-2 text-center text-[10px] font-bold uppercase leading-tight tracking-[0.06em] transition active:scale-95",
          isAvailable
            ? "border-berry bg-berry text-white hover:border-berry-deep hover:bg-berry-deep"
            : "pointer-events-none border-line text-sage-deep",
        ]}
      >
        {isAvailable ? "Add to basket" : "Closed"}
      </button>

    <!-- "Enquire on WhatsApp" is the direct single-bouquet enquiry and
         "Add to basket" collects several bouquets; both are primary
         actions, so both are Deep Rose with white lettering. -->
    <a
      href={enquiryFallbackHref}
      data-product-enquiry
      data-enquiry-text={finalMessage}
      data-whatsapp-order-link
      data-whatsapp-custom-text={whatsappText ? "true" : "false"}
      data-whatsapp-number={whatsappNumber}
      data-whatsapp-product-name={named}
      data-whatsapp-quantity-line={quantityLine}
      data-whatsapp-price-label={priceLabel}
      data-whatsapp-quote-only={quoteOnly ? "true" : undefined}
      class:list={[
        "fp-btn-whatsapp mt-2 inline-flex min-h-[44px] w-full items-center justify-center rounded-full px-2 py-2 text-center text-[10px] font-bold uppercase leading-tight tracking-[0.06em] shadow-[0_10px_22px_rgba(138,63,86,0.22)]",
        isAvailable
          ? "bg-berry text-white hover:bg-berry-deep"
          : "pointer-events-none bg-linen text-moss",
      ]}
    >
      {isAvailable ? "Enquire on WhatsApp" : "Unavailable"}
    </a>

    <div data-cart-feedback={cartId} class="fp-cart-toast mt-3">
      <div>
        <p class="rounded-full bg-mint-soft px-3 py-2 text-center text-[11px] font-semibold text-ink">
          Added to basket
        </p>
      </div>
    </div>
  </div>
</article>

<script>
  import { addToCart } from "../utils/cart";
  import { QUOTE_ONLY_CLOSING } from "../shared/quoteOnly";
  import { journeyFromParams, journeyLines } from "../utils/journey";
  const contextFor = (element: Element) => { const link = element.closest("article")?.querySelector<HTMLAnchorElement>("[data-journey-link]"); return link ? journeyFromParams(new URL(link.href).searchParams) : null; };
  // P1.5 (Phase 1 discovery hardening) -- same pattern DiscoveryPostCard.astro
  // and products/[slug].astro already use: a delegated listener plus a
  // SAVED_UPDATED_EVENT-driven repaint. Added directly here (not assumed
  // to already exist on the page) because ProductCard renders on /search
  // and /categories/*, neither of which renders DiscoveryPostCard, so
  // there is no other save listener present to rely on. Astro dedupes
  // this whole script block once per page no matter how many ProductCard
  // instances render -- confirmed by this component already relying on
  // that same dedup for its addToCart/WhatsApp wiring below.
  import { isSaved, toggleSaved, SAVED_UPDATED_EVENT } from "../utils/saved";

  function applySaveState(button: HTMLElement, saved: boolean) {
    button.setAttribute("aria-pressed", saved ? "true" : "false");
    button.classList.toggle("is-saved", saved);

    const outline = button.querySelector(".fp-save-icon-outline");
    const filled = button.querySelector(".fp-save-icon-filled");

    outline?.classList.toggle("hidden", saved);
    filled?.classList.toggle("hidden", !saved);
  }

  function syncSaveButtons() {
    document.querySelectorAll<HTMLButtonElement>("[data-save-toggle]").forEach((button) => {
      const id = button.dataset.saveId || "";
      applySaveState(button, isSaved(id));
    });
  }

  syncSaveButtons();

  // Same event-level guard as products/[slug].astro's dedicated save
  // script and DiscoveryPostCard.astro's -- more than one of these
  // delegated listeners can legitimately coexist on one page (e.g. the
  // product page's own hero save button + this component's related-
  // products rail), and without the guard a single click toggles save
  // twice via both listeners and cancels itself out. Confirmed live.
  document.addEventListener("click", (event) => {
    const target = event.target as HTMLElement;
    const button = target.closest<HTMLButtonElement>("[data-save-toggle]");

    if (!button) return;

    const marked = event as Event & { __fpSaveHandled?: boolean };
    if (marked.__fpSaveHandled) return;
    marked.__fpSaveHandled = true;

    event.preventDefault();

    const id = button.dataset.saveId || "";

    if (!id) return;

    toggleSaved(id);
  });

  window.addEventListener(SAVED_UPDATED_EVENT, syncSaveButtons);

  // The card's enquiry draft follows the shopping context (occasion and
  // intent from the filters). It never carries the recipient city: the
  // enquiry gate (src/utils/productEnquiry.ts) adds the chosen city's line
  // when the link is used, and blocks it until one is chosen. Links whose
  // message was customised via the `whatsappText` prop are left alone.
  function updateEnquiryDrafts() {
    const links = document.querySelectorAll<HTMLAnchorElement>(
      '[data-whatsapp-order-link][data-whatsapp-custom-text="false"]'
    );

    links.forEach((link) => {
      const productName = link.dataset.whatsappProductName || "";
      const priceLabel = link.dataset.whatsappPriceLabel || "";
      const quantityLine = link.dataset.whatsappQuantityLine || "Quantity: 1";

      const journey = contextFor(link);
      const productLink = link.closest("article")?.querySelector<HTMLAnchorElement>("[data-journey-link]");
      const linkLine = productLink ? `Link: ${location.origin}${new URL(productLink.href).pathname}` : "";
      const lines = link.dataset.whatsappQuoteOnly === "true"
        ? [...[`Hi Fresh Petals, I'd like to enquire about ${productName}.`, quantityLine, linkLine, ...journeyLines(journey)].filter(Boolean), "", QUOTE_ONLY_CLOSING]
        : [`Hi Fresh Petals, I want to order ${productName}. Please confirm today's availability and price.`, `Price: ${priceLabel}`, quantityLine, linkLine, ...journeyLines(journey)].filter(Boolean);
      link.dataset.enquiryText = lines.join("\n");
    });
  }

  updateEnquiryDrafts();
  document.addEventListener("fresh-petals-shop-updated", updateEnquiryDrafts);

  const buttons = document.querySelectorAll("[data-add-to-cart]");

  buttons.forEach((button) => {
    button.addEventListener("click", () => {
      const htmlButton = button as HTMLButtonElement;

      const id = htmlButton.dataset.cartId || "";
      const slug = htmlButton.dataset.cartSlug || "";
      const name = htmlButton.dataset.cartName || "";
      const image = htmlButton.dataset.cartImage || "";
      const priceLabel = htmlButton.dataset.cartPriceLabel || "";
      const category = htmlButton.dataset.cartCategory || "";

      addToCart(
        {
          id,
          slug,
          name,
          image,
          priceLabel,
          category,
          journey: contextFor(htmlButton),
        },
        1
      );

      const feedback = document.querySelector(`[data-cart-feedback="${id}"]`);

      if (feedback) {
        feedback.classList.add("is-visible");

        setTimeout(() => {
          feedback.classList.remove("is-visible");
        }, 1800);
      }
    });
  });
</script>

<style>
  /* P1.5 (Phase 1 discovery hardening) -- same fill-pop animation
     DiscoveryPostCard.astro and products/[slug].astro already define in
     their own scoped <style> blocks. Astro scopes styles per-component,
     so it doesn't reach here automatically; copied rather than extracted
     into a shared module for four lines, matching the existing pattern. */
  @media (prefers-reduced-motion: no-preference) {
    .fp-save-btn.is-saved .fp-save-icon-filled {
      animation: fp-save-pop 0.28s cubic-bezier(0.22, 1, 0.36, 1);
    }
  }

  @keyframes fp-save-pop {
    0% {
      transform: scale(0.6);
    }
    60% {
      transform: scale(1.18);
    }
    100% {
      transform: scale(1);
    }
  }
</style>
