---
type PriceType = "fixed" | "from" | "market" | "quote";

interface Props {
  id?: string;
  name: string;
  image: string;
  priceLabel?: string;
  category?: string;
  description?: string;
  slug?: string;
  priceType?: PriceType;
  isAvailable?: boolean;
  whatsappText?: string;
}

const {
  id,
  name,
  image,
  priceLabel = "Market price today",
  category = "Fresh Flowers",
  description = "Fresh flowers made on order based on availability.",
  slug,
  priceType = "market",
  isAvailable = true,
  whatsappText,
} = Astro.props;

const whatsappNumber = "919652012274";

const productUrl = slug ? `/products/${slug}` : "#";

const cartId = id || slug || name.toLowerCase().replaceAll(" ", "-");

const defaultMessage = `Hi Fresh Petals, I want to order ${name}. Please confirm today's availability and price.`;

const finalMessage = whatsappText || defaultMessage;

const whatsappUrl = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(finalMessage)}`;

const priceBadge =
  priceType === "fixed"
    ? "Fixed price"
    : priceType === "from"
      ? "Starting price"
      : priceType === "quote"
        ? "Custom quote"
        : "Today’s price";
---

<article
  class="group fp-card overflow-hidden hover:-translate-y-1"
>
  <a href={productUrl} class="block" aria-label={`View ${name}`}>
    <div class="relative aspect-square overflow-hidden bg-[#F8F1F3]">
      <img
        src={image}
        alt={name}
        loading="lazy"
        decoding="async"
        class="h-full w-full object-cover transition duration-700 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:scale-105"
      />

      {
        !isAvailable && (
          <div class="absolute inset-0 flex items-center justify-center bg-black/45">
            <span class="rounded-full bg-white px-4 py-2 text-[11px] font-bold uppercase tracking-[0.22em] text-[#2A2025]">
              Unavailable
            </span>
          </div>
        )
      }

      <span class="absolute left-3 top-3 rounded-full bg-white/95 px-3 py-1 text-[10px] font-bold uppercase tracking-[0.18em] text-[#7C243E] shadow-sm">
        {priceBadge}
      </span>
    </div>
  </a>

  <div class="p-5">
    <p class="text-[10px] font-semibold uppercase tracking-[0.24em] text-[#9B6B78]">
      {category}
    </p>

    <a href={productUrl} class="mt-2 block">
      <h3 class="line-clamp-2 min-h-[42px] text-[15px] font-semibold leading-snug text-[#2A2025] transition group-hover:text-[#7C243E]">
        {name}
      </h3>
    </a>

    <p class="mt-2 line-clamp-2 min-h-[38px] text-[13px] leading-6 text-[#66565D]">
      {description}
    </p>

    <p class="mt-4 text-[14px] font-bold text-[#7C243E]">
      {priceLabel}
    </p>

    <div class="mt-4 grid grid-cols-2 gap-2">
      <a
        href={productUrl}
        class="inline-flex items-center justify-center rounded-full border border-[#111111] px-4 py-2 text-[10px] font-bold uppercase tracking-[0.16em] text-[#111111] transition active:scale-95 hover:bg-[#111111] hover:text-white"
      >
        View
      </a>

      <button
        type="button"
        data-add-to-cart
        data-cart-id={cartId}
        data-cart-slug={slug || ""}
        data-cart-name={name}
        data-cart-image={image}
        data-cart-price-label={priceLabel}
        data-cart-category={category}
        class:list={[
          "inline-flex items-center justify-center rounded-full px-4 py-2 text-[10px] font-bold uppercase tracking-[0.16em] transition active:scale-95",
          isAvailable
            ? "bg-[#7C243E] text-white hover:bg-[#111111]"
            : "pointer-events-none bg-[#D8D1D4] text-[#7A6E73]",
        ]}
      >
        {isAvailable ? "Add" : "Closed"}
      </button>
    </div>

    <a
      href={whatsappUrl}
      target="_blank"
      rel="noopener noreferrer"
      data-whatsapp-order-link
      data-whatsapp-custom-text={whatsappText ? "true" : "false"}
      data-whatsapp-number={whatsappNumber}
      data-whatsapp-product-name={name}
      data-whatsapp-price-label={priceLabel}
      class:list={[
        "mt-3 inline-flex w-full items-center justify-center rounded-full px-4 py-2 text-[10px] font-bold uppercase tracking-[0.18em] transition active:scale-95",
        isAvailable
          ? "bg-[#075838] text-white hover:bg-[#7C243E]"
          : "pointer-events-none bg-[#D8D1D4] text-[#7A6E73]",
      ]}
    >
      {isAvailable ? "Order on WhatsApp" : "Unavailable"}
    </a>

    <p
      data-cart-feedback={cartId}
      class="mt-3 hidden rounded-full bg-[#F3FFF7] px-3 py-2 text-center text-[11px] font-semibold text-[#075838]"
    >
      Added to cart
    </p>
  </div>
</article>

<script>
  import { addToCart } from "../utils/cart";
  import { getSelectedArea, AREA_UPDATED_EVENT } from "../utils/area";

  // Customer UX milestone — Simple Order (Journey A): the product card's
  // WhatsApp link is server-rendered with a generic message (area is
  // client-only, localStorage). Once mounted, if the customer has already
  // selected an area, rebuild the message to include it — matching the
  // preferred "FreshPetals Order Request" template. Links whose message
  // was explicitly customized via the `whatsappText` prop are left alone.
  function updateWhatsappLinks(area: string | null) {
    const links = document.querySelectorAll<HTMLAnchorElement>(
      '[data-whatsapp-order-link][data-whatsapp-custom-text="false"]'
    );

    links.forEach((link) => {
      const number = link.dataset.whatsappNumber || "";
      const productName = link.dataset.whatsappProductName || "";
      const priceLabel = link.dataset.whatsappPriceLabel || "";

      const message = area
        ? [
            "FreshPetals Order Request 🌸",
            "",
            "Product:",
            productName,
            "",
            "Price:",
            priceLabel,
            "",
            "Delivery area:",
            area,
            "",
            "Please confirm availability, final price and delivery details.",
          ].join("\n")
        : `Hi Fresh Petals, I want to order ${productName}. Please confirm today's availability and price.`;

      link.href = `https://wa.me/${number}?text=${encodeURIComponent(message)}`;
    });
  }

  updateWhatsappLinks(getSelectedArea());

  window.addEventListener(AREA_UPDATED_EVENT, ((event: CustomEvent<{ area: string }>) => {
    updateWhatsappLinks(event.detail.area);
  }) as EventListener);

  const buttons = document.querySelectorAll("[data-add-to-cart]");

  buttons.forEach((button) => {
    button.addEventListener("click", () => {
      const htmlButton = button as HTMLButtonElement;

      const id = htmlButton.dataset.cartId || "";
      const slug = htmlButton.dataset.cartSlug || "";
      const name = htmlButton.dataset.cartName || "";
      const image = htmlButton.dataset.cartImage || "";
      const priceLabel = htmlButton.dataset.cartPriceLabel || "";
      const category = htmlButton.dataset.cartCategory || "";

      addToCart(
        {
          id,
          slug,
          name,
          image,
          priceLabel,
          category,
        },
        1
      );

      const feedback = document.querySelector(`[data-cart-feedback="${id}"]`);

      if (feedback) {
        feedback.classList.remove("hidden");

        setTimeout(() => {
          feedback.classList.add("hidden");
        }, 1600);
      }
    });
  });
</script>   