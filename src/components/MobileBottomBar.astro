---
const whatsappNumber = "919652012274";

const whatsappMessage = encodeURIComponent(
  "Hi Fresh Petals, I want to place an order."
);

const whatsappUrl = `https://wa.me/${whatsappNumber}?text=${whatsappMessage}`;

const navItems = [
  {
    label: "Home",
    href: "/",
    icon: "home",
  },
  {
    label: "Shop",
    href: "/categories/bouquets",
    icon: "shop",
  },
  {
    label: "Pooja",
    href: "/categories/pooja-flowers",
    icon: "flower",
  },
  {
    label: "Cart",
    href: "/cart",
    icon: "cart",
  },
];
---

<div class="fixed bottom-0 left-0 right-0 z-[999] border-t border-line bg-white/95 shadow-[0_-8px_24px_rgba(0,0,0,0.08)] backdrop-blur md:hidden">
  <div class="grid grid-cols-[1fr_1fr_1fr_1fr_1fr_1.25fr] items-center">
    {
      navItems.map((item) => (
        <a
          href={item.href}
          class="fp-icon-tap relative flex flex-col items-center justify-center gap-1 px-1.5 py-2.5 text-ink hover:text-rose-deep"
          aria-label={item.label}
        >
          {
            item.icon === "home" && (
              <svg
                class="h-5 w-5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M3 10.8 12 3l9 7.8"></path>
                <path d="M5.5 10.5V21h13V10.5"></path>
                <path d="M9.5 21v-6h5v6"></path>
              </svg>
            )
          }

          {
            item.icon === "shop" && (
              <svg
                class="h-5 w-5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M6 8h12l1 13H5L6 8z"></path>
                <path d="M9 8V6a3 3 0 0 1 6 0v2"></path>
              </svg>
            )
          }

          {
            item.icon === "flower" && (
              <svg
                class="h-5 w-5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M12 13c2.5-2.5 2.5-5.5 0-8-2.5 2.5-2.5 5.5 0 8Z"></path>
                <path d="M12 13c-2.5-2.5-5.5-2.5-8 0 2.5 2.5 5.5 2.5 8 0Z"></path>
                <path d="M12 13c2.5 2.5 5.5 2.5 8 0-2.5-2.5-5.5-2.5-8 0Z"></path>
                <path d="M12 13v8"></path>
              </svg>
            )
          }


          {
            item.icon === "cart" && (
              <>
                <svg
                  class="h-5 w-5"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.7"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M6 8h12l1 13H5L6 8z"></path>
                  <path d="M9 8V6a3 3 0 0 1 6 0v2"></path>
                </svg>

                <span
                  data-mobile-cart-count-badge
                  class="absolute right-2 top-1 hidden min-h-4 min-w-4 items-center justify-center rounded-full bg-apricot-deep px-1 text-[9px] font-bold leading-none text-white"
                >
                  0
                </span>
              </>
            )
          }

          <span class="text-[8px] font-semibold uppercase tracking-[0.13em]">
            {item.label}
          </span>
        </a>
      ))
    }

    <a
      href={whatsappUrl}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Order Fresh Petals flowers on WhatsApp"
      class="fp-btn-whatsapp mx-1.5 flex items-center justify-center rounded-full bg-ink px-2 py-3 text-[9px] font-bold uppercase tracking-[0.13em] text-white hover:bg-rose hover:text-ink"
    >
      Order
    </a>
  </div>

  <script>
    import { getCartCount } from "../utils/cart";

    let previousMobileCartCount = 0;

    function updateMobileCartCount() {
      const badge = document.querySelector("[data-mobile-cart-count-badge]");
      if (!badge) return;

      const count = getCartCount();

      if (count > 0) {
        badge.textContent = String(count);
        badge.classList.remove("hidden");
        badge.classList.add("inline-flex");

        if (count > previousMobileCartCount) {
          badge.classList.remove("fp-badge-pulse");
          void badge.offsetWidth;
          badge.classList.add("fp-badge-pulse");
        }
      } else {
        badge.textContent = "0";
        badge.classList.add("hidden");
        badge.classList.remove("inline-flex");
      }

      previousMobileCartCount = count;
    }

    updateMobileCartCount();

    window.addEventListener("fresh-petals-cart-updated", updateMobileCartCount);
    window.addEventListener("storage", updateMobileCartCount);
  </script>
</div>