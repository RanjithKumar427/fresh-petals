---
const whatsappNumber = "919652012274";

const whatsappMessage = encodeURIComponent(
  "Hi Fresh Petals, I want to place an order."
);

const whatsappUrl = `https://wa.me/${whatsappNumber}?text=${whatsappMessage}`;

const navItems = [
  {
    label: "Home",
    href: "/",
    icon: "home",
  },
  {
    label: "Shop",
    href: "/categories/bouquets",
    icon: "shop",
  },
  {
    label: "Pooja",
    href: "/categories/pooja-flowers",
    icon: "flower",
  },
  {
    label: "Offers",
    href: "/categories/offers",
    icon: "tag",
  },
];
---

<div class="fixed bottom-0 left-0 right-0 z-[999] border-t border-[#EEE5E8] bg-white/95 shadow-[0_-8px_24px_rgba(0,0,0,0.08)] backdrop-blur md:hidden">
  <div class="grid grid-cols-[1fr_1fr_1fr_1fr_1.4fr] items-center">
    {
      navItems.map((item) => (
        <a
          href={item.href}
          class="flex flex-col items-center justify-center gap-1 px-2 py-2.5 text-[#171717] transition hover:text-[#D98B9A]"
          aria-label={item.label}
        >
          {
            item.icon === "home" && (
              <svg
                class="h-5 w-5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M3 10.8 12 3l9 7.8"></path>
                <path d="M5.5 10.5V21h13V10.5"></path>
                <path d="M9.5 21v-6h5v6"></path>
              </svg>
            )
          }

          {
            item.icon === "shop" && (
              <svg
                class="h-5 w-5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M6 8h12l1 13H5L6 8z"></path>
                <path d="M9 8V6a3 3 0 0 1 6 0v2"></path>
              </svg>
            )
          }

          {
            item.icon === "flower" && (
              <svg
                class="h-5 w-5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M12 13c2.5-2.5 2.5-5.5 0-8-2.5 2.5-2.5 5.5 0 8Z"></path>
                <path d="M12 13c-2.5-2.5-5.5-2.5-8 0 2.5 2.5 5.5 2.5 8 0Z"></path>
                <path d="M12 13c2.5 2.5 5.5 2.5 8 0-2.5-2.5-5.5-2.5-8 0Z"></path>
                <path d="M12 13v8"></path>
              </svg>
            )
          }

          {
            item.icon === "tag" && (
              <svg
                class="h-5 w-5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M20 13 11 22l-9-9V4h9l9 9Z"></path>
                <path d="M7.5 7.5h.01"></path>
              </svg>
            )
          }

          <span class="text-[9px] font-semibold uppercase tracking-[0.16em]">
            {item.label}
          </span>
        </a>
      ))
    }

    <a
      href={whatsappUrl}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Order Fresh Petals flowers on WhatsApp"
      class="mx-2 flex items-center justify-center rounded-full bg-[#075838] px-3 py-3 text-[10px] font-bold uppercase tracking-[0.16em] text-white transition hover:bg-[#E8A7B8] hover:text-[#111111]"
    >
      Order
    </a>
  </div>
</div>