---
import ProductCard from "./ProductCard.astro";
import { productCatalog } from "../data/productCatalog";
import { loadAuthoritativePrices, withAuthoritativePrice } from "../server/services/ProductPricing";

// Catalog/Database Reconciliation milestone — same adapter every other
// migrated storefront surface uses (see ProductPricing.ts). Overlays the
// authoritative Postgres price onto this section's existing curated
// selection below; does not touch which products are chosen, their order,
// or any other field.
const priceMap = await loadAuthoritativePrices();

// Hand-picked spread across colour, mood and price point — the homepage
// shows a curated edit, not the full catalogue. Full range lives at
// /categories/bouquets via "View All Bouquets" below.
const sectionProductSlugs = [
  "blue-mountain-grace",
  "red-affair",
  "midnight-romance",
  "rose-promise",
  "sunshine-story",
  "cotton-candy-poetry",
  "snow-white-saga",
  "rainbow-hug",
];

const products = sectionProductSlugs
  .map((slug) => productCatalog.find((product) => product.slug === slug))
  .filter((product): product is NonNullable<typeof product> => Boolean(product))
  .map((product) => withAuthoritativePrice(product, priceMap));
---

<section id="bouquets" class="bg-white px-5 py-14 md:px-8 md:py-16">
  <div class="mx-auto max-w-7xl">
    <div class="mb-9 text-center">
      <p class="fp-eyebrow">
        Fresh Petals Hyderabad
      </p>

      <h2 class="fp-h2 mt-3">
        Bouquets
      </h2>

      <p class="mx-auto mt-4 max-w-2xl text-sm leading-7 text-[#66565D]">
        Fresh hand-arranged bouquets for gifting, celebrations and custom flower orders.
      </p>
    </div>

    <div class="grid grid-cols-2 gap-4 md:grid-cols-3 lg:grid-cols-4">
      {
        products.map((product) => (
          <ProductCard
            name={product.name}
            image={product.image}
            priceLabel={product.priceLabel}
            priceType={product.priceType}
            category={product.category}
            description={product.description}
            slug={product.slug}
            isAvailable={product.isAvailable}
          />
        ))
      }
    </div>

    <div class="mt-12 flex justify-center">
      <a
        href="/categories/bouquets"
        class="fp-btn-block"
      >
        View All Bouquets
      </a>
    </div>
  </div>
</section>
