---
// Xiaohongshu-Inspired Post Card System milestone — converted from the
// shared ecommerce ProductCard.astro (image/category/name/description/
// price/View/Add/WhatsApp button stack) to the same discovery post-card
// language as DiscoveryFeed.astro, flagged explicitly by the product owner
// as the next thing on the homepage that still read as an ecommerce
// catalogue. Confirmed safe to change here specifically: this component's
// only live, routed usage is index.astro (the homepage) -- CategoryGrid.astro
// also imports it, but CategoryGrid.astro itself is never imported by any
// page or component in the repository, i.e. dead code, not a real route --
// so this change cannot affect any other live page. ProductCard.astro
// itself is untouched; search/category/occasion pages keep it exactly as
// it was.
//
// Curated slug list, order, price source (PostgreSQL via ProductPricing)
// and destination category link are all unchanged from before -- only the
// card presentation and section chrome changed.
import DiscoveryPostCard from "./DiscoveryPostCard.astro";
import { productCatalog } from "../data/productCatalog";
import { loadAuthoritativePrices, withAuthoritativePrice } from "../server/services/ProductPricing";

const priceMap = await loadAuthoritativePrices();

// Hand-picked spread across colour, mood and price point — the homepage
// shows a curated edit, not the full catalogue. Full range lives at
// /categories/bouquets via the "View all" link below.
const sectionProductSlugs = [
  "blue-mountain-grace",
  "red-affair",
  "midnight-romance",
  "rose-promise",
  "sunshine-story",
  "cotton-candy-poetry",
  "snow-white-saga",
  "rainbow-hug",
];

const products = sectionProductSlugs
  .map((slug) => productCatalog.find((product) => product.slug === slug))
  .filter((product): product is NonNullable<typeof product> => Boolean(product))
  .map((product) => withAuthoritativePrice(product, priceMap));
---

<section id="bouquets" class="bg-linen px-3 pb-8 pt-5 md:px-6 md:pb-12">
  <div class="mx-auto max-w-7xl">
    <div class="mb-3 flex items-baseline justify-between px-0.5">
      <h2 class="text-[15px] font-medium text-black/80">
        Bouquets
      </h2>

      <a
        href="/categories/bouquets"
        class="group inline-flex items-center gap-1 text-[12px] text-black/45 transition hover:text-apricot-deep"
      >
        View all
        <span aria-hidden="true" class="transition group-hover:translate-x-0.5">→</span>
      </a>
    </div>

    <div class="columns-2 gap-2 md:columns-3 md:gap-2.5 lg:columns-4 xl:columns-5">
      {
        products.map((product) => (
          <DiscoveryPostCard
            slug={product.slug}
            name={product.name}
            image={product.image}
            priceLabel={product.priceLabel}
            priceType={product.priceType}
            idealFor={product.idealFor}
            badge={product.badge}
          />
        ))
      }
    </div>
  </div>
</section>
