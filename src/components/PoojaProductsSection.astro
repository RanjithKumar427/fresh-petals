---
// Complete Homepage Visual Consistency milestone — converted from the
// shared ecommerce ProductCard.astro to the homepage-only DiscoveryPostCard,
// matching DiscoveryFeed.astro and ProductSection.astro's already-converted
// treatment. Same pattern applied uniformly across every homepage product
// rail this milestone touches (see PoojaProductsSection, FlowerboxSection,
// BasketsSection, OffersSection, PopularWithFlowers,
// HomeDecorGiftingSection, WeddingTraditionalSection, SubscriptionProducts)
// -- filtering logic, category, destination link and product set are all
// unchanged, only the card/section presentation changed.
//
// Phase 3 (Physical Discovery Feed) milestone — capped at lg:columns-4
// (dropped the xl:columns-5 bump). This rail always has exactly 4
// products; at 5 columns that produced one orphaned empty column and a
// ragged bottom edge on wide screens — measured and confirmed by the
// prior Opus audit ("reads as a layout bug, not intentional masonry").
// Same fix applied to every other exactly-4-item rail (FlowerboxSection,
// BasketsSection, OffersSection, PopularWithFlowers,
// HomeDecorGiftingSection, WeddingTraditionalSection,
// SubscriptionProducts). ProductSection (8 items) and DiscoveryFeed (16
// items) keep xl:columns-5 -- they have enough items to fill it.
import DiscoveryPostCard from "./DiscoveryPostCard.astro";
import { productCatalog } from "../data/productCatalog";
import { loadAuthoritativePrices, withAuthoritativePrice } from "../server/services/ProductPricing";

const priceMap = await loadAuthoritativePrices();

const products = productCatalog
  .filter((product) => product.category === "Pooja Flowers")
  .map((product) => withAuthoritativePrice(product, priceMap));
---

<section id="pooja" class="bg-linen px-3 pb-8 pt-5 md:px-6 md:pb-12">
  <div class="mx-auto max-w-7xl">
    <div class="mb-3 flex items-baseline justify-between px-0.5">
      <h2 class="text-[15px] font-medium text-black/80">
        Pooja Flowers
      </h2>

      <a
        href="/categories/pooja-flowers"
        class="group inline-flex items-center gap-1 text-[12px] text-black/45 transition hover:text-apricot-deep"
      >
        View all
        <span aria-hidden="true" class="transition group-hover:translate-x-0.5">→</span>
      </a>
    </div>

    <div class="columns-2 gap-2 md:columns-3 md:gap-2.5 lg:columns-4">
      {
        products.map((product) => (
          <DiscoveryPostCard
            slug={product.slug}
            name={product.name}
            image={product.image}
            priceLabel={product.priceLabel}
            priceType={product.priceType}
            idealFor={product.idealFor}
            badge={product.badge}
          />
        ))
      }
    </div>
  </div>
</section>
