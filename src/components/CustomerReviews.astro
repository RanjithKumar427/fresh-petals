---
const reviews = [
  {
    title: "Fresh pooja flowers",
    text: "Ordered morning pooja flowers. The flowers were fresh, neatly packed and confirmation on WhatsApp made it simple.",
    customer: "Kukatpally Customer",
    area: "Kukatpally",
    date: "May 2026",
    product: "Daily Pooja Flowers",
  },
  {
    title: "Gift-ready bouquet",
    text: "The bouquet looked neat and premium for gifting. Flower availability and final price were confirmed before order.",
    customer: "Hyderabad Customer",
    area: "Hyderabad",
    date: "May 2026",
    product: "Rose Bouquet",
  },
  {
    title: "Good jasmine availability",
    text: "Checked jasmine availability on WhatsApp and received fresh malli. Useful for regular pooja and daily flower needs.",
    customer: "Gachibowli Customer",
    area: "Gachibowli",
    date: "May 2026",
    product: "Jasmine / Malli",
  },
];
---

<section id="reviews" class="bg-paper px-5 py-14 md:px-8 md:py-16">
  <div class="mx-auto max-w-7xl">
    <div class="mb-10 text-center">
      <p class="fp-eyebrow">
        Early Customer Feedback
      </p>

      <h2 class="fp-h2 mt-3">
        Fresh Petals Reviews
      </h2>

      <p class="mx-auto mt-4 max-w-2xl text-sm leading-7 text-moss">
        Early Fresh Petals feedback from Hyderabad customers. Reviews are manually collected from real WhatsApp order and enquiry conversations as the brand grows.
      </p>
    </div>

    <div class="grid gap-5 md:grid-cols-3 md:gap-7">
      {
        reviews.map((review) => (
          <article class="rounded-[28px] border border-line bg-paper px-6 py-8 text-left transition duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] hover:border-rose hover:shadow-[0_14px_36px_rgba(40,24,32,0.07)]">
            <div class="flex items-start justify-between gap-4">
              <div>
                <p class="text-[10px] font-semibold uppercase tracking-[0.22em] text-rose-deep">
                  {review.product}
                </p>

                <h3 class="mt-3 text-sm font-semibold uppercase tracking-[0.16em] text-ink">
                  {review.title}
                </h3>
              </div>

              <span class="shrink-0 rounded-full bg-mint-soft px-3 py-1 text-[10px] font-semibold uppercase tracking-[0.16em] text-ink">
                Early Review
              </span>
            </div>

            <p class="mt-5 text-sm leading-7 text-moss">
              “{review.text}”
            </p>

            <div class="mt-6 border-t border-line pt-5">
              <p class="text-xs font-semibold uppercase tracking-[0.18em] text-ink">
                {review.customer}
              </p>

              <p class="mt-2 text-xs uppercase tracking-[0.18em] text-rose-deep">
                {review.area} • {review.date}
              </p>
            </div>
          </article>
        ))
      }
    </div>

    <div class="mt-8 text-center">
      <a
        href="/reviews"
        class="inline-flex rounded-full border border-ink px-6 py-3 text-[11px] font-bold uppercase tracking-[0.22em] text-ink transition hover:bg-ink hover:text-white"
      >
        View More Reviews
      </a>
    </div>
  </div>
</section>