---

<nav class="relative z-40 hidden border-b border-[#EEE5E8] bg-white lg:block">
  <div class="mx-auto flex max-w-7xl items-center justify-center gap-9 px-8">
    {
      menuItems.map((item) => (
        <div class="group">
          <a
            href={item.href}
            class="relative block whitespace-nowrap py-4 text-[13px] font-medium uppercase tracking-[0.28em] text-[#111111] transition-colors duration-300 ease-out hover:text-[#D98B9A]"
          >
            {item.label}

            <span class="absolute bottom-0 left-0 h-px w-0 bg-[#111111] transition-all duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:w-full" />
          </a>

          {item.columns && (
            <div class="pointer-events-none absolute left-0 top-full z-50 w-full translate-y-3 border-b border-[#EEE5E8] bg-white/95 opacity-0 shadow-[0_20px_50px_rgba(40,24,32,0.08)] backdrop-blur-sm transition-all duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:pointer-events-auto group-hover:translate-y-0 group-hover:opacity-100">
              <div
                class={`mx-auto grid max-w-7xl gap-20 px-12 py-14 ${
                  item.columns.length === 1 ? "md:grid-cols-1" : "md:grid-cols-4"
                }`}
              >
                {
                  item.columns.map((column, columnIndex) => (
                    <div
                      class="translate-y-2 opacity-0 transition-all duration-500 ease-out group-hover:translate-y-0 group-hover:opacity-100"
                      style={`transition-delay: ${columnIndex * 70}ms`}
                    >
                      <h3 class="mb-6 text-[13px] font-medium uppercase tracking-[0.32em] text-[#333333]">
                        {column.title}
                      </h3>

                      <ul class="space-y-5">
                        {
                          column.links.map((link, linkIndex) => (
                            <li
                              class="translate-y-1 opacity-0 transition-all duration-500 ease-out group-hover:translate-y-0 group-hover:opacity-100"
                              style={`transition-delay: ${120 + linkIndex * 25}ms`}
                            >
                              <a
                                href={link.href}
                                class="text-[14px] font-normal uppercase tracking-[0.28em] text-[#333333] transition-colors duration-300 ease-out hover:text-[#000000]"
                              >
                                {link.label}
                              </a>
                            </li>
                          ))
                        }
                      </ul>
                    </div>
                  ))
                }
              </div>
            </div>
          )}
        </div>
      ))
    }
  </div>
</nav>