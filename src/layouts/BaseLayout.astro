---
import "../styles/global.css";

// Atelier redesign: the site header/footer below replace CityBar,
// EcommerceHeader, MegaNav, MobileBottomBar and Footer (those files are left
// on disk unchanged). Fonts are self-hosted via global.css.
import SiteHeader from "../components/atelier/SiteHeader.astro";
import SiteFooter from "../components/atelier/SiteFooter.astro";
import RoundCategoryCarousel from "../components/RoundCategoryCarousel.astro";


const {
  title = "Fresh Petals Bengaluru",
  description = "Fresh flowers, pooja flowers, jasmine, bouquets, garlands and event flowers in Bengaluru.",
  // Falls back to a real, existing site image (the homepage's own hero
  // banner) rather than inventing per-page artwork — every page that
  // doesn't pass its own image (e.g. a product photo) still gets a
  // genuine, already-shipped photo for link previews, not a blank one.
  image = "/images/hero-main-banner.jpg",
  showCategoryCarousel = true,
  // Keeps a page reachable for customers but out of search results
  // (cart, search, saved, empty categories). "follow" so its links still
  // count.
  noindex = false,
  // Schema.org objects for this page, rendered as one JSON-LD @graph.
  // Only facts the page itself shows or that are verified (see
  // src/data/seoLanding.ts) belong here.
  jsonLd = [],
} = Astro.props;

// Astro.site comes from astro.config.mjs's `site` value (see that file's
// header comment on why it's currently the Vercel URL, not a permanent
// domain). Every canonical/OG/Twitter URL below derives from this one
// value — change it once there and everything here updates with it.
//
// Canonical paths drop the trailing slash (except "/"): the sitemap and
// every internal link already use the slash-less form, and both forms
// return 200 on Vercel, so a slashed canonical sent Google conflicting
// signals about which URL to index.
const canonicalPath = Astro.url.pathname.length > 1 ? Astro.url.pathname.replace(/\/+$/, "") : "/";
const canonicalUrl = new URL(canonicalPath, Astro.site);
const absoluteImageUrl = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Self-hosted fonts (no third-party request), loaded on demand by
         global.css with font-display: swap. Deliberately not preloaded:
         measured, preloading them delayed first render and the largest
         paint on product-listing pages. -->
    <meta name="theme-color" content="#f7f3eb" />

    <!-- Motion is opt-in: reveal masks only apply when the visitor allows
         motion and this script ran, so content is never hidden otherwise. -->
    <!-- "js": controls that only work with scripts (listing filters) are laid
         out from the first paint instead of appearing later and pushing
         the products down. -->
    <script is:inline>
      (function () {
        document.documentElement.classList.add("js");
        if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
          document.documentElement.classList.add("motion");
        }
      })();
    </script>
    <slot name="head" />

    <title>{title}</title>

    <!-- Open Graph / Twitter Card — every value here is either an
         existing page prop (title/description/image) or derived from
         Astro.site; nothing invented (no ratings, no fabricated business
         info — see docs/architecture/supabase-migration.md's SEO
         findings for why LocalBusiness/Product structured data was
         deliberately left out this milestone: the repo has no verified
         address/hours/SKU/stock data to populate it honestly). -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:site_name" content="Fresh Petals Bengaluru" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={absoluteImageUrl} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteImageUrl} />

    {
      jsonLd.length > 0 && (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify({ "@context": "https://schema.org", "@graph": jsonLd }).replace(/</g, "\\u003c")}
        />
      )
    }
  </head>

  <body>
    <SiteHeader />
    <slot name="stage" />
    <div id="main" class="site-main" tabindex="-1">
      {showCategoryCarousel && <RoundCategoryCarousel />}
      <slot />
    </div>
    <SiteFooter />

    <script is:inline>
      (function () {
        var root = document.documentElement;
        var els = [].slice.call(document.querySelectorAll("[data-reveal]"));
        if (!root.classList.contains("motion") || !("IntersectionObserver" in window)) {
          els.forEach(function (el) { el.classList.add("is-in"); });
          return;
        }
        var io = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-in");
                io.unobserve(entry.target);
              }
            });
          },
          { rootMargin: "0px 0px -4% 0px", threshold: 0 }
        );
        els.forEach(function (el) { io.observe(el); });
      })();
    </script>
  </body>
</html>