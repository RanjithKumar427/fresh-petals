# build output
dist/
.vercel/

# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# environment variables — ignore every real .env file (.env, .env.local,
# .env.development, .env.production, etc.) but keep the valueless template
# tracked so the required variable names stay documented in the repo.
.env*
!.env.example

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# admin backend — local SQLite database and uploaded media, both generated
# at runtime (see src/server/db/paths.mjs)
/data/
/uploads/
scripts/_tmp-*
